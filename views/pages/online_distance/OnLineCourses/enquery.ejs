<!-- ============================================================
     ENQUIRY FORM – Inline message (no toast
============================================================ -->
<!-- The Form with message container -->
<div class="hero-form-wrapper">
    <h3>Get Free Consultation</h3>
    <p>Fill in your details & our academic experts will assist you.</p>

    <!-- Message container – shows success/error messages -->
    <div id="formMessage" style="display: none; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-weight: 500; text-align: center; font-size: 15px;"></div>

    <form class="hero-form" id="enquiryForm" onsubmit="return submitEnquiryForm(event)" novalidate>
        <div class="form-group">
            <input type="text" name="name" placeholder="Full Name">
        </div>
        <div class="form-group">
            <input type="email" name="email" placeholder="Email Address">
        </div>
        <div class="form-group">
            <input type="tel" name="phoneNumber" placeholder="Phone Number">
        </div>
        <div class="form-group">
            <select name="course">
                <option value="">Select Program</option>
                <option value="mba">Online MBA</option>
                <option value="bba">Online BBA</option>
                <option value="mca">Online MCA</option>
                <option value="bca">Online BCA</option>
                <option value="mcom">Online M.Com</option>
                <option value="bcom">Online B.Com</option>
            </select>
            <input type="hidden" name="degree" id="degreeHidden" value="">
        </div>
        <div class="form-group">
            <textarea name="message" placeholder="Your message (optional)" rows="2"></textarea>
        </div>
        <div class="form-group">
            <select name="callbackTime">
                <option value="">Preferred Callback Time (optional)</option>
                <option value="Morning (9 AM - 12 PM)">Morning (9 AM - 12 PM)</option>
                <option value="Afternoon (12 PM - 5 PM)">Afternoon (12 PM - 5 PM)</option>
                <option value="Evening (5 PM - 8 PM)">Evening (5 PM - 8 PM)</option>
            </select>
        </div>
        <button type="submit" class="btn-primary">Submit Application <i class="fas fa-arrow-right"></i></button>
        <p class="form-disclaimer">By submitting, you agree to our <a href="#">Privacy Policy</a>.</p>
    </form>
</div>

<script>
    // Display message inline
    function showFormMessage(message, type = 'success') {
        const msgDiv = document.getElementById('formMessage');
        if (!msgDiv) return;
        msgDiv.textContent = message;
        msgDiv.style.display = 'block';
        if (type === 'success') {
            msgDiv.style.background = '#f0fdf4';
            msgDiv.style.color = '#166534';
            msgDiv.style.border = '1px solid #86efac';
        } else {
            msgDiv.style.background = '#fef2f2';
            msgDiv.style.color = '#991b1b';
            msgDiv.style.border = '1px solid #fca5a5';
        }
        // Auto-hide after 6 seconds
        clearTimeout(window.messageTimer);
        window.messageTimer = setTimeout(() => {
            msgDiv.style.display = 'none';
        }, 6000);
    }

    // Main submission
    window.submitEnquiryForm = function(event) {
        event.preventDefault();
        const form = document.getElementById('enquiryForm');
        if (!form) { alert('Form not found!'); return false; }

        const name = form.querySelector('input[name="name"]').value.trim();
        const email = form.querySelector('input[name="email"]').value.trim();
        const phone = form.querySelector('input[name="phoneNumber"]').value.trim();
        const course = form.querySelector('select[name="course"]').value;
        const message = form.querySelector('textarea[name="message"]').value.trim();
        const callbackTime = form.querySelector('select[name="callbackTime"]').value;
        const degree = document.getElementById('degreeHidden').value;

        const payload = { name, email, phoneNumber: phone, course, degree, message, callbackTime };
        const endpoint = window.location.origin + '/submitEnquery';

        // Show submitting message
        showFormMessage('Submitting...', 'success');

        fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        })
        .then(res => {
            return res.json().then(data => {
                return { status: res.status, data };
            }).catch(() => {
                return { status: res.status, data: { error: 'Server error' } };
            });
        })
        .then(({ status, data }) => {
            if (data.success) {
                showFormMessage(data.message, 'success');
                form.reset();
                document.getElementById('degreeHidden').value = '';
            } else {
                showFormMessage(data.error || 'Submission failed.', 'error');
            }
        })
        .catch(err => {
            console.error(err);
            showFormMessage('Network error. Please try again.', 'error');
        });

        return false;
    };

    // Sync degree with course selection
    document.addEventListener('DOMContentLoaded', function() {
        const courseSelect = document.querySelector('select[name="course"]');
        const degreeHidden = document.getElementById('degreeHidden');
        if (courseSelect && degreeHidden) {
            courseSelect.addEventListener('change', function() {
                degreeHidden.value = this.value;
            });
        }
    });
</script>