    <!-- ============================================================
    JAVASCRIPT
    ============================================================ -->
    <script>
        // ============================================================
        // FAQ
        // ============================================================
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', function() {
                this.parentElement.classList.toggle('open');
            });
        });

        // ============================================================
        // STICKY SUBMENU SCROLL SPY
        // ============================================================
        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.submenu-scroll a');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const top = section.offsetTop - 180;
                if (window.scrollY >= top) {
                    current = section.getAttribute('id');
                }
            });
            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === '#' + current) {
                    link.classList.add('active');
                }
            });
        });

        // ============================================================
        // SLIDER
        // ============================================================
        (() => {
            const track = document.getElementById("sliderTrack");
            const wrapper = document.getElementById("sliderWrapper");
            const left = document.querySelector(".arrow-left");
            const right = document.querySelector(".arrow-right");

            let position = 0;
            const gap = 20;

            function getStep() {
                const card = track.querySelector(".slider-card");
                return card.offsetWidth + gap;
            }

            function getMaxScroll() {
                return track.scrollWidth - wrapper.offsetWidth;
            }

            function slideNext() {
                const max = getMaxScroll();
                const step = getStep();
                if (position >= max - 5) {
                    position = 0;
                } else {
                    position = Math.min(position + step, max);
                }
                track.style.transform = `translateX(-${position}px)`;
            }

            function slidePrev() {
                const max = getMaxScroll();
                const step = getStep();
                if (position <= 5) {
                    position = max;
                } else {
                    position = Math.max(position - step, 0);
                }
                track.style.transform = `translateX(-${position}px)`;
            }

            if (right) right.onclick = slideNext;
            if (left) left.onclick = slidePrev;

            window.addEventListener('resize', () => {
                position = 0;
                track.style.transform = `translateX(0)`;
            });
        })();
    </script>

