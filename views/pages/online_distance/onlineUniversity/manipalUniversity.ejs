            ];

            const rowsPerPage = 10;
            let currentPage = 1;
            const totalPages = Math.ceil(rowsData.length / rowsPerPage);

            const tbody = document.getElementById('tableBody');
            const pageNumbersDiv = document.getElementById('pageNumbers');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');

            function renderTable(page) {
                const start = (page - 1) * rowsPerPage;
                const end = Math.min(start + rowsPerPage, rowsData.length);
                const pageData = rowsData.slice(start, end);

                let html = '';
                pageData.forEach(row => {
                    html += `<tr>
                                <td>${row.course}</td>
                                <td>${row.spec}</td>
                                <td>${row.duration}</td>
                                <td>${row.fees}</td>
                                <td>${row.emi}</td>
                                <td><a href="#" class="brochure-link"><i class="fas fa-download"></i> Download Brochure</a></td>
                            </tr>`;
                });
                tbody.innerHTML = html;
                updatePagination(page);
            }

            function updatePagination(page) {
                prevBtn.disabled = (page === 1);
                nextBtn.disabled = (page === totalPages);

                let numbersHtml = '';
                for (let i = 1; i <= totalPages; i++) {
                    numbersHtml +=
                        `<button class="page-num ${i === page ? 'active' : ''}" data-page="${i}">${i}</button>`;
                }
                pageNumbersDiv.innerHTML = numbersHtml;

                document.querySelectorAll('.page-num').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const pageNum = parseInt(this.dataset.page);
                        if (pageNum !== currentPage) {
                            currentPage = pageNum;
                            renderTable(currentPage);
                        }
                    });
                });
            }

            prevBtn.addEventListener('click', function() {
                if (currentPage > 1) {
                    currentPage--;
                    renderTable(currentPage);
                }
            });

            nextBtn.addEventListener('click', function() {
                if (currentPage < totalPages) {
                    currentPage++;
                    renderTable(currentPage);
                }
            });

            renderTable(currentPage);
        })();
    </script>

