            }
            .cta-section h2 {
                font-size: 28px;
            }
            .hero-video iframe {
                aspect-ratio: 16/9;
            }
            .eligibility-card {
                padding: 24px 20px;
            }
            .eligibility-header h3 {
                font-size: 20px;
            }
            .eligibility-icon {
                width: 42px;
                height: 42px;
                font-size: 18px;
            }
            .fee-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
                padding: 14px 16px;
            }
            .fee-amount {
                text-align: left;
                width: 100%;
            }
            .fee-price {
                font-size: 16px;
                display: inline;
            }
            .fee-period {
                display: inline;
                margin-left: 6px;
            }
            .fees-highlight {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }
            .cert-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .cert-content {
                padding: 0;
                order: 1;
            }
            .cert-image {
                order: 2;
                height: auto;
                padding: 20px;
                min-height: 300px;
            }
            .cert-image img {
                max-height: 400px;
                width: auto;
                height: auto;
            }
        }

        @media (max-width: 480px) {
            .why-grid {
                grid-template-columns: 1fr;
                gap: 14px;
            }
            .why-card {
                min-height: unset;
                padding: 20px 16px;
            }
            .steps-grid {
                grid-template-columns: 1fr;
            }
            .hero-buttons .btn-primary,
            .hero-buttons .btn-outline {
                width: 100%;
                text-align: center;
            }
            .hero-badges img {
                height: 32px;
            }
            .tab-btn {
                padding: 8px 14px;
                font-size: 13px;
            }
            .program-card ul li {
                font-size: 13px;
            }
            .table-wrap table {
                font-size: 12px;
                min-width: 520px;
            }
            .table-wrap thead th,
            .table-wrap tbody td {
                padding: 8px 10px;
            }
            .pagination-controls {
                gap: 4px;
                flex-wrap: wrap;
            }
            .pagination-controls .page-btn,
            .pagination-controls .page-num {
                padding: 5px 10px;
                font-size: 13px;
                min-width: 32px;
            }
            .about-image {
                min-height: 200px;
                padding: 16px;
            }
            .about-image img {
                max-height: 280px;
            }
            .cert-image {
                min-height: 200px;
                padding: 12px;
            }
            .cert-image img {
                max-height: 220px;
            }
            .cert-feature {
                padding: 14px 16px;
