            margin-bottom: 16px;
        }
        .mb-24 {
            margin-bottom: 24px;
        }
        .mt-24 {
            margin-top: 24px;
        }
        .gap-12 {
            gap: 12px;
        }
        .flex-wrap {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
        }
    </style>
</head>
