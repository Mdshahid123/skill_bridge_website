            { name: 'PhD (Online)', icon: 'fa-graduation-cap', desc: 'Doctor of Philosophy', tag: 'Online' },
        ],
        'graduate_arts_online': [
            { name: 'MA (Online)', icon: 'fa-book-open', desc: 'Master of Arts', tag: 'Online' },
            { name: 'M.Ed (Online)', icon: 'fa-chalkboard-teacher', desc: 'Master of Education', tag: 'Online' },
        ],
    };

    const defaultPrograms = [
        { name: 'MBA (Online)', icon: 'fa-briefcase', desc: 'Master of Business Administration', tag: 'Online' },
        { name: 'BCA (Online)', icon: 'fa-laptop-code', desc: 'Bachelor of Computer Applications', tag: 'Online' },
        { name: 'B.Com (Online)', icon: 'fa-calculator', desc: 'Bachelor of Commerce', tag: 'Online' },
    ];

    // ─── Stepper Update ───
    function updateStepper(step) {
        const items = document.querySelectorAll('.stepper-item');
        const lines = document.querySelectorAll('.stepper-line');
        
        items.forEach((item, index) => {
            const num = parseInt(item.dataset.step);
            item.classList.remove('active', 'completed');
            if (num === step) item.classList.add('active');
            else if (num < step) item.classList.add('completed');
        });
        
        lines.forEach((line, index) => {
            line.classList.toggle('completed', index < step - 1);
        });
    }

    // ─── Option click ───
    document.querySelectorAll('.step-option').forEach(option => {
        option.addEventListener('click', function() {
            const step = this.closest('.finder-step');
            const stepNumber = parseInt(step.dataset.step);
            
            step.querySelectorAll('.step-option').forEach(opt => opt.classList.remove('selected'));
            this.classList.add('selected');

            const value = this.dataset.value;
            userSelections[`step${stepNumber}`] = value;

            const nextBtn = step.querySelector('.step-btn-next');
            if (nextBtn) nextBtn.disabled = false;
        });
    });

    // ─── Navigation ───
    function goToStep(stepNumber) {
        const steps = document.querySelectorAll('.finder-step');
        steps.forEach(step => step.classList.remove('active'));
        const target = document.querySelector(`.finder-step[data-step="${stepNumber}"]`);
        if (target) target.classList.add('active');
        currentStep = stepNumber;
        updateStepper(stepNumber);
    }

    document.querySelectorAll('.step-btn-next').forEach(btn => {
        btn.addEventListener('click', function() {
            const stepEl = this.closest('.finder-step');
            const stepNumber = parseInt(stepEl.dataset.step);
            if (stepNumber === totalSteps) {
                showResults();
                return;
            }
            goToStep(stepNumber + 1);
        });
    });

    document.querySelectorAll('.step-btn-prev').forEach(btn => {
        btn.addEventListener('click', function() {
            const stepEl = this.closest('.finder-step');
            const stepNumber = parseInt(stepEl.dataset.step);
            if (stepNumber > 1) goToStep(stepNumber - 1);
        });
    });

    // ─── Show Results ───
    function showResults() {
        document.querySelector('.finder-step[data-step="5"]').style.display = 'none';
        const results = document.getElementById('finderResults');
        results.classList.add('show');

        const q = userSelections.step1 || 'graduate';
        const field = userSelections.step2 || 'management';
        const mode = userSelections.step3 || 'online';
        const budget = userSelections.step4 || 'budget-mid';
        const goal = userSelections.step5 || 'career-start';

        let key = `${q}_${field}_${mode}`;
        let programs = programDatabase[key] || [];
        if (programs.length === 0) {
            key = `${q}_${field}`;
            programs = programDatabase[key] || [];
        }
        if (programs.length === 0) {
            key = `${q}`;
            programs = programDatabase[key] || [];
        }
        if (programs.length === 0) {
            programs = defaultPrograms;
        }

        renderResults(programs);
    }

    // ─── Render Results ───
    function renderResults(programs) {
        const grid = document.getElementById('resultsGrid');
        const iconMap = {
            'fa-briefcase': '💼',
            'fa-laptop-code': '💻',
            'fa-book-reader': '📖',
            'fa-code': '📝',
            'fa-calculator': '🧮',
            'fa-microchip': '🔬',
            'fa-database': '📊',
            'fa-chart-line': '📈',
            'fa-flask': '🧪',
            'fa-graduation-cap': '🎓',
            'fa-book-open': '📚',
            'fa-chalkboard-teacher': '👨‍🏫',
        };
        grid.innerHTML = programs.map(p => {
            const icon = iconMap[p.icon] || '🎓';
            return `
                <div class="result-card">
                    <div class="result-icon">${icon}</div>
                    <h4>${p.name}</h4>
                    <p>${p.desc}</p>
                    <span class="result-tag">${p.tag}</span>
                    <a href="#" class="result-link">View Details →</a>
                </div>
            `;
        }).join('');
    }

    // ─── Reset ───
    function resetFinder() {
        userSelections = {};
        currentStep = 1;
        document.querySelectorAll('.step-option').forEach(opt => opt.classList.remove('selected'));
        document.querySelectorAll('.step-btn-next').forEach(btn => btn.disabled = true);
        document.getElementById('finderResults').classList.remove('show');
        document.querySelector('.finder-step[data-step="5"]').style.display = 'block';
        goToStep(1);
    }

    // ─── Keyboard support ───
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            const activeStep = document.querySelector('.finder-step.active');
            if (activeStep) {
                const nextBtn = activeStep.querySelector('.step-btn-next:not(:disabled)');
                if (nextBtn) {
                    e.preventDefault();
                    nextBtn.click();
                }
            }
        }
    });

    // ─── Initialize ───
    updateStepper(1);
</script>
   
