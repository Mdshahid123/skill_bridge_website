<!-- ─── Page-specific JavaScript ─── -->
<script>
    // ─── Slider ───
    const slides = document.querySelectorAll(".slide");
    const dots = document.querySelectorAll(".dot");
    let current = 0;

    function showSlide(index) {
        slides.forEach(slide => slide.classList.remove("active"));
        dots.forEach(dot => dot.classList.remove("active"));
        slides[index].classList.add("active");
        dots[index].classList.add("active");
    }

    if (document.querySelector(".next")) {
        document.querySelector(".next").addEventListener("click", () => {
            current = (current + 1) % slides.length;
            showSlide(current);
        });
    }

    if (document.querySelector(".prev")) {
        document.querySelector(".prev").addEventListener("click", () => {
            current = (current - 1 + slides.length) % slides.length;
            showSlide(current);
        });
    }

    dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
            current = index;
            showSlide(current);
        });
    });

    setInterval(() => {
        current = (current + 1) % slides.length;
        showSlide(current);
    }, 5000);

    // ─── Shared Toggle Logic ───
    function setupToggle(containerSelector, toggleBtnId, initialLimit = 8, viewAllText, viewLessText) {
        const container = document.querySelector(containerSelector);
        if (!container) return;
        const cards = container.querySelectorAll('.uni-card, .course-card'); // works for both
        const btn = document.getElementById(toggleBtnId);
        if (!btn) return;

        let isExpanded = false; // false = showing limited, true = showing all

        // Helper: get currently visible cards (not filter-hidden)
        function getVisibleCards() {
            const visible = [];
            cards.forEach(card => {
                if (!card.classList.contains('filter-hidden')) {
                    visible.push(card);
                }
            });
            return visible;
        }

        // Helper: show limited number of cards
        function showLimited() {
            const visible = getVisibleCards();
            visible.forEach((card, index) => {
                if (index < initialLimit) {
                    card.classList.remove('view-hidden');
                } else {
                    card.classList.add('view-hidden');
                }
            });
            isExpanded = false;
            updateButton();
        }

        // Helper: show all visible cards
        function showAll() {
            const visible = getVisibleCards();
            visible.forEach(card => {
                card.classList.remove('view-hidden');
            });
            isExpanded = true;
            updateButton();
        }

        // Update button text and class
        function updateButton() {
            const visible = getVisibleCards();
            if (visible.length <= initialLimit) {
                btn.style.display = 'none';
                return;
            }
            btn.style.display = 'inline-block';
            if (isExpanded) {
                btn.textContent = viewLessText;
                btn.className = 'view-toggle-btn view-less';
                btn.innerHTML = viewLessText + ' <i class="fas fa-chevron-up" style="font-size: 12px; margin-left: 6px;"></i>';
            } else {
                btn.textContent = viewAllText;
                btn.className = 'view-toggle-btn view-all';
                btn.innerHTML = viewAllText + ' <i class="fas fa-chevron-down" style="font-size: 12px; margin-left: 6px;"></i>';
            }
        }

        // Toggle
        btn.addEventListener('click', function() {
            if (isExpanded) {
                showLimited();
            } else {
                showAll();
            }
        });

        // Expose a reset function for filters
        function resetToggle() {
            showLimited();
        }

        return { resetToggle, getVisibleCards };
    }

    // ─── Universities Section ───
    const uniToggle = setupToggle(
        '.uni-grid',
        'viewToggleBtn',
        8,
        'View All Universities',
        'View Less'
    );

    // ─── Universities Filter ───
    const uniFilterBtns = document.querySelectorAll('.filter-btn:not(.course-filter)');
    const uniCards = document.querySelectorAll('.uni-card');

    uniFilterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            uniFilterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            const region = this.dataset.region;
            uniCards.forEach(card => {
                if (region === 'all' || card.dataset.region === region) {
                    card.classList.remove('filter-hidden');
                } else {
                    card.classList.add('filter-hidden');
                }
            });
            // Reset toggle after filter
            if (uniToggle) uniToggle.resetToggle();
        });
    });

    // ─── Courses Section ───
    const courseToggle = setupToggle(
        '.course-grid',
        'courseToggleBtn',
        8,
        'View All Courses',
        'View Less'
    );

    // ─── Courses Filter ───
    const courseFilterBtns = document.querySelectorAll('.course-filter');
    const courseCards = document.querySelectorAll('.course-card');

    courseFilterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            courseFilterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            const category = this.dataset.category;
            courseCards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.classList.remove('filter-hidden');
                } else {
                    card.classList.add('filter-hidden');
                }
            });
            // Reset toggle after filter
            if (courseToggle) courseToggle.resetToggle();
        });
    });

    // ─── Initial state ───
    // Universities: show first 8
    if (uniToggle) uniToggle.resetToggle();
    // Courses: show first 8
    if (courseToggle) courseToggle.resetToggle();
</script>

</body>
</html>