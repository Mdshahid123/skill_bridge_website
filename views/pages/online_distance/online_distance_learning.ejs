<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Distance Degree Programs</title>

     <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- ✅ Page-specific styles -->
    <style>
        /* ─── Page Specific Styles ─── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f8fafc;
        }

        /* ─── HERO ─── */
        .hero-section {
            position: relative;
            height: 80vh;
            min-height: 520px;
            max-height: 720px;
            overflow: hidden;
            margin-top:20px;
        }

        .slider {
            width: 100%;
            height: 100%;
            position: relative;
        }

        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: 1s ease;
        }

        .slide.active {
            opacity: 1;
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg,
                    rgba(0, 0, 0, .85),
                    rgba(0, 0, 0, .45),
                    rgba(0, 0, 0, .15));
        }

        .content {
            position: absolute;
            top: 50%;
            left: 8%;
            transform: translateY(-50%);
            max-width: 700px;
            color: white;
            z-index: 10;
        }

        .badge {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 50px;
            background: rgba(255, 255, 255, .12);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, .2);
            margin-bottom: 16px;
            font-weight: 500;
            font-size: 0.85rem;
        }

        .content h1 {
            font-size: 3.6rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 10px;
        }

        .content h2 {
            color: #14b8a6;
            font-size: 1.6rem;
            margin-bottom: 14px;
        }

        .content p {
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 22px;
            color: #e2e8f0;
            max-width: 550px;
        }

        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 24px;
        }

        .features div {
            background: rgba(255, 255, 255, .1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, .15);
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 0.9rem;
        }

        .buttons {
            display: flex;
            gap: 15px;
        }

        .btn {
            text-decoration: none;
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 600;
            transition: .4s;
            font-size: 0.95rem;
        }

        .primary {
            background: #14b8a6;
            color: white;
        }

        .primary:hover {
            background: #0f766e;
            transform: translateY(-3px);
        }

        .secondary {
            border: 2px solid white;
            color: white;
        }

        .secondary:hover {
            background: white;
            color: #111;
        }

        .prev,
        .next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 48px;
            height: 48px;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            font-size: 20px;
            background: rgba(255, 255, 255, .15);
            color: white;
            backdrop-filter: blur(10px);
            z-index: 20;
            transition: .3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .prev:hover,
        .next:hover {
            background: #14b8a6;
        }

        .prev {
            left: 16px;
        }

        .next {
            right: 16px;
        }

        .dots {
            position: absolute;
            bottom: 22px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 20;
        }

        .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: white;
            opacity: .4;
            cursor: pointer;
            transition: .3s;
        }

        .dot.active {
            opacity: 1;
            background: #14b8a6;
            transform: scale(1.2);
        }

        /* ─── STATS ─── */
        .stats {
            width: 90%;
            max-width: 1300px;
            margin: -40px auto 0;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, .08);
            padding: 24px 30px;
            position: relative;
            z-index: 50;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
        }

        .stat {
            text-align: center;
        }

        .stat h3 {
            font-size: 1.7rem;
            color: #0f172a;
        }

        .stat p {
            color: #64748b;
            font-size: 0.9rem;
        }

        /* ─── UNIVERSITIES SECTION ─── */
        .universities {
            padding: 60px 20px 80px;
            max-width: 1300px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-header h2 {
            font-size: 2.4rem;
            color: #0f172a;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .section-header h2 span {
            color: #EE2C3C;
        }

        .section-header p {
            color: #64748b;
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        /* ─── Filter Label ─── */
        .filter-label {
            text-align: center;
            font-size: 0.9rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .filter-label i {
            color: #EE2C3C;
            margin-right: 6px;
        }

        /* ─── Filter Buttons ─── */
        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-bottom: 40px;
        }

        .filter-btn {
            padding: 8px 24px;
            border-radius: 50px;
            border: 2px solid #e2e8f0;
            background: transparent;
            font-weight: 500;
            font-size: 0.9rem;
            color: #475569;
            cursor: pointer;
            transition: 0.3s;
        }

        .filter-btn:hover {
            border-color: #EE2C3C;
            color: #EE2C3C;
        }

        .filter-btn.active {
            background: #EE2C3C;
            color: #fff;
            border-color: #EE2C3C;
        }

        /* ─── University Grid – 4 cards per row ─── */
        .uni-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .uni-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px 16px 18px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            border: 1px solid #f1f5f9;
            transition: 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .uni-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.07);
            border-color: #EE2C3C;
        }

        /* ─── Filter & View Toggle Classes ─── */
        .uni-card.filter-hidden {
            display: none !important;
        }

        .uni-card.view-hidden {
            display: none !important;
        }

        .uni-region {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #EE2C3C;
            background: #FEF2F2;
            padding: 2px 14px;
            border-radius: 50px;
            margin-bottom: 12px;
            display: inline-block;
        }

        .uni-logo {
            width: 120px;
            height: 60px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .uni-logo img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .uni-courses {
            font-size: 0.8rem;
            color: #64748b;
            margin-bottom: 6px;
        }

        .uni-courses span {
            background: #f1f5f9;
            padding: 2px 10px;
            border-radius: 50px;
            margin: 0 4px;
            font-weight: 500;
            color: #0f172a;
        }

        .uni-name {
            font-size: 1.05rem;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .uni-location {
            font-size: 0.85rem;
            color: #64748b;
            margin-bottom: 10px;
        }

        .uni-tags {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px;
            margin-top: 4px;
        }

        .uni-tags .tag {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 50px;
            font-size: 0.65rem;
            font-weight: 500;
            background: #f1f5f9;
            color: #475569;
        }

        .uni-tags .tag.approved {
            background: #dcfce7;
            color: #166534;
        }

        .uni-tags .tag.popular {
            background: #fef3c7;
            color: #92400e;
        }

        .uni-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 12px;
            color: #EE2C3C;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            transition: 0.3s;
        }

        .uni-link:hover {
            gap: 10px;
            color: #b91c1c;
        }

        /* ─── Toggle Button ─── */
        .view-toggle-wrapper {
            text-align: center;
            margin-top: 40px;
        }

        .view-toggle-btn {
            display: inline-block;
            padding: 14px 48px;
            border-radius: 50px;
            background: #EE2C3C;
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: 0.3s;
            font-family: 'Poppins', sans-serif;
        }

        .view-toggle-btn:hover {
            background: #b91c1c;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(238, 44, 60, 0.3);
        }

        .view-toggle-btn.view-all {
            background: transparent;
            color: #EE2C3C;
            border: 2px solid #EE2C3C;
        }

        .view-toggle-btn.view-all:hover {
            background: #EE2C3C;
            color: #fff;
        }

        .view-toggle-btn.view-less {
            background: #EE2C3C;
            color: #fff;
            border: none;
        }

        .view-toggle-btn.view-less:hover {
            background: #b91c1c;
        }

        /* ─── COURSES SECTION ─── */
        .courses-section {
            padding: 60px 20px 80px;
            max-width: 1300px;
            margin: 0 auto;
        }

        .course-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .course-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 30px 20px 24px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            border: 1px solid #f1f5f9;
            transition: 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            min-height: 180px;
            justify-content: center;
        }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.07);
            border-color: #EE2C3C;
        }

        .course-card .course-icon {
            width: 60px;
            height: 60px;
            background: #FEF2F2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #EE2C3C;
            margin-bottom: 12px;
            transition: 0.3s;
        }

        .course-card:hover .course-icon {
            background: #EE2C3C;
            color: #fff;
        }

        .course-card .course-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 6px;
            line-height: 1.3;
        }

        .course-card .course-duration {
            font-size: 0.85rem;
            color: #64748b;
        }

        .course-card .course-duration i {
            margin-right: 4px;
        }

        /* ─── Filter & Toggle Classes for Courses ─── */
        .course-card.filter-hidden {
            display: none !important;
        }

        .course-card.view-hidden {
            display: none !important;
        }

        /* ─── RESPONSIVE ─── */
        @media(max-width: 992px) {
            .content h1 {
                font-size: 3rem;
            }
            .content h2 {
                font-size: 1.4rem;
            }
            .hero-section {
                height: 75vh;
                min-height: 480px;
                max-height: 650px;
            }
            .section-header h2 {
                font-size: 2rem;
            }
            .uni-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
            }
            .course-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
            }
        }

        @media(max-width: 768px) {
            .hero-section {
                height: 72vh;
                min-height: 440px;
                max-height: 600px;
                margin-top: 60px;
            }

            .content {
                left: 5%;
                right: 5%;
                max-width: 100%;
            }

            .content h1 {
                font-size: 2.2rem;
            }

            .content h2 {
                font-size: 1.2rem;
            }

            .content p {
                font-size: 0.9rem;
                max-width: 100%;
            }

            .features {
                gap: 8px;
            }

            .features div {
                font-size: .8rem;
                padding: 6px 12px;
            }

            .buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                text-align: center;
                padding: 10px 20px;
                font-size: 0.9rem;
            }

            .prev,
            .next {
                display: none;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
                padding: 18px 16px;
                margin-top: -30px;
                gap: 12px;
            }

            .stat h3 {
                font-size: 1.3rem;
            }
            .stat p {
                font-size: 0.8rem;
            }

            .universities {
                padding: 40px 16px 60px;
            }
            .section-header h2 {
                font-size: 1.8rem;
            }
            .section-header p {
                font-size: 0.95rem;
            }
            .uni-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }
            .uni-card {
                padding: 16px 12px;
            }
            .uni-logo {
                width: 100px;
                height: 50px;
            }
            .uni-name {
                font-size: 0.95rem;
            }
            .uni-location {
                font-size: 0.8rem;
            }
            .filter-btn {
                padding: 6px 16px;
                font-size: 0.8rem;
            }
            .view-toggle-btn {
                padding: 12px 32px;
                font-size: 0.9rem;
            }

            .courses-section {
                padding: 40px 16px 60px;
            }
            .course-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }
            .course-card {
                padding: 24px 14px 20px;
                min-height: 150px;
            }
            .course-card .course-name {
                font-size: 0.95rem;
            }
            .course-card .course-icon {
                width: 50px;
                height: 50px;
                font-size: 1.2rem;
            }
        }

        @media(max-width: 480px) {
            .hero-section {
                height: 68vh;
                min-height: 400px;
                max-height: 520px;
            }

            .content h1 {
                font-size: 1.8rem;
            }
            .content h2 {
                font-size: 1rem;
            }
            .badge {
                font-size: 0.7rem;
                padding: 5px 12px;
            }
            .stats {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                padding: 14px 12px;
            }
            .stat h3 {
                font-size: 1.1rem;
            }
            .uni-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            .uni-card {
                padding: 14px 10px;
            }
            .uni-logo {
                width: 80px;
                height: 40px;
            }
            .uni-name {
                font-size: 0.85rem;
            }
            .uni-location {
                font-size: 0.7rem;
            }
            .uni-courses {
                font-size: 0.7rem;
            }
            .uni-tags .tag {
                font-size: 0.6rem;
                padding: 2px 8px;
            }
            .uni-link {
                font-size: 0.75rem;
            }
            .section-header h2 {
                font-size: 1.5rem;
            }
            .filter-bar {
                gap: 6px;
            }
            .filter-btn {
                padding: 4px 12px;
                font-size: 0.7rem;
                border-width: 1.5px;
            }
            .view-toggle-btn {
                padding: 10px 24px;
                font-size: 0.8rem;
            }

            .course-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            .course-card {
                padding: 18px 10px 16px;
                min-height: 130px;
            }
            .course-card .course-name {
                font-size: 0.85rem;
            }
            .course-card .course-icon {
                width: 44px;
                height: 44px;
                font-size: 1rem;
            }
            .course-card .course-duration {
                font-size: 0.75rem;
            }
        }

        @media(max-width: 400px) {
            .uni-grid {
                grid-template-columns: 1fr;
            }
            .course-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- nav bar -->
      <%- include("../../partials/common/navbar.ejs") %>
<!-- ====== MAIN CONTENT WRAPPER ====== -->
<div class="course-content-wrapper">
    <main>

        <!-- ─── HERO SECTION ─── -->
        <section class="hero-section" style="height: 65vh; min-height: 440px; max-height: 580px;">

            <div class="slider">

                <!-- Slide 1 -->
                <div class="slide active">
                    <img src="https://images.unsplash.com/photo-1661693758705-4fa65572bced?q=80&w=870&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Online Degree">
                    <div class="overlay"></div>
                    <div class="content">
                        <span  class="badge">UGC & AICTE Approved Programs</span>
                        <h1 style="font-size: 3rem;">Online & Distance <br>Degree Programs</h1>
                        <h2 style="font-size: 1.3rem;">Learn Anytime, Anywhere</h2>
                        <div class="features" style="gap: 8px; margin-bottom: 18px;">
                            <div style="padding: 6px 14px; font-size: 0.8rem;"> UGC Approved</div>
                            <div style="padding: 6px 14px; font-size: 0.8rem;"> Flexible Learning</div>
                            <div style="padding: 6px 14px; font-size: 0.8rem;"> Career Focused</div>
                            <div style="padding: 6px 14px; font-size: 0.8rem;"> Affordable Fees</div>
                        </div>
                        <div class="buttons">
                            <a href="#" class="btn primary" style="padding: 10px 24px; font-size: 0.85rem;">Explore Programs</a>
                            <a href="#" class="btn secondary" style="padding: 10px 24px; font-size: 0.85rem;">Find Your Program</a>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="slide">
                    <img style="object-fit:cover;" src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655" alt="MBA">
                    <div class="overlay"></div>
                    <div class="content">
                        <span style="position: relative; top: -30px" class="badge">Top Online MBA Programs</span>
                        <h1 style="font-size: 3rem;">Advance Your <br>Career with MBA</h1>
                        <h2 style="font-size: 1.3rem;">Study From Top Universities</h2>
                        <p style="font-size: 0.95rem; margin-bottom: 18px;">Build leadership, management and business skills through flexible online MBA programs.</p>
                        <div class="buttons">
                            <a href="#" class="btn primary" style="padding: 10px 24px; font-size: 0.85rem;">Apply Now</a>
                        </div>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="slide">
                    <img style="object-fit:cover;" src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTl8fHN0dWRlbnR8ZW58MHx8MHx8fDA%3D" alt="BCA">
                    <div class="overlay"></div>
                    <div class="content">
                        <span style="position: relative; top: -30px" class="badge"> Future Ready Programs</span>
                        <h1 style="font-size: 3rem;">Online BCA & MCA <br>Programs</h1>
                        <h2 style="font-size: 1.3rem;">Build Your Tech Career</h2>
                        <p style="font-size: 0.95rem; margin-bottom: 18px;">Learn AI, Cloud Computing, Programming, Data Science and Software Development.</p>
                        <div class="buttons">
                            <a href="#" class="btn primary" style="padding: 10px 24px; font-size: 0.85rem;">View Programs</a>
                        </div>
                    </div>
                </div>

            </div>

            <button class="prev">&#10094;</button>
            <button class="next">&#10095;</button>

            <div class="dots">
                <span class="dot active"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>

        </section>

        <!-- ─── STATS ─── -->
        <section class="stats" style="margin-top: -30px; padding: 18px 24px;">
            <div class="stat">
                <h3 style="font-size: 1.4rem;">50,000+</h3>
                <p style="font-size: 0.8rem;">Students Enrolled</p>
            </div>
            <div class="stat">
                <h3 style="font-size: 1.4rem;">50+</h3>
                <p style="font-size: 0.8rem;">Top Universities</p>
            </div>
