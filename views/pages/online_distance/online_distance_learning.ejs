        ],
        'graduate_management_distance': [
            { name: 'MBA (Distance)', icon: 'fa-book-reader', desc: 'Master of Business Administration', tag: 'Distance' },
            { name: 'PGDM (Distance)', icon: 'fa-chart-line', desc: 'Post Graduate Diploma in Management', tag: 'Distance' },
        ],
        'graduate_technology_distance': [
            { name: 'MCA (Distance)', icon: 'fa-code', desc: 'Master of Computer Applications', tag: 'Distance' },
