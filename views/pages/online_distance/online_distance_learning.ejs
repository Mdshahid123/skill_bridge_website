<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Online & Distance Learning – SkillBridge</title>
    <meta name="description" content="Explore UGC-approved online and distance degree programs. Online BBA, BCA, BA, B.Sc, MBA, MCA, M.Sc, MA, and PGDM with 100% flexible learning." />
    <meta name="keywords" content="online degree, distance learning, online MBA, online BBA, online MCA, UGC approved, distance education" />
    <meta name="author" content="SkillBridge" />
    <link rel="canonical" href="https://www.skillbridge.com/online-distance" />

    <script src="https://cdn.tailwindcss.com">
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />

    <style>
        :root {
            --ink: #101B30;
            --ink-soft: #1B2A47;
            --paper: #F7F3EA;
            --paper-deep: #EFE8D8;
            --gold: #C8932B;
            --gold-light: #E9C674;
            --teal: #2E6F66;
            --teal-deep: #163F38;
            --teal-pale: #E7F0EC;
            --line: rgba(16, 27, 48, 0.12);
            --line-soft: rgba(16, 27, 48, 0.07);
            --card: #FFFFFF;
            --muted: #5C6478;
            --radius: 16px;
            --shadow-sm: 0 1px 2px rgba(16, 27, 48, 0.06);
            --shadow-md: 0 18px 40px -22px rgba(16, 27, 48, 0.28);
            --shadow-lg: 0 30px 60px -28px rgba(16, 27, 48, 0.38);
        }
        * {
            box-sizing: border-box;
        }
        html {
            scroll-behavior: smooth;
        }
        html,
        body {
            margin: 0;
            padding: 0;
        }
        body {
            background: var(--paper);
            color: var(--ink);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            font-size: 16px;
            line-height: 1.5;
        }
        h1,
        h2,
        h3,
        h4,
        .display {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            letter-spacing: -0.012em;
            margin: 0;
            color: var(--ink);
        }
        a {
            color: inherit;
        }
        .eyebrow {
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--teal-deep);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }
        .eyebrow::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--gold);
            display: inline-block;
        }
        .wrap {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 32px;
        }
        .muted {
            color: var(--muted);
        }
        svg {
            display: block;
        }

        /* ===== HERO ===== */
        .hero {
            position: relative;
            background: var(--ink);
            color: var(--paper);
            overflow: hidden;
            padding: 46px 0 34px;
        }
        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
            background-size: 42px 42px;
            -webkit-mask-image: radial-gradient(ellipse 90% 100% at 50% 0%, #000 50%, transparent 100%);
            mask-image: radial-gradient(ellipse 90% 100% at 50% 0%, #000 50%, transparent 100%);
            pointer-events: none;
        }
        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 88% 0%, rgba(200, 147, 43, 0.22), transparent 55%);
            pointer-events: none;
        }
        .hero-grid {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
            flex-wrap: wrap;
        }
        .hero-grid>div:first-child {
            max-width: 620px;
        }
        .hero h1 {
            font-size: clamp(1.8rem, 3.2vw, 2.7rem);
            line-height: 1.14;
            margin-top: 12px;
            color: #ffffff;
        }
        .hero h1 em {
            font-style: normal;
            color: var(--gold-light);
            font-family: inherit;
        }
        .hero p.lede {
            font-size: 0.98rem;
            line-height: 1.6;
            color: #CBD2E2;
            max-width: 480px;
            margin-top: 12px;
        }
        .hero-cta-row {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .btn-primary {
            background: var(--gold);
            color: var(--ink);
            border: none;
            font-weight: 700;
            font-size: 0.9rem;
            padding: 12px 22px;
            border-radius: 999px;
            cursor: pointer;
            box-shadow: var(--shadow-md);
            transition: transform .15s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
        }
        .btn-ghost {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.3);
            font-weight: 600;
            font-size: 0.9rem;
            padding: 12px 20px;
            border-radius: 999px;
            cursor: pointer;
        }
        .btn-ghost:hover {
            border-color: #fff;
        }
        .hero-stats {
            position: relative;
            z-index: 1;
            display: flex;
            gap: 0;
            flex-shrink: 0;
        }
        .hero-stats .stat {
            padding: 0 26px;
            border-right: 1px solid rgba(255, 255, 255, 0.14);
            text-align: center;
        }
        .hero-stats .stat:last-child {
            border-right: none;
        }
        .hero-stats .num {
            font-family: 'Fraunces', serif;
            font-size: 1.6rem;
            color: #fff;
        }
        .hero-stats .lab {
            font-size: 0.72rem;
            color: #9AA3BD;
            margin-top: 3px;
            max-width: 110px;
        }

        /* ===== STICKY LEVEL TOGGLE ===== */
        .level-bar {
            position: sticky;
            top: 0;
            z-index: 30;
            background: rgba(247, 243, 234, 0.94);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--line);
        }
        .level-bar .wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 14px 32px;
            overflow-x: auto;
        }
        .level-btn {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            padding: 9px 18px;
            border-radius: 999px;
            cursor: pointer;
            white-space: nowrap;
            transition: all .15s ease;
            display: flex;
            align-items: center;
            gap: 7px;
        }
        .level-btn svg {
            width: 14px;
            height: 14px;
            opacity: .6;
        }
        .level-btn:hover {
            border-color: var(--teal);
            box-shadow: var(--shadow-sm);
        }
        .level-btn.active {
            background: var(--ink);
            color: var(--paper);
            border-color: var(--ink);
        }
        .level-btn.active svg {
            opacity: 1;
        }

        /* ===== Section wrappers ===== */
        section.block {
            padding: 64px 0;
        }
        .block+.block {
            border-top: 1px solid var(--line);
        }
        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 34px;
            flex-wrap: wrap;
        }
        .section-head h2 {
            font-size: clamp(1.55rem, 2.6vw, 2.15rem);
        }
        .section-head .sub {
            color: var(--muted);
            font-size: 0.96rem;
            max-width: 480px;
            line-height: 1.55;
            margin-top: 8px;
        }
        .section-num {
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            color: var(--gold);
            letter-spacing: .1em;
            font-weight: 700;
        }

        /* ===== Program cards grid ===== */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
        }
        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }
        .card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: rgba(46, 111, 102, 0.35);
        }
        .card-top {
            padding: 22px 24px 18px;
            display: flex;
            gap: 14px;
            align-items: flex-start;
            background: linear-gradient(180deg, var(--teal-pale), rgba(231, 240, 236, 0));
        }
        .card-icon {
            flex-shrink: 0;
            width: 44px;
            height: 44px;
            border-radius: 11px;
            background: var(--teal-deep);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }
        .card-icon svg {
            width: 22px;
            height: 22px;
        }
        .card-top .titleblock {
            flex: 1;
        }
        .card .tag {
            font-family: 'Inter', sans-serif;
            font-size: 0.66rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--gold);
            font-weight: 700;
        }
        .card h3 {
            font-size: 1.16rem;
            margin-top: 5px;
        }
        .card-body {
            padding: 18px 24px 24px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            flex: 1;
        }
        .card .meta {
            display: flex;
            gap: 20px;
            font-size: 0.8rem;
            color: var(--muted);
            border-top: 1px solid var(--line-soft);
            border-bottom: 1px solid var(--line-soft);
            padding: 11px 0;
            flex-wrap: wrap;
        }
        .card .meta span b {
            color: var(--ink);
            font-weight: 700;
        }
        .card .meta .duration-icon {
            color: var(--teal);
            margin-right: 4px;
        }
        .card ul.chips {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .card ul.chips li {
            font-size: 0.73rem;
            background: #F1ECDF;
            color: var(--teal-deep);
            border-radius: 6px;
            padding: 5px 10px;
            font-weight: 600;
        }
        .card .overview-text {
            font-size: 0.85rem;
            color: var(--muted);
            line-height: 1.6;
            margin: 0;
        }
        .card-foot {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .card-foot button {
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 0.82rem;
            color: var(--teal-deep);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .card-foot button svg {
            width: 14px;
            height: 14px;
            transition: transform .2s ease;
        }
        .card.open .card-foot button svg {
            transform: rotate(180deg);
        }
        .card .details {
            display: none;
            font-size: 0.85rem;
            line-height: 1.6;
            color: var(--muted);
            padding-top: 6px;
            border-top: 1px dashed var(--line);
        }
        .card.open .details {
            display: block;
        }
        .card .details h4 {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: var(--ink);
            margin: 12px 0 6px;
            font-weight: 700;
        }
        .card .details ul {
            margin: 0 0 0 16px;
            padding: 0;
        }
        .card .details li {
            margin-bottom: 3px;
        }

        /* ===== University table ===== */
        .uni-table-wrap {
            overflow-x: auto;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: #fff;
            box-shadow: var(--shadow-sm);
        }
        table.uni {
            width: 100%;
            border-collapse: collapse;
            min-width: 780px;
        }
        table.uni th {
            text-align: left;
            font-family: 'Inter', sans-serif;
            font-size: 0.66rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 16px 18px;
            border-bottom: 1px solid var(--line);
            background: var(--paper-deep);
            font-weight: 700;
        }
        table.uni td {
            padding: 16px 18px;
            border-bottom: 1px solid var(--line-soft);
            font-size: 0.9rem;
            vertical-align: middle;
        }
        table.uni tr:last-child td {
            border-bottom: none;
        }
        table.uni tbody tr {
            transition: background .15s ease;
        }
        table.uni tbody tr:hover {
            background: var(--teal-pale);
        }
        .uname-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .uni-avatar {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--ink-soft);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Fraunces', serif;
            font-weight: 700;
            font-size: 0.92rem;
            flex-shrink: 0;
        }
        table.uni .uname {
            font-weight: 700;
        }
        table.uni .accred {
            color: var(--muted);
            font-size: 0.78rem;
        }
        .rating {
            color: var(--gold);
            font-weight: 700;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .fee {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
        }
        .cta-mini {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--teal-deep);
            border: 1px solid var(--teal);
            border-radius: 7px;
            padding: 7px 14px;
            background: none;
            cursor: pointer;
            transition: all .15s ease;
        }
        .cta-mini:hover {
            background: var(--teal);
            color: #fff;
        }
        .table-foot-note {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 14px;
            display: flex;
            gap: 8px;
            align-items: flex-start;
        }

        /* ===== Why trust strip ===== */
        .trust-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
        }
        .trust-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 26px;
            transition: box-shadow .2s ease, transform .2s ease;
        }
        .trust-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }
        .trust-card .ico {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: var(--teal);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
        }
        .trust-card .ico svg {
            width: 21px;
            height: 21px;
        }
        .trust-card h4 {
            font-size: 1.02rem;
            margin-bottom: 7px;
        }
        .trust-card p {
            font-size: 0.87rem;
            color: var(--muted);
            line-height: 1.55;
            margin: 0;
        }

        /* ===== Admission steps ===== */
        .steps {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            overflow: hidden;
            background: #fff;
            box-shadow: var(--shadow-sm);
        }
        .step {
            padding: 26px 22px;
            border-right: 1px solid var(--line);
            position: relative;
        }
        .step:last-child {
            border-right: none;
        }
        .step .n {
            font-family: 'Fraunces', serif;
            font-size: 1.7rem;
            color: var(--gold);
        }
        .step h5 {
            font-size: 0.92rem;
            margin: 10px 0 5px;
        }
        .step p {
            font-size: 0.8rem;
            color: var(--muted);
            margin: 0;
            line-height: 1.45;
        }

        /* ===== FAQ ===== */
        .faq-wrap {
            max-width: 820px;
        }
        .faq-item {
            border-bottom: 1px solid var(--line);
        }
        .faq-q {
            width: 100%;
            text-align: left;
            background: none;
            border: none;
            cursor: pointer;
            padding: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'Fraunces', serif;
            font-size: 1.04rem;
            color: var(--ink);
            gap: 16px;
        }
        .faq-q .plus {
            font-size: 1rem;
            color: var(--gold);
            transition: transform .2s ease;
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            border: 1px solid var(--line);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .faq-item.open .plus {
            transform: rotate(45deg);
            border-color: var(--gold);
        }
        .faq-a {
            display: none;
            padding: 0 0 20px;
            color: var(--muted);
            font-size: 0.93rem;
            line-height: 1.65;
            max-width: 760px;
        }
        .faq-item.open .faq-a {
            display: block;
        }

        /* ===== Final CTA ===== */
        .final-cta {
            background: linear-gradient(135deg, var(--teal-deep), var(--ink));
            color: #fff;
            border-radius: 22px;
            padding: 54px;
            text-align: center;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
        }
        .final-cta::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 80% 0%, rgba(200, 147, 43, 0.25), transparent 55%);
        }
        .final-cta * {
            position: relative;
            z-index: 1;
        }
        .final-cta .eyebrow {
            color: var(--gold-light);
            justify-content: center;
        }
        .final-cta h2 {
            color: #fff;
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            margin-top: 10px;
        }
        .final-cta p {
            color: #CBD2E0;
            margin: 12px auto 26px;
            max-width: 480px;
        }

        @media (max-width: 900px) {
            .hero-grid {
                flex-direction: column;
                align-items: flex-start;
            }
            .hero-stats {
                flex-wrap: wrap;
                gap: 14px;
            }
            .steps {
                grid-template-columns: 1fr 1fr;
            }
            .step {
                border-bottom: 1px solid var(--line);
            }
        }
        @media (max-width: 640px) {
            .hero {
                padding: 36px 0 28px;
            }
            .hero-grid>div:first-child {
                max-width: 100%;
            }
            .hero h1 {
                font-size: 1.5rem;
            }
            .wrap {
                padding: 0 16px;
            }
            .card .meta {
                flex-direction: column;
                gap: 6px;
            }
            .grid {
                grid-template-columns: 1fr;
            }
            .steps {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <%- include('../../partials/common/navbar') %>

    <header class="hero">
        <div class="wrap hero-grid">
            <div>
                <div class="eyebrow" style="color: #E9C674;">Online &amp; Distance Learning</div>
                <h1>A recognized degree, built around <em>the life you already have.</em></h1>
                <p class="lede">Compare UGC‑approved Online &amp; Distance UG and PG programs, see real fee ranges and career outcomes, and get free counselling before you commit to a university.</p>
                <div class="hero-cta-row">
                    <button class="btn-primary">Explore Programs</button>
                    <button class="btn-ghost">Talk to a Counsellor</button>
                </div>
            </div>
            <div class="hero-stats">
                <div class="stat">
                    <div class="num">12+</div>
                    <div class="lab">Degree programs</div>
                </div>
                <div class="stat">
                    <div class="num">100+</div>
                    <div class="lab">Partner universities</div>
                </div>
                <div class="stat">
                    <div class="num">UGC‑DEB</div>
                    <div class="lab">Approved &amp; valid in India</div>
                </div>
            </div>
        </div>
    </header>

    <nav class="level-bar">
        <div class="wrap">
            <button class="level-btn active" data-level="ug">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5zm4 2v5c0 1 4 3 6 3s6-2 6-3v-5"/></svg>
                Undergraduate
            </button>
            <button class="level-btn" data-level="pg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5zm4 2v5c0 1 4 3 6 3s6-2 6-3v-5"/></svg>
                Postgraduate
            </button>
            <button class="level-btn" data-level="universities">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1M9 13h1M14 9h1M14 13h1"/></svg>
                Top Universities
            </button>
            <button class="level-btn" data-level="trust">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/></svg>
                HR Acceptance
