<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Course Details | Skill Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; }
        
        .btn-primary-custom { background: linear-gradient(135deg, #0a2b3e, #1a6f8c); transition: all 0.2s; color: white; }
        .btn-primary-custom:hover { background: linear-gradient(135deg, #0a2b3e, #0066b3); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26,111,140,0.3); }
        
        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(26,111,140,0.12) 0%, rgba(0,102,179,0.06) 50%, transparent 70%);
            animation: rotateGlow 20s linear infinite;
        }
        @keyframes rotateGlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .brand-grid {
            background-image: 
                repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px),
                repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px);
            background-size: 50px 50px;
        }
        
        .brand-grid-light {
            background-image: 
                repeating-linear-gradient(90deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px),
                repeating-linear-gradient(0deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px);
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(5deg); }
        }
        .float-animation { animation: float 4s ease-in-out infinite; }
        .float-delay-1 { animation-delay: 1s; }
        .float-delay-2 { animation-delay: 2s; }
        
        .mentor-card { transition: all 0.3s; }
        .mentor-card:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 20px 30px -12px rgba(26,111,140,0.2); }
        
        .offering-card { transition: all 0.3s ease; }
        .offering-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -12px rgba(26,111,140,0.15); }
        
        .project-card { transition: all 0.3s ease; }
        .project-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -12px rgba(0, 0, 0, 0.15); }
        
        .breadcrumb a:hover { text-decoration: underline; }
        #videoModal { backdrop-filter: blur(8px); }
        .lecture-item { cursor: pointer; }
        .lecture-item:hover { background: #e6f4f5; }
        
        .glow-text { text-shadow: 0 0 20px rgba(26,111,140,0.3); }
        
        .help-split-card {
            background: #ffffff;
            border-radius: 2rem;
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.10);
            transition: box-shadow 0.2s;
            overflow: hidden;
        }
        .help-split-card:hover { box-shadow: 0 28px 48px -12px rgba(26,111,140,0.2); }
        .person-illustration {
            background: linear-gradient(135deg, #e6f4f5, #d4eef2);
        }
        .question-mark-big {
            font-size: 4rem;
            font-weight: 700;
            background: linear-gradient(145deg, #0a2b3e, #1a6f8c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            opacity: 0.9;
        }
        .question-mark-small {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(145deg, #1a6f8c, #5ba3bc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            opacity: 0.6;
        }
        .float-question { animation: float 4s ease-in-out infinite; }
        .input-field {
            border: 1px solid #e5e7eb;
            transition: all 0.15s;
            background: #f9fafb;
        }
        .input-field:focus {
            border-color: #1a6f8c;
            box-shadow: 0 0 0 4px rgba(26,111,140,0.12);
            outline: none;
            background: #ffffff;
        }
        
        /* Lecture Locked Style */
        .lecture-item.locked {
            opacity: 0.6;
            cursor: not-allowed;
            position: relative;
        }
        .lecture-item.locked:hover {
            background: transparent;
        }
        .lecture-item.locked .fa-lock {
            color: #ef4444;
        }
        .lecture-item .fa-lock {
            display: none;
        }
        .lecture-item.locked .fa-circle-play {
            display: none;
        }
        .lecture-item.locked .fa-lock {
            display: inline-block;
        }
        
        @media (max-width: 640px) {
            .question-mark-big { font-size: 4rem; }
        }
    </style>
</head>
<body>

    <!-- nav bar -->
     
    <%- include("../partials/common/navbar")  %>

    <!-- Mobile Menu -->
    <%- include("../partials/common/mobileMenu")  %>

    <!-- MAIN CONTENT -->
    <main>
        <!-- Course Header -->

        <%- include("../partials/viewCourse/courseHeader.ejs") %>
       
        <!-- Course Content -->
              <%- include("../partials/viewCourse/courseContent.ejs") %>

         <!-- Projects Showcase -->
          <%- include("../partials/viewCourse/courseProject.ejs") %>

          <!-- Exclusive Course Offerings -->
         <%- include("../partials/viewCourse/courseOffering.ejs") %>

         <!-- Certificate Section -->
            <%- include("../partials/viewCourse/courseCertificate.ejs") %>

            <!-- Need Help Section -->
            <%- include("../partials/viewCourse/courseHelp.ejs") %>
            
            <!-- Payment Modal -->
           <%- include("../partials/viewCourse/coursePayment.ejs") %>

    <!-- Video Modal -->
    <%- include("../partials/viewCourse/courseVideo.ejs") %>

   <!-- footer -->

   <%- include("../partials/common/footer")  %>

    <script>

        //Course Data

        const coursesData = {
            1: {
                id: 1, title: "Web Development with Generative AI", breadcrumb: "Web Development",
                shortDesc: "Master HTML, CSS, JavaScript, React, Node.js, MongoDB, and integrate Generative AI.",
                fullDescription: "This comprehensive Web Development course is designed to take you from beginner to professional full-stack developer...",
                price: 5999, originalPrice: 20000, duration: "6 Months", level: "Beginner to Job Ready",
                image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=600&h=400&fit=crop",
                whatYouLearn: ["Build responsive websites using HTML5, CSS3, and JavaScript","Master React.js for building dynamic user interfaces","Create RESTful APIs with Node.js and Express","Work with MongoDB and MySQL for database management","Integrate Generative AI into your web applications","Deploy applications to production"],
                syllabus: [
                    { title: "HTML & CSS Fundamentals", lectures: ["Introduction to Web Development","Setting up Development Environment","HTML Basics: Tags, Elements, Attributes","HTML Forms and Input Types","HTML5 Semantic Elements","Introduction to CSS","CSS Selectors and Properties","CSS Box Model","CSS Flexbox Layout","CSS Grid Layout","Responsive Design with Media Queries","Building a Landing Page Project"] },
                    { title: "JavaScript Essentials", lectures: ["JavaScript Introduction & Setup","Variables, Data Types, and Operators","Control Flow: If-Else, Switch","Loops: For, While, Do-While","Functions and Scope","Arrays and Array Methods","Objects and Object Methods","DOM Manipulation","Event Handling","ES6 Features: Arrow Functions, Template Literals","Promises and Async/Await","Fetch API and AJAX"] },
                    { title: "React.js Mastery", lectures: ["Introduction to React and Virtual DOM","Setting up React Environment","Components: Functional and Class Components","JSX Syntax and Expressions","Props and State Management","Handling Events in React","Hooks: useState, useEffect","React Router for Navigation","API Integration in React","State Management with Context API","Building a Complete React Application"] },
                    { title: "Node.js & Express", lectures: ["Introduction to Node.js","Node.js Modules and NPM","HTTP Module and Creating Servers","Introduction to Express.js","Routing in Express","Middleware Functions","REST API Development","Authentication with JWT","Error Handling Middleware","Building a Complete REST API Project"] },
                    { title: "Database Management", lectures: ["Introduction to Databases","SQL vs NoSQL","MongoDB Setup and CRUD Operations","Mongoose ODM","Connecting Node.js with MongoDB","Database Integration Project"] },
                    { title: "Generative AI Integration", lectures: ["Introduction to Generative AI","OpenAI API Integration","Building AI-Powered Features","Prompt Engineering Basics","AI Chatbot Implementation","Final Project: AI-Powered Web App"] }
                ],
                requirements: ["Basic computer knowledge","No prior programming experience required","A computer with internet connection (4GB+ RAM recommended)","Eagerness to learn and build projects"]
            }
        };

        
        const params = new URLSearchParams(window.location.search);
        const courseId = params.get('id') || '1';
        const course = coursesData[courseId] || coursesData[1];
        let isPurchased = localStorage.getItem(`course_${courseId}_purchased`) === 'true';

        // Populate course data
        document.getElementById('courseBreadcrumb').textContent = course.breadcrumb;
        document.getElementById('courseTitle').innerHTML = `Web Development with <span class="bg-gradient-to-r from-teal-600 to-blue-600 bg-clip-text text-transparent">Generative AI</span>`;
        document.getElementById('courseShortDesc').textContent = course.shortDesc;
        document.getElementById('fullDescription').textContent = course.fullDescription;
        document.getElementById('sidebarTitle').textContent = course.title;
        document.getElementById('coursePrice').textContent = `₹${course.price}`;
        document.getElementById('originalPrice').textContent = `₹${course.originalPrice}`;
        document.getElementById('courseDuration').textContent = course.duration;
        document.getElementById('courseLevel').textContent = course.level;
        document.getElementById('courseImage').src = course.image;
        const discountPercent = Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100);
        document.getElementById('discount').textContent = `${discountPercent}% off`;

        // Populate What You'll Learn
        document.getElementById('whatYouLearn').innerHTML = course.whatYouLearn.map(item => `<div class="flex items-center gap-2 text-gray-600 text-sm"><i class="fa-regular fa-circle-check text-teal-500"></i><span>${item}</span></div>`).join('');
        
        // Populate Requirements
        document.getElementById('requirements').innerHTML = course.requirements.map(req => `<li class="flex items-center gap-2 text-gray-600 text-sm"><i class="fa-regular fa-circle-check text-teal-500"></i><span>${req}</span></li>`).join('');

        // Function to render syllabus with lock/unlock based on purchase status
        function renderSyllabus() {
            const contentContainer = document.getElementById('courseContent');
            if (contentContainer && course.syllabus) {
                let lectureCounter = 0;
                contentContainer.innerHTML = `
                    <div class="space-y-3">
                        ${course.syllabus.map((sec, idx) => `
                            <div class="border rounded-xl overflow-hidden bg-white">
                                <div class="flex justify-between items-center p-4 bg-gray-50 cursor-pointer hover:bg-teal-50 transition-all duration-300 section-header" data-section="${idx}">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-regular fa-folder-open text-teal-500"></i>
                                        <span class="font-semibold text-gray-800">${sec.title}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-gray-500">${sec.lectures.length} lectures</span>
                                        <i class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
                                    </div>
                                </div>
                                <div class="lecture-list hidden border-t border-gray-100 bg-white">
                                    <div class="divide-y divide-gray-50">
                                        ${sec.lectures.map((lec, li) => {
                                            lectureCounter++;
                                            const isLocked = !isPurchased && lectureCounter > 2;
                                            return `
                                                <div class="lecture-item flex items-center gap-3 p-3 transition-all duration-200 cursor-pointer group ${isLocked ? 'locked' : ''}" 
                                                     data-lecture="${lec.replace(/"/g, '&quot;')}" 
                                                     data-section="${sec.title.replace(/"/g, '&quot;')}"
                                                     data-locked="${isLocked}">
                                                    <i class="fa-regular fa-circle-play text-gray-400 text-base w-5 group-hover:text-teal-500 transition"></i>
                                                    <i class="fa-solid fa-lock text-red-500 text-base w-5"></i>
                                                    <span class="text-sm text-gray-700 flex-1 group-hover:text-teal-600 transition ${isLocked ? 'opacity-60' : ''}">${lec}</span>
                                                    <span class="text-xs text-gray-400">${Math.floor(Math.random() * 30) + 5}:${Math.floor(Math.random() * 59).toString().padStart(2, '0')} min</span>
                                                    ${!isLocked ? '<i class="fa-brands fa-youtube text-gray-400 text-sm group-hover:text-red-500 transition"></i>' : '<i class="fa-solid fa-lock text-gray-400 text-sm"></i>'}
                                                </div>
                                            `;
                                        }).join('')}
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                        ${!isPurchased ? `<div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                            <i class="fa-solid fa-lock text-amber-600 mr-2"></i>
                            <span class="text-amber-700 text-sm">First 2 lectures are free. <strong>Enroll now</strong> to unlock all ${lectureCounter} lectures!</span>
                        </div>` : `<div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
                            <i class="fa-solid fa-circle-check text-green-600 mr-2"></i>
                            <span class="text-green-700 text-sm">✅ Course unlocked! You have access to all ${lectureCounter} lectures.</span>
                        </div>`}
                        <div class="text-center mt-4">
                            <button class="text-teal-600 text-sm font-semibold hover:underline expand-all-btn transition-all duration-300">
                                <i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections
                            </button>
                        </div>
                    </div>
                `;

                // Accordion functionality
                document.querySelectorAll('.section-header').forEach(header => {
                    header.addEventListener('click', function() {
                        const lectureList = this.nextElementSibling;
                        const icon = this.querySelector('.fa-chevron-down');
                        lectureList.classList.toggle('hidden');
                        if (icon) {
                            icon.style.transform = lectureList.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                        }
                    });
                });

                // Video click handler - only if not locked
                document.querySelectorAll('.lecture-item').forEach(item => {
                    item.addEventListener('click', function(e) {
                        const isLocked = this.getAttribute('data-locked') === 'true';
                        if (isLocked) {
                            e.preventDefault();
                            e.stopPropagation();
                            alert('🔒 This lecture is locked. Please complete payment to unlock all lectures!');
                            return false;
                        }
                        const lecture = this.getAttribute('data-lecture');
                        const section = this.getAttribute('data-section');
                        openVideoModal(lecture, section);
                    });
                });

                // Expand/Collapse all functionality
                let expanded = false;
                const expandBtn = document.querySelector('.expand-all-btn');
                if (expandBtn) {
                    expandBtn.addEventListener('click', function() {
                        const allLectureLists = document.querySelectorAll('.lecture-list');
                        const allIcons = document.querySelectorAll('.fa-chevron-down');
                        if (expanded) {
                            allLectureLists.forEach(list => list.classList.add('hidden'));
                            allIcons.forEach(icon => icon.style.transform = 'rotate(0deg)');
                            this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections';
                        } else {
                            allLectureLists.forEach(list => list.classList.remove('hidden'));
                            allIcons.forEach(icon => icon.style.transform = 'rotate(180deg)');
                            this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Collapse all sections';
                        }
                        expanded = !expanded;
                    });
                }
            }
        }

        // Video Modal functions
        function openVideoModal(lecture, section) { 
            const modal = document.getElementById('videoModal'); 
            document.getElementById('videoTitle').textContent = lecture; 
            document.getElementById('videoSection').textContent = section; 
            document.getElementById('youtubeFrame').src = `https://www.youtube.com/embed/EVW4nj1jCy0?autoplay=1&rel=0`; 
            modal.classList.remove('hidden'); 
            modal.style.display = 'flex'; 
            document.body.style.overflow = 'hidden'; 
        }
        
        function closeVideoModal() { 
            const modal = document.getElementById('videoModal'); 
            document.getElementById('youtubeFrame').src = ''; 
            modal.classList.add('hidden'); 
            modal.style.display = 'none'; 
            document.body.style.overflow = ''; 
        }

        // Payment Modal Logic
        const paymentModal = document.getElementById('paymentModal');
        const closePaymentModal = document.getElementById('closePaymentModal');
        const payAmount = document.getElementById('payAmount');
        const coursePrice = course.price;
        
        // Update payment amount
        if (payAmount) payAmount.textContent = `₹${coursePrice}`;
        if (document.getElementById('paymentCoursePrice')) document.getElementById('paymentCoursePrice').textContent = `₹${coursePrice}`;
        if (document.getElementById('paymentTotalAmount')) document.getElementById('paymentTotalAmount').textContent = `₹${coursePrice}`;
        
        // Payment method switching
        const paymentMethodBtns = document.querySelectorAll('.payment-method-btn');
        const cardFields = document.getElementById('cardFields');
        const upiFields = document.getElementById('upiFields');
        const netbankingFields = document.getElementById('netbankingFields');
        
        paymentMethodBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                paymentMethodBtns.forEach(b => {
                    b.classList.remove('active', 'border-teal-500', 'bg-teal-50');
                    b.classList.add('border-gray-200');
                });
                this.classList.add('active', 'border-teal-500', 'bg-teal-50');
                const method = this.getAttribute('data-method');
                cardFields.classList.add('hidden');
                upiFields.classList.add('hidden');
                netbankingFields.classList.add('hidden');
                if (method === 'card') cardFields.classList.remove('hidden');
                else if (method === 'upi') upiFields.classList.remove('hidden');
                else if (method === 'netbanking') netbankingFields.classList.remove('hidden');
            });
        });
        
        // Enroll button - Open payment modal
        document.querySelectorAll('.enroll-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                if (isPurchased) {
                    alert('✅ You already have access to this course! All lectures are unlocked.');
                } else {
                    paymentModal.classList.remove('hidden');
                    paymentModal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
            });
        });
        
        // Payment form submission - Simulate successful payment
        const paymentForm = document.getElementById('paymentForm');
        if (paymentForm) {
            paymentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
                submitBtn.disabled = true;
                
                // Simulate payment processing
                setTimeout(() => {
                    isPurchased = true;
                    localStorage.setItem(`course_${courseId}_purchased`, 'true');
                    alert('🎉 Payment Successful! You now have full access to all lectures.');
                    paymentModal.classList.add('hidden');
                    paymentModal.style.display = 'none';
                    document.body.style.overflow = '';
                    renderSyllabus(); // Re-render syllabus with unlocked lectures
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 2000);
            });
        }
        
        // Close payment modal
        if (closePaymentModal) {
            closePaymentModal.addEventListener('click', () => {
                paymentModal.classList.add('hidden');
                paymentModal.style.display = 'none';
                document.body.style.overflow = '';
            });
        }
        
        // Close modal on outside click
        if (paymentModal) {
            paymentModal.addEventListener('click', (e) => {
                if (e.target === paymentModal) {
                    paymentModal.classList.add('hidden');
                    paymentModal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
        }
        // Close video modal
        document.getElementById('closeVideoModal')?.addEventListener('click', closeVideoModal);
        document.getElementById('videoModal')?.addEventListener('click', (e) => { if(e.target === e.currentTarget) closeVideoModal(); });
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeVideoModal(); });
        
        // Other handlers
        document.getElementById('downloadBrochureBtn')?.addEventListener('click', () => alert('📄 Brochure download started (demo).'));
        document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.remove('hidden'));
        document.getElementById('closeMenu')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.add('hidden'));
        document.getElementById('helpForm')?.addEventListener('submit', function(e) { e.preventDefault(); alert('✅ Your message has been sent! We\'ll get back to you soon.'); this.reset(); });
        
        // Initial render
        renderSyllabus();
    </script>
</body>
</html>