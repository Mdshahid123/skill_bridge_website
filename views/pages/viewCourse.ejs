                { 
                    title: "Database Management", 
                    lectures: [
                        "Introduction to Databases",
                        "SQL vs NoSQL",
                        "MongoDB Setup and CRUD Operations",
                        "Mongoose ODM",
                        "Connecting Node.js with MongoDB",
                        "Database Integration Project"
                    ] 
