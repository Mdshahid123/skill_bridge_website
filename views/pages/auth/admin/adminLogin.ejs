<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Skill Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0a2b3e 0%, #1a6f8c 100%);
        }
        .admin-login-card {
            backdrop-filter: blur(8px);
            animation: fadeInUp 0.5s ease-out;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .input-group:focus-within i {
            color: #1a6f8c;
        }
        .btn-admin {
            background: linear-gradient(135deg, #0a2b3e, #1a6f8c);
            transition: all 0.3s ease;
        }
        .btn-admin:hover {
            background: linear-gradient(135deg, #0a2b3e, #0066b3);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-5">
    <div class="w-full max-w-md">
        <!-- Logo / Brand -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-sm px-5 py-2 rounded-full shadow-sm">
                <div class="w-8 h-8 rounded-lg bg-white/90 flex items-center justify-center">
                    <span class="text-[#0a2b3e] font-black text-sm">SB</span>
                </div>
                <span class="text-white font-black text-xl tracking-tight">Skill<span class="text-teal-200">Bridge</span></span>
                <span class="ml-2 text-xs bg-red-500/80 text-white px-2 py-0.5 rounded-full">Admin</span>
            </div>
        </div>

        <!-- Admin Login Card -->
        <div class="admin-login-card bg-white/10 backdrop-blur-md rounded-2xl shadow-2xl overflow-hidden border border-white/20">
            <div class="p-6 md:p-8">
                <div class="text-center mb-6">
                    <i class="fa-solid fa-shield-haltered text-4xl text-white/80 mb-2"></i>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-white">Administrator Access</h2>
                    <p class="text-white/70 text-sm mt-1">Secure login for authorized personnel only</p>
                </div>

                <!-- Error Message Display -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="mb-5 p-3 bg-red-500/20 backdrop-blur-sm border-l-4 border-red-500 rounded-lg">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-circle-exclamation text-red-300"></i>
                            <span class="text-red-100 text-sm font-medium"><%= error %></span>
                        </div>
                    </div>
                <% } %>

                <form action="/admin/submitLogin" method="POST" id="adminLoginForm" class="space-y-5">
                    <!-- Email -->
                    <div class="input-group relative">
                        <i class="fa-regular fa-envelope absolute left-3 top-1/2 transform -translate-y-1/2 text-white/60 transition-colors"></i>
                        <input type="email"  id="adminEmail" name="email" placeholder="Admin Email" value="<%= typeof email !== 'undefined' ? email : '' %>"
                            class="w-full pl-10 pr-4 py-3 rounded-xl bg-white/20 border border-white/30 text-white placeholder-white/50 focus:border-teal-300 focus:ring-2 focus:ring-teal-300/30 transition-all" >
                    </div>

                    <!-- Password -->
                    <div class="input-group relative">
                        <i class="fa-solid fa-lock absolute left-3 top-1/2 transform -translate-y-1/2 text-white/60 transition-colors"></i>
                        <input type="password" id="adminPassword" name="password" placeholder="Password"
                            class="w-full pl-10 pr-12 py-3 rounded-xl bg-white/20 border border-white/30 text-white placeholder-white/50 focus:border-teal-300 focus:ring-2 focus:ring-teal-300/30 transition-all" >
                        <button type="button" id="toggleAdminPassword" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-white/60 hover:text-white transition-colors">
                            <i class="fa-regular fa-eye-slash"></i>
                        </button>
                    </div>

                    <!-- Remember Me & Forgot Password -->
                    <div class="flex items-center justify-between">
                        <label class="flex items-center gap-2 text-sm text-white/80 cursor-pointer">
                            <input type="checkbox" name="remember" class="rounded border-white/30 bg-white/20 text-teal-500 focus:ring-teal-500">
                            <span>Remember me</span>
                        </label>
                        <a href="/admin/forgot-password" class="text-sm text-teal-200 hover:text-white transition-colors">Forgot password?</a>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="btn-admin w-full text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition-all duration-300">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        Login to Admin Panel
                    </button>
                </form>

                <!-- Back to Main Site -->
                <div class="text-center mt-6">
                    <a href="/" class="text-white/70 hover:text-white text-sm transition-colors">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Back to Skill Bridge
                    </a>
                </div>
            </div>
        </div>

        <!-- Footer note -->
        <p class="text-center text-xs text-white/50 mt-6">
            <i class="fa-regular fa-shield-haltered mr-1"></i> This area is restricted to authorized administrators only.
        </p>
    </div>

    <script>
        // Toggle password visibility
        document.getElementById('toggleAdminPassword')?.addEventListener('click', function() {
            const passwordInput = document.getElementById('adminPassword');
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            this.querySelector('i').classList.toggle('fa-eye');
            this.querySelector('i').classList.toggle('fa-eye-slash');
        });
    </script>
</body>
</html>