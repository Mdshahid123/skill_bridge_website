<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= course.courseName %> | Skill Bridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <style>
        /* Base styles – no global text overrides that break nav/footer */
        body { font-family: 'Inter', sans-serif; background: #f8fafc; color: #1e293b; }
        
        /* ========== COURSE PAGE SPECIFIC STYLES ========== */
        .course-content-wrapper h1,
        .course-content-wrapper h2,
        .course-content-wrapper h3,
        .course-content-wrapper h4,
        .course-content-wrapper .font-bold,
        .course-content-wrapper .font-semibold,
        .course-content-wrapper .font-extrabold {
            font-weight: 800 !important;
            letter-spacing: -0.01em;
        }
        
        .course-content-wrapper p,
        .course-content-wrapper li,
        .course-content-wrapper span:not(.badge-text),
        .course-content-wrapper .text-gray-600,
        .course-content-wrapper .text-gray-500,
        .course-content-wrapper .text-sm {
            font-weight: 500 !important;
            color: #334155 !important;
        }
        
        .course-content-wrapper .text-gray-400 {
            color: #64748b !important;
            font-weight: 500 !important;
        }
        
        .btn-primary-custom { background: linear-gradient(135deg, #0a2b3e, #1a6f8c); transition: all 0.2s; color: white; font-weight: 700; }
        .btn-primary-custom:hover { background: linear-gradient(135deg, #0a2b3e, #0066b3); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26,111,140,0.3); }
        
        /* Hero section */
        .hero-glow { background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%); position: relative; overflow: hidden; }
        .hero-glow::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(26,111,140,0.12) 0%, rgba(0,102,179,0.06) 50%, transparent 70%); animation: rotateGlow 20s linear infinite; }
        @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .brand-grid { background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px), repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px); background-size: 50px 50px; }
        .brand-grid-light { background-image: repeating-linear-gradient(90deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px), repeating-linear-gradient(0deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px); }
        @keyframes float { 0%, 100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-10px) rotate(5deg); } }
        .float-animation { animation: float 4s ease-in-out infinite; }
        .offering-card { transition: all 0.3s ease; }
        .offering-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -12px rgba(26,111,140,0.15); }
        .project-card { transition: all 0.3s ease; }
        .project-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -12px rgba(0, 0, 0, 0.15); }
        .breadcrumb a:hover { text-decoration: underline; }
        #videoModal { backdrop-filter: blur(8px); }
        .lecture-item { cursor: pointer; }
        .lecture-item:hover { background: #e6f4f5; }
        .glow-text { text-shadow: 0 0 20px rgba(26,111,140,0.3); }
        .lecture-item.locked { opacity: 0.6; cursor: not-allowed; position: relative; }
        .lecture-item.locked:hover { background: transparent; }
        .lecture-item.locked .fa-lock { color: #ef4444; }
        .lecture-item .fa-lock { display: none; }
        .lecture-item.locked .fa-circle-play { display: none; }
        .lecture-item.locked .fa-lock { display: inline-block; }
        
        /* ========== INSTRUCTOR CARD – NO VACANT SPACE, CONSTANT RATIO ========== */
        .instructor-card {
            background: white;
            border-radius: 1.25rem;
            overflow: hidden;
            width: 100%;
            max-width: 300px;
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.12);
            transition: all 0.3s ease;
            border: 1px solid #eef2f8;
        }
        .instructor-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 35px -14px rgba(26,111,140,0.25);
        }
        .instructor-image-container {
            width: 100%;
            background: #f1f5f9;
            aspect-ratio: 4 / 3;
            overflow: hidden;
        }
        .instructor-cover-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
        }
        .instructor-card:hover .instructor-cover-img {
            transform: scale(1.02);
        }
        .instructor-info {
            padding: 1.25rem 1rem;
            text-align: left;
            background: white;
        }
        .instructor-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0a2b3e;
            margin-bottom: 0.25rem;
        }
        .instructor-bio {
            font-size: 0.8rem;
            font-weight: 500;
            color: #334155;
            line-height: 1.4;
        }
        
        /* ========== ENROLLMENT CARD IMAGE – NO VACANT SPACE, CONSTANT RATIO ========== */
        .course-sidebar-img-container {
            width: 100%;
            background: #f1f5f9;
            aspect-ratio: 4 / 3;
            overflow: hidden;
            border-radius: 0.75rem;
        }
        .course-sidebar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        
        /* Responsive adjustments */
        @media (max-width: 1024px) {
            .instructor-card {
                max-width: 340px;
                margin: 0 auto;
            }
        }
        @media (max-width: 768px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .hero-glow .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .instructor-card {
                margin-top: 1rem;
            }
            .breadcrumb {
                font-size: 0.75rem;
            }
            h1 {
                font-size: 1.75rem !important;
            }
            .typing-dynamic-container {
                min-width: 160px;
            }
            .instructor-image-container {
                aspect-ratio: 3 / 4;
            }
            .course-sidebar-img-container {
                aspect-ratio: 16 / 9;
            }
        }
        
        /* Need help section animations */
        @keyframes bounce-slow {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-6px); }
        }
        .animate-bounce-slow {
            animation: bounce-slow 2s ease-in-out infinite;
        }
        .delay-100 {
            animation-delay: 0.5s;
        }
        .ml-13 {
            margin-left: 3.25rem;
        }
        @media (max-width: 768px) {
            .ml-13 {
                margin-left: 0;
            }
        }


        /* Enhanced message toast styling */
#helpFormMessage {
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    transform-origin: top;
    animation: messageSlideIn 0.3s ease-out forwards;
}

@keyframes messageSlideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Success message */
#helpFormMessage.bg-green-100 {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border-left: 4px solid #22c55e;
    box-shadow: 0 4px 12px rgba(34,197,94,0.15);
}

/* Error message */
#helpFormMessage.bg-red-100 {
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
    border-left: 4px solid #ef4444;
    box-shadow: 0 4px 12px rgba(239,68,68,0.15);
}

#helpFormMessage i {
    margin-right: 0.5rem;
    font-size: 1rem;
}
    </style>
</head>
<body>

    <%- include("../../partials/common/navbar.ejs") %>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="fixed inset-0 bg-gray-900 z-50 hidden flex-col p-6 pt-24">
        <button id="closeMenu" class="absolute top-6 right-6 text-3xl"><i class="fa-solid fa-xmark text-white"></i></button>
        <div class="flex items-center bg-gray-800 rounded-full px-4 py-3 mb-6">
            <i class="fa-solid fa-search text-gray-400 mr-2"></i>
            <input type="text" placeholder="Search courses..." class="bg-transparent text-white placeholder-gray-400 text-sm w-full focus:outline-none">
        </div>
        <div class="flex flex-col gap-5 text-xl">
            <a href="/" class="font-semibold text-gray-300 py-3 border-b border-gray-800">Home</a>
            <a href="/about" class="font-semibold text-gray-300 py-3 border-b">About</a>
            <a href="/courses" class="font-semibold text-gray-300 py-3 border-b">Courses</a>
            <a href="/contact" class="font-semibold text-gray-300 py-3 border-b">Contact</a>
            <div class="flex gap-4 mt-4">
                <button class="flex-1 bg-transparent border border-gray-600 text-gray-300 py-3 rounded-full font-semibold">Login</button>
                <button class="flex-1 btn-primary-custom text-white py-3 rounded-full font-semibold">Enroll Now</button>
            </div>
        </div>
    </div>

    <!-- MAIN COURSE CONTENT WRAPPER -->
    <div class="course-content-wrapper">
        <main>
            <!-- Course Header -->
            <div class="hero-glow pt-28 pb-16 relative overflow-hidden">
                <div class="absolute inset-0 opacity-[0.08] brand-grid"></div>
                <div class="absolute inset-0 opacity-[0.05] brand-grid-light"></div>
                <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(45deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px), repeating-linear-gradient(135deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px);"></div>
                <div class="absolute top-0 right-0 w-96 h-96 bg-teal-400/20 rounded-full blur-3xl"></div>
                <div class="absolute bottom-0 left-0 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl"></div>
                
                <div class="container mx-auto px-6 relative z-10">
                    <div class="breadcrumb text-sm mb-4">
                        <a href="/" class="text-teal-700/70 hover:text-teal-700 font-medium">Home</a>
                        <span class="text-teal-700/40 mx-2">/</span>
                        <a href="/courses" class="text-teal-700/70 hover:text-teal-700 font-medium">Courses</a>
                        <span class="text-teal-700/40 mx-2">/</span>
                        <span class="text-teal-800 font-bold" id="courseBreadcrumb"><%= course.category %></span>
                    </div>
                    
                    <div class="flex flex-col lg:flex-row gap-8 items-start">
                        <div class="flex-1">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/50 backdrop-blur-sm border border-teal-200 mb-4">
                                <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                                <span class="text-teal-600 text-xs font-extrabold tracking-wide">Most Popular Course</span>
                            </div>
                            <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-4 glow-text"><%= course.courseName %></h1>
                            <p class="text-gray-700 text-base md:text-lg max-w-2xl font-medium"><%= course.courseDescription %></p>
                            
                            <div class="flex flex-wrap gap-4 mt-6">
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-4 py-2 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-star text-teal-500"></i>
                                    <span class="text-sm font-bold text-gray-700">4.9 ★ (2.5k+ ratings)</span>
                                </div>
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-4 py-2 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-user text-teal-500"></i>
                                    <span class="text-sm font-bold text-gray-700">15k+ students enrolled</span>
                                </div>
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-4 py-2 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-clock text-teal-500"></i>
                                    <span class="text-sm font-bold text-gray-700">Updated monthly</span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- INSTRUCTOR CARD -->
                        <div class="instructor-card mx-auto lg:mx-0">
                            <div class="instructor-image-container">
                                <img style="object-fit:contain;" src="<%= course.instructor.profilePicture || '/default-avatar.png' %>" alt="<%= course.instructor.name %>" class="instructor-cover-img">
                            </div>
                            <div class="instructor-info">
                                <h3 class="instructor-name"><%= course.instructor.name %></h3>
                                <p class="instructor-bio"><%= course.instructor.bio %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course Content Container -->
            <div class="container mx-auto px-6 py-12 max-w-8xl">
                <div class="grid lg:grid-cols-3 gap-8">
                    <!-- Left Column (2/3) -->
                    <div class="lg:col-span-2 space-y-8">
                        <!-- What You'll Learn -->
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-4 flex items-center gap-2"><i class="fa-regular fa-lightbulb text-teal-500"></i> What You'll Learn</h2>
                            <div class="grid md:grid-cols-2 gap-3">
                                <% course.whatYouLearn.forEach(item => { %>
                                    <div class="flex items-center gap-2 text-gray-700 text-sm font-medium"><i class="fa-regular fa-circle-check text-teal-500"></i><span><%= item %></span></div>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Syllabus -->
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                            <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                                <h2 class="text-xl font-extrabold text-gray-800 flex items-center gap-2"><i class="fa-regular fa-rectangle-list text-teal-500"></i> Course Content</h2>
                                <button id="downloadBrochureBtn" class="flex items-center gap-2 text-sm font-bold text-teal-600 border border-teal-300 px-4 py-1.5 rounded-full hover:bg-teal-500 hover:text-white transition-all"><i class="fa-regular fa-file-pdf"></i>Download Brochure</button>
                            </div>
                            <div id="courseContent"></div>
                        </div>

                        <!-- Requirements -->
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-4 flex items-center gap-2"><i class="fa-regular fa-list-check text-teal-500"></i> Requirements</h2>
                            <ul class="space-y-2">
                                <% course.requirements.forEach(req => { %>
                                    <li class="flex items-center gap-2 text-gray-700 text-sm font-medium"><i class="fa-regular fa-circle-check text-teal-500"></i><span><%= req %></span></li>
                                <% }); %>
                            </ul>
                        </div>

                        <!-- Description -->
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-4 flex items-center gap-2"><i class="fa-regular fa-file-lines text-teal-500"></i> Description</h2>
                            <p class="text-gray-700 leading-relaxed font-medium"><%= course.longDescription %></p>
                        </div>
                    </div>

                    <!-- Right Sidebar - Enrollment Card -->
                    <div class="lg:col-span-1 space-y-6">
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-teal-100 sticky top-24">
                            <div class="course-sidebar-img-container mb-4">
                                <img style="object-fit:fill" src="<%= course.image %>" alt="<%= course.courseName %>" class="course-sidebar-img">
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2"><%= course.courseName %></h3>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="text-3xl font-extrabold text-teal-600">₹<%= course.price %></span>
                                <span class="text-sm text-gray-500 line-through font-medium">₹<%= course.originalPrice %></span>
                                <span class="text-xs bg-green-100 text-green-800 font-bold px-2 py-0.5 rounded-full"><%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off</span>
                            </div>
                            <div class="space-y-3 mb-6">
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-clock w-5 text-teal-500"></i> <span><%= course.duration %> Months</span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-signal w-5 text-teal-500"></i> <span><%= course.level %></span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-certificate w-5 text-teal-500"></i> <span>Certificate of Completion</span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-clock w-5 text-teal-500"></i> <span>Lifetime Access</span></div>
                            </div>
                            <button class="w-full btn-primary-custom text-white py-3 rounded-xl font-extrabold transition-all enroll-btn hover:scale-105">Enroll Now <i class="fa-solid fa-arrow-right ml-2"></i></button>
                            <p class="text-center text-xs text-gray-500 font-medium mt-3">Join 15,000+ successful students</p>
                        </div>
                    </div>
                </div>

                <!-- Exclusive Course Offerings -->
                <div class="mt-20">
                    <div class="text-center mb-14">
                        <div class="inline-flex items-center justify-center mb-4">
                            <span class="w-12 h-px bg-gradient-to-r from-transparent to-teal-400"></span>
                            <span class="mx-3 text-teal-600 text-sm font-bold tracking-wider uppercase">Why Choose Us</span>
                            <span class="w-12 h-px bg-gradient-to-l from-transparent to-teal-400"></span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Exclusive Course Offerings</h2>
                        <p class="text-gray-500 mt-3 max-w-2xl mx-auto font-medium">Comprehensive learning ecosystem designed for your success</p>
                    </div>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
                        <!-- Offering Cards (unchanged) -->
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-100 to-rose-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-diagram-project text-rose-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Capstone Project</h3>
                            <p class="text-gray-500 leading-relaxed">Build real-world projects that showcase your skills to employers.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-pen-ruler text-amber-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Practice Exercises</h3>
                            <p class="text-gray-500 leading-relaxed">Topic-wise coding challenges and practice problems to strengthen concepts.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-folder-open text-green-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Assignments & Projects</h3>
                            <p class="text-gray-500 leading-relaxed">Regular assignments and mini-projects to apply what you've learned.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-100 to-cyan-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-headset text-cyan-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Live Doubt Resolution</h3>
                            <p class="text-gray-500 leading-relaxed">Get your doubts resolved instantly by expert mentors during live sessions.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-100 to-emerald-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-regular fa-certificate text-emerald-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Certification of Completion</h3>
                            <p class="text-gray-500 leading-relaxed">Earn a globally recognized certificate to boost your career.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-bullhorn text-orange-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Career Guidance & Interview Prep</h3>
                            <p class="text-gray-500 leading-relaxed">Resume building, mock interviews, and placement assistance.</p>
                        </div>
                    </div>
                </div>

                <!-- Certificate Section -->
                <div class="relative mt-20 mb-36">
                    <div class="absolute inset-0 bg-gradient-to-r from-teal-50/30 to-blue-50/30 rounded-3xl -z-10"></div>
                    <div class="flex flex-col lg:flex-row items-center gap-12 bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
                        <div class="relative w-full lg:w-5/12 bg-gradient-to-br from-teal-50 to-blue-50 p-8 flex justify-center">
                            <div class="relative">
                                <div class="absolute -top-3 -left-3 z-10">
                                    <div class="bg-gradient-to-r from-teal-500 to-teal-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md flex items-center gap-1">
                                        <i class="fa-solid fa-award text-xs"></i>
                                        <span>Official</span>
                                    </div>
                                </div>
