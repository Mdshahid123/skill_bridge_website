<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= course.courseName %> | SkillBridge</title>
    <meta name="description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Learn ' + course.courseName + ' with expert mentors. Hands‑on projects, certification, and placement assistance.' %>">
    <meta name="keywords" content="<%= course.courseName %>, online course, IT training, <%= course.category %>, learn <%= course.courseName %>">
    <meta name="author" content="Skill Bridge">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.skillbridge.com/viewCourse/<%= course._id %>">
    <meta property="og:title" content="<%= course.courseName %> – Skill Bridge">
    <meta property="og:description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Enroll now in ' + course.courseName + ' to gain industry‑relevant skills.' %>">
    <meta property="og:image" content="<%= course.image ? course.image : 'https://www.skillbridge.com/default-course.jpg' %>">
    <meta property="og:url" content="https://www.skillbridge.com/viewCourse/<%= course._id %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= course.courseName %>">
    <meta name="twitter:description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Course details, curriculum, and enrollment information.' %>">

    <!-- Schema.org – Course -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "<%= course.courseName.replace(/"/g, '&quot;') %>",
      "description": "<%= course.courseDescription ? course.courseDescription.replace(/"/g, '&quot;').slice(0, 300) : '' %>",
      "provider": {
        "@type": "Organization",
        "name": "Skill Bridge"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "online",
        "duration": "<%= course.duration %> Months"
      },
      "offers": {
        "@type": "Offer",
        "price": "<%= course.price %>",
        "priceCurrency": "INR"
      }
    }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; color: #0f172a; }
        .course-content-wrapper h1 { font-size: 2rem !important; }
        @media (min-width: 768px) { .course-content-wrapper h1 { font-size: 2.5rem !important; } }
        .course-content-wrapper h2 { font-size: 1.5rem !important; font-weight: 800 !important; }
        .course-content-wrapper .module-title { font-size: 1rem !important; font-weight: 800 !important; }
        .course-content-wrapper p, .course-content-wrapper li { font-weight: 500 !important; line-height: 1.5; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(25px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeUp 0.6s ease forwards; }

        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            top: -30%;
            left: -30%;
            width: 160%;
            height: 160%;
            background: radial-gradient(circle, rgba(6,182,212,0.12), transparent 70%);
            animation: rotateGlow 20s linear infinite;
            pointer-events: none;
        }
        @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .brand-grid {
            background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px),
                              repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px);
        }
        .instructor-card { transition: all 0.3s ease; max-width: 280px; border-radius: 1rem; overflow: hidden; }
        .instructor-card:hover { transform: translateY(-4px); box-shadow: 0 15px 25px -10px rgba(26,111,140,0.2); }
        .instructor-image-container { aspect-ratio: 1 / 1; overflow: hidden; background: #f1f5f9; }
        .instructor-info { padding: 1rem; text-align: center; }
        .instructor-name { font-size: 1.1rem; font-weight: 800; }
        .instructor-bio { font-size: 0.75rem; font-weight: 500; color: #4b5563; }

        .section-header:hover { background: #e6f4f5; }
        .lecture-item { transition: all 0.2s; cursor: pointer; }
        .lecture-item:not(.locked):hover { background: #f0f9ff; padding-left: 1rem; }

        .sticky-cta { transition: transform 0.3s ease; }
        .sticky-cta.hide { transform: translateY(120%); }
        .btn-pulse { animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(20,184,166,0.4); } 70% { box-shadow: 0 0 0 10px rgba(20,184,166,0); } 100% { box-shadow: 0 0 0 0 rgba(20,184,166,0); } }

        .silver-card {
            background: linear-gradient(135deg, #ffffff 0%, #f9fafb 50%, #f3f4f6 100%);
            border: 1px solid rgba(107,114,128,0.15);
            box-shadow: 0 8px 20px -6px rgba(0,0,0,0.05);
        }
        .payment-card {
            background: white;
            border-radius: 1.25rem;
            border: 1px solid rgba(20,184,166,0.2);
            box-shadow: 0 20px 35px -12px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }
        .payment-card:hover { transform: translateY(-4px); box-shadow: 0 25px 40px -12px rgba(20,184,166,0.2); }
        .payment-btn { background: linear-gradient(105deg, #1a6f8c, #0f5f7a); transition: all 0.2s; }
        .payment-btn:hover { transform: scale(1.02); box-shadow: 0 10px 20px -8px rgba(26,111,140,0.5); }
    </style>
</head>
<body>

    <%- include("../../partials/common/navbar.ejs") %>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="fixed inset-0 bg-gray-900 z-50 hidden flex-col p-6 pt-24">
        <button id="closeMenu" class="absolute top-6 right-6 text-3xl"><i class="fa-solid fa-xmark text-white"></i></button>
        <div class="flex flex-col gap-5 text-xl">
            <a href="/" class="font-semibold text-gray-300 py-3 border-b border-gray-800">Home</a>
            <a href="/about" class="font-semibold text-gray-300 py-3 border-b">About</a>
            <a href="/courses" class="font-semibold text-gray-300 py-3 border-b">Courses</a>
            <a href="/contact" class="font-semibold text-gray-300 py-3 border-b">Contact</a>
            <div class="flex gap-4 mt-4">
                <button class="flex-1 bg-transparent border border-gray-600 text-gray-300 py-3 rounded-full font-semibold">Login</button>
                <button class="flex-1 btn-primary-custom text-white py-3 rounded-full font-semibold">Enroll Now</button>
            </div>
        </div>
    </div>

    <div class="course-content-wrapper">
        <main>
            <!-- Hero Section (reduced height) -->
            <div class="hero-glow pt-20 pb-10 relative overflow-hidden">
                <div class="absolute inset-0 opacity-[0.08] brand-grid"></div>
                <div class="container mx-auto px-6 relative z-10">
                    <div class="flex flex-col lg:flex-row gap-6 items-start">
                        <div class="flex-1 fade-up">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/50 backdrop-blur-sm border border-teal-200 mb-3">
                                <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                                <span class="text-teal-700 text-xs font-extrabold tracking-wide">Most Popular Course</span>
                            </div>
                            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-3"><%= course.courseName.replaceAll("-", " ") %></h1>
                            <p class="text-gray-700 text-base max-w-2xl font-medium"><%= course.courseDescription %></p>
                            <div class="flex flex-wrap gap-3 mt-4">
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-3 py-1.5 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-star text-teal-500"></i>
                                    <span class="text-xs font-bold text-gray-700">4.9 ★ (2.5k+ ratings)</span>
                                </div>
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-3 py-1.5 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-user text-teal-500"></i>
                                    <span class="text-xs font-bold text-gray-700">15k+ students enrolled</span>
                                </div>
                                <div class="flex items-center gap-2 bg-white/60 backdrop-blur-sm px-3 py-1.5 rounded-full border border-teal-100">
                                    <i class="fa-regular fa-clock text-teal-500"></i>
                                    <span class="text-xs font-bold text-gray-700">Updated monthly</span>
                                </div>
                            </div>
                        </div>
                        <!-- Instructor Card -->
                        <div class="instructor-card bg-white shadow-md mx-auto lg:mx-0 fade-up">
                            <div class="instructor-image-container">
                                <img style="object-fit:cover;" src="<%= course.instructor.profilePicture || '/default-avatar.png' %>" alt="<%= course.instructor.name %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                            </div>
                            <div class="instructor-info">
                                <h3 class="instructor-name"><%= course.instructor.name %></h3>
                                <p class="instructor-bio"><%= course.instructor.bio %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="container mx-auto px-6 py-10 max-w-8xl">
                <div class="grid lg:grid-cols-3 gap-8">
                    <!-- Left Column (silver cards) -->
                    <div class="lg:col-span-2 space-y-6">
                        <!-- What You'll Learn -->
                        <div class="silver-card rounded-xl p-5 shadow-sm fade-up">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-3 flex items-center gap-2"><i class="fa-regular fa-lightbulb text-teal-500"></i> What You'll Learn</h2>
                            <div class="grid md:grid-cols-2 gap-3">
                                <% course.whatYouLearn.forEach(item => { %>
                                    <div class="flex items-center gap-2 text-gray-700 text-sm font-medium"><i class="fa-regular fa-circle-check text-teal-500"></i><span><%= item %></span></div>
                                <% }); %>
                            </div>
                        </div>
                        <!-- Syllabus -->
                        <div class="silver-card rounded-xl p-5 shadow-sm">
                            <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                                <h2 class="text-xl font-extrabold text-gray-800 flex items-center gap-2"><i class="fa-regular fa-rectangle-list text-teal-500"></i> Course Content</h2>
                                <button id="downloadBrochureBtn" class="flex items-center gap-2 text-sm font-bold text-teal-600 border border-teal-300 px-4 py-1.5 rounded-full hover:bg-teal-500 hover:text-white transition-all"><i class="fa-regular fa-file-pdf"></i>Download Brochure</button>
                            </div>
                            <div id="courseContent"></div>
                        </div>
                        <!-- Requirements -->
                        <div class="silver-card rounded-xl p-5 shadow-sm fade-up">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-3 flex items-center gap-2"><i class="fa-regular fa-list-check text-teal-500"></i> Requirements</h2>
                            <ul class="space-y-2">
                                <% course.requirements.forEach(req => { %>
                                    <li class="flex items-center gap-2 text-gray-700 text-sm font-medium"><i class="fa-regular fa-circle-check text-teal-500"></i><span><%= req %></span></li>
                                <% }); %>
                            </ul>
                        </div>
                        <!-- Description -->
                        <div class="silver-card rounded-xl p-5 shadow-sm fade-up">
                            <h2 class="text-xl font-extrabold text-gray-800 mb-3 flex items-center gap-2"><i class="fa-regular fa-file-lines text-teal-500"></i> Description</h2>
                            <p class="text-gray-700 leading-relaxed font-medium"><%= course.longDescription %></p>
                        </div>
                    </div>

                    <!-- Right Sidebar - Payment Card -->
                    <div class="lg:col-span-1 space-y-6">
                        <div class="payment-card p-5 sticky top-24 fade-up">
                            <div class="course-sidebar-img-container aspect-video rounded-xl overflow-hidden mb-4 shadow-md">
                                <img style="object-fit:cover;" src="<%= course.image %>" alt="<%= course.courseName %>" class="w-full h-full object-cover">
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2"><%= course.courseName %></h3>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="text-3xl font-extrabold text-teal-600">₹<%= course.price %></span>
                                <span class="text-sm text-gray-500 line-through font-medium">₹<%= course.originalPrice %></span>
                                <span class="text-xs bg-green-100 text-green-800 font-bold px-2 py-0.5 rounded-full"><%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off</span>
                            </div>
                            <div class="space-y-2 mb-6">
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-clock w-4 text-teal-500"></i> <span><%= course.duration %> Months</span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-signal w-4 text-teal-500"></i> <span><%= course.level %></span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-certificate w-4 text-teal-500"></i> <span>Certificate of Completion</span></div>
                                <div class="flex items-center gap-3 text-sm text-gray-700 font-medium"><i class="fa-regular fa-infinity w-4 text-teal-500"></i> <span>Lifetime Access</span></div>
                            </div>
                            <!-- Main payment button (dark) -->
                       <button id="mainEnrollBtn" class="w-full bg-black hover:bg-gray-900 text-white py-3 rounded-xl font-extrabold text-sm transition-all shadow-lg flex items-center justify-center gap-2 border border-teal-500/40" style="background: #000000 !important; box-shadow: 0 4px 14px 0 rgba(0,0,0,0.3);">
    <i class="fa-solid fa-lock"></i> Enroll Now <i class="fa-solid fa-arrow-right"></i>
</button>
                            <p class="text-center text-xs text-gray-500 font-medium mt-3">✅ Instant access after payment • 7‑day refund guarantee</p>
                        </div>
                    </div>
                </div>

                <!-- ========== EXCLUSIVE COURSE OFFERINGS ========== -->
                <div class="mt-20">
                    <div class="text-center mb-14">
                        <div class="inline-flex items-center justify-center mb-4">
                            <span class="w-12 h-px bg-gradient-to-r from-transparent to-teal-400"></span>
                            <span class="mx-3 text-teal-600 text-sm font-bold tracking-wider uppercase">Why Choose Us</span>
                            <span class="w-12 h-px bg-gradient-to-l from-transparent to-teal-400"></span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Exclusive Course Offerings</h2>
                        <p class="text-gray-500 mt-3 max-w-2xl mx-auto font-medium">Comprehensive learning ecosystem designed for your success</p>
                    </div>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-100 to-rose-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-diagram-project text-rose-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Capstone Project</h3>
                            <p class="text-gray-500 leading-relaxed">Build real-world projects that showcase your skills to employers.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-100 to-amber-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-pen-ruler text-amber-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Practice Exercises</h3>
                            <p class="text-gray-500 leading-relaxed">Topic-wise coding challenges and practice problems to strengthen concepts.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-folder-open text-green-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Assignments & Projects</h3>
                            <p class="text-gray-500 leading-relaxed">Regular assignments and mini-projects to apply what you've learned.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-100 to-cyan-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-headset text-cyan-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Live Doubt Resolution</h3>
                            <p class="text-gray-500 leading-relaxed">Get your doubts resolved instantly by expert mentors during live sessions.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-100 to-emerald-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-regular fa-certificate text-emerald-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Certification of Completion</h3>
                            <p class="text-gray-500 leading-relaxed">Earn a globally recognized certificate to boost your career.</p>
                        </div>
                        <div class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 fade-up">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
                                <i class="fa-solid fa-bullhorn text-orange-600 text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-extrabold text-gray-800 mb-2">Career Guidance & Interview Prep</h3>
                            <p class="text-gray-500 leading-relaxed">Resume building, mock interviews, and placement assistance.</p>
                        </div>
                    </div>
                </div>

                <!-- ========== CERTIFICATE SECTION ========== -->
                <div class="relative mt-20 mb-36 fade-up">
                    <div class="flex flex-col lg:flex-row items-center gap-12 bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 hover:shadow-2xl transition-all">
                        <div class="relative w-full lg:w-5/12 bg-gradient-to-br from-teal-50 to-blue-50 p-8 flex justify-center">
                            <div class="relative">
                                <div class="absolute -top-3 -left-3 z-10">
                                    <div class="bg-gradient-to-r from-teal-500 to-teal-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md flex items-center gap-1">
                                        <i class="fa-solid fa-award text-xs"></i>
                                        <span>Official</span>
                                    </div>
                                </div>
                                <img src="/cc.png" alt="Course Certificate Sample" class="w-full max-w-md mx-auto rounded-xl shadow-2xl border-4 border-white transition-transform duration-300 hover:scale-105">
                                <div class="absolute bottom-3 right-3 bg-black/70 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full">
                                    <i class="fa-regular fa-eye mr-1"></i> Sample
                                </div>
                            </div>
                        </div>
                        <div class="flex-1 lg:w-7/12 p-8 lg:p-10">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center">
                                    <i class="fa-regular fa-certificate text-teal-600 text-xl"></i>
                                </div>
                                <h2 class="text-3xl lg:text-4xl font-extrabold text-gray-900 tracking-tight">Course Certificate</h2>
                            </div>
                            <p class="text-gray-600 text-base leading-relaxed font-medium mb-6">Earn a verified certificate upon course completion. Showcase your skills to employers and get recognized globally.</p>
                            <div class="flex flex-wrap gap-5 mb-6">
                                <div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center"><i class="fa-regular fa-circle-check text-green-600 text-sm"></i></div><span class="text-gray-700 font-semibold">Shareable on LinkedIn</span></div>
                                <div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center"><i class="fa-regular fa-circle-check text-green-600 text-sm"></i></div><span class="text-gray-700 font-semibold">Verifiable & Secure</span></div>
                                <div class="flex items-center gap-2"><div class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center"><i class="fa-regular fa-circle-check text-green-600 text-sm"></i></div><span class="text-gray-700 font-semibold">Lifetime Access</span></div>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <span class="bg-gradient-to-r from-teal-50 to-teal-100 text-teal-700 text-xs font-bold px-4 py-2 rounded-full shadow-sm border border-teal-200"><i class="fa-regular fa-building mr-1"></i> Industry Recognized</span>
                                <span class="bg-gradient-to-r from-blue-50 to-blue-100 text-blue-700 text-xs font-bold px-4 py-2 rounded-full shadow-sm border border-blue-200"><i class="fa-regular fa-star mr-1"></i> UGC Approved</span>
                                <span class="bg-gradient-to-r from-emerald-50 to-emerald-100 text-emerald-700 text-xs font-bold px-4 py-2 rounded-full shadow-sm border border-emerald-200"><i class="fa-solid fa-globe mr-1"></i> Globally Accepted</span>
                            </div>
                            <div class="mt-8">
                                <button class="inline-flex items-center gap-2 text-teal-600 font-bold text-sm bg-teal-50 px-5 py-2.5 rounded-full hover:bg-teal-100 transition-all hover:gap-3">
                                    <i class="fa-regular fa-file-pdf"></i> Download Sample Certificate
                                    <i class="fa-solid fa-arrow-right text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========== NEED HELP SECTION ========== -->
                <div class="mt-16 fade-up">
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 transition-all duration-300 hover:shadow-2xl">
                        <div class="flex flex-col md:flex-row">
                            <div class="relative w-full md:w-5/12 bg-gradient-to-br from-teal-50 via-blue-50 to-indigo-50 p-8 flex flex-col items-center justify-center">
                                <div class="relative">
                                    <div class="absolute -top-14 left-1/2 transform -translate-x-1/2 animate-bounce-slow z-10">
                                        <div class="relative">
                                            <div class="bg-white rounded-2xl shadow-lg px-4 py-2 flex items-center gap-2 border border-teal-200">
                                                <i class="fa-solid fa-circle-question text-teal-500 text-lg"></i>
                                                <span class="text-teal-700 font-bold text-sm">Need Help?</span>
                                            </div>
                                            <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-3 h-3 bg-white rotate-45 border-b border-r border-teal-200"></div>
                                        </div>
                                    </div>
                                    <img src="https://pwskills.com/images/accountImage/leadform/man.webp" alt="Support illustration" class="w-48 h-48 object-contain relative z-20">
                                </div>
                                <div class="text-center mt-6 relative z-20">
                                    <h3 class="text-xl font-extrabold text-gray-800">We're here to help <span class="text-teal-500">💙</span></h3>
                                    <p class="text-gray-500 text-sm mt-1 max-w-xs mx-auto">Got a question? Our support team is ready to assist you.</p>
                                </div>
                            </div>

                            <div class="w-full md:w-7/12 p-8 lg:p-10 bg-white">
                                <div class="mb-6">
                                    <div class="flex items-center gap-3 mb-2">
                                        <div class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center">
                                            <i class="fa-regular fa-envelope-open text-teal-600 text-lg"></i>
                                        </div>
                                        <h2 class="text-2xl lg:text-3xl font-extrabold text-gray-900 tracking-tight">Need help?</h2>
                                    </div>
                                    <p class="text-gray-500 text-sm ml-13">Fill out the form below and we'll get back to you within 24 hours.</p>
                                </div>

                                <div id="helpFormMessage" class="mb-4 hidden rounded-lg p-3 text-sm"></div>

                                <form id="helpForm" class="space-y-4">
                                    <div>
                                        <label class="text-sm font-bold text-gray-700 block mb-1.5"><i class="fa-regular fa-user mr-1 text-teal-500 text-xs"></i> Full Name <span class="text-red-500">*</span></label>
                                        <input type="text" id="helpName" name="name" placeholder="e.g. Rahul Kumar" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all bg-gray-50 focus:bg-white" required>
                                    </div>
                                    <div>
                                        <label class="text-sm font-bold text-gray-700 block mb-1.5"><i class="fa-regular fa-envelope mr-1 text-teal-500 text-xs"></i> Email Address <span class="text-red-500">*</span></label>
                                        <input type="email" id="helpEmail" name="email" placeholder="rahul@example.com" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all bg-gray-50 focus:bg-white" required>
                                    </div>
                                    <div>
                                        <label class="text-sm font-bold text-gray-700 block mb-1.5"><i class="fa-solid fa-phone mr-1 text-teal-500 text-xs"></i> Phone Number <span class="text-red-500">*</span></label>
                                        <input type="tel" id="helpPhone" name="phoneNumber" placeholder="9876543210" maxlength="10" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all bg-gray-50 focus:bg-white" required>
                                        <p class="text-xs text-gray-400 mt-1">Exactly 10 digits, no spaces or symbols</p>
                                    </div>
                                    <input type="hidden" id="helpCourse" name="course" value="<%= course.courseName %>">
                                    <input type="hidden" name="degree" value="">
                                    <div>
                                        <label class="text-sm font-bold text-gray-700 block mb-1.5"><i class="fa-regular fa-clock mr-1 text-teal-500 text-xs"></i> Preferred Callback Time</label>
                                        <input type="datetime-local" id="helpCallbackTime" name="callbackTime" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all bg-gray-50 focus:bg-white">
                                    </div>
                                    <div>
                                        <label class="text-sm font-bold text-gray-700 block mb-1.5"><i class="fa-regular fa-message mr-1 text-teal-500 text-xs"></i> Message (Optional)</label>
                                        <textarea id="helpMessage" name="message" rows="3" placeholder="How can we assist you? Please provide details..." class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all bg-gray-50 focus:bg-white resize-none"></textarea>
                                    </div>
                                    <button type="submit" id="helpSubmitBtn" class="w-full bg-gradient-to-r from-teal-600 to-blue-600 hover:from-teal-700 hover:to-blue-700 text-white font-extrabold py-3 rounded-xl flex items-center justify-center gap-2 transition-all duration-300 transform hover:scale-[1.02] shadow-md hover:shadow-lg">
                                        <i class="fa-regular fa-paper-plane"></i> Send Message
                                        <i class="fa-solid fa-arrow-right text-xs"></i>
                                    </button>
                                    <p class="text-xs text-gray-400 text-center mt-3 flex items-center justify-center gap-1">
                                        <i class="fa-regular fa-clock"></i> We'll respond within 24 hours
                                        <i class="fa-regular fa-face-smile ml-1"></i>
                                    </p>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Sticky CTA Bar (button now dark) -->
    <div id="stickyCta" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl p-3 transform translate-y-full transition-transform duration-300 z-40 sticky-cta">
        <div class="container mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <span class="font-extrabold text-gray-800 text-sm"><%= course.courseName %></span>
                <span class="text-xl font-extrabold text-teal-600">₹<%= course.price %></span>
                <span class="text-xs text-gray-500 line-through font-medium">₹<%= course.originalPrice %></span>
            </div>
            <!-- Sticky button changed to dark -->
            <button id="stickyEnrollBtn" class="bg-gray-900 hover:bg-gray-950 text-white px-6 py-1.5 rounded-full font-extrabold text-sm shadow-lg transition-all flex items-center gap-2 border border-teal-500/30">Enroll Now <i class="fa-solid fa-arrow-right ml-1"></i></button>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="paymentModal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);">
        <div class="relative max-w-md w-full bg-white rounded-2xl overflow-hidden shadow-2xl">
            <button id="closePaymentModal" class="absolute top-4 right-4 z-10 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center transition-all hover:scale-110">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div class="bg-gradient-to-r from-teal-600 to-blue-600 px-6 py-4">
                <div class="flex items-center gap-3"><i class="fa-solid fa-lock text-white text-xl"></i><h3 class="text-white font-extrabold text-xl">Secure Payment</h3></div>
                <p class="text-white/80 text-sm font-medium mt-1">Complete your enrollment securely</p>
            </div>
            <div class="p-6">
                <form id="paymentForm">
                    <div class="space-y-4">
                        <div><label class="text-sm font-bold text-gray-700 block mb-1">Cardholder Name</label><input type="text" placeholder="John Doe" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 font-medium" required></div>
                        <div><label class="text-sm font-bold text-gray-700 block mb-1">Card Number</label><input type="text" placeholder="1234 5678 9012 3456" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-teal-500 focus:border-teal-500 font-medium" required></div>
                        <div class="grid grid-cols-2 gap-4"><div><label class="text-sm font-bold text-gray-700 block mb-1">Expiry Date</label><input type="text" placeholder="MM/YY" class="w-full px-4 py-2 border border-gray-300 rounded-xl font-medium" required></div><div><label class="text-sm font-bold text-gray-700 block mb-1">CVV</label><input type="text" placeholder="123" class="w-full px-4 py-2 border border-gray-300 rounded-xl font-medium" required></div></div>
                        <button type="submit" class="w-full bg-gradient-to-r from-teal-600 to-blue-600 text-white py-3 rounded-xl font-extrabold transition-all">Pay ₹<%= course.price %> <i class="fa-solid fa-arrow-right ml-2"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Video Modal -->
    <div id="videoModal" class="fixed inset-0 bg-black/90 z-[2000] hidden items-center justify-center p-4" style="backdrop-filter: blur(8px);">
        <div class="relative w-full max-w-4xl bg-black rounded-2xl overflow-hidden shadow-2xl">
            <button id="closeVideoModal" class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition"><i class="fa-solid fa-xmark text-2xl"></i></button>
            <div class="aspect-video bg-gradient-to-br from-gray-900 to-black">
                <iframe id="youtubeFrame" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="p-4 bg-gray-900"><h3 id="videoTitle" class="text-white font-extrabold text-lg">Lecture</h3><p id="videoSection" class="text-gray-400 text-sm font-medium mt-1">Section</p></div>
        </div>
    </div>

    <%- include("../../partials/common/footer") %>

    <script>
        const courseFromServer = <%- JSON.stringify(course) %>;
        let isPurchased = localStorage.getItem(`course_${courseFromServer._id}_purchased`) === 'true';

        function renderSyllabus() {
            const contentContainer = document.getElementById('courseContent');
            if (!contentContainer) return;
            let lectureCounter = 0;
            const syllabusHtml = `
                <div class="space-y-3">
                    ${courseFromServer.syllabus.map((module, idx) => {
                        let lecturesHtml = '';
                        module.lectures.forEach(lecture => {
                            lectureCounter++;
                            const isLocked = !isPurchased && lectureCounter > 2;
                            lecturesHtml += `
                                <div class="lecture-item flex items-center gap-3 p-3 transition-all duration-200 cursor-pointer group ${isLocked ? 'locked' : ''}" 
                                     data-lecture="${escapeHtml(lecture.lectureTitle)}" 
                                     data-section="${escapeHtml(module.moduleTitle)}"
                                     data-locked="${isLocked}"
                                     data-video-url="${lecture.videoUrl || ''}">
                                    <i class="fa-regular fa-circle-play text-gray-400 text-base w-5 group-hover:text-teal-500 transition"></i>
                                    <i class="fa-solid fa-lock text-red-500 text-base w-5"></i>
                                    <span class="text-sm text-gray-700 flex-1 group-hover:text-teal-600 transition font-medium ${isLocked ? 'opacity-60' : ''}">${escapeHtml(lecture.lectureTitle)}</span>
                                    <span class="text-xs text-gray-500 font-medium">${lecture.videoDuration || '0:00'}</span>
                                    ${!isLocked ? '<i class="fa-brands fa-youtube text-gray-400 text-sm group-hover:text-red-500 transition"></i>' : '<i class="fa-solid fa-lock text-gray-400 text-sm"></i>'}
                                </div>
                            `;
                        });
                        return `
                            <div class="border rounded-xl overflow-hidden bg-white">
                                <div class="flex justify-between items-center p-4 bg-gray-50 cursor-pointer hover:bg-teal-50 transition-all duration-300 section-header" data-section="${idx}">
                                    <div class="flex items-center gap-3">
                                        <i class="fa-regular fa-folder-open text-teal-500"></i>
                                        <span class="font-extrabold text-gray-800 module-title">${escapeHtml(module.moduleTitle)}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-gray-600 font-medium">${module.lectures.length} lectures</span>
                                        <i class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
                                    </div>
                                </div>
                                <div class="lecture-list hidden border-t border-gray-100 bg-white">
                                    <div class="divide-y divide-gray-50">
                                        ${lecturesHtml}
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('')}
                    ${!isPurchased ? `<div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                        <i class="fa-solid fa-lock text-amber-600 mr-2"></i>
                        <span class="text-amber-700 text-sm font-bold">First 2 lectures are free. <strong>Enroll now</strong> to unlock all ${lectureCounter} lectures!</span>
                    </div>` : `<div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
                        <i class="fa-solid fa-circle-check text-green-600 mr-2"></i>
                        <span class="text-green-700 text-sm font-bold">✅ Course unlocked! You have access to all ${lectureCounter} lectures.</span>
                    </div>`}
                    <div class="text-center mt-4">
                        <button class="text-teal-600 text-sm font-extrabold hover:underline expand-all-btn transition-all duration-300">
                            <i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections
                        </button>
                    </div>
                </div>
            `;
            contentContainer.innerHTML = syllabusHtml;

            document.querySelectorAll('.section-header').forEach(header => {
                header.addEventListener('click', function() {
                    const lectureList = this.nextElementSibling;
                    const icon = this.querySelector('.fa-chevron-down');
                    lectureList.classList.toggle('hidden');
                    if (icon) icon.style.transform = lectureList.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            document.querySelectorAll('.lecture-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    if (this.getAttribute('data-locked') === 'true') {
                        e.preventDefault();
                        alert('🔒 This lecture is locked. Please complete payment to unlock all lectures!');
                        return;
                    }
                    const lecture = this.getAttribute('data-lecture');
                    const section = this.getAttribute('data-section');
                    const videoUrl = this.getAttribute('data-video-url');
                    if (videoUrl) openVideoModal(lecture, section, videoUrl);
                    else alert('Video not available.');
                });
            });

            let expanded = false;
            const expandBtn = document.querySelector('.expand-all-btn');
            if (expandBtn) {
                expandBtn.addEventListener('click', function() {
                    const allLists = document.querySelectorAll('.lecture-list');
                    const allIcons = document.querySelectorAll('.fa-chevron-down');
                    if (expanded) {
                        allLists.forEach(list => list.classList.add('hidden'));
                        allIcons.forEach(icon => icon.style.transform = 'rotate(0deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections';
                    } else {
                        allLists.forEach(list => list.classList.remove('hidden'));
                        allIcons.forEach(icon => icon.style.transform = 'rotate(180deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Collapse all sections';
                    }
                    expanded = !expanded;
                });
            }
        }

        function openVideoModal(lecture, section, videoUrl) {
            const modal = document.getElementById('videoModal');
            document.getElementById('videoTitle').textContent = lecture;
            document.getElementById('videoSection').textContent = section;
            let embedUrl = videoUrl;
            if (videoUrl && (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be'))) {
                const videoId = videoUrl.split('v=')[1]?.split('&')[0] || videoUrl.split('/').pop();
                embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
            } else if (videoUrl) embedUrl = videoUrl;
            else embedUrl = 'https://www.youtube.com/embed/EVW4nj1jCy0?autoplay=1&rel=0';
            document.getElementById('youtubeFrame').src = embedUrl;
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeVideoModal() {
            const modal = document.getElementById('videoModal');
            document.getElementById('youtubeFrame').src = '';
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }

        // Payment functionality
        const paymentModal = document.getElementById('paymentModal');
        const closePaymentModal = document.getElementById('closePaymentModal');
        
        function openPaymentModal() {
            if (isPurchased) {
                alert('✅ You already have access to this course! All lectures are unlocked.');
                return;
            }
            paymentModal.classList.remove('hidden');
            paymentModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }
        
        const mainEnrollBtn = document.getElementById('mainEnrollBtn');
        const stickyEnrollBtn = document.getElementById('stickyEnrollBtn');
        if (mainEnrollBtn) mainEnrollBtn.addEventListener('click', openPaymentModal);
        if (stickyEnrollBtn) stickyEnrollBtn.addEventListener('click', openPaymentModal);
        
        if (closePaymentModal) closePaymentModal.addEventListener('click', () => {
            paymentModal.classList.add('hidden');
            paymentModal.style.display = 'none';
            document.body.style.overflow = '';
        });
        if (paymentModal) paymentModal.addEventListener('click', (e) => {
            if (e.target === paymentModal) {
                paymentModal.classList.add('hidden');
                paymentModal.style.display = 'none';
                document.body.style.overflow = '';
            }
        });

        const paymentForm = document.getElementById('paymentForm');
        if (paymentForm) {
            paymentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
                submitBtn.disabled = true;
                setTimeout(() => {
                    isPurchased = true;
                    localStorage.setItem(`course_${courseFromServer._id}_purchased`, 'true');
                    alert('✅ Payment Successful! You now have full access to all lectures.');
                    paymentModal.classList.add('hidden');
                    paymentModal.style.display = 'none';
                    document.body.style.overflow = '';
                    renderSyllabus();
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 2000);
            });
        }

        document.getElementById('closeVideoModal')?.addEventListener('click', closeVideoModal);
        document.getElementById('videoModal')?.addEventListener('click', (e) => { if(e.target === e.currentTarget) closeVideoModal(); });
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeVideoModal(); });

        let lastScroll = 0;
        const stickyCta = document.getElementById('stickyCta');
        window.addEventListener('scroll', () => {
            if (!stickyCta) return;
            const currentScroll = window.scrollY;
            if (currentScroll > 400 && currentScroll > lastScroll) stickyCta.classList.remove('hide');
            else if (currentScroll < lastScroll && currentScroll > 300) stickyCta.classList.add('hide');
            if (currentScroll < 300) stickyCta.classList.add('hide');
            lastScroll = currentScroll;
        });
        if (stickyCta) stickyCta.classList.add('hide');

        document.getElementById('downloadBrochureBtn')?.addEventListener('click', () => alert('📄 Brochure download started (demo).'));
        document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.remove('hidden'));
        document.getElementById('closeMenu')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.add('hidden'));

        function escapeHtml(str) {
            return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
        }
        renderSyllabus();

        // Need Help Form Submission
        const helpForm = document.getElementById('helpForm');
        const helpSubmitBtn = document.getElementById('helpSubmitBtn');
        const helpMsgDiv = document.getElementById('helpFormMessage');
        function showHelpMessage(message, isError = false) {
            if (!helpMsgDiv) return;
            if (window.helpMsgTimeout) clearTimeout(window.helpMsgTimeout);
            helpMsgDiv.innerHTML = `${isError ? '❌' : '✅'} ${message}`;
            helpMsgDiv.className = `mb-4 rounded-xl p-3 text-sm font-medium ${
                isError ? 'bg-red-100 text-red-800 border-l-4 border-red-500' : 'bg-green-100 text-green-800 border-l-4 border-green-500'
            }`;
            helpMsgDiv.classList.remove('hidden');
            setTimeout(() => helpMsgDiv.classList.add('hidden'), 5000);
        }
        if (helpForm) {
            helpForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const name = document.getElementById('helpName')?.value.trim();
                const email = document.getElementById('helpEmail')?.value.trim();
                const phone = document.getElementById('helpPhone')?.value.trim();
                const course = document.getElementById('helpCourse')?.value || '';
                const callbackTime = document.getElementById('helpCallbackTime')?.value || '';
                const message = document.getElementById('helpMessage')?.value.trim() || '';
                
                if (!name || !email || !phone || !course) {
                    showHelpMessage('All required fields (Name, Email, Phone) must be filled.', true);
                    return;
                }
                const phoneRegex = /^\d{10}$/;
                if (!phoneRegex.test(phone)) {
                    showHelpMessage('Phone number must be exactly 10 digits (numbers only).', true);
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    showHelpMessage('Invalid email format.', true);
                    return;
                }
                
                const payload = { name, email, phoneNumber: phone, course, message, degree: '', callbackTime };
                
                if (helpSubmitBtn) {
                    helpSubmitBtn.disabled = true;
                    helpSubmitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
                }
                
                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Submission failed');
                    showHelpMessage(data.message || 'Your inquiry has been received. We will contact you soon!', false);
                    helpForm.reset();
                } catch (err) {
                    showHelpMessage(err.message || 'Something went wrong. Please try again later.', true);
                } finally {
                    if (helpSubmitBtn) {
                        helpSubmitBtn.disabled = false;
                        helpSubmitBtn.innerHTML = '<i class="fa-regular fa-paper-plane"></i> Send Message <i class="fa-solid fa-arrow-right text-xs"></i>';
                    }
                }
            });
        }

        const fadeElements = document.querySelectorAll('.fade-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.1 });
        fadeElements.forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(25px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    </script>
</body>
</html>