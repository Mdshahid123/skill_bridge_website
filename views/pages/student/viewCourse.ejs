<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= course.courseName %> | SkillBridge</title>
    <meta name="description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Learn ' + course.courseName + ' with expert mentors. Hands‑on projects, certification, and placement assistance.' %>">
    <meta name="keywords" content="<%= course.courseName %>, online course, IT training, <%= course.category %>, learn <%= course.courseName %>">
    <meta name="author" content="Skill Bridge">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.skillbridge.com/viewCourse/<%= course._id %>">
    <meta property="og:title" content="<%= course.courseName %> – Skill Bridge">
    <meta property="og:description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Enroll now in ' + course.courseName + ' to gain industry‑relevant skills.' %>">
    <meta property="og:image" content="<%= course.image ? course.image : 'https://www.skillbridge.com/default-course.jpg' %>">
    <meta property="og:url" content="https://www.skillbridge.com/viewCourse/<%= course._id %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= course.courseName %>">
    <meta name="twitter:description" content="<%= course.courseDescription ? course.courseDescription.slice(0, 160) : 'Course details, curriculum, and enrollment information.' %>">

    <!-- Schema.org – Course -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "<%= course.courseName.replace(/"/g, '&quot;') %>",
      "description": "<%= course.courseDescription ? course.courseDescription.replace(/"/g, '&quot;').slice(0, 300) : '' %>",
      "provider": {
        "@type": "Organization",
        "name": "Skill Bridge"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "online",
        "duration": "<%= course.duration %> Months"
      },
      "offers": {
        "@type": "Offer",
        "price": "<%= course.price %>",
        "priceCurrency": "INR"
      }
    }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <style>
        /* Base styles – heavy fonts & smooth interactions */
        body { font-family: 'Inter', sans-serif; background: #f8fafc; color: #0f172a; }

        /* ========== HEAVY TYPOGRAPHY (main content) ========== */
        .course-content-wrapper h1,
        .course-content-wrapper h2,
        .course-content-wrapper h3,
        .course-content-wrapper h4,
        .course-content-wrapper .font-bold,
        .course-content-wrapper .font-semibold,
        .course-content-wrapper .font-extrabold {
            font-weight: 800 !important;
            letter-spacing: -0.01em;
        }
        .course-content-wrapper p,
        .course-content-wrapper li,
        .course-content-wrapper .description-text,
        .course-content-wrapper .requirement-item,
        .course-content-wrapper .text-gray-600,
        .course-content-wrapper .text-gray-700 {
            font-weight: 600 !important;
            color: #1e293b !important;
        }
        .course-content-wrapper .text-gray-500 {
            font-weight: 500 !important;
            color: #475569 !important;
        }
        /* Syllabus module titles & lectures */
        .module-title {
            font-weight: 800 !important;
            font-size: 1.1rem;
        }
        .lecture-title {
            font-weight: 600 !important;
        }
        .offer-card p {
            font-weight: 500 !important;
        }

        /* ========== ANIMATIONS ========== */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-up {
            animation: fadeUp 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
        }
        .delay-100 { animation-delay: 0.1s; }
        .delay-200 { animation-delay: 0.2s; }
        .delay-300 { animation-delay: 0.3s; }
        .hover-grow {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .hover-grow:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.15);
        }
        .btn-pulse {
            animation: pulse-border 1.5s infinite;
        }
        @keyframes pulse-border {
            0% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.4); }
            70% { box-shadow: 0 0 0 12px rgba(20, 184, 166, 0); }
            100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0); }
        }
        .gradient-border {
            position: relative;
            background: white;
            border-radius: 1rem;
        }
        .gradient-border::after {
            content: '';
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            background: linear-gradient(135deg, #14b8a6, #3b82f6);
            border-radius: 1rem;
            z-index: -1;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .gradient-border:hover::after {
            opacity: 1;
        }

        /* Sticky CTA */
        .sticky-cta {
            transition: transform 0.3s ease;
        }
        .sticky-cta.hide {
            transform: translateY(120%);
        }

        /* Syllabus interactive */
        .lecture-item {
            transition: all 0.2s ease;
        }
        .lecture-item:not(.locked):hover {
            background: #e6f4f5;
            padding-left: 1rem;
        }

        /* Hero & cards */
        .hero-glow {
            background: linear-gradient(135deg, #e0f2fe 0%, #ccfbf1 50%, #cffafe 100%);
            position: relative;
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 40%, rgba(6,182,212,0.2), transparent 70%);
            animation: slowDrift 12s infinite alternate;
        }
        @keyframes slowDrift {
            0% { opacity: 0.4; transform: translate(0,0);}
            100% { opacity: 0.8; transform: translate(5%, 5%);}
        }
        .brand-grid {
            background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px),
                              repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px);
        }
        .instructor-card {
            transition: all 0.3s cubic-bezier(0.2,0.9,0.4,1.1);
        }
        .instructor-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 35px -12px rgba(26,111,140,0.25);
        }
        .floating-icon {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes float {
            0%,100%{ transform: translateY(0px); }
            50%{ transform: translateY(-8px); }
        }
    </style>
</head>
<body>

    <%- include("../../partials/common/navbar.ejs") %>

    <!-- Mobile Menu (unchanged) -->
    <div id="mobileMenu" class="fixed inset-0 bg-gray-900 z-50 hidden flex-col p-6 pt-24">
        <button id="closeMenu" class="absolute top-6 right-6 text-3xl"><i class="fa-solid fa-xmark text-white"></i></button>
        <div class="flex flex-col gap-5 text-xl">
            <a href="/" class="font-semibold text-gray-300 py-3 border-b border-gray-800">Home</a>
            <a href="/about" class="font-semibold text-gray-300 py-3 border-b">About</a>
            <a href="/courses" class="font-semibold text-gray-300 py-3 border-b">Courses</a>
            <a href="/contact" class="font-semibold text-gray-300 py-3 border-b">Contact</a>
            <div class="flex gap-4 mt-4"><button class="flex-1 btn-primary-custom text-white py-3 rounded-full font-bold">Enroll Now</button></div>
        </div>
    </div>

    <div class="course-content-wrapper">
        <main>
            <!-- Hero Section (Enhanced) -->
            <div class="hero-glow pt-28 pb-16 relative overflow-hidden">
                <div class="absolute inset-0 opacity-[0.08] brand-grid"></div>
                <div class="container mx-auto px-6 relative z-10">
                    <div class="flex flex-col lg:flex-row gap-10 items-start">
                        <div class="flex-1 animate-fade-up">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/50 backdrop-blur-sm border border-teal-200 mb-5">
                                <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
                                <span class="text-teal-700 text-xs font-black tracking-wider">⭐ MOST POPULAR</span>
                            </div>
                            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 mb-5 leading-tight"><%= course.courseName.replaceAll("-", " ") %></h1>
                            <p class="text-gray-800 text-lg max-w-2xl font-semibold leading-relaxed"><%= course.courseDescription %></p>
                            <div class="flex flex-wrap gap-4 mt-8">
                                <div class="flex items-center gap-2 bg-white/70 backdrop-blur-sm px-5 py-2 rounded-full"><i class="fa-regular fa-star text-teal-600"></i><span class="font-bold text-gray-800">4.9 ★ (2.5k+ ratings)</span></div>
                                <div class="flex items-center gap-2 bg-white/70 backdrop-blur-sm px-5 py-2 rounded-full"><i class="fa-regular fa-user text-teal-600"></i><span class="font-bold text-gray-800">15k+ enrolled</span></div>
                                <div class="flex items-center gap-2 bg-white/70 backdrop-blur-sm px-5 py-2 rounded-full"><i class="fa-regular fa-clock text-teal-600"></i><span class="font-bold text-gray-800">Updated monthly</span></div>
                            </div>
                        </div>
                        <!-- Instructor Card with animation -->
                        <div class="instructor-card bg-white rounded-2xl shadow-xl overflow-hidden max-w-sm mx-auto lg:mx-0 animate-fade-up delay-100">
                            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                                <img style="object-fit:cover;" src="<%= course.instructor.profilePicture || '/default-avatar.png' %>" alt="<%= course.instructor.name %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                            </div>
                            <div class="p-5">
                                <h3 class="text-2xl font-black text-gray-800"><%= course.instructor.name %></h3>
                                <p class="text-gray-600 font-semibold mt-1"><%= course.instructor.bio %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Container -->
            <div class="container mx-auto px-6 py-12 max-w-8xl">
                <div class="grid lg:grid-cols-3 gap-10">
                    <!-- Left Column (2/3) - Animated sections -->
                    <div class="lg:col-span-2 space-y-10">
                        <!-- What You'll Learn -->
                        <div class="bg-white rounded-2xl p-7 shadow-md hover:shadow-lg transition-all gradient-border animate-fade-up delay-100">
                            <h2 class="text-2xl font-black text-gray-900 mb-5 flex items-center gap-2"><i class="fa-regular fa-lightbulb text-teal-500 text-2xl"></i> What You'll Learn</h2>
                            <div class="grid md:grid-cols-2 gap-4">
                                <% course.whatYouLearn.forEach(item => { %>
                                    <div class="flex items-start gap-3"><i class="fa-regular fa-circle-check text-teal-600 mt-0.5"></i><span class="text-gray-800 font-semibold"><%= item %></span></div>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Syllabus (Interactive + Heavy Font) -->
                        <div class="bg-white rounded-2xl p-7 shadow-md hover:shadow-lg transition-all" id="syllabusSection">
                            <div class="flex flex-wrap justify-between items-center mb-6">
                                <h2 class="text-2xl font-black text-gray-900 flex items-center gap-2"><i class="fa-regular fa-rectangle-list text-teal-500"></i> Course Content</h2>
                                <button id="downloadBrochureBtn" class="flex items-center gap-2 text-sm font-extrabold text-teal-700 border border-teal-300 px-5 py-2 rounded-full hover:bg-teal-600 hover:text-white transition-all"><i class="fa-regular fa-file-pdf"></i>Download Brochure</button>
                            </div>
                            <div id="courseContent" class="space-y-4"></div>
                        </div>

                        <!-- Requirements -->
                        <div class="bg-white rounded-2xl p-7 shadow-md hover:shadow-lg transition-all animate-fade-up delay-200">
                            <h2 class="text-2xl font-black text-gray-900 mb-5 flex items-center gap-2"><i class="fa-regular fa-list-check text-teal-500"></i> Requirements</h2>
                            <ul class="space-y-3">
                                <% course.requirements.forEach(req => { %>
                                    <li class="flex items-start gap-3"><i class="fa-regular fa-circle-check text-teal-600 mt-1"></i><span class="text-gray-800 font-semibold"><%= req %></span></li>
                                <% }); %>
                            </ul>
                        </div>

                        <!-- Description (Long) -->
                        <div class="bg-white rounded-2xl p-7 shadow-md hover:shadow-lg transition-all animate-fade-up delay-300">
                            <h2 class="text-2xl font-black text-gray-900 mb-5 flex items-center gap-2"><i class="fa-regular fa-file-lines text-teal-500"></i> Full Description</h2>
                            <div class="text-gray-800 font-semibold leading-relaxed space-y-4"><%= course.longDescription %></div>
                        </div>
                    </div>

                    <!-- Right Sidebar – Enrollment Card (Sticky) -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-2xl p-6 shadow-xl border border-teal-100 sticky top-24 transition-all hover:shadow-2xl animate-fade-up">
                            <div class="aspect-video rounded-xl overflow-hidden mb-5">
                                <img style="object-fit:cover;" src="<%= course.image %>" alt="<%= course.courseName %>" class="w-full h-full object-cover">
                            </div>
                            <h3 class="text-2xl font-black text-gray-800"><%= course.courseName %></h3>
                            <div class="flex items-center gap-3 my-4">
                                <span class="text-4xl font-black text-teal-600">₹<%= course.price %></span>
                                <span class="text-lg text-gray-500 line-through font-semibold">₹<%= course.originalPrice %></span>
                                <span class="bg-green-100 text-green-800 font-black px-2 py-1 rounded-full text-sm"><%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off</span>
                            </div>
                            <div class="space-y-3 mb-6">
                                <div class="flex items-center gap-3"><i class="fa-regular fa-clock w-5 text-teal-600"></i><span class="font-bold"><%= course.duration %> Months</span></div>
                                <div class="flex items-center gap-3"><i class="fa-regular fa-signal w-5 text-teal-600"></i><span class="font-bold"><%= course.level %></span></div>
                                <div class="flex items-center gap-3"><i class="fa-regular fa-certificate w-5 text-teal-600"></i><span class="font-bold">Certificate of Completion</span></div>
                                <div class="flex items-center gap-3"><i class="fa-regular fa-infinity w-5 text-teal-600"></i><span class="font-bold">Lifetime Access</span></div>
                            </div>
                            <button class="w-full bg-gradient-to-r from-teal-600 to-blue-700 hover:from-teal-700 hover:to-blue-800 text-white py-3.5 rounded-xl font-extrabold transition-all enroll-btn btn-pulse">Enroll Now <i class="fa-solid fa-arrow-right ml-2"></i></button>
                            <p class="text-center text-sm text-gray-600 font-semibold mt-4">⚡ Join 15,000+ successful students</p>
                        </div>
                    </div>
                </div>

                <!-- Sticky CTA bar (appears on scroll) -->
                <div id="stickyCta" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl p-4 transform translate-y-full transition-transform duration-300 z-40 sticky-cta">
                    <div class="container mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="flex items-center gap-3"><span class="font-black text-gray-800"><%= course.courseName %></span><span class="text-2xl font-black text-teal-600">₹<%= course.price %></span><span class="text-sm text-gray-500 line-through">₹<%= course.originalPrice %></span></div>
                        <button class="enroll-btn bg-teal-600 text-white px-8 py-2.5 rounded-full font-extrabold shadow-lg hover:bg-teal-700 transition-all">Enroll Now <i class="fa-solid fa-arrow-right ml-1"></i></button>
                    </div>
                </div>

                <!-- Exclusive Offerings (Animated) -->
                <div class="mt-24">
                    <div class="text-center mb-12">
                        <span class="text-teal-600 font-black tracking-wider">WHY CHOOSE US</span>
                        <h2 class="text-4xl md:text-5xl font-black text-gray-900 mt-2">Exclusive Course Offerings</h2>
                    </div>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-100">
                            <div class="w-14 h-14 rounded-2xl bg-rose-100 flex items-center justify-center mb-4"><i class="fa-solid fa-diagram-project text-rose-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Capstone Project</h3>
                            <p class="text-gray-700 font-medium">Build real‑world projects that showcase your skills to employers.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-200">
                            <div class="w-14 h-14 rounded-2xl bg-amber-100 flex items-center justify-center mb-4"><i class="fa-solid fa-pen-ruler text-amber-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Practice Exercises</h3>
                            <p class="text-gray-700 font-medium">Topic-wise challenges to strengthen concepts.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-300">
                            <div class="w-14 h-14 rounded-2xl bg-green-100 flex items-center justify-center mb-4"><i class="fa-solid fa-folder-open text-green-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Assignments & Projects</h3>
                            <p class="text-gray-700 font-medium">Apply what you've learned with regular tasks.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-150">
                            <div class="w-14 h-14 rounded-2xl bg-cyan-100 flex items-center justify-center mb-4"><i class="fa-solid fa-headset text-cyan-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Live Doubt Resolution</h3>
                            <p class="text-gray-700 font-medium">Instant help from expert mentors.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-250">
                            <div class="w-14 h-14 rounded-2xl bg-emerald-100 flex items-center justify-center mb-4"><i class="fa-regular fa-certificate text-emerald-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Certification</h3>
                            <p class="text-gray-700 font-medium">Globally recognized certificate.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all hover:-translate-y-1 animate-fade-up delay-350">
                            <div class="w-14 h-14 rounded-2xl bg-orange-100 flex items-center justify-center mb-4"><i class="fa-solid fa-bullhorn text-orange-600 text-2xl"></i></div>
                            <h3 class="text-xl font-black">Career Guidance</h3>
                            <p class="text-gray-700 font-medium">Resume, mock interviews, placement assistance.</p>
                        </div>
                    </div>
                </div>

                <!-- Certificate Section (animated) -->
                <div class="relative mt-24 mb-32 animate-fade-up delay-100">
                    <div class="flex flex-col lg:flex-row items-center gap-12 bg-white rounded-3xl shadow-xl overflow-hidden border p-8">
                        <div class="lg:w-5/12 text-center">
                            <img src="/cc.png" alt="Certificate" class="w-full max-w-sm mx-auto rounded-xl shadow-2xl border-4 border-white hover:scale-105 transition-transform">
                        </div>
                        <div class="lg:w-7/12">
                            <h2 class="text-3xl lg:text-4xl font-black text-gray-900">Course Certificate</h2>
                            <p class="text-gray-700 font-semibold mt-3 text-lg">Earn a verified certificate upon completion. Showcase your skills globally.</p>
                            <div class="flex flex-wrap gap-4 mt-6"><span class="bg-teal-50 text-teal-700 font-bold px-4 py-2 rounded-full">✓ Shareable on LinkedIn</span><span class="bg-blue-50 text-blue-700 font-bold px-4 py-2 rounded-full">✓ Verifiable & Secure</span><span class="bg-emerald-50 text-emerald-700 font-bold px-4 py-2 rounded-full">✓ Lifetime Access</span></div>
                            <button class="mt-8 inline-flex items-center gap-2 text-teal-700 font-bold bg-teal-50 px-6 py-2.5 rounded-full hover:bg-teal-100 transition-all">Download Sample <i class="fa-regular fa-file-pdf"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Need Help Section (Enhanced animation & validation) -->
                <div class="mt-16 animate-fade-up delay-200">
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                        <div class="flex flex-col md:flex-row">
                            <div class="md:w-5/12 bg-gradient-to-br from-teal-50 to-blue-50 p-8 text-center">
                                <img src="https://pwskills.com/images/accountImage/leadform/man.webp" alt="Support" class="w-40 h-40 mx-auto floating-icon">
                                <h3 class="text-2xl font-black mt-4">We're here to help 💙</h3>
                                <p class="text-gray-700 font-semibold">Our support team will assist you within 24h.</p>
                            </div>
                            <div class="md:w-7/12 p-8">
                                <div id="helpFormMessage" class="mb-4 hidden rounded-xl p-3 text-sm font-bold"></div>
                                <form id="helpForm" class="space-y-4">
                                    <input type="text" id="helpName" placeholder="Full Name *" class="w-full rounded-xl border border-gray-200 px-4 py-3 font-semibold focus:ring-2 focus:ring-teal-500" required>
                                    <input type="email" id="helpEmail" placeholder="Email Address *" class="w-full rounded-xl border border-gray-200 px-4 py-3 font-semibold" required>
                                    <input type="tel" id="helpPhone" placeholder="Phone Number *" class="w-full rounded-xl border border-gray-200 px-4 py-3 font-semibold" required>
                                    <input type="hidden" id="helpCourse" value="<%= course.courseName %>">
                                    <textarea id="helpMessage" rows="3" placeholder="Your question..." class="w-full rounded-xl border border-gray-200 px-4 py-3 font-semibold"></textarea>
                                    <button type="submit" class="w-full bg-gradient-to-r from-teal-600 to-blue-600 text-white font-extrabold py-3 rounded-xl hover:scale-[1.02] transition-all">Send Message <i class="fa-regular fa-paper-plane ml-2"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Payment Modal -->
    <div id="paymentModal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 relative">
            <button id="closePaymentModal" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800"><i class="fa-solid fa-xmark text-2xl"></i></button>
            <h3 class="text-2xl font-black text-center mb-4">Secure Payment</h3>
            <form id="paymentForm">
                <input type="text" placeholder="Cardholder Name" class="w-full mb-3 p-3 border rounded-xl font-semibold" required>
                <input type="text" placeholder="Card Number" class="w-full mb-3 p-3 border rounded-xl font-semibold" required>
                <div class="flex gap-3"><input type="text" placeholder="MM/YY" class="w-1/2 p-3 border rounded-xl font-semibold" required><input type="text" placeholder="CVV" class="w-1/2 p-3 border rounded-xl font-semibold" required></div>
                <button type="submit" class="w-full mt-5 bg-teal-600 text-white py-3 rounded-xl font-extrabold">Pay ₹<%= course.price %></button>
            </form>
        </div>
    </div>

    <!-- Video Modal -->
    <div id="videoModal" class="fixed inset-0 bg-black/90 z-[2000] hidden items-center justify-center p-4 backdrop-blur-sm">
        <div class="relative w-full max-w-4xl bg-black rounded-2xl overflow-hidden">
            <button id="closeVideoModal" class="absolute top-4 right-4 text-white text-3xl z-10"><i class="fa-solid fa-xmark"></i></button>
            <div class="aspect-video"><iframe id="youtubeFrame" class="w-full h-full" src="" frameborder="0" allowfullscreen></iframe></div>
            <div class="p-4 bg-gray-900"><h3 id="videoTitle" class="text-white font-black"></h3><p id="videoSection" class="text-gray-400 font-semibold"></p></div>
        </div>
    </div>

    <%- include("../../partials/common/footer") %>

    <script>
        const courseFromServer = <%- JSON.stringify(course) %>;
        let isPurchased = localStorage.getItem(`course_${courseFromServer._id}_purchased`) === 'true';

        function renderSyllabus() {
            const container = document.getElementById('courseContent');
            if (!container) return;
            let lectureCounter = 0;
            let html = '';
            courseFromServer.syllabus.forEach((module, idx) => {
                let lecturesHtml = '';
                module.lectures.forEach(lecture => {
                    lectureCounter++;
                    const locked = !isPurchased && lectureCounter > 2;
                    lecturesHtml += `
                        <div class="lecture-item flex items-center gap-3 p-3 rounded-xl cursor-pointer transition-all ${locked ? 'locked opacity-60' : 'hover:bg-teal-50'}" data-lecture="${escapeHtml(lecture.lectureTitle)}" data-section="${escapeHtml(module.moduleTitle)}" data-locked="${locked}" data-video-url="${lecture.videoUrl || ''}">
                            <i class="fa-regular fa-circle-play text-gray-500 w-5"></i>
                            <i class="fa-solid fa-lock text-red-500 w-5 hidden"></i>
                            <span class="flex-1 text-gray-800 font-semibold lecture-title">${escapeHtml(lecture.lectureTitle)}</span>
                            <span class="text-gray-500 text-sm font-medium">${lecture.videoDuration || '0:00'}</span>
                            ${!locked ? '<i class="fa-brands fa-youtube text-gray-500 group-hover:text-red-500"></i>' : '<i class="fa-solid fa-lock text-gray-500"></i>'}
                        </div>
                    `;
                });
                html += `
                    <div class="border rounded-2xl overflow-hidden">
                        <div class="flex justify-between items-center p-4 bg-gray-50 cursor-pointer hover:bg-teal-50 transition section-header" data-section="${idx}">
                            <div class="flex items-center gap-3"><i class="fa-regular fa-folder-open text-teal-600"></i><span class="font-black text-gray-800 module-title">${escapeHtml(module.moduleTitle)}</span></div>
                            <div class="flex items-center gap-2"><span class="text-xs font-bold text-gray-600">${module.lectures.length} lectures</span><i class="fa-solid fa-chevron-down text-gray-400 transition-transform"></i></div>
                        </div>
                        <div class="lecture-list hidden divide-y">${lecturesHtml}</div>
                    </div>
                `;
            });
            html += `<div class="mt-4 text-center">${!isPurchased ? '<div class="bg-amber-50 p-3 rounded-xl font-bold text-amber-700">🔒 First 2 lectures free. Enroll to unlock all!</div>' : '<div class="bg-green-50 p-3 rounded-xl font-bold text-green-700">✅ Course unlocked! Full access.</div>'}</div>`;
            container.innerHTML = html;

            document.querySelectorAll('.section-header').forEach(header => {
                header.addEventListener('click', function() {
                    const list = this.nextElementSibling;
                    const icon = this.querySelector('.fa-chevron-down');
                    list.classList.toggle('hidden');
                    icon.style.transform = list.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            document.querySelectorAll('.lecture-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    if (this.dataset.locked === 'true') { alert('🔒 Please enroll to unlock this lecture.'); return; }
                    const videoUrl = this.dataset.videoUrl;
                    if (videoUrl) openVideoModal(this.dataset.lecture, this.dataset.section, videoUrl);
                    else alert('Video not available.');
                });
            });
        }

        function openVideoModal(title, section, url) {
            let embed = url;
            if (url.includes('youtube.com') || url.includes('youtu.be')) {
                let vid = url.split('v=')[1]?.split('&')[0] || url.split('/').pop();
                embed = `https://www.youtube.com/embed/${vid}?autoplay=1`;
            }
            document.getElementById('youtubeFrame').src = embed;
            document.getElementById('videoTitle').innerText = title;
            document.getElementById('videoSection').innerText = section;
            document.getElementById('videoModal').classList.remove('hidden');
            document.getElementById('videoModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeVideoModal() {
            document.getElementById('youtubeFrame').src = '';
            document.getElementById('videoModal').classList.add('hidden');
            document.getElementById('videoModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        // Sticky CTA scroll
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
            const cta = document.getElementById('stickyCta');
            if (!cta) return;
            const current = window.scrollY;
            if (current > 400 && current > lastScroll) cta.classList.remove('hide');
            else if (current < lastScroll && current > 400) cta.classList.add('hide');
            if (current < 300) cta.classList.add('hide');
            lastScroll = current;
        });
        document.getElementById('stickyCta')?.classList.add('hide');

        // Enroll buttons logic
        const paymentModal = document.getElementById('paymentModal');
        document.querySelectorAll('.enroll-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                if (isPurchased) alert('✅ You already own this course!');
                else { paymentModal.classList.remove('hidden'); paymentModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
            });
        });
        document.getElementById('closePaymentModal')?.addEventListener('click', () => { paymentModal.classList.add('hidden'); paymentModal.style.display = 'none'; document.body.style.overflow = ''; });
        document.getElementById('paymentForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            setTimeout(() => {
                isPurchased = true;
                localStorage.setItem(`course_${courseFromServer._id}_purchased`, 'true');
                alert('✅ Payment successful! All lectures unlocked.');
                paymentModal.classList.add('hidden');
                renderSyllabus();
                document.body.style.overflow = '';
            }, 1000);
        });

        document.getElementById('closeVideoModal')?.addEventListener('click', closeVideoModal);
        document.getElementById('videoModal')?.addEventListener('click', (e) => { if(e.target === e.currentTarget) closeVideoModal(); });
        document.getElementById('downloadBrochureBtn')?.addEventListener('click', () => alert('📄 Brochure download started.'));

        // Need help form submission (backend)
        const helpForm = document.getElementById('helpForm');
        const msgDiv = document.getElementById('helpFormMessage');
        function showMsg(text, isErr) {
            msgDiv.innerHTML = (isErr ? '❌ ' : '✅ ') + text;
            msgDiv.className = `mb-4 rounded-xl p-3 font-bold ${isErr ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'}`;
            msgDiv.classList.remove('hidden');
            setTimeout(() => msgDiv.classList.add('hidden'), 5000);
        }
        helpForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('helpName').value.trim();
            const email = document.getElementById('helpEmail').value.trim();
            const phone = document.getElementById('helpPhone').value.trim();
            const course = document.getElementById('helpCourse').value;
            const message = document.getElementById('helpMessage').value.trim();
            if (!name || !email || !phone) return showMsg('All required fields must be filled', true);
            if (!/^\d{10}$/.test(phone)) return showMsg('Phone must be 10 digits', true);
            try {
                const res = await fetch('/submitEnquery', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({name,email,phoneNumber:phone,course,message}) });
                const data = await res.json();
                if(res.ok) showMsg(data.message || 'Inquiry sent!', false);
                else showMsg(data.error || 'Error', true);
            } catch(err) { showMsg('Network error', true); }
        });

        renderSyllabus();

        // Scroll animations (fade-up already applied, but ensure visibility)
        const faders = document.querySelectorAll('.animate-fade-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if(e.isIntersecting) e.target.style.opacity = '1'; });
        }, { threshold: 0.1 });
        faders.forEach(f => { f.style.opacity = '0'; observer.observe(f); });
    </script>
</body>
</html>
