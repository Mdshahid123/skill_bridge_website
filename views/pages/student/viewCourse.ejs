    <%- include("../../partials/common/footer") %>

    <script>
        const courseFromServer = <%- JSON.stringify(course) %>;
        let isPurchased = localStorage.getItem(`course_${courseFromServer._id}_purchased`) === 'true';

        function renderSyllabus() {
            const contentContainer = document.getElementById('courseContent');
            if (!contentContainer) return;
            
            let lectureCounter = 0;
            const syllabusHtml = `
                <div class="space-y-3">
                    ${courseFromServer.syllabus.map((module, idx) => `
                        <div class="border rounded-xl overflow-hidden bg-white">
                            <div class="flex justify-between items-center p-4 bg-gray-50 cursor-pointer hover:bg-teal-50 transition-all duration-300 section-header" data-section="${idx}">
                                <div class="flex items-center gap-3">
                                    <i class="fa-regular fa-folder-open text-teal-500"></i>
                                    <span class="font-extrabold text-gray-800">${escapeHtml(module.moduleTitle)}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-gray-600 font-medium">${module.lectures.length} lectures</span>
                                    <i class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
                                </div>
                            </div>
                            <div class="lecture-list hidden border-t border-gray-100 bg-white">
                                <div class="divide-y divide-gray-50">
                                    ${module.lectures.map((lecture, li) => {
                                        lectureCounter++;
                                        const isLocked = !isPurchased && lectureCounter > 2;
                                        return `
                                            <div class="lecture-item flex items-center gap-3 p-3 transition-all duration-200 cursor-pointer group ${isLocked ? 'locked' : ''}" 
                                                 data-lecture="${escapeHtml(lecture.lectureTitle)}" 
                                                 data-section="${escapeHtml(module.moduleTitle)}"
                                                 data-locked="${isLocked}"
                                                 data-video-url="${lecture.videoUrl || ''}">
                                                <i class="fa-regular fa-circle-play text-gray-400 text-base w-5 group-hover:text-teal-500 transition"></i>
                                                <i class="fa-solid fa-lock text-red-500 text-base w-5"></i>
                                                <span class="text-sm text-gray-700 flex-1 group-hover:text-teal-600 transition font-medium ${isLocked ? 'opacity-60' : ''}">${escapeHtml(lecture.lectureTitle)}</span>
                                                <span class="text-xs text-gray-500 font-medium">${lecture.videoDuration || '0:00'}</span>
                                                ${!isLocked ? '<i class="fa-brands fa-youtube text-gray-400 text-sm group-hover:text-red-500 transition"></i>' : '<i class="fa-solid fa-lock text-gray-400 text-sm"></i>'}
                                            </div>
                                        `;
                                    }).join('')}
                                </div>
                            </div>
                        </div>
                    `).join('')}
                    ${!isPurchased ? `<div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                        <i class="fa-solid fa-lock text-amber-600 mr-2"></i>
                        <span class="text-amber-700 text-sm font-bold">First 2 lectures are free. <strong>Enroll now</strong> to unlock all ${lectureCounter} lectures!</span>
                    </div>` : `<div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
                        <i class="fa-solid fa-circle-check text-green-600 mr-2"></i>
                        <span class="text-green-700 text-sm font-bold">✅ Course unlocked! You have access to all ${lectureCounter} lectures.</span>
                    </div>`}
                    <div class="text-center mt-4">
                        <button class="text-teal-600 text-sm font-extrabold hover:underline expand-all-btn transition-all duration-300">
                            <i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections
                        </button>
                    </div>
                </div>
            `;
            contentContainer.innerHTML = syllabusHtml;

            document.querySelectorAll('.section-header').forEach(header => {
                header.addEventListener('click', function() {
                    const lectureList = this.nextElementSibling;
                    const icon = this.querySelector('.fa-chevron-down');
                    lectureList.classList.toggle('hidden');
                    if (icon) icon.style.transform = lectureList.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            document.querySelectorAll('.lecture-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    const isLocked = this.getAttribute('data-locked') === 'true';
                    if (isLocked) {
                        e.preventDefault();
                        alert('🔒 This lecture is locked. Please complete payment to unlock all lectures!');
                        return;
                    }
                    const lecture = this.getAttribute('data-lecture');
                    const section = this.getAttribute('data-section');
                    const videoUrl = this.getAttribute('data-video-url');
                    if (videoUrl) {
                        openVideoModal(lecture, section, videoUrl);
                    } else {
                        alert('Video not available.');
                    }
                });
            });

            let expanded = false;
            const expandBtn = document.querySelector('.expand-all-btn');
            if (expandBtn) {
                expandBtn.addEventListener('click', function() {
                    const allLists = document.querySelectorAll('.lecture-list');
                    const allIcons = document.querySelectorAll('.fa-chevron-down');
                    if (expanded) {
                        allLists.forEach(list => list.classList.add('hidden'));
                        allIcons.forEach(icon => icon.style.transform = 'rotate(0deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections';
                    } else {
                        allLists.forEach(list => list.classList.remove('hidden'));
                        allIcons.forEach(icon => icon.style.transform = 'rotate(180deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Collapse all sections';
                    }
                    expanded = !expanded;
                });
            }
        }

        function openVideoModal(lecture, section, videoUrl) {
            const modal = document.getElementById('videoModal');
            document.getElementById('videoTitle').textContent = lecture;
            document.getElementById('videoSection').textContent = section;
            let embedUrl = videoUrl;
            if (videoUrl && (videoUrl.includes('youtube.com') || videoUrl.includes('youtu.be'))) {
                const videoId = videoUrl.split('v=')[1]?.split('&')[0] || videoUrl.split('/').pop();
                embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
            } else if (videoUrl) {
                embedUrl = videoUrl;
            } else {
                embedUrl = 'https://www.youtube.com/embed/EVW4nj1jCy0?autoplay=1&rel=0';
            }
            document.getElementById('youtubeFrame').src = embedUrl;
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeVideoModal() {
            const modal = document.getElementById('videoModal');
            document.getElementById('youtubeFrame').src = '';
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }

        const paymentModal = document.getElementById('paymentModal');
        const closePaymentModal = document.getElementById('closePaymentModal');
        if (closePaymentModal) closePaymentModal.addEventListener('click', () => {
            paymentModal.classList.add('hidden');
            paymentModal.style.display = 'none';
            document.body.style.overflow = '';
        });
        if (paymentModal) paymentModal.addEventListener('click', (e) => {
            if (e.target === paymentModal) {
                paymentModal.classList.add('hidden');
                paymentModal.style.display = 'none';
                document.body.style.overflow = '';
            }
        });

        document.querySelectorAll('.enroll-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                if (isPurchased) {
                    alert('✅ You already have access to this course! All lectures are unlocked.');
                } else {
                    paymentModal.classList.remove('hidden');
                    paymentModal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
            });
        });

        const paymentForm = document.getElementById('paymentForm');
        if (paymentForm) {
            paymentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
                submitBtn.disabled = true;
                setTimeout(() => {
                    isPurchased = true;
                    localStorage.setItem(`course_${courseFromServer._id}_purchased`, 'true');
                    alert('✅ Payment Successful! You now have full access to all lectures.');
                    paymentModal.classList.add('hidden');
                    paymentModal.style.display = 'none';
                    document.body.style.overflow = '';
                    renderSyllabus();
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }, 2000);
            });
        }

        document.getElementById('closeVideoModal')?.addEventListener('click', closeVideoModal);
        document.getElementById('videoModal')?.addEventListener('click', (e) => { if(e.target === e.currentTarget) closeVideoModal(); });
        document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeVideoModal(); });

        document.getElementById('downloadBrochureBtn')?.addEventListener('click', () => alert('📄 Brochure download started (demo).'));
        document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.remove('hidden'));
        document.getElementById('closeMenu')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.add('hidden'));

        function escapeHtml(str) {
            return str.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        renderSyllabus();

        // ========== NEED HELP FORM SUBMISSION (Backend Ready) ==========
        const helpForm = document.getElementById('helpForm');
        const helpSubmitBtn = document.getElementById('helpSubmitBtn');
        const helpMsgDiv = document.getElementById('helpFormMessage');
function showHelpMessage(message, isError = false) {
    if (!helpMsgDiv) return;
    
    // Clear previous timeout
    if (window.helpMsgTimeout) clearTimeout(window.helpMsgTimeout);
    
    // Set icon and additional classes
    const icon = isError ? '<i class="fa-solid fa-circle-exclamation"></i>' : '<i class="fa-regular fa-circle-check"></i>';
    helpMsgDiv.innerHTML = `${icon} <span>${message}</span>`;
    helpMsgDiv.className = `mb-4 rounded-xl p-3 text-sm font-medium flex items-center gap-2 shadow-md transition-all duration-300 ${
        isError 
            ? 'bg-gradient-to-r from-red-50 to-red-100 text-red-800 border-l-4 border-red-500' 
            : 'bg-gradient-to-r from-green-50 to-green-100 text-green-800 border-l-4 border-green-500'
    }`;
    helpMsgDiv.classList.remove('hidden');
    
    // Force reflow before scroll
    void helpMsgDiv.offsetHeight;
    
    // Auto-scroll to the message (smoothly, with a tiny delay)
    setTimeout(() => {
        helpMsgDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        // If inside a scrollable container, also adjust that container's scroll
        const scrollParent = helpMsgDiv.closest('.overflow-y-auto, .max-h-\\[90vh\\], .overflow-auto');
        if (scrollParent) {
            const offset = helpMsgDiv.offsetTop - scrollParent.offsetTop - 80;
            scrollParent.scrollTo({ top: offset, behavior: 'smooth' });
        }
    }, 80);
    
    // Auto-hide after 5 seconds
    window.helpMsgTimeout = setTimeout(() => {
        if (helpMsgDiv) helpMsgDiv.classList.add('hidden');
    }, 5000);
}
        if (helpForm) {
            helpForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const name = document.getElementById('helpName')?.value.trim();
                const email = document.getElementById('helpEmail')?.value.trim();
                const phone = document.getElementById('helpPhone')?.value.trim();
                const course = document.getElementById('helpCourse')?.value || '';
                const callbackTime = document.getElementById('helpCallbackTime')?.value || '';
                const message = document.getElementById('helpMessage')?.value.trim() || '';
                
                if (!name || !email || !phone || !course) {
                    showHelpMessage('❌ All required fields (Name, Email, Phone) must be filled.', true);
                    return;
                }
                const phoneRegex = /^\d{10}$/;
                if (!phoneRegex.test(phone)) {
                    showHelpMessage('❌ Phone number must be exactly 10 digits (numbers only).', true);
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    showHelpMessage('❌ Invalid email format.', true);
                    return;
                }
                
                const payload = {
                    name,
                    email,
                    phoneNumber: phone,
                    course,
                    message,
                    degree: '',
                    callbackTime
                };
                
                if (helpSubmitBtn) {
                    helpSubmitBtn.disabled = true;
                    helpSubmitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
                }
                
                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Submission failed');
                    showHelpMessage(data.message || '✅ Your inquiry has been received. We will contact you soon!', false);
                    helpForm.reset();
                } catch (err) {
                    showHelpMessage(err.message || '❌ Something went wrong. Please try again later.', true);
                } finally {
                    if (helpSubmitBtn) {
                        helpSubmitBtn.disabled = false;
                        helpSubmitBtn.innerHTML = '<i class="fa-regular fa-paper-plane"></i> Send Message <i class="fa-solid fa-arrow-right text-xs"></i>';
                    }
                }
            });
        }
    </script>
</body>
</html>