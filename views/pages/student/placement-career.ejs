                            </div>
                        </div>
                        
                        <!-- Right Side - Contact Form with Tabs -->
                        <div class="w-full md:w-7/12 p-6 md:p-8 bg-white">
                            <div class="flex items-center gap-2 mb-5">
                                <i class="fa-regular fa-headset text-teal-600 text-xl"></i>
