                    { name: "Priya", role: "Data Analyst", initials: "PS", gradient: "from-emerald-500 to-teal-500",
                        text: "The Data Science program gave me real-world skills. The mock interviews and resume workshops were incredibly helpful." },
                    { name: "Rahul", role: "Full Stack Dev", initials: "RV", gradient: "from-rose-500 to-pink-500",
