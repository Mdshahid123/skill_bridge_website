                    { name: "Sneha", role: "UI/UX Designer", initials: "SP", gradient: "from-violet-500 to-purple-500",
                        text: "The design portfolio reviews and interview practice boosted my confidence. I landed my dream role at Amazon." },
                    { name: "Vikram", role: "DevOps Engineer", initials: "VS", gradient: "from-cyan-500 to-blue-500",
