                // ========== RENDER STUDENT CARDS ==========
                function renderStudentCards() {
                    const track = document.getElementById('studentTrack');
                    if (!track) return;
                    // Double the array for seamless looping
                    const allStudents = [...students, ...students];
                    track.innerHTML = allStudents.map(s => `
                            <div class="student-card">
                                <div class="student-avatar bg-gradient-to-br ${s.gradient}">${s.initials}</div>
                                <div class="student-info">
                                    <p class="font-bold text-gray-800 text-sm">${s.name}</p>
                                    <p class="text-xs text-gray-500">${s.role}</p>
                                    <p class="text-sky-600 font-bold text-sm">${s.package}</p>
                                    <p class="text-xs text-gray-400">${s.company}</p>
                                </div>
                            </div>
                        `).join('');
                }

                // ========== RENDER TESTIMONIAL CARDS ==========
                function renderTestimonialCards() {
                    const track = document.getElementById('testimonialTrack');
                    if (!track) return;
                    const allTestimonials = [...testimonials, ...testimonials];
                    track.innerHTML = allTestimonials.map(t => `
                            <div class="testimonial-card">
                                <div class="flex items-center gap-1 mb-2">
                                    <i class="fa-solid fa-star text-yellow-400"></i>
                                    <i class="fa-solid fa-star text-yellow-400"></i>
                                    <i class="fa-solid fa-star text-yellow-400"></i>
                                    <i class="fa-solid fa-star text-yellow-400"></i>
                                    <i class="fa-solid fa-star text-yellow-400"></i>
                                </div>
                                <p class="text-gray-600 text-sm leading-relaxed">"${t.text}"</p>
                                <div class="flex items-center gap-3 mt-3">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br ${t.gradient} text-white flex items-center justify-center font-bold text-sm">${t.initials}</div>
                                    <div>
                                        <p class="font-bold text-gray-800 text-sm">${t.name}</p>
                                        <p class="text-xs text-gray-500">${t.role}</p>
                                    </div>
                                </div>
                            </div>
                        `).join('');
                }

                // ========== INIT CAROUSELS ==========
                document.addEventListener('DOMContentLoaded', function() {
                    renderStudentCards();
                    renderTestimonialCards();

                    // ========== FAQ ACCORDION - FIXED ==========
                    const faqItems = document.querySelectorAll('.faq-item');
                    faqItems.forEach(item => {
                        const question = item.querySelector('.faq-question');
                        const answer = item.querySelector('.faq-answer');
                        const icon = question.querySelector('.fa-chevron-down');

                        question.addEventListener('click', function() {
                            const isOpen = answer.classList.contains('open');

                            // Close all other items
                            faqItems.forEach(other => {
                                const otherAnswer = other.querySelector('.faq-answer');
                                const otherIcon = other.querySelector('.fa-chevron-down');
                                if (other !== item && otherAnswer.classList.contains('open')) {
                                    otherAnswer.classList.remove('open');
                                    otherAnswer.style.display = 'none';
                                    other.classList.remove('active');
                                    if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
                                }
                            });

                            // Toggle this item
                            if (isOpen) {
                                answer.classList.remove('open');
                                answer.style.display = 'none';
                                item.classList.remove('active');
                                if (icon) icon.style.transform = 'rotate(0deg)';
                            } else {
                                answer.classList.add('open');
                                answer.style.display = 'block';
                                item.classList.add('active');
                                if (icon) icon.style.transform = 'rotate(180deg)';
                            }
                        });
                    });

                    // ========== FADE UP OBSERVER ==========
                    const fadeElements = document.querySelectorAll('.fade-up');
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('visible');
                            }
                        });
                    }, { threshold: 0.1 });
                    fadeElements.forEach(el => {
                        el.classList.add('fade-up');
                        observer.observe(el);
                    });
                });

                // ========== CTA FORM SUBMISSION ==========
                (function() {
                    document.addEventListener('DOMContentLoaded', function() {
                        const coursesTab = document.getElementById('ctaCoursesTab');
                        const degreeTab = document.getElementById('ctaDegreeTab');
                        const courseOptions = document.getElementById('ctaCourseOptions');
                        const degreeOptions = document.getElementById('ctaDegreeOptions');
                        const courseSelect = document.getElementById('ctaCourseSelect');
                        const degreeSelect = document.getElementById('ctaDegreeSelect');

                        function removeActiveFromTabs() {
                            coursesTab?.classList.remove('active');
                            degreeTab?.classList.remove('active');
                        }

                        function setActiveTab(tab, showElement, hideElement) {
                            removeActiveFromTabs();
                            tab.classList.add('active');
                            showElement.classList.remove('hidden');
                            hideElement.classList.add('hidden');
                        }

                        if (coursesTab && degreeTab) {
                            setActiveTab(coursesTab, courseOptions, degreeOptions);
                            coursesTab.addEventListener('click', (e) => {
                                e.preventDefault();
                                setActiveTab(coursesTab, courseOptions, degreeOptions);
                            });
                            degreeTab.addEventListener('click', (e) => {
                                e.preventDefault();
                                setActiveTab(degreeTab, degreeOptions, courseOptions);
                            });
                        }

                        const ctaForm = document.getElementById('ctaHelpForm');
                        if (ctaForm) {
                            ctaForm.removeEventListener('submit', ctaForm._handler);
                            ctaForm._handler = async function(e) {
                                e.preventDefault();

                                const name = document.getElementById('ctaFullName')?.value.trim() || '';
                                const email = document.getElementById('ctaEmail')?.value.trim() || '';
                                const phone = document.getElementById('ctaPhoneNumber')?.value.trim() || '';
                                const callbackTime = document.getElementById('ctaCallbackTime')?.value || '';
                                const message = document.getElementById('ctaMessage')?.value.trim() || '';

                                const isCourseActive = coursesTab.classList.contains('active');
                                let selectedProgram = '';
                                if (isCourseActive) {
                                    selectedProgram = courseSelect ? courseSelect.value : '';
                                } else {
                                    selectedProgram = degreeSelect ? degreeSelect.value : '';
                                }

                                let errorMsg = '';
                                if (!name) errorMsg = 'Please enter your full name.';
                                else if (!email) errorMsg = 'Please enter your email address.';
                                else if (!phone) errorMsg = 'Please enter your phone number.';
                                else if (!selectedProgram) errorMsg = isCourseActive ? 'Please select a course.' :
                                    'Please select a degree program.';
                                else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errorMsg =
                                    'Please enter a valid email address.';
                                else if (!/^\d{10}$/.test(phone)) errorMsg = 'Phone number must be exactly 10 digits.';

                                if (errorMsg) {
                                    alert(errorMsg);
                                    return;
                                }

                                const payload = { name, email, phoneNumber: phone, course: selectedProgram,
                                    callbackTime, message };

                                const submitBtn = ctaForm.querySelector('button[type="submit"]');
                                const originalText = submitBtn.innerHTML;
                                submitBtn.disabled = true;
                                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

                                try {
                                    const response = await fetch('/submitEnquery', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });
                                    let result;
                                    const contentType = response.headers.get('content-type');
                                    if (contentType && contentType.includes('application/json')) {
                                        result = await response.json();
                                    } else {
                                        const text = await response.text();
                                        result = { error: text || 'Unknown error' };
                                    }
                                    if (response.ok) {
                                        alert('✅ Inquiry sent! You will receive a confirmation email shortly.');
                                        ctaForm.reset();
                                        if (courseSelect) courseSelect.value = '';
                                        if (degreeSelect) degreeSelect.value = '';
                                        document.getElementById('ctaCallbackTime').value = '';
                                        setActiveTab(coursesTab, courseOptions, degreeOptions);
                                    } else {
                                        alert('❌ ' + (result.error || 'Submission failed.'));
                                    }
                                } catch (err) {
                                    console.error(err);
                                    alert('❌ Network error. Please try again.');
                                } finally {
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = originalText;
                                }
                            };
                            ctaForm.addEventListener('submit', ctaForm._handler);
                        }
                    });
                })();
            </script>
</body>
</html>