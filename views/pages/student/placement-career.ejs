    <%- include("../../partials/common/footer") %>

    <script>
        // ========== INQUIRY FORM SUBMISSION ==========
        const inquiryForm = document.getElementById('placementInquiryForm');
        if (inquiryForm) {
            inquiryForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const name = document.getElementById('inquiryName').value.trim();
                const email = document.getElementById('inquiryEmail').value.trim();
                const phone = document.getElementById('inquiryPhone').value.trim();
                const course = document.getElementById('inquiryCourse').value;
                const message = document.getElementById('inquiryMessage').value.trim();

                if (!name || !email || !phone) {
                    alert('Please fill all required fields.');
                    return;
                }

                const payload = { name, email, phoneNumber: phone, course, message, degree: 'Placement Inquiry' };
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();
                    if (response.ok) {
                        alert('✅ Inquiry sent! Our team will contact you shortly.');
                        this.reset();
                        document.getElementById('inquiryModal').style.display = 'none';
                    } else {
                        alert('❌ ' + (result.error || 'Submission failed. Please try again.'));
                    }
                } catch (err) {
                    console.error(err);
                    alert('❌ Something went wrong. Please try again later.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }

        // ========== STICKY CTA SCROLL ==========
        let lastScroll = 0;
        const stickyCta = document.getElementById('stickyCta');
        window.addEventListener('scroll', () => {
            if (!stickyCta) return;
            const currentScroll = window.scrollY;
            if (currentScroll > 400 && currentScroll > lastScroll) stickyCta.classList.remove('hide');
            else if (currentScroll < lastScroll && currentScroll > 300) stickyCta.classList.add('hide');
            if (currentScroll < 300) stickyCta.classList.add('hide');
            lastScroll = currentScroll;
        });
        if (stickyCta) stickyCta.classList.add('hide');

        // ========== MOBILE MENU ==========
        document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.remove('hidden'));
        document.getElementById('closeMenu')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.add('hidden'));

        // ========== ESCAPE TO CLOSE MODAL ==========
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const modal = document.getElementById('inquiryModal');
                if (modal) modal.style.display = 'none';
            }
        });

        // ========== STUDENT CAROUSEL (AUTO-SCROLL) ==========
        (function() {
            const slider = document.getElementById('studentCarousel');
            const dots = document.querySelectorAll('.student-dot');
            const prevBtn = document.getElementById('studentPrev');
            const nextBtn = document.getElementById('studentNext');
            if (!slider || dots.length === 0) return;
            let currentIndex = 0;
            let interval;
            const slideCount = dots.length;
            const autoSlideInterval = 4000;

            function updateSlider(index) {
                const slideWidth = slider.parentElement.clientWidth;
                slider.style.transform = `translateX(-${index * slideWidth}px)`;
                dots.forEach((dot, i) => {
                    if (i === index) {
                        dot.classList.add('bg-pink-600');
                        dot.classList.remove('bg-gray-300');
                    } else {
                        dot.classList.add('bg-gray-300');
                        dot.classList.remove('bg-pink-600');
                    }
                });
                currentIndex = index;
            }

            function nextSlide() {
                let newIndex = currentIndex + 1;
                if (newIndex >= slideCount) newIndex = 0;
                updateSlider(newIndex);
            }

            function prevSlide() {
                let newIndex = currentIndex - 1;
                if (newIndex < 0) newIndex = slideCount - 1;
                updateSlider(newIndex);
            }

            function startAutoSlide() {
                if (interval) clearInterval(interval);
                interval = setInterval(nextSlide, autoSlideInterval);
            }

            function stopAutoSlide() {
                if (interval) clearInterval(interval);
            }

            if (prevBtn) prevBtn.addEventListener('click', () => { stopAutoSlide(); prevSlide(); startAutoSlide(); });
            if (nextBtn) nextBtn.addEventListener('click', () => { stopAutoSlide(); nextSlide(); startAutoSlide(); });

            dots.forEach(dot => {
                dot.addEventListener('click', function() {
                    const index = parseInt(this.getAttribute('data-index'));
                    if (!isNaN(index)) {
                        stopAutoSlide();
                        updateSlider(index);
                        startAutoSlide();
                    }
                });
            });

            const container = slider.closest('.relative');
            if (container) {
                container.addEventListener('mouseenter', stopAutoSlide);
                container.addEventListener('mouseleave', startAutoSlide);
            }

            window.addEventListener('resize', () => updateSlider(currentIndex));
            updateSlider(0);
            startAutoSlide();
        })();

        // ========== TESTIMONIAL CAROUSEL (AUTO-SCROLL) ==========
        (function() {
            const slider = document.getElementById('testimonialCarousel');
            const dots = document.querySelectorAll('.testimonial-dot');
            const prevBtn = document.getElementById('testimonialPrev');
            const nextBtn = document.getElementById('testimonialNext');
            if (!slider || dots.length === 0) return;
            let currentIndex = 0;
            let interval;
            const slideCount = dots.length;
            const autoSlideInterval = 5000;

            function updateSlider(index) {
                const slideWidth = slider.parentElement.clientWidth;
                slider.style.transform = `translateX(-${index * slideWidth}px)`;
                dots.forEach((dot, i) => {
                    if (i === index) {
                        dot.classList.add('bg-pink-600');
                        dot.classList.remove('bg-gray-300');
                    } else {
                        dot.classList.add('bg-gray-300');
                        dot.classList.remove('bg-pink-600');
                    }
                });
                currentIndex = index;
            }

            function nextSlide() {
                let newIndex = currentIndex + 1;
                if (newIndex >= slideCount) newIndex = 0;
                updateSlider(newIndex);
            }

            function prevSlide() {
                let newIndex = currentIndex - 1;
                if (newIndex < 0) newIndex = slideCount - 1;
                updateSlider(newIndex);
            }

            function startAutoSlide() {
                if (interval) clearInterval(interval);
                interval = setInterval(nextSlide, autoSlideInterval);
            }

            function stopAutoSlide() {
                if (interval) clearInterval(interval);
            }

            if (prevBtn) prevBtn.addEventListener('click', () => { stopAutoSlide(); prevSlide(); startAutoSlide(); });
            if (nextBtn) nextBtn.addEventListener('click', () => { stopAutoSlide(); nextSlide(); startAutoSlide(); });

            dots.forEach(dot => {
                dot.addEventListener('click', function() {
                    const index = parseInt(this.getAttribute('data-index'));
                    if (!isNaN(index)) {
                        stopAutoSlide();
                        updateSlider(index);
                        startAutoSlide();
                    }
                });
            });

            const container = slider.closest('.relative');
            if (container) {
                container.addEventListener('mouseenter', stopAutoSlide);
                container.addEventListener('mouseleave', startAutoSlide);
            }

            window.addEventListener('resize', () => updateSlider(currentIndex));
            updateSlider(0);
            startAutoSlide();
        })();

        // ========== FAQ ACCORDION (FIXED) ==========
        document.addEventListener('DOMContentLoaded', function() {
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const question = item.querySelector('.faq-question');
                const answer = item.querySelector('.faq-answer');
                const icon = question.querySelector('.fa-chevron-down');
                
                question.addEventListener('click', function() {
                    const isOpen = answer.classList.contains('open');
                    
                    // Close all other items
                    faqItems.forEach(other => {
                        const otherAnswer = other.querySelector('.faq-answer');
                        const otherIcon = other.querySelector('.fa-chevron-down');
                        if (otherAnswer !== answer && otherAnswer.classList.contains('open')) {
                            otherAnswer.classList.remove('open');
                            otherAnswer.style.display = 'none';
                            if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
                        }
                    });
                    
                    // Toggle current
                    if (isOpen) {
                        answer.classList.remove('open');
                        answer.style.display = 'none';
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    } else {
                        answer.classList.add('open');
                        answer.style.display = 'block';
                        if (icon) icon.style.transform = 'rotate(180deg)';
                    }
                });
            });
        });

        // ========== FADE UP OBSERVER ==========
        const fadeElements = document.querySelectorAll('.fade-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });
        fadeElements.forEach(el => {
            el.classList.add('fade-up');
            observer.observe(el);
        });
    </script>
</body>
</html>