    <!-- Sticky CTA -->
    <div id="stickyCta" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl p-3 transform translate-y-full transition-transform duration-300 z-40 sticky-cta">
        <div class="container mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
            <span class="font-extrabold text-gray-800 text-sm">Placement & Career</span>
            <button onclick="document.getElementById('inquiryModal').style.display='flex'" class="bg-pink-600 hover:bg-pink-700 text-white px-6 py-1.5 rounded-full font-extrabold text-sm shadow-lg transition-all">Request Info <i class="fa-solid fa-arrow-right ml-1"></i></button>
        </div>
