    <script>
        // ========== SYLLABUS RENDER – CLASSROOM STYLE ==========
        const courseFromServer = <%- JSON.stringify(course) %>;

        function renderSyllabus() {
            const container = document.getElementById('courseContent');
            if (!container) return;
            const html = courseFromServer.syllabus.map((module, idx) => {
                const lecturesHtml = module.lectures.map(lecture => `
                    <div class="flex items-center gap-3 p-3 border-b border-gray-50 last:border-0">
                        <i class="fa-regular fa-calendar-check text-amber-500 w-5"></i>
                        <span class="flex-1 text-gray-800 font-medium">${escapeHtml(lecture.lectureTitle)}</span>
                       
                    </div>
                `).join('');
                return `
                    <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
                        <div class="section-header flex justify-between items-center p-4 bg-gray-50 hover:bg-amber-50 transition-colors" data-section="${idx}">
                            <div class="flex items-center gap-3">
                                <i class="fa-regular fa-folder-open text-amber-500"></i>
                                <span class="font-extrabold text-gray-800">${escapeHtml(module.moduleTitle)}</span>
                            </div>
                            <div class="flex items-center gap-2">
                              
                                <i class="fa-solid fa-chevron-down text-gray-400 text-xs transition-transform duration-300"></i>
                            </div>
                        </div>
                        <div class="lecture-list hidden bg-white">
                            ${lecturesHtml}
                        </div>
                    </div>
                `;
            }).join('') + `
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
                    <i class="fa-regular fa-calendar-check text-amber-600 mr-2"></i>
                    <span class="text-amber-700 text-sm font-bold">All sessions are delivered in‑person on campus.</span>
                </div>
                <div class="text-center mt-4">
                    <button class="text-amber-600 text-sm font-extrabold hover:underline expand-all-btn transition-all duration-300">
                        <i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections
                    </button>
                </div>
            `;
            container.innerHTML = html;

            document.querySelectorAll('.section-header').forEach(header => {
                header.addEventListener('click', function() {
                    const list = this.nextElementSibling;
                    const icon = this.querySelector('.fa-chevron-down');
                    list.classList.toggle('hidden');
                    if (icon) icon.style.transform = list.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            });

            let expanded = false;
            const expandBtn = document.querySelector('.expand-all-btn');
            if (expandBtn) {
                expandBtn.addEventListener('click', function() {
                    const allLists = document.querySelectorAll('.lecture-list');
                    const allIcons = document.querySelectorAll('.fa-chevron-down');
                    if (expanded) {
                        allLists.forEach(l => l.classList.add('hidden'));
                        allIcons.forEach(i => i.style.transform = 'rotate(0deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Expand all sections';
                    } else {
                        allLists.forEach(l => l.classList.remove('hidden'));
                        allIcons.forEach(i => i.style.transform = 'rotate(180deg)');
                        this.innerHTML = '<i class="fa-regular fa-rectangle-list mr-1"></i> Collapse all sections';
                    }
                    expanded = !expanded;
                });
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
        }

        // ========== INQUIRY FORM SUBMISSION ==========
        const inquiryForm = document.getElementById('classroomInquiryForm');
        if (inquiryForm) {
            inquiryForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const name = document.getElementById('inquiryName').value.trim();
                const email = document.getElementById('inquiryEmail').value.trim();
                const phone = document.getElementById('inquiryPhone').value.trim();
                const batch = document.getElementById('inquiryBatch').value;
                const message = document.getElementById('inquiryMessage').value.trim();

                if (!name || !email || !phone) {
                    alert('Please fill all required fields.');
                    return;
                }

                const payload = {
                    name,
                    email,
                    phoneNumber: phone,
                    course: '<%= course.courseName %> (Classroom)',
                    message: `Preferred batch: ${batch}\n${message}`,
                    degree: 'Classroom Program'
                };

                const submitBtn = inquiryForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();
                    if (response.ok) {
                        alert('✅ Inquiry sent! Our team will contact you shortly.');
                        inquiryForm.reset();
                        document.getElementById('inquiryModal').style.display = 'none';
                    } else {
                        alert('❌ ' + (result.error || 'Submission failed. Please try again.'));
                    }
                } catch (err) {
                    console.error(err);
                    alert('❌ Something went wrong. Please try again later.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }

        // ========== STICKY CTA SCROLL ==========
        let lastScroll = 0;
        const stickyCta = document.getElementById('stickyCta');
        window.addEventListener('scroll', () => {
            if (!stickyCta) return;
            const currentScroll = window.scrollY;
            if (currentScroll > 400 && currentScroll > lastScroll) stickyCta.classList.remove('hide');
            else if (currentScroll < lastScroll && currentScroll > 300) stickyCta.classList.add('hide');
            if (currentScroll < 300) stickyCta.classList.add('hide');
            lastScroll = currentScroll;
        });
        if (stickyCta) stickyCta.classList.add('hide');

        // ========== MOBILE MENU ==========
        document.getElementById('menuBtn')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.remove('hidden'));
        document.getElementById('closeMenu')?.addEventListener('click', () => document.getElementById('mobileMenu').classList.add('hidden'));

        // ========== ESCAPE TO CLOSE MODAL ==========
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                const modal = document.getElementById('inquiryModal');
                if (modal) modal.style.display = 'none';
            }
        });

        // ========== RENDER ==========
        renderSyllabus();

        // ========== FADE UP OBSERVER ==========
        const fadeElements = document.querySelectorAll('.fade-up');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });
        fadeElements.forEach(el => {
            el.classList.add('fade-up');
            observer.observe(el);
        });
    </script>
</body>
</html>