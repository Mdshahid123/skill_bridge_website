                            <div id="heroCourseOptions">
                                <select id="heroCourseSelect" class="w-full px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all bg-gray-50 focus:bg-white">
                                    <option value="">Select a course</option>
                                    <option>Web Development</option>
                                    <option>Data Science & AI</option>
                                    <option>Cloud & DevOps</option>
                                    <option>DSA</option>
                                    <option>Cybersecurity</option>
                                </select>
                            </div>
                            
                            <!-- Degree Options (Hidden by default) -->
                            <div id="heroDegreeOptions" class="hidden">
                                <select id="heroDegreeSelect" class="w-full px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all bg-gray-50 focus:bg-white">
                                    <option value="">Select a degree</option>
                                    <option>B.Tech in CS</option>
                                    <option>BCA</option>
                                    <option>MCA</option>
                                    <option>M.Sc in AI</option>
                                </select>
                            </div>
                            
                            <div>
                                <textarea id="heroMessage" rows="1" class="w-full px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all bg-gray-50 focus:bg-white resize-none" placeholder="Your message..."></textarea>
                            </div>
                            
                            <button type="submit" class="w-full bg-gradient-to-r from-teal-500 to-blue-600 hover:from-teal-600 hover:to-blue-700 text-white py-1.5 rounded-lg font-semibold text-sm transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2 group">
                                Submit Inquiry
                                <i class="fa-solid fa-paper-plane text-[10px] group-hover:translate-x-1 transition-transform"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Hero Tab Styles */
    .hero-tab {
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }
    
    .hero-tab.active {
        color: #0f5c6e;
        font-weight: 700;
    }
    
    .hero-tab.active span {
        transform: scaleX(1);
    }
    
    .hero-tab span {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #14b8a6, #3b82f6);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }
    
    .hero-tab.active span {
        transform: scaleX(1);
    }
    
    /* Form Input Focus Effect */
    input:focus, select:focus, textarea:focus {
        outline: none;
    }
    
    /* Glow text */
    .glow-text {
        text-shadow: 0 0 20px rgba(26,111,140,0.2);
    }
</style>

<script>
    // Tab Switching Logic for Hero Form
    (function() {
        const coursesTab = document.getElementById('heroCoursesTab');
        const degreeTab = document.getElementById('heroDegreeTab');
        const courseOptions = document.getElementById('heroCourseOptions');
        const degreeOptions = document.getElementById('heroDegreeOptions');
        
        if (coursesTab && degreeTab) {
            coursesTab.addEventListener('click', function() {
                coursesTab.classList.add('active');
                degreeTab.classList.remove('active');
                courseOptions.classList.remove('hidden');
                degreeOptions.classList.add('hidden');
            });
            
            degreeTab.addEventListener('click', function() {
                degreeTab.classList.add('active');
                coursesTab.classList.remove('active');
                degreeOptions.classList.remove('hidden');
                courseOptions.classList.add('hidden');
            });
        }
        
        // Form Submission
        const heroForm = document.getElementById('heroContactForm');
        if (heroForm) {
            heroForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const isCourseInquiry = !courseOptions.classList.contains('hidden');
                const inquiryType = isCourseInquiry ? 'Courses' : 'Online Degree Program';
                alert(`✅ Thank you for your ${inquiryType} inquiry! Our counselor will contact you soon.`);
                heroForm.reset();
            });
        }
    })();
</script>
