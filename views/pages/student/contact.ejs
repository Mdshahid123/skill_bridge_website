  <!-- Contact Hero Section - Balanced Height -->
<section class="hero-glow pt-16 pb-10 relative overflow-hidden">
    <!-- Brand Grid Pattern Layers -->
    <div class="absolute inset-0 opacity-[0.08] brand-grid"></div>
    <div class="absolute inset-0 opacity-[0.05] brand-grid-light"></div>
    
    <!-- Diagonal grid pattern for extra depth -->
    <div class="absolute inset-0 opacity-[0.04]"
        style="background-image: 
            repeating-linear-gradient(45deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px),
            repeating-linear-gradient(135deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px);">
    </div>
    
    <!-- Glowing orbs -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-teal-400/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-56 h-56 bg-blue-400/20 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <div class="breadcrumb text-sm mb-3 mt-4">
            <a href="/" class="text-teal-700/70 hover:text-teal-700">Home</a>
            <span class="text-teal-700/40 mx-2">/</span>
            <span class="text-teal-800 font-medium">Contact Us</span>
        </div>
        
        <div class="flex flex-col lg:flex-row gap-6 items-center">
            <!-- Left Side - Text Content -->
            <div class="flex-1 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/50 backdrop-blur-sm border border-teal-200 mb-2">
                    <i class="fa-solid fa-headset text-teal-500 text-xs"></i>
                    <span class="text-teal-600 text-[11px] font-semibold tracking-wide">24/7 Support Available</span>
                </div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-2 glow-text">Get in Touch</h1>
                <p class="text-gray-600 text-sm max-w-md mx-auto lg:mx-0">Have questions about our courses or degree programs? Our team is here to help.</p>
            </div>
            
            <!-- Right Side - Compact Inquiry Form Card -->
            <div class="flex-1 max-w-sm w-full">
                <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-100">
                    <!-- Compact Form Header -->
                    <div class="bg-gradient-to-r from-teal-600 to-blue-600 px-4 py-2.5">
                        <h3 class="text-white font-bold text-base flex items-center gap-2">
                            <i class="fa-regular fa-pen-to-square text-sm"></i>
                            Quick Inquiry
                        </h3>
                        <p class="text-white/75 text-[11px] mt-0.5">Fill the form - we'll respond within 24 hours</p>
                    </div>
                    
                    <!-- Compact Tabs -->
                    <div class="flex border-b border-gray-200">
                        <button id="heroCoursesTab" class="hero-tab active flex-1 py-1.5 text-center font-semibold text-[11px] transition-all duration-300 relative">
                            <i class="fa-solid fa-laptop-code mr-1 text-[10px]"></i> Courses
