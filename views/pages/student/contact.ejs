    <!-- FAQ Section – Collapsible Questions & Answers -->
    <section class="py-20 px-6 md:px-12 bg-gray-50">
        <div class="container mx-auto max-w-6xl">
            <div class="text-center mb-12 animate-fade-in-up">
                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Frequently Asked <span class="bg-gradient-to-r from-cyan-600 to-blue-600 bg-clip-text text-transparent">Questions</span></h2>
                <div class="w-20 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full mx-auto mt-4"></div>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
                <!-- FAQ 1 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #0a2b3e 0%, #1a6f8c 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-question text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">How can I enroll in a course?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">You can enroll directly through our website by clicking the "Enroll Now" button on any course page, or visit our center for offline enrollment. Our counselors will guide you through the process.</p></div>
                </div>
                <!-- FAQ 2 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #1a6f8c 0%, #0066b3 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-briefcase text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">Do you offer placement assistance?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">Yes, we have a dedicated placement cell that helps students prepare for interviews, build resumes, and get placed in top companies. Our placement rate is over 90%.</p></div>
                </div>
                <!-- FAQ 3 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #0a2b3e 0%, #1a6f8c 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-globe text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">Are the courses online or offline?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">We offer both online and offline learning options with flexible schedules. You can choose what suits you best – live online classes, recorded sessions, or classroom training.</p></div>
                </div>
                <!-- FAQ 4 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #1a6f8c 0%, #0066b3 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-certificate text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">Do you provide certificates?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">Yes, upon successful course completion, you will receive an industry-recognized certificate that you can share on LinkedIn and with employers.</p></div>
                </div>
                <!-- FAQ 5 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #0a2b3e 0%, #1a6f8c 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-clock text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">What is the course duration?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">Course durations vary: short-term certification courses run 3–6 months, while full-stack programs take 6–12 months. Degree programs are 3–4 years.</p></div>
                </div>
                <!-- FAQ 6 -->
                <div class="faq-card rounded-xl p-6 shadow-lg transition-all duration-300" style="background: linear-gradient(135deg, #1a6f8c 0%, #0066b3 100%);">
                    <div class="faq-question flex items-start justify-between gap-4">
                        <div class="flex items-start gap-4"><div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-university text-white text-lg"></i></div><h3 class="font-bold text-white text-lg">Are the degree programs UGC recognized?</h3></div>
                        <i class="fa-solid fa-chevron-down text-white/60 transition-transform duration-300"></i>
                    </div>
                    <div class="faq-answer"><p class="text-white/75 text-sm">Yes, our online degree programs are offered in collaboration with UGC-recognized partner universities, ensuring your degree is valid for government jobs and higher studies.</p></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Full Width Map – Shows exact location, click to open in Google Maps -->
    <section class="py-16 px-6 md:px-12 bg-white">
        <div class="container mx-auto max-w-7xl">
            <div class="text-center mb-10">
                <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-2">Our Location</h2>
            </div>
            <div class="bg-white rounded-2xl overflow-hidden shadow-xl border border-gray-100">
                <div id="mapContainer" class="relative cursor-pointer group">
                    <div class="h-96 md:h-[450px] w-full">
                        <!-- Embedded map already showing the institute's address (no manual search needed) -->
                         <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7003.9035308636985!2d77.2788865!3d28.631207699999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390ce30651f90e91%3A0x483ad3c612be0602!2sSkillBridge!5e0!3m2!1sen!2sin!4v1780729035277!5m2!1sen!2sin" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section – Ready to Start Your Journey -->
    <section class="py-20 px-6 md:px-12">
        <div class="container mx-auto max-w-5xl">
            <div class="help-split-card rounded-2xl overflow-hidden shadow-xl">
                <div class="flex flex-col md:flex-row">
                    <div class="person-illustration w-full md:w-5/12 p-6 md:p-8 flex flex-col items-center justify-center" style="background: linear-gradient(135deg, #e6f4f5, #d4eef2);">
                        <div class="relative inline-block">
                            <img src="https://pwskills.com/images/accountImage/leadform/man.webp" alt="Need help" class="w-full max-w-[260px] h-auto object-contain" />
                            <div class="absolute -top-8 -right-3 bg-white/80 backdrop-blur-sm p-1.5 rounded-full shadow-sm float-question"><span class="question-mark-big">?</span></div>
                            <div class="absolute -top-5 -left-5 bg-white/80 backdrop-blur-sm p-1 rounded-full shadow-sm float-question" style="animation-delay: 0.7s;"><span class="question-mark-small">?</span></div>
                        </div>
                        <div class="mt-4 text-center">
                            <h3 class="text-lg font-semibold text-gray-800">Ready to Start? <span class="text-teal-500">Join Us</span></h3>
                            <p class="text-sm text-gray-500">Transform your career with Skill Bridge's industry-ready courses.</p>
                        </div>
                    </div>
                    <div class="w-full md:w-7/12 p-6 md:p-8 bg-white">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4">Ready to <span class="text-teal-500">Start Your Journey?</span></h2>
                        <p class="text-gray-600 mb-5">Join thousands of successful students who transformed their careers with Skill Bridge.</p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="/courses" class="flex-1 btn-primary-custom text-white py-3 rounded-xl font-semibold text-center flex items-center justify-center gap-2 transition hover:scale-105">Browse Courses <i class="fa-solid fa-arrow-right"></i></a>
                            <button id="scrollToEnquiryBtn" class="flex-1 border-2 border-teal-500 text-teal-600 py-3 rounded-xl font-semibold text-center flex items-center justify-center gap-2 hover:bg-teal-500 hover:text-white transition-all">
                                <i class="fa-regular fa-pen-to-square"></i> Submit Enquiry
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <%- include("../../partials/common/footer") %>

    <script>
        // Helper: Show message inside hero section
        function showFormMessage(message, isError = false) {
            const msgDiv = document.getElementById('heroFormMessage');
            if (!msgDiv) return;
            msgDiv.textContent = message;
            msgDiv.className = `mx-3 mt-3 rounded-lg p-2 text-xs ${isError ? 'bg-red-100 text-red-700 border border-red-200' : 'bg-green-100 text-green-700 border border-green-200'}`;
            msgDiv.classList.remove('hidden');
            setTimeout(() => { if (msgDiv) msgDiv.classList.add('hidden'); }, 5000);
        }

        // Hero form submission
        const heroForm = document.getElementById('heroContactForm');
        if (heroForm) {
            heroForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const isCourseTab = document.getElementById('heroCoursesTab').classList.contains('active');
                let courseValue = '';
                if (isCourseTab) {
                    courseValue = document.getElementById('heroCourseSelect').value;
                } else {
                    courseValue = document.getElementById('heroDegreeSelect').value;
                }
                const name = document.getElementById('heroFullName').value.trim();
                const email = document.getElementById('heroEmail').value.trim();
                const phone = document.getElementById('heroPhone').value.trim();
                const callbackTime = document.getElementById('heroCallbackTime').value;
                const message = document.getElementById('heroMessage').value.trim();
                
                if (!name || !email || !phone || !courseValue) {
                    showFormMessage('❌ All required fields (Name, Email, Phone, Course/Degree) must be filled.', true);
                    return;
                }
                if (!/^\d{10}$/.test(phone)) {
                    showFormMessage('❌ Phone number must be exactly 10 digits (numbers only).', true);
                    return;
                }
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    showFormMessage('❌ Invalid email format.', true);
                    return;
                }
                const payload = {
                    name, email, phoneNumber: phone, course: courseValue,
                    message: message || '', degree: '', callbackTime: callbackTime || ''
                };
                const submitBtn = heroForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Submission failed');
                    showFormMessage(data.message || '✅ Your inquiry has been received. We will contact you soon!', false);
                    heroForm.reset();
                    document.getElementById('heroCourseSelect').value = '';
                    document.getElementById('heroDegreeSelect').value = '';
                    document.getElementById('heroCallbackTime').value = '';
                    document.getElementById('heroCoursesTab').click();
                } catch (err) {
                    showFormMessage(err.message || '❌ Something went wrong. Please try again later.', true);
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }
        
        // Tab switching
        const coursesTab = document.getElementById('heroCoursesTab');
        const degreeTab = document.getElementById('heroDegreeTab');
        const courseOptionsDiv = document.getElementById('heroCourseOptions');
        const degreeOptionsDiv = document.getElementById('heroDegreeOptions');
        if (coursesTab && degreeTab) {
            coursesTab.addEventListener('click', () => {
                coursesTab.classList.add('active');
                degreeTab.classList.remove('active');
                courseOptionsDiv.classList.remove('hidden');
                degreeOptionsDiv.classList.add('hidden');
            });
            degreeTab.addEventListener('click', () => {
                degreeTab.classList.add('active');
                coursesTab.classList.remove('active');
                degreeOptionsDiv.classList.remove('hidden');
                courseOptionsDiv.classList.add('hidden');
            });
        }
        
        // Scroll to enquiry form
        const scrollBtn = document.getElementById('scrollToEnquiryBtn');
        if (scrollBtn) {
            scrollBtn.addEventListener('click', () => {
                document.getElementById('hero-contact').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        }
        
        // FAQ collapsible
        document.querySelectorAll('.faq-card').forEach(card => {
            const qDiv = card.querySelector('.faq-question');
            const aDiv = card.querySelector('.faq-answer');
            const chevron = card.querySelector('.fa-chevron-down');
            if (qDiv && aDiv) {
                aDiv.classList.remove('open');
                qDiv.addEventListener('click', () => {
                    document.querySelectorAll('.faq-answer').forEach(ans => {
                        if (ans !== aDiv) {
                            ans.classList.remove('open');
                            ans.parentElement?.querySelector('.fa-chevron-down')?.classList.remove('rotate-180');
                        }
                    });
                    aDiv.classList.toggle('open');
                    if (chevron) chevron.style.transform = aDiv.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
                });
            }
        });
        
        // ========== MAP CLICK: OPENS GOOGLE MAPS WITH THE ADDRESS (NO MANUAL SEARCH) ==========
        const mapContainer = document.getElementById('mapContainer');
        if (mapContainer) {
            const address = "First Floor, U-197, Vikas Marg, Laxmi Nagar, Shakarpur Extension, Shakarpur, Delhi, 110092";
            const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
            mapContainer.addEventListener('click', () => {
                window.open(mapsUrl, '_blank');
            });
        }
        
        // Mobile menu (keep if your navbar doesn't already handle it)
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const closeMenu = document.getElementById('closeMenu');
        if (menuBtn && mobileMenu && closeMenu) {
            menuBtn.addEventListener('click', () => mobileMenu.classList.remove('hidden'));
            closeMenu.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        }
    </script>
</body>
</html>
