        .hero-tab { cursor: pointer; position: relative; transition: all 0.3s ease; }
        .hero-tab.active { color: #0f5c6e; font-weight: 700; }
        .hero-tab span { position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, #14b8a6, #3b82f6); transform: scaleX(0); transition: transform 0.3s ease; }
        .hero-tab.active span { transform: scaleX(1); }
        .question-mark-big { font-size: 4rem; font-weight: 700; background: linear-gradient(145deg, #0a2b3e, #1a6f8c); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .question-mark-small { font-size: 2.5rem; font-weight: 700; background: linear-gradient(145deg, #1a6f8c, #5ba3bc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .help-split-card { background: white; border-radius: 2rem; transition: box-shadow 0.2s; }
        .help-split-card:hover { box-shadow: 0 28px 48px -12px rgba(26,111,140,0.2); }
        .form-message { transition: all 0.3s ease; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
        .glow-text { text-shadow: 0 0 20px rgba(26,111,140,0.3); }
        @keyframes ping-slow { 0% { transform: scale(1); opacity: 0.5; } 75%, 100% { transform: scale(1.3); opacity: 0; } }
        .animate-ping-slow { animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite; }
        .float-question { animation: floatQuestion 4s ease-in-out infinite; }
        @keyframes floatQuestion { 0%, 100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-8px) rotate(4deg); } }
        
