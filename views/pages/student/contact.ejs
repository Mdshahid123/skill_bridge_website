        body { font-family: 'Inter', sans-serif; background: #f8fafc; }
        .btn-primary-custom { background: linear-gradient(135deg, #0a2b3e, #1a6f8c); transition: all 0.2s; color: white; }
        .btn-primary-custom:hover { background: linear-gradient(135deg, #0a2b3e, #0066b3); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(26,111,140,0.3); }
        .hero-glow { background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%); position: relative; overflow: hidden; }
        .hero-glow::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(26,111,140,0.12) 0%, rgba(0,102,179,0.06) 50%, transparent 70%); animation: rotateGlow 20s linear infinite; }
        @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .brand-grid { background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px), repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px); background-size: 50px 50px; }
        .brand-grid-light { background-image: repeating-linear-gradient(90deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px), repeating-linear-gradient(0deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px); }
