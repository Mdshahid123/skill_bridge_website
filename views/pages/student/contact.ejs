                        <form id="heroContactForm" class="space-y-2">
                            <div>
                                <input type="text" id="heroFullName" placeholder="Full Name" required class="w-full px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all bg-gray-50 focus:bg-white">
                            </div>
                            
                            <div>
