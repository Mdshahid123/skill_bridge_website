                        </button>
                        <button id="heroDegreeTab" class="hero-tab flex-1 py-1.5 text-center font-semibold text-[11px] text-gray-500 hover:text-gray-700 transition-all duration-300 relative">
                            <i class="fa-solid fa-graduation-cap mr-1 text-[10px]"></i> Online Degree
