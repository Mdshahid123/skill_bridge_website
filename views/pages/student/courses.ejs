<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>All Courses – SkillBridge | IT & Tech Training</title>
    <meta name="description" content="Explore 30+ industry‑relevant courses: Web Development, Data Science, Digital Marketing, Cloud Computing, DSA, and more. Enroll now for placement assistance.">
    <meta name="keywords" content="IT courses, tech training, web development course, data science course, digital marketing course, placement assistance">
    <meta name="author" content="Skill Bridge">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.skillbridge.com/courses">
    <meta property="og:title" content="Skill Bridge Courses – Learn from Industry Experts">
    <meta property="og:description" content="Browse all our courses – from beginner to advanced. Get certified and job‑ready.">
    <meta property="og:image" content="https://www.skillbridge.com/og-courses.jpg">
    <meta property="og:url" content="https://www.skillbridge.com/courses">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Skill Bridge Course Catalog">
    <meta name="twitter:description" content="Join thousands of students learning high‑demand tech skills.">

    <!-- Schema.org – ItemList (courses) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Skill Bridge Courses",
      "url": "https://www.skillbridge.com/courses",
      "numberOfItems": 30
    }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        /* ========== GLOBAL RESET ========== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100%;
            background: #f8fafc;
            scroll-behavior: smooth;
        }
        body {
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            color: #1e293b;
        }

        /* ========== HERO SECTION ========== */
        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            top: -30%;
            left: -30%;
            width: 160%;
            height: 160%;
            background: radial-gradient(circle, rgba(6,182,212,0.12), transparent 70%);
            animation: slowPulse 15s infinite alternate;
            pointer-events: none;
        }
        @keyframes slowPulse {
            0% { opacity: 0.3; transform: scale(1);}
            100% { opacity: 0.8; transform: scale(1.08);}
        }
        .brand-grid {
            background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px),
                              repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px);
            background-size: 60px 60px;
        }
        .glow-text {
            text-shadow: 0 4px 20px rgba(6,182,212,0.2);
            letter-spacing: -0.01em;
        }

        /* ========== COURSE CARD ========== */
        .course-card {
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 8px 20px -8px rgba(0,0,0,0.06);
        }
        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 30px -12px rgba(0,0,0,0.12);
            border-color: rgba(6,182,212,0.3);
        }

        /* Feature badges */
        .feature-badge {
            background: #f0f9ff;
            color: #0c4e6e;
            padding: 4px 10px;
            font-weight: 600;
            border-radius: 40px;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* Dropdown */
        .category-option {
            font-weight: 500;
            transition: all 0.2s;
        }
        .category-option:hover {
            background: #e2f0f5;
            transform: translateX(4px);
        }

        /* ========== MODAL STYLES ========== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .course-modal {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            max-width: 90%;
            width: 500px;
            position: relative;
            box-shadow: 0 25px 40px -12px rgba(0,0,0,0.3);
            animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            cursor: pointer;
            font-size: 1.5rem;
            color: #6b7280;
            transition: color 0.2s;
        }
        .modal-close:hover {
            color: #1f2937;
        }

        /* Filter tags animation */
        .filter-tag {
            animation: tagPop 0.2s ease-out;
        }
        @keyframes tagPop {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        /* Reduced hero and card heights */
        .hero-reduced {
            padding-top: 5rem; /* was pt-28 (7rem) */
            padding-bottom: 3rem; /* was pb-16 (4rem) */
        }
        .card-image {
            height: 180px; /* was h-52 (208px) */
        }
        .card-padding {
            padding: 1.25rem; /* was p-6 (1.5rem) */
        }
        @media (max-width: 640px) {
            .container { padding-left: 1rem; padding-right: 1rem; }
            #categoryDropdownMenu { width: calc(100vw - 2rem); max-width: 320px; left: 1rem; right: 1rem; }
            .course-modal { width: 90%; padding: 1.25rem; }
            .hero-reduced {
                padding-top: 4rem;
                padding-bottom: 2rem;
            }
            .card-image {
                height: 160px;
            }
        }
    </style>
</head>
<body>

<!-- nav bar (included via EJS) -->
<%- include("../../partials/common/navbar.ejs") %>

<!-- Hero Section (reduced height) -->
<div class="hero-glow hero-reduced relative">
    <div class="absolute inset-0 opacity-[0.04] brand-grid pointer-events-none"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-cyan-400/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-6 relative z-20">
        <div class="breadcrumb text-sm mb-3">
            <a href="/" class="text-teal-700/80 hover:text-teal-900">Home</a>
            <span class="text-gray-500 mx-2">/</span>
            <span class="text-gray-800 font-semibold">Courses</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 text-center mb-3 glow-text tracking-tight">All Premium Courses</h1>
       <br>
        
        <div class="max-w-4xl mx-auto mb-5">
            <div class="flex flex-col sm:flex-row gap-3 items-center justify-center">
                <div class="relative flex-1 max-w-md">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 text-sm"></i>
                    <input type="text" id="courseSearchInput" placeholder="Search courses by name, category, or skill..." class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-200 bg-white/90 shadow-sm focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 text-gray-800 font-medium">
                </div>
                
                <div class="relative" style="z-index: 100;">
                    <button id="categoryDropdownBtn" class="flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-gray-200 text-gray-800 font-semibold shadow-sm hover:border-cyan-500 hover:text-cyan-700 transition-all">
                        <i class="fa-solid fa-filter text-cyan-600"></i>
                        <span id="selectedCategoryText">All Categories</span>
                        <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"></i>
                    </button>
                </div>
                
                <button id="resetFiltersBtn" class="px-5 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold transition-all flex items-center gap-2 shadow-sm"><i class="fa-solid fa-rotate-right text-sm"></i> Reset</button>
            </div>
            <div id="activeFiltersContainer" class="flex flex-wrap gap-2 justify-center mt-3 min-h-[30px]"></div>
        </div>
        <p class="text-gray-700 text-center font-medium" id="resultsCount">Showing 0 courses</p>
    </div>
</div>

<!-- Courses Grid Section – 3 cards per row (reduced card size) -->
<section class="py-12 px-6 md:px-12 bg-transparent">
    <div class="container mx-auto max-w-7xl px-2 md:px-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="coursesGridContainer">
            <!-- Courses will be dynamically loaded -->
        </div>
        <div id="noResultsMessage" class="text-center py-12 hidden">
            <i class="fa-regular fa-folder-open text-6xl text-gray-400 mb-4"></i>
            <h3 class="text-2xl font-bold text-gray-800 mb-2">No courses found</h3>
            <p class="text-gray-600">Try adjusting your search or filter criteria</p>
            <button id="clearAllFiltersBtn" class="mt-4 px-6 py-2.5 bg-cyan-600 text-white rounded-xl text-sm font-bold hover:bg-cyan-700 transition-all shadow-md">Clear all filters</button>
        </div>
    </div>
</section>

<!-- Enrollment Modal (unchanged) -->
<div id="enrollModal" class="modal-overlay">
    <div class="course-modal">
        <div class="modal-close" id="closeEnrollModal">&times;</div>
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-cyan-700 to-blue-800 flex items-center justify-center mx-auto mb-4 shadow-lg">
                <i class="fa-solid fa-graduation-cap text-white text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Start Your Journey</h2>
            <p class="text-gray-600 text-sm mt-1">Fill the form to get a free counseling session</p>
        </div>
        <form id="enrollmentForm" class="space-y-4">
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Full Name *</label>
                <input type="text" id="fullName" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 font-medium" placeholder="Enter your full name">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email Address *</label>
                <input type="email" id="email" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:border-cyan-500" placeholder="you@example.com">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Phone Number *</label>
                <input type="tel" id="phone" required class="w-full px-4 py-2.5 border border-gray-200 rounded-xl" placeholder="+91 98765 43210">
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Interested Course</label>
                <select id="courseSelect" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl">
                    <option value="">Select a course</option>
                    <option>Web Development</option>
                    <option>Data Science & AI</option>
                    <option>Cloud & DevOps</option>
                    <option>Data Structures & Algorithms</option>
                    <option>Cybersecurity</option>
                    <option>Digital Marketing</option>
                    <option>UI/UX Design</option>
                    <option>Blockchain Development</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Message (Optional)</label>
                <textarea id="message" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl" placeholder="Any specific questions?"></textarea>
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-cyan-700 to-blue-800 text-white py-3 rounded-xl font-bold text-base transition-all hover:shadow-lg">Submit Application <i class="fa-solid fa-arrow-right ml-2"></i></button>
        </form>
        <p class="text-center text-xs text-gray-500 mt-4">We'll contact you within 24 hours. No spam, guaranteed.</p>
    </div>
</div>

<%- include("../../partials/common/footer") %>

<script>
    // ==================== SERVER-PASSED COURSES DATA ====================
    const allCourses = <%- JSON.stringify(registerCourses) %> || [];
    let currentCategory = "all";
    let currentSearchTerm = "";

    const categoryNames = {
        all: "All Categories",
        development: "Web Development",
        data: "Data Science",
        analyst: "Data Analyst",
        dsa: "DSA",
        placement: "Placement Preparation",
        marketing: "Digital Marketing",
        design: "UI/UX Design",
        cloud: "Cloud & DevOps",
        programming: "Programming Languages",
        cyber: "Cybersecurity",
        ai: "Artificial Intelligence",
        mobile: "Mobile Development",
        blockchain: "Blockchain"
    };

    const searchInput = document.getElementById('courseSearchInput');
    const dropdownBtn = document.getElementById('categoryDropdownBtn');
    const dropdownMenu = document.getElementById('categoryDropdownMenu');
    const selectedCategoryText = document.getElementById('selectedCategoryText');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const resultsCount = document.getElementById('resultsCount');
    const activeFiltersContainer = document.getElementById('activeFiltersContainer');
    const coursesGridContainer = document.getElementById('coursesGridContainer');
    const noResultsMessage = document.getElementById('noResultsMessage');
    const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');

    function calculateDiscount(price, originalPrice) {
        if (!originalPrice || originalPrice <= price) return 0;
        return Math.round(((originalPrice - price) / originalPrice) * 100);
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
    }

    function renderCourses() {
        let filtered = [...allCourses];
        if (currentCategory !== "all") {
            filtered = filtered.filter(c => c.category === currentCategory);
        }
        if (currentSearchTerm.trim()) {
            const term = currentSearchTerm.toLowerCase();
            filtered = filtered.filter(c =>
                (c.courseName?.toLowerCase().includes(term)) ||
                (categoryNames[c.category]?.toLowerCase().includes(term)) ||
                (c.level?.toLowerCase().includes(term)) ||
                (c.courseDescription?.toLowerCase().includes(term))
            );
        }
        resultsCount.textContent = `Showing ${filtered.length} premium courses`;
        if (filtered.length === 0) {
            coursesGridContainer.innerHTML = '';
            noResultsMessage.classList.remove('hidden');
            return;
        }
        noResultsMessage.classList.add('hidden');
        
        coursesGridContainer.innerHTML = filtered.map(c => `
            <div class="course-card bg-white rounded-2xl overflow-hidden flex flex-col h-full">
                <div class="relative card-image overflow-hidden bg-gray-100">
                    <img src="${c.image || 'https://via.placeholder.com/600x400?text=No+Image'}" alt="${escapeHtml(c.courseName)}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                </div>
                <div class="card-padding flex flex-col flex-grow">
                    <h3 class="text-lg font-bold text-gray-900 mb-1.5 tracking-tight">${escapeHtml(c.courseName)}</h3>
                    <p class="text-gray-700 text-sm font-medium mb-3 leading-relaxed line-clamp-2">${escapeHtml(c.courseDescription || c.description || 'No description available')}</p>
                    <div class="flex flex-wrap gap-2 mb-3">
                        <span class="feature-badge"><i class="fa-solid fa-briefcase"></i> Assured Placement</span>
                        <span class="feature-badge"><i class="fa-solid fa-chart-line"></i> Live Projects</span>
                        <span class="feature-badge"><i class="fa-regular fa-certificate"></i> Certificate</span>
                    </div>
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2 text-xs text-gray-700 font-medium"><i class="fa-regular fa-clock"></i> ${c.duration || 'N/A'} Months</div>
                        <div class="flex items-center gap-2 text-xs text-gray-700 font-medium"><i class="fa-regular fa-user"></i> ${Math.floor(Math.random() * 5000) + 500}+ students</div>
                    </div>
                    <div class="flex items-center justify-between mb-4">
                        <div><span class="text-2xl font-bold text-cyan-700">₹${c.price}</span><span class="text-xs text-gray-400 line-through ml-2">₹${c.originalPrice}</span><span class="text-xs font-semibold text-green-600 ml-2">${calculateDiscount(c.price, c.originalPrice)}% off</span></div>
                        <span class="text-xs font-semibold bg-gray-200 px-2 py-1 rounded-full text-gray-800">${c.level || 'Beginner'}</span>
                    </div>
                    <div class="flex gap-2 mt-auto">
                        <a href="/viewCourse/${c.courseName}" class="flex-1 bg-gradient-to-r from-cyan-700 to-blue-800 hover:from-cyan-800 hover:to-blue-900 text-white text-center py-2 rounded-xl font-semibold text-sm transition-all shadow-md hover:shadow-lg">View Details</a>
                        <button onclick="downloadBrochure('${escapeHtml(c.courseName)}')" class="px-3 py-2 border-2 border-cyan-600 text-cyan-700 rounded-xl hover:bg-cyan-50 transition-all font-semibold flex items-center gap-2 text-sm"><i class="fa-regular fa-file-pdf"></i> Brochure</button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    function updateActiveFilters() {
        activeFiltersContainer.innerHTML = "";
        if (currentCategory !== "all") {
            const tag = document.createElement('div');
            tag.className = "filter-tag inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-cyan-100 text-cyan-800 text-sm font-semibold shadow-sm";
            tag.innerHTML = `<i class="fa-regular fa-filter-circle-xmark text-cyan-700 text-xs"></i> Category: ${categoryNames[currentCategory]} <button class="remove-category-filter ml-1 w-4 h-4 rounded-full hover:bg-cyan-200 flex items-center justify-center"><i class="fa-solid fa-xmark text-[9px]"></i></button>`;
            tag.querySelector('.remove-category-filter').onclick = () => {
                currentCategory = "all";
                selectedCategoryText.textContent = "All Categories";
                updateActiveFilters();
                renderCourses();
            };
            activeFiltersContainer.appendChild(tag);
        }
        if (currentSearchTerm.trim()) {
            const tag = document.createElement('div');
            tag.className = "filter-tag inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-cyan-100 text-cyan-800 text-sm font-semibold";
            tag.innerHTML = `<i class="fa-regular fa-filter-circle-xmark text-cyan-700"></i> Search: "${currentSearchTerm.length > 15 ? currentSearchTerm.substring(0,15)+'...' : currentSearchTerm}" <button class="remove-search-filter ml-1 w-4 h-4 rounded-full hover:bg-cyan-200 flex items-center justify-center"><i class="fa-solid fa-xmark text-[9px]"></i></button>`;
            tag.querySelector('.remove-search-filter').onclick = () => {
                searchInput.value = "";
                currentSearchTerm = "";
                updateActiveFilters();
                renderCourses();
            };
            activeFiltersContainer.appendChild(tag);
        }
        if (currentCategory === "all" && !currentSearchTerm.trim()) {
            const noFiltersDiv = document.createElement('div');
            noFiltersDiv.className = "text-sm text-gray-500 font-medium";
            noFiltersDiv.innerHTML = '<i class="fa-regular fa-sliders-up mr-1"></i> No active filters';
            activeFiltersContainer.appendChild(noFiltersDiv);
        }
    }

    // Dropdown toggle
    dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownMenu.classList.toggle('hidden');
        const chevron = dropdownBtn.querySelector('.fa-chevron-down');
        chevron.style.transform = dropdownMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
    });
    document.addEventListener('click', (e) => {
        if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
            dropdownMenu.classList.add('hidden');
            const chevron = dropdownBtn.querySelector('.fa-chevron-down');
            chevron.style.transform = 'rotate(0deg)';
        }
    });

    document.querySelectorAll('.category-option').forEach(opt => {
        opt.addEventListener('click', () => {
            const category = opt.dataset.category;
            const displayName = opt.querySelector('span:last-child')?.textContent || categoryNames[category];
            currentCategory = category;
            selectedCategoryText.textContent = displayName;
            dropdownMenu.classList.add('hidden');
            updateActiveFilters();
            renderCourses();
        });
    });

    searchInput.addEventListener('input', (e) => {
        currentSearchTerm = e.target.value;
        updateActiveFilters();
        renderCourses();
    });

    resetBtn.addEventListener('click', () => {
        currentCategory = "all";
        currentSearchTerm = "";
        searchInput.value = "";
        selectedCategoryText.textContent = "All Categories";
        updateActiveFilters();
        renderCourses();
    });

    if (clearAllFiltersBtn) {
        clearAllFiltersBtn.addEventListener('click', () => {
            currentCategory = "all";
            currentSearchTerm = "";
            searchInput.value = "";
            selectedCategoryText.textContent = "All Categories";
            updateActiveFilters();
            renderCourses();
        });
    }

    window.downloadBrochure = function(courseName) {
        alert(`📄 Downloading brochure for "${courseName}"\n\nBrochure will be available shortly.`);
    };

    // Enrollment modal functionality
    const enrollModal = document.getElementById('enrollModal');
    const closeEnrollModal = document.getElementById('closeEnrollModal');
    const enrollmentForm = document.getElementById('enrollmentForm');
    if (enrollModal) {
        window.openEnrollModal = function() { enrollModal.style.display = 'flex'; };
        closeEnrollModal.onclick = () => enrollModal.style.display = 'none';
        enrollModal.onclick = (e) => { if (e.target === enrollModal) enrollModal.style.display = 'none'; };
        enrollmentForm.onsubmit = (e) => {
            e.preventDefault();
            alert('✅ Thank you! Our counselor will contact you soon.');
            enrollmentForm.reset();
            enrollModal.style.display = 'none';
        };
    }

    renderCourses();
    updateActiveFilters();
</script>
</body>
</html>