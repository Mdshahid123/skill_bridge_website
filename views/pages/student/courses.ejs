 <!DOCTYPE html>
<html lang="en">
<head>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>All Courses – SkillBridge | IT & Tech Training</title>
    <meta name="description" content="Explore 30+ industry‑relevant courses: Web Development, Data Science, Digital Marketing, Cloud Computing, DSA, and more. Enroll now for placement assistance.">
    <meta name="keywords" content="IT courses, tech training, web development course, data science course, digital marketing course, placement assistance">
    <meta name="author" content="Skill Bridge">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://www.skillbridge.com/courses">
    <meta property="og:title" content="Skill Bridge Courses – Learn from Industry Experts">
    <meta property="og:description" content="Browse all our courses – from beginner to advanced. Get certified and job‑ready.">
    <meta property="og:image" content="https://www.skillbridge.com/og-courses.jpg">
    <meta property="og:url" content="https://www.skillbridge.com/courses">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Skill Bridge Course Catalog">
    <meta name="twitter:description" content="Join thousands of students learning high‑demand tech skills.">

    <!-- Schema.org – ItemList (courses) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Skill Bridge Courses",
      "url": "https://www.skillbridge.com/courses",
      "numberOfItems": 30,
      "itemListElement": [
        <!-- you can dynamically generate this from your course array -->
      ]
    }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        /* ========== GLOBAL RESET & SCROLL FIX ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100%;
            position: relative;
            background-color: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* ========== HERO SECTION – FLOWING LIGHT WAVE (no rotating glow) ========== */
        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
            width: 100%;
        }

        /* Flowing light wave animation – replaces the old rotateGlow */
        .hero-glow::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 200%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(26,111,140,0.1), 
                rgba(0,102,179,0.15), 
                rgba(26,111,140,0.1), 
                transparent
            );
            animation: lightWave 10s ease-in-out infinite;
            pointer-events: none;
            z-index: 1;
        }

        @keyframes lightWave {
            0% { transform: translateX(0); }
            100% { transform: translateX(50%); }
        }

        /* Grid patterns (kept for texture) */
        .brand-grid {
            background-image: 
                repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px),
                repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 50px);
            background-size: 50px 50px;
        }

        .brand-grid-light {
            background-image: 
                repeating-linear-gradient(90deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px),
                repeating-linear-gradient(0deg, #5ba3bc 0px, #5ba3bc 0.5px, transparent 0.5px, transparent 40px);
        }

        .glow-text {
            text-shadow: 0 0 20px rgba(26,111,140,0.3);
        }

        /* ========== COURSE CARD STYLES ========== */
        .course-card {
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            overflow: hidden;
        }
        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -12px rgba(26,111,140,0.15);
        }

        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* ========== FEATURE BADGE – LARGER FONT ========== */
        .feature-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f0fdf4;
            color: #166534;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.2s ease;
            white-space: nowrap;
        }
        .feature-badge:hover {
            transform: translateY(-1px);
            background: #dcfce7;
        }
        .feature-badge i {
            font-size: 11px;
        }

        /* ========== DROPDOWN & FILTERS ========== */
        #categoryDropdownMenu {
            animation: dropdownFade 0.2s ease-out;
        }
        @keyframes dropdownFade {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .category-option {
            transition: all 0.2s ease;
        }
        .category-option:hover {
            background-color: #e6f4f5;
            transform: translateX(4px);
        }
        .filter-tag {
            animation: tagPop 0.2s ease-out;
        }
        @keyframes tagPop {
            from {
                transform: scale(0.8);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* ========== MODAL ========== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .course-modal {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            max-width: 90%;
            width: 500px;
            position: relative;
        }
        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            cursor: pointer;
            font-size: 1.5rem;
        }

        /* ========== RESPONSIVE UTILITIES ========== */
        @media (max-width: 640px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .px-6 {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            .md\:px-12 {
                padding-left: 1rem;
                padding-right: 1rem;
            }
            #categoryDropdownMenu {
                width: calc(100vw - 2rem);
                max-width: 320px;
                left: 1rem;
                right: 1rem;
            }
            .feature-badge {
                font-size: 11px;
                padding: 3px 10px;
            }
            .feature-badge i {
                font-size: 10px;
            }
        }
    </style>
</head>
<body>

<!-- nav bar -->
<%- include("../../partials/common/navbar.ejs") %>

<!-- Hero Section (Flowing Light Wave – no rotating glow) -->
<div class="hero-glow pt-28 pb-16 relative">
    <!-- Background grid layers (kept as before) -->
    <div class="absolute inset-0 opacity-[0.08] brand-grid pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.05] brand-grid-light pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
        style="background-image: 
            repeating-linear-gradient(45deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px),
            repeating-linear-gradient(135deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px);">
    </div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-teal-400/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="container mx-auto px-6 relative z-20">
        <div class="breadcrumb text-sm mb-4">
            <a href="/" class="text-teal-700/70 hover:text-teal-700">Home</a>
            <span class="text-teal-700/40 mx-2">/</span>
            <span class="text-teal-800 font-medium">Courses</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 text-center mb-3 glow-text">All Premium Courses</h1>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-8">Explore our comprehensive collection of industry-ready courses taught by expert mentors</p>
        
        <div class="max-w-3xl mx-auto mb-6">
            <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
                <!-- Search bar -->
                <div class="relative flex-1 max-w-md">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="courseSearchInput" placeholder="Search courses by name, category, or skill..." class="w-full pl-11 pr-4 py-3 rounded-full border border-gray-200 bg-white/80 backdrop-blur-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all text-gray-700 text-sm">
                </div>
                
                <!-- Category dropdown -->
                <div class="relative" style="z-index: 100;">
                    <button id="categoryDropdownBtn" class="flex items-center gap-2 px-5 py-3 rounded-full bg-white/80 backdrop-blur-sm border border-gray-200 text-gray-700 text-sm font-medium hover:border-teal-500 hover:text-teal-600 transition-all">
                        <i class="fa-solid fa-filter text-teal-500"></i>
                        <span id="selectedCategoryText">All Categories</span>
                        <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"></i>
                    </button>
                    <div id="categoryDropdownMenu" class="absolute top-full left-0 mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 hidden overflow-y-auto" style="z-index: 1000; max-height: 400px;">
                        <div class="p-2">
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="all"><i class="fa-regular fa-circle-dot text-teal-500 text-base w-5"></i><span>All Categories</span></div>
                            <div class="border-t border-gray-100 my-1"></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="development"><i class="fa-brands fa-react text-teal-500 text-base w-5"></i><span>Web Development</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="data"><i class="fa-solid fa-chart-line text-teal-500 text-base w-5"></i><span>Data Science</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="analyst"><i class="fa-solid fa-table text-teal-500 text-base w-5"></i><span>Data Analyst</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="dsa"><i class="fa-solid fa-diagram-project text-teal-500 text-base w-5"></i><span>DSA</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="placement"><i class="fa-solid fa-briefcase text-teal-500 text-base w-5"></i><span>Placement Preparation</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="programming"><i class="fa-solid fa-code text-teal-500 text-base w-5"></i><span>Programming Languages</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="cloud"><i class="fa-solid fa-cloud-arrow-up text-teal-500 text-base w-5"></i><span>Cloud & DevOps</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="cyber"><i class="fa-solid fa-shield-haltered text-teal-500 text-base w-5"></i><span>Cybersecurity</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="ai"><i class="fa-solid fa-robot text-teal-500 text-base w-5"></i><span>Artificial Intelligence</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="marketing"><i class="fa-solid fa-chart-simple text-teal-500 text-base w-5"></i><span>Digital Marketing</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="design"><i class="fa-solid fa-pen-ruler text-teal-500 text-base w-5"></i><span>UI/UX Design</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="mobile"><i class="fa-brands fa-android text-teal-500 text-base w-5"></i><span>Mobile Development</span></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="blockchain"><i class="fa-solid fa-link text-teal-500 text-base w-5"></i><span>Blockchain</span></div>
                        </div>
                    </div>
                </div>
                
                <button id="resetFiltersBtn" class="px-5 py-3 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium transition-all flex items-center gap-2"><i class="fa-solid fa-rotate-right text-xs"></i> Reset</button>
            </div>
            <div id="activeFiltersContainer" class="flex flex-wrap gap-2 justify-center mt-4 min-h-[32px]"></div>
        </div>
        <p class="text-gray-500 text-center text-sm" id="resultsCount">Showing 0 courses</p>
    </div>
</div>

<!-- Courses Grid Section -->
<section class="py-12 px-6 md:px-12 bg-white">
    <div class="container  max-w-5xl">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="coursesGridContainer">
            <!-- Courses will be dynamically loaded here -->
        </div>
        <div id="noResultsMessage" class="text-center py-12 hidden">
            <i class="fa-regular fa-folder-open text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">No courses found</h3>
