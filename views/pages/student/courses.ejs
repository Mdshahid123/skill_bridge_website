        <%- include('../../partials/common/footer')  %>

<script>
    // ------------- COURSES DATABASE (Physics Waalah Enhanced) ----------
    const coursesData = [
        { id: 1, courseName: "Quantum Full Stack (MERN)", category: "fullstack", price: "49,999", oldPrice: "89,999", rating: 4.9, image: "", featured: true },
        { id: 2, courseName: "Frontend Physics: React & Next.js", category: "frontend", price: "35,999", oldPrice: "69,999", rating: 4.8, image: "" },
        { id: 3, courseName: "Backend & API Mechanics (Node.js)", category: "backend", price: "32,999", oldPrice: "59,999", rating: 4.7, image: "" },
        { id: 4, courseName: "Data Science & AI (Quantum ML)", category: "data-science", price: "54,999", oldPrice: "99,999", rating: 4.9, image: "" },
        { id: 5, courseName: "Generative AI Engineering", category: "gen-ai", price: "59,999", oldPrice: "1,09,999", rating: 4.95, image: "" },
        { id: 6, courseName: "Cloud & DevOps (K8s, AWS)", category: "cloud", price: "44,999", oldPrice: "79,999", rating: 4.7, image: "" },
        { id: 7, courseName: "React Relativity + Hooks", category: "react", price: "29,999", oldPrice: "49,999", rating: 4.8, image: "" },
        { id: 8, courseName: "C++ & DSA (Physics Approach)", category: "programming", price: "24,999", oldPrice: "44,999", rating: 4.6, image: "" },
        { id: 9, courseName: "Digital Marketing Gravity", category: "digital-marketing", price: "27,999", oldPrice: "49,999", rating: 4.5, image: "" },
        { id: 10, courseName: "Quantum Computing Essentials", category: "gen-ai", price: "39,999", oldPrice: "69,999", rating: 4.9, image: "" }
    ];

    // Helper mapping
    const categoryDisplay = {
        all: "All Dimensions", frontend: "Frontend Physics", backend: "Backend Mechanics", react: "React Relativity", fullstack: "Full Stack Quantum", "data-science": "Data Science", "gen-ai": "Generative AI", cloud: "Cloud & DevOps", programming: "Programming Core", "digital-marketing": "Digital Gravity"
    };

    let activeCategory = "all";
    let activeSearch = "";

    function renderCourses() {
        const container = document.getElementById('coursesGrid');
        const noMsg = document.getElementById('noCoursesMsg');
        let filtered = coursesData.filter(c => activeCategory === "all" || c.category === activeCategory);
        if(activeSearch.trim() !== "") {
            filtered = filtered.filter(c => c.courseName.toLowerCase().includes(activeSearch.toLowerCase()));
        }
        if(filtered.length === 0) {
            container.innerHTML = "";
            noMsg.classList.remove("hidden");
            document.getElementById('resultCountInfo').innerText = `⚛️ No courses found — adjust filters.`;
            return;
        }
        noMsg.classList.add("hidden");
        container.innerHTML = filtered.map(course => `
            <div class="glass-premium p-5 transition-all duration-300">
                <div class="course-img w-full h-40 rounded-2xl flex items-center justify-center text-teal-300 text-3xl"><i class="fa-solid fa-microchip text-5xl opacity-70"></i></div>
                <div class="mt-4 flex justify-between items-start"><div><h3 class="text-xl font-bold text-white">${escapeHtml(course.courseName)}</h3><span class="text-xs bg-teal-900/60 px-2 py-0.5 rounded-full text-teal-200">${categoryDisplay[course.category] || course.category}</span></div><div class="flex items-center"><i class="fa-regular fa-star text-yellow-400 text-sm"></i><span class="text-sm ml-1">${course.rating}</span></div></div>
                <div class="mt-3 flex items-baseline gap-2"><span class="text-2xl font-black text-teal-300">₹${course.price}</span><span class="line-through text-gray-500 text-sm">₹${course.oldPrice}</span><span class="bg-green-800/60 text-green-300 text-xs px-2 py-0.5 rounded-full">save up to 45%</span></div>
                <div class="mt-4 flex gap-2"><button class="flex-1 btn-physics py-2 rounded-full text-white text-sm font-semibold">Enroll →</button><button class="px-3 py-2 rounded-full bg-gray-800 hover:bg-teal-800/40"><i class="fa-regular fa-circle-info"></i></button></div>
            </div>
        `).join('');
        document.getElementById('resultCountInfo').innerHTML = `⚛️ showing ${filtered.length} quantum-ready courses | <span class="text-teal-300">escape velocity guaranteed</span>`;
    }

    function escapeHtml(str) { if(!str) return ''; return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m])); }

    function initCategoryFilters() {
        const container = document.getElementById('categoryFilterList');
        const categories = ["all", "frontend", "backend", "fullstack", "data-science", "gen-ai", "cloud", "react"];
        container.innerHTML = categories.map(cat => `<button data-cat="${cat}" class="category-pill px-5 py-2 rounded-full border border-teal-500/50 text-sm font-medium transition-all ${activeCategory === cat ? 'active bg-teal-500 text-black border-teal-400' : 'bg-gray-900/60 text-gray-300 hover:bg-teal-900/40'}">${categoryDisplay[cat] || cat}</button>`).join('');
        document.querySelectorAll('[data-cat]').forEach(btn => {
            btn.addEventListener('click', (e) => {
                activeCategory = btn.getAttribute('data-cat');
                document.querySelectorAll('.category-pill').forEach(b => b.classList.remove('active', 'bg-teal-500', 'text-black'));
                btn.classList.add('active', 'bg-teal-500', 'text-black');
                renderCourses();
            });
        });
    }

    // Search event
    document.getElementById('searchCourse')?.addEventListener('input', (e) => { activeSearch = e.target.value; renderCourses(); });
    document.getElementById('resetFilterBtn')?.addEventListener('click', () => { activeCategory = "all"; activeSearch = ""; document.getElementById('searchCourse').value = ""; renderCourses(); initCategoryFilters(); });

    // FAQ accordion (Quantum style)
    const faqList = [
        { q: "What is Physics Waalah's unique approach?", a: "We teach coding using first principles from physics — building deep intuition, not just syntax. You'll think like an engineer + physicist." },
        { q: "Do you provide placement assistance?", a: "Yes! 98% placement support including mock interviews, resume tunneling, and 500+ hiring partners like Amazon, Microsoft, and unicorns." },
        { q: "Can I switch from recorded to live classes?", a: "Absolutely. Upgrade seamlessly with fee adjustment — like quantum state transition." },
        { q: "Is there a demo session?", a: "Yes, book a free consultation using the form above and get a live demo with mentors." }
    ];
    const faqContainer = document.getElementById('faqContainer');
    faqContainer.innerHTML = faqList.map((f, idx) => `
        <div class="faq-item glass-premium p-5 cursor-pointer transition" onclick="toggleFaq(this)">
            <div class="flex justify-between items-center"><div class="flex gap-3"><i class="fa-regular fa-circle-question text-teal-400"></i><span class="font-semibold text-white">${f.q}</span></div><i class="fa-solid fa-chevron-down text-teal-400 transition-transform duration-300"></i></div>
            <div class="faq-answer mt-2 text-gray-300 text-sm pl-6">${f.a}</div>
        </div>
    `).join('');

    window.toggleFaq = (el) => {
        el.classList.toggle('open');
        const icon = el.querySelector('.fa-chevron-down');
        if(el.classList.contains('open')) icon.style.transform = "rotate(180deg)";
        else icon.style.transform = "rotate(0deg)";
    };

    // Form Handling
    document.getElementById('inquiryForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('nameInput').value.trim();
        if(!name) { alert("Please enter your name"); return; }
        alert(`✨ Thanks ${name}! Your quantum callback request is received. A mentor will entangle with you within 24 hours.`);
        e.target.reset();
    });

    window.scrollToCourses = () => { document.getElementById('coursesGrid').scrollIntoView({ behavior: 'smooth', block: 'start' }); };
    window.scrollToForm = () => { document.getElementById('formSection').scrollIntoView({ behavior: 'smooth' }); };

    renderCourses();
    initCategoryFilters();
</script>
</body>
</html>
