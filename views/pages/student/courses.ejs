            <button id="clearAllFiltersBtn" class="mt-4 px-6 py-2 bg-teal-500 text-white rounded-full text-sm font-semibold hover:bg-teal-600 transition-all">Clear all filters</button>
        </div>
    </div>
</section>

<!-- Enrollment Modal -->
<div id="enrollModal" class="modal-overlay">
    <div class="course-modal" style="max-width: 500px;">
        <div class="modal-close" id="closeEnrollModal">&times;</div>
        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-[#1a1a2e] to-[#0f3460] flex items-center justify-center mx-auto mb-3">
                <i class="fa-solid fa-graduation-cap text-white text-xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-800">Start Your Journey</h2>
            <p class="text-gray-500 text-xs mt-1">Fill the form to get a free counseling session</p>
        </div>
        <form id="enrollmentForm" class="space-y-3">
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Full Name *</label><input type="text" id="fullName" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="Enter your full name"></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Email Address *</label><input type="email" id="email" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="you@example.com"></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Phone Number *</label><input type="tel" id="phone" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="+91 98765 43210"></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Interested Course</label><select id="courseSelect" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]"><option value="">Select a course</option><option>Web Development</option><option>Data Science & AI</option><option>Cloud & DevOps</option><option>Data Structures & Algorithms</option><option>Cybersecurity</option><option>Digital Marketing</option><option>UI/UX Design</option><option>Blockchain Development</option></select></div>
            <div><label class="block text-xs font-medium text-gray-700 mb-1">Message (Optional)</label><textarea id="message" rows="2" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="Any specific questions?"></textarea></div>
            <button type="submit" class="w-full bg-gradient-to-r from-[#1a1a2e] to-[#0f3460] text-white py-2.5 rounded-lg font-semibold text-sm transition-all hover:opacity-90">Submit Application <i class="fa-solid fa-arrow-right ml-2"></i></button>
        </form>
        <p class="text-center text-[10px] text-gray-400 mt-3">We'll contact you within 24 hours. No spam, guaranteed.</p>
    </div>
</div>

<%- include("../../partials/common/footer") %>

<script>
    // ==================== SERVER-PASSED COURSES DATA ====================
    const allCourses = <%- JSON.stringify(registerCourses) %> || [];
    let currentCategory = "all";
    let currentSearchTerm = "";

    // Category mapping
    const categoryNames = {
        all: "All Categories",
        development: "Web Development",
        data: "Data Science",
        analyst: "Data Analyst",
        dsa: "DSA",
        placement: "Placement Preparation",
        marketing: "Digital Marketing",
        design: "UI/UX Design",
        cloud: "Cloud & DevOps",
        programming: "Programming Languages",
        cyber: "Cybersecurity",
        ai: "Artificial Intelligence",
        mobile: "Mobile Development",
        blockchain: "Blockchain"
    };

    // DOM elements
    const searchInput = document.getElementById('courseSearchInput');
    const dropdownBtn = document.getElementById('categoryDropdownBtn');
    const dropdownMenu = document.getElementById('categoryDropdownMenu');
    const selectedCategoryText = document.getElementById('selectedCategoryText');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const resultsCount = document.getElementById('resultsCount');
    const activeFiltersContainer = document.getElementById('activeFiltersContainer');
    const coursesGridContainer = document.getElementById('coursesGridContainer');
    const noResultsMessage = document.getElementById('noResultsMessage');
    const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');

    // Helper: calculate discount %
    function calculateDiscount(price, originalPrice) {
        if (!originalPrice || originalPrice <= price) return 0;
        return Math.round(((originalPrice - price) / originalPrice) * 100);
    }

    // Render courses
    function renderCourses() {
        let filtered = [...allCourses];
        if (currentCategory !== "all") {
            filtered = filtered.filter(c => c.category === currentCategory);
        }
        if (currentSearchTerm.trim()) {
            const term = currentSearchTerm.toLowerCase();
            filtered = filtered.filter(c =>
                (c.courseName?.toLowerCase().includes(term)) ||
                (categoryNames[c.category]?.toLowerCase().includes(term)) ||
                (c.level?.toLowerCase().includes(term)) ||
                (c.courseDescription?.toLowerCase().includes(term))
            );
        }
        resultsCount.textContent = `Showing ${filtered.length} courses`;
        if (filtered.length === 0) {
            coursesGridContainer.innerHTML = '';
            noResultsMessage.classList.remove('hidden');
            return;
        }
        noResultsMessage.classList.add('hidden');
        coursesGridContainer.innerHTML = filtered.map(c => `
            <div class="course-card bg-white rounded-xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                <div class="relative h-48 overflow-hidden">
                    <img src="${c.image || 'https://via.placeholder.com/600x400?text=No+Image'}" alt="${escapeHtml(c.courseName)}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                    <div class="absolute top-3 left-3"></div>
                </div>
                <div class="p-5">
                    <h3 class="text-lg font-bold text-gray-800 mb-2 line-clamp-1">${escapeHtml(c.courseName)}</h3>
                    <p class="text-gray-500 text-sm mb-3 line-clamp-2">${escapeHtml(c.courseDescription || c.description || 'No description available')}</p>
                    <div class="flex flex-wrap gap-2 mb-3">
                        <span class="feature-badge"><i class="fa-solid fa-briefcase"></i> Assured Placement</span>
                        <span class="feature-badge"><i class="fa-solid fa-chart-line"></i> Live Projects</span>
                        <span class="feature-badge"><i class="fa-regular fa-certificate"></i> Certificate</span>
                    </div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 text-xs text-gray-500"><i class="fa-regular fa-clock"></i> ${c.duration || 'N/A'} Months</div>
                        <div class="flex items-center gap-2 text-xs text-gray-500"><i class="fa-regular fa-user"></i> ${Math.floor(Math.random() * 5000) + 500}+ students</div>
                    </div>
                    <div class="flex items-center justify-between mb-4">
                        <div><span class="text-2xl font-bold text-teal-600">₹${c.price}</span><span class="text-xs text-gray-400 line-through ml-2">₹${c.originalPrice}</span><span class="text-xs text-green-600 ml-2">${calculateDiscount(c.price, c.originalPrice)}% off</span></div>
                        <span class="text-xs bg-gray-100 px-2 py-1 rounded-full">${c.level || 'Beginner'}</span>
                    </div>
                    <div class="flex gap-2">
                        <a href="/viewCourse/${c.courseName}" class="flex-1 bg-gradient-to-r from-teal-500 to-blue-600 hover:from-teal-600 hover:to-blue-700 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all hover:scale-105">View Details</a>
                        <!-- Download Brochure button with text -->
                        <button onclick="downloadBrochure('${escapeHtml(c.courseName)}')" class="px-3 py-2 border border-teal-500 text-teal-600 rounded-lg hover:bg-teal-500 hover:text-white transition-all flex items-center gap-2 text-sm font-medium whitespace-nowrap">
                            <i class="fa-regular fa-file-pdf"></i> Download
                        </button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    // Update active filters display
    function updateActiveFilters() {
        activeFiltersContainer.innerHTML = "";
        if (currentCategory !== "all") {
            const tag = document.createElement('div');
            tag.className = "filter-tag inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-teal-100 text-teal-700 text-xs font-medium";
            tag.innerHTML = `<i class="fa-regular fa-filter-circle-xmark text-teal-500 text-[10px]"></i> Category: ${categoryNames[currentCategory]} <button class="remove-category-filter ml-1 w-3 h-3 rounded-full hover:bg-teal-200 flex items-center justify-center transition-all"><i class="fa-solid fa-xmark text-[8px]"></i></button>`;
            tag.querySelector('.remove-category-filter').onclick = () => {
                currentCategory = "all";
                selectedCategoryText.textContent = "All Categories";
                updateActiveFilters();
                renderCourses();
            };
            activeFiltersContainer.appendChild(tag);
        }
        if (currentSearchTerm.trim()) {
            const tag = document.createElement('div');
            tag.className = "filter-tag inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-teal-100 text-teal-700 text-xs font-medium";
            tag.innerHTML = `<i class="fa-regular fa-filter-circle-xmark text-teal-500 text-[10px]"></i> Search: "${currentSearchTerm.length > 15 ? currentSearchTerm.substring(0,15)+'...' : currentSearchTerm}" <button class="remove-search-filter ml-1 w-3 h-3 rounded-full hover:bg-teal-200 flex items-center justify-center transition-all"><i class="fa-solid fa-xmark text-[8px]"></i></button>`;
            tag.querySelector('.remove-search-filter').onclick = () => {
                searchInput.value = "";
                currentSearchTerm = "";
                updateActiveFilters();
                renderCourses();
            };
            activeFiltersContainer.appendChild(tag);
        }
        if (currentCategory === "all" && !currentSearchTerm.trim()) {
            const noFiltersDiv = document.createElement('div');
            noFiltersDiv.className = "text-xs text-gray-400";
            noFiltersDiv.innerHTML = '<i class="fa-regular fa-sliders-up mr-1"></i> No active filters';
            activeFiltersContainer.appendChild(noFiltersDiv);
        }
    }

    // Dropdown toggle
    dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdownMenu.classList.toggle('hidden');
        const chevron = dropdownBtn.querySelector('.fa-chevron-down');
        chevron.style.transform = dropdownMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)';
    });
    document.addEventListener('click', (e) => {
        if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
            dropdownMenu.classList.add('hidden');
            const chevron = dropdownBtn.querySelector('.fa-chevron-down');
            chevron.style.transform = 'rotate(0deg)';
        }
    });

    // Category selection
    document.querySelectorAll('.category-option').forEach(opt => {
        opt.addEventListener('click', () => {
            const category = opt.dataset.category;
            const displayName = opt.querySelector('span:last-child')?.textContent || categoryNames[category];
            currentCategory = category;
            selectedCategoryText.textContent = displayName;
            dropdownMenu.classList.add('hidden');
            updateActiveFilters();
            renderCourses();
        });
    });

    // Search
    searchInput.addEventListener('input', (e) => {
        currentSearchTerm = e.target.value;
        updateActiveFilters();
        renderCourses();
    });

    // Reset filters
    resetBtn.addEventListener('click', () => {
        currentCategory = "all";
        currentSearchTerm = "";
        searchInput.value = "";
        selectedCategoryText.textContent = "All Categories";
        updateActiveFilters();
        renderCourses();
    });

    if (clearAllFiltersBtn) {
        clearAllFiltersBtn.addEventListener('click', () => {
            currentCategory = "all";
            currentSearchTerm = "";
            searchInput.value = "";
            selectedCategoryText.textContent = "All Categories";
            updateActiveFilters();
            renderCourses();
        });
    }

    // Download brochure (global)
    window.downloadBrochure = function(courseName) {
        alert(`📄 Downloading brochure for "${courseName}"\n\nBrochure will be available shortly.`);
    };

    // Enrollment modal
    const enrollModal = document.getElementById('enrollModal');
    const closeEnrollModal = document.getElementById('closeEnrollModal');
    const enrollmentForm = document.getElementById('enrollmentForm');
    if (enrollModal) {
        window.openEnrollModal = function() { enrollModal.style.display = 'flex'; };
        closeEnrollModal.onclick = () => enrollModal.style.display = 'none';
        enrollModal.onclick = (e) => { if (e.target === enrollModal) enrollModal.style.display = 'none'; };
        enrollmentForm.onsubmit = (e) => {
            e.preventDefault();
            alert('✅ Thank you! Our counselor will contact you soon.');
            enrollmentForm.reset();
            enrollModal.style.display = 'none';
        };
    }

    // Escape HTML
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
    }

    // Initial render
    renderCourses();
    updateActiveFilters();
</script>
</body>
