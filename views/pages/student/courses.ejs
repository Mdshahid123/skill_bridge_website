<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Physics Waalah | Quantum Tech Academy – Where Code Meets Gravity</title>
    <meta name="description" content="Learn tech with a physics-first approach. Web Dev, AI, Quantum-Ready coding with placement guarantee. Join the revolution.">
    <!-- Tailwind + FontAwesome + Google Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #01020b;
            color: #eef5ff;
            overflow-x: hidden;
        }

        /* animated physics background */
        .quantum-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background: radial-gradient(circle at 20% 30%, #071426, #000000);
        }

        .particle-field {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: -1;
            background-image: radial-gradient(circle at 30% 40%, rgba(45, 212, 191, 0.12) 1.5px, transparent 1.5px);
            background-size: 48px 48px;
            pointer-events: none;
            animation: driftParticles 90s linear infinite;
        }

        @keyframes driftParticles {
            0% { background-position: 0 0; }
            100% { background-position: 240px 240px; }
        }

        /* glass-card premium */
        .glass-premium {
            background: rgba(10, 20, 30, 0.55);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(45, 212, 191, 0.3);
            border-radius: 2rem;
            transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            box-shadow: 0 20px 35px -15px rgba(0, 0, 0, 0.6);
        }

        .glass-premium:hover {
            border-color: #2dd4bf;
            transform: translateY(-6px);
            box-shadow: 0 30px 45px -12px #0f766e40;
        }

        .btn-physics {
            background: linear-gradient(105deg, #0f766e, #14b8a6);
            box-shadow: 0 6px 14px rgba(15, 118, 110, 0.4);
            transition: all 0.2s;
        }

        .btn-physics:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 22px #2dd4bf40;
        }

        .btn-outline-physics {
            border: 1px solid #2dd4bf;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
        }

        .neon-glow-text {
            text-shadow: 0 0 12px #2dd4bf80, 0 0 4px #14b8a6;
        }

        /* course card inner image fallback */
        .course-img {
            background: linear-gradient(145deg, #0b1a2e, #021020);
            border-radius: 1.5rem;
            height: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .category-pill {
            transition: all 0.2s;
            cursor: pointer;
        }

        .category-pill.active {
            background: #14b8a6;
            color: #01020b;
            border-color: #14b8a6;
            box-shadow: 0 4px 12px #14b8a680;
        }

        .rotate-slow {
            animation: spinSlow 12s linear infinite;
        }

        @keyframes spinSlow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out;
        }

        .faq-item.open .faq-answer {
            max-height: 220px;
        }

        .scrollbar-custom::-webkit-scrollbar {
            height: 5px;
        }
        .scrollbar-custom::-webkit-scrollbar-track {
            background: #0f172a;
            border-radius: 20px;
        }
        .scrollbar-custom::-webkit-scrollbar-thumb {
            background: #2dd4bf;
            border-radius: 20px;
        }
    </style>
</head>
<body>

