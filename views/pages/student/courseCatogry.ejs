<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>
        <% if (selectedCategory && selectedCategory !== 'all') { %>
            <%= decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1) %> – SkillBridge
        <% } else { %>
            All Courses – SkillBridge
        <% } %>
    </title>
    <meta name="description" content="Browse our courses by category and find the perfect program for your career. Industry-ready training with placement assistance.">
    <meta name="keywords" content="courses, IT training, online learning, skill development">
    <meta name="author" content="SkillBridge">
    <link rel="canonical" href="https://www.skillbridge.com/courseCatogry">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <link rel="icon" type="image/png" sizes="96x96"   href="/favicon.ico.png">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { overflow-x: hidden; background: #f8fafc; scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; font-weight: 500; color: #1e293b; }
        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            top: -30%;
            left: -30%;
            width: 160%;
            height: 160%;
            background: radial-gradient(circle, rgba(6,182,212,0.12), transparent 70%);
            animation: slowPulse 15s infinite alternate;
            pointer-events: none;
        }
        @keyframes slowPulse {
            0% { opacity: 0.3; transform: scale(1);}
            100% { opacity: 0.8; transform: scale(1.08);}
        }
        .brand-grid {
            background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px),
                              repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px);
            background-size: 60px 60px;
        }
        .course-card {
            transition: all 0.3s ease;
            background: white;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 8px 20px -8px rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            height: 100%;
            border-radius: 1rem;
        }
        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 30px -12px rgba(0,0,0,0.12);
            border-color: rgba(6,182,212,0.3);
        }
        .feature-badge {
            background: #f0f9ff;
            color: #0c4e6e;
            padding: 6px 12px;
            font-weight: 600;
            border-radius: 40px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .course-modal {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            max-width: 90%;
            width: 500px;
            position: relative;
            animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .modal-close {
            position: absolute;
            top: 1rem; right: 1rem;
            cursor: pointer;
            font-size: 1.5rem;
            color: #6b7280;
        }
        .image-container { height: 200px; overflow: hidden; border-radius: 1rem 1rem 0 0; }
        @media (min-width: 768px) { .image-container { height: 220px; } }
        @media (max-width: 640px) {
            .container { padding-left: 1rem; padding-right: 1rem; }
            .grid { gap: 1rem; }
            .image-container { height: 180px; }
        }
        .faq-question {
            cursor: pointer;
            transition: all 0.2s;
        }
        .faq-answer {
            display: none;
            padding-top: 0.5rem;
        }
        .faq-answer.open {
            display: block;
        }
        .section-fade-up {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .section-fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .testimonial-card, .tool-icon, .partner-logo, .faq-item {
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        .testimonial-card:hover, .tool-icon:hover, .partner-logo:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 25px -12px rgba(0,0,0,0.15);
        }
        .faq-item:hover {
            transform: translateX(4px);
        }
    </style>
</head>
<body>

<%- include("../../partials/common/navbar.ejs") %>

<% 
    function toTitleCase(str) {
        if (!str) return '';
        return str
            .toLowerCase()
            .split(' ')
            .map(word => word.charAt(0).toUpperCase() + word.slice(1))
            .join(' ');
    }
%>

<!-- ==================== HERO SECTION - PROFESSIONAL (COURSE CATEGORY PAGE) ==================== -->
<div class="relative overflow-hidden bg-gradient-to-br from-cyan-900 via-blue-900 to-indigo-900 py-16 md:py-24">
    <div class="absolute inset-0 opacity-30">
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-cyan-400 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-blue-500 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-purple-500 rounded-full blur-3xl opacity-20"></div>
    </div>
    <div class="absolute inset-0 opacity-[0.05]"
        style="background-image: 
            repeating-linear-gradient(90deg, #fff 0px, #fff 1px, transparent 1px, transparent 60px),
            repeating-linear-gradient(0deg, #fff 0px, #fff 1px, transparent 1px, transparent 60px);">
    </div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
            <div class="breadcrumb text-sm mb-4 text-white/70">
                <a href="/" class="text-teal-300 hover:text-teal-200 transition">Home</a>
                <span class="text-white/40 mx-2">/</span>
                <a href="/courseCatogry" class="text-teal-300 hover:text-teal-200 transition">Courses</a>
                <% if (selectedCategory && selectedCategory !== 'all') { %>
                    <span class="text-white/40 mx-2">/</span>
                    <span class="text-white font-semibold"><%= decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1) %></span>
                <% } %>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-4 animate-fade-up">
                <% if (selectedCategory && selectedCategory !== 'all') { %>
                    <span class="bg-gradient-to-r from-cyan-300 via-blue-300 to-purple-300 bg-clip-text text-transparent">
                        <%= decodeURIComponent(selectedCategory).toUpperCase() %>
                    </span>
                <% } else { %>
                    <span class="bg-gradient-to-r from-cyan-300 via-blue-300 to-purple-300 bg-clip-text text-transparent">
                        All Premium Courses
                    </span>
                <% } %>
            </h1>
            <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-6 animate-fade-up" style="animation-delay: 0.1s;">
                <% if (selectedCategory && selectedCategory !== 'all') { %>
                    Choose your learning path – classroom, online live, or recorded – and master <%= decodeURIComponent(selectedCategory).toLowerCase() %> with industry experts.
                <% } else { %>
                    Discover a wide range of industry‑ready courses taught by expert mentors.
                <% } %>
            </p>
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 text-sm font-medium animate-fade-up" style="animation-delay: 0.2s;">
                <i class="fa-regular fa-circle-check text-teal-300"></i>
                <span>100% Placement Assistance • 5000+ Students Trained</span>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes fade-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
        opacity: 0;
    }
</style>

<!-- Courses Grid + Extra Program Cards (Vertical Layout, Lecture Type, Lecture Hours) -->
<section class="py-12 px-6 md:px-12 bg-transparent">
    <div class="container mx-auto max-w-7xl px-2 md:px-4">
        <% if (errorMessage) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center mb-6">
                <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= errorMessage %>
            </div>
        <% } %>
        
        <% 
            if (typeof selectedCategory === 'undefined') selectedCategory = 'all';
            if (typeof registerCourses === 'undefined') registerCourses = [];
            let categoryDisplay = "Full Stack Development";
            if (selectedCategory && selectedCategory !== 'all') {
                categoryDisplay = decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1);
            }
            const defaultImg = (registerCourses && registerCourses.length > 0 && registerCourses[0].image) 
                ? registerCourses[0].image 
                : 'https://via.placeholder.com/600x400?text=No+Image';
            // Use first course's _id for Classroom and Online links
            const firstCourseId = (registerCourses && registerCourses.length > 0) 
                ? registerCourses[0]._id 
                : '';
        %>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            <!-- Classroom Program Card -->
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <div class="course-card rounded-xl overflow-hidden border-l-4 border-l-amber-500">
                    <div class="image-container relative">
                        <img src="<%= defaultImg %>" alt="<%= categoryDisplay %> Classroom" class="w-full h-full object-cover">
                        <div class="absolute top-3 left-3 bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-full">Classroom</div>
                    </div>
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-xl font-bold text-gray-900 mb-2">  <%= toTitleCase(categoryDisplay) %></h3>
                        <div class="mb-3">
                            <span class="inline-block bg-amber-100 text-amber-800 text-xs font-bold px-2 py-0.5 rounded-full">Lecture Type: Classroom</span>
                        </div>
                        <p class="text-gray-700 text-sm mb-3 leading-relaxed">Instructor‑led classroom training with hands‑on projects, peer collaboration, and campus placement support.</p>
                        <div class="flex flex-col gap-1.5 mb-3">
                            <span class="feature-badge"><i class="fa-solid fa-chalkboard-user"></i> On‑Campus</span>
                            <span class="feature-badge"><i class="fa-solid fa-users"></i> Group Learning</span>
                            <span class="feature-badge"><i class="fa-regular fa-building"></i> Lab Access</span>
                        </div>
                        <div class="flex flex-col gap-1 mb-3 text-sm text-gray-700">
                            <span><i class="fa-regular fa-clock w-4"></i> 6 Months</span>
                            <span><i class="fa-regular fa-user w-4"></i> Limited Seats</span>
                            <span><i class="fa-regular fa-hourglass-half w-4"></i> 120+ Learning Hours</span>
                        </div>
                        <div class="flex items-center justify-between mb-4">
                            <!-- <div><span class="text-2xl font-bold text-amber-700">₹45,000</span><span class="text-sm text-gray-400 line-through ml-2">₹65,000</span><span class="text-sm font-semibold text-green-600 ml-2">31% off</span></div> -->
                            <span class="text-xs font-semibold bg-amber-100 px-2 py-1 rounded-full text-amber-800">Classroom</span>
                        </div>
                        <div class="flex gap-3 mt-auto">
                            <!-- Link to viewClassroom with first course ID -->
                            <a href="/viewClassroom/<%= firstCourseId %>" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">View Details</a>
                            <button onclick="downloadBrochure('<%= categoryDisplay %> Classroom')" class="px-3 py-2 border-2 border-amber-600 text-amber-700 rounded-lg hover:bg-amber-50 transition-all text-sm flex items-center gap-2 font-semibold">
                                <i class="fa-regular fa-file-pdf"></i> Download Brochure
                            </button>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <!-- Online Live Program Card -->
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <div class="course-card rounded-xl overflow-hidden border-l-4 border-l-cyan-500">
                    <div class="image-container relative">
                        <img src="<%= defaultImg %>" alt="<%= categoryDisplay %> Online Live" class="w-full h-full object-cover">
                        <div class="absolute top-3 left-3 bg-cyan-500 text-white text-xs font-bold px-2 py-1 rounded-full">Online Live</div>
                    </div>
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-xl font-bold text-gray-900 mb-2"><h3 class="text-xl font-bold text-gray-900 mb-2">
                            <%= toTitleCase(categoryDisplay) %>
                        </h3>
                    </h3>
                        <div class="mb-3">
                            <span class="inline-block bg-cyan-100 text-cyan-800 text-xs font-bold px-2 py-0.5 rounded-full">Lecture Type: Online Live</span>
                        </div>
                        <p class="text-gray-700 text-sm mb-3 leading-relaxed">Live interactive classes from anywhere. Industry mentors, real‑time doubt solving, and recorded sessions.</p>
                        <div class="flex flex-col gap-1.5 mb-3">
                            <span class="feature-badge"><i class="fa-solid fa-video"></i> Live Classes</span>
                            <span class="feature-badge"><i class="fa-regular fa-clock"></i> Flexible Timing</span>
                            <span class="feature-badge"><i class="fa-solid fa-cloud-arrow-up"></i> Recorded Backup</span>
                        </div>
                        <div class="flex flex-col gap-1 mb-3 text-sm text-gray-700">
                            <span><i class="fa-regular fa-clock w-4"></i> 6 Months</span>
                            <span><i class="fa-regular fa-user w-4"></i> Unlimited Access</span>
                            <span><i class="fa-regular fa-hourglass-half w-4"></i> 120+ Learning Hours</span>
                        </div>
                        <div class="flex items-center justify-between mb-4">
                            <!-- <div><span class="text-2xl font-bold text-cyan-700">₹35,000</span><span class="text-sm text-gray-400 line-through ml-2">₹55,000</span><span class="text-sm font-semibold text-green-600 ml-2">36% off</span></div> -->
                            <span class="text-xs font-semibold bg-cyan-100 px-2 py-1 rounded-full text-cyan-800">Online</span>
                        </div>
                        <div class="flex gap-3 mt-auto">
                            <!-- Link to viewOnline with first course ID -->
                            <a href="/viewOnline/<%= firstCourseId %>" class="flex-1 bg-cyan-700 hover:bg-cyan-800 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">View Details</a>
                            <button onclick="downloadBrochure('<%= categoryDisplay %> Online Live')" class="px-3 py-2 border-2 border-cyan-600 text-cyan-700 rounded-lg hover:bg-cyan-50 transition-all text-sm flex items-center gap-2 font-semibold">
                                <i class="fa-regular fa-file-pdf"></i> Download Brochure
                            </button>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <!-- Regular Database Courses (Recorded) – vertical layout, lecture hours -->
            <% if (registerCourses && registerCourses.length > 0) { %>
                <% registerCourses.forEach(course => { %>
                    <div class="course-card rounded-xl overflow-hidden">
                        <div class="image-container relative">
                            <img src="<%= defaultImg %>" alt="<%= categoryDisplay %> Online Live" class="w-full h-full object-cover">
                            <div class="absolute top-3 left-3 bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded-full">Recorded</div>
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h3 class="text-xl font-bold text-gray-900 mb-2">  <%= toTitleCase(categoryDisplay) %></h3>
                            <div class="mb-3">
                                <span class="inline-block bg-purple-100 text-purple-800 text-xs font-bold px-2 py-0.5 rounded-full">Lecture Type: Recorded</span>
                            </div>
                            <p class="text-gray-700 text-sm mb-3 leading-relaxed"><%= course.courseDescription || course.description || 'No description available' %></p>
                            <div class="flex flex-col gap-1.5 mb-3">
                                <span class="feature-badge"><i class="fa-solid fa-briefcase"></i> Placement</span>
                                <span class="feature-badge"><i class="fa-solid fa-chart-line"></i> Live Projects</span>
                                <span class="feature-badge"><i class="fa-regular fa-certificate"></i> Certificate</span>
                            </div>
                            <div class="flex flex-col gap-1 mb-3 text-sm text-gray-700">
                                <span><i class="fa-regular fa-clock w-4"></i> <%= course.duration || 'N/A' %> Months</span>
                                <span><i class="fa-regular fa-user w-4"></i> <%= Math.floor(Math.random() * 5000) + 500 %>+ students</span>
                                <span><i class="fa-regular fa-hourglass-half w-4"></i> 120+ Learning Hours</span>
                            </div>
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <span class="text-2xl font-bold text-cyan-700">₹<%= course.price %></span>
                                    <span class="text-sm text-gray-400 line-through ml-2">₹<%= course.originalPrice %></span>
                                    <span class="text-sm font-semibold text-green-600 ml-2">
                                        <%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off
                                    </span>
                                </div>
                                <span class="text-xs font-semibold bg-cyan-100 px-2 py-1 rounded-full text-cyan-800">Recorded</span>
                            </div>
                            <div class="flex gap-3 mt-auto">
                                <a href="/viewCourse/<%= course._id %>" class="flex-1 bg-cyan-700 hover:bg-cyan-800 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">View Details</a>
                                <button onclick="downloadBrochure('<%= course.courseName %>')" class="px-3 py-2 border-2 border-cyan-600 text-cyan-700 rounded-lg hover:bg-cyan-50 transition-all text-sm flex items-center gap-2 font-semibold">
                                    <i class="fa-regular fa-file-pdf"></i> Download Brochure
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else if (!(selectedCategory && selectedCategory !== 'all')) { %>
                <div class="col-span-full text-center py-12">
                    <i class="fa-regular fa-folder-open text-6xl text-gray-400 mb-3"></i>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">No courses found</h3>
                    <p class="text-gray-600">No courses available at the moment. Please check back later.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

