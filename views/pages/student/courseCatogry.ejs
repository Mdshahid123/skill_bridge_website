<script>
    // Testimonial Carousel Logic (unchanged)
    (function() {
        const slider = document.getElementById('testimonialSlider');
        const dots = document.querySelectorAll('.testimonial-dot');
        let currentIndex = 0;
        let interval;
        const slideCount = dots.length;
        const autoSlideInterval = 5000;

        function updateSlider(index) {
            if (!slider) return;
            const slideWidth = slider.parentElement.clientWidth;
            slider.style.transform = `translateX(-${index * slideWidth}px)`;
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add('bg-cyan-600', 'w-5');
                    dot.classList.remove('bg-gray-300', 'w-3');
                } else {
                    dot.classList.add('bg-gray-300', 'w-3');
                    dot.classList.remove('bg-cyan-600', 'w-5');
                }
            });
            currentIndex = index;
        }

        function nextSlide() {
            let newIndex = currentIndex + 1;
            if (newIndex >= slideCount) newIndex = 0;
            updateSlider(newIndex);
        }

        function startAutoSlide() {
            if (interval) clearInterval(interval);
            interval = setInterval(nextSlide, autoSlideInterval);
        }

        function stopAutoSlide() {
            if (interval) clearInterval(interval);
        }

        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => updateSlider(currentIndex), 100);
        });

        dots.forEach(dot => {
            dot.addEventListener('click', (e) => {
                const index = parseInt(dot.getAttribute('data-index'));
                if (!isNaN(index)) {
                    stopAutoSlide();
                    updateSlider(index);
                    startAutoSlide();
                }
            });
        });

        const sliderParent = slider?.parentElement?.parentElement;
        if (sliderParent) {
            sliderParent.addEventListener('mouseenter', stopAutoSlide);
            sliderParent.addEventListener('mouseleave', startAutoSlide);
        }

        updateSlider(0);
        startAutoSlide();
    })();
</script>

