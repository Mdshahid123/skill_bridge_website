<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>
        <% if (selectedCategory && selectedCategory !== 'all') { %>
            <%= decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1) %> – SkillBridge
        <% } else { %>
            All Courses – SkillBridge
        <% } %>
    </title>
    <meta name="description" content="Browse our courses by category and find the perfect program for your career. Industry-ready training with placement assistance.">
    <meta name="keywords" content="courses, IT training, online learning, skill development">
    <meta name="author" content="SkillBridge">
    <link rel="canonical" href="https://www.skillbridge.com/courseCatogry">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { overflow-x: hidden; background: #f8fafc; scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; font-weight: 500; color: #1e293b; }
        .hero-glow {
            background: linear-gradient(135deg, #e6f4f5 0%, #d4eef2 50%, #c2e8ef 100%);
            position: relative;
            overflow: hidden;
        }
        .hero-glow::before {
            content: '';
            position: absolute;
            top: -30%;
            left: -30%;
            width: 160%;
            height: 160%;
            background: radial-gradient(circle, rgba(6,182,212,0.12), transparent 70%);
            animation: slowPulse 15s infinite alternate;
            pointer-events: none;
        }
        @keyframes slowPulse {
            0% { opacity: 0.3; transform: scale(1);}
            100% { opacity: 0.8; transform: scale(1.08);}
        }
        .brand-grid {
            background-image: repeating-linear-gradient(90deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px),
                              repeating-linear-gradient(0deg, #1a6f8c 0px, #1a6f8c 1px, transparent 1px, transparent 60px);
            background-size: 60px 60px;
        }
        /* Improved course card styles – more spacing, larger text */
        .course-card {
            transition: all 0.3s ease;
            background: white;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 8px 20px -8px rgba(0,0,0,0.06);
            display: flex;
            flex-direction: column;
            height: 100%;
            border-radius: 1rem;
        }
        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 25px 30px -12px rgba(0,0,0,0.12);
            border-color: rgba(6,182,212,0.3);
        }
        .feature-badge {
            background: #f0f9ff;
            color: #0c4e6e;
            padding: 6px 12px;
            font-weight: 600;
            border-radius: 40px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .course-modal {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            max-width: 90%;
            width: 500px;
            position: relative;
            animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .modal-close {
            position: absolute;
            top: 1rem; right: 1rem;
            cursor: pointer;
            font-size: 1.5rem;
            color: #6b7280;
        }
        /* Improved image container */
        .image-container { height: 200px; overflow: hidden; border-radius: 1rem 1rem 0 0; }
        @media (min-width: 768px) { .image-container { height: 220px; } }
        @media (max-width: 640px) {
            .container { padding-left: 1rem; padding-right: 1rem; }
            .grid { gap: 1rem; }
            .image-container { height: 180px; }
        }
        .faq-question {
            cursor: pointer;
            transition: all 0.2s;
        }
        .faq-answer {
            display: none;
            padding-top: 0.5rem;
        }
        .faq-answer.open {
            display: block;
        }
        .section-fade-up {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }
        .section-fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .testimonial-card, .tool-icon, .partner-logo, .faq-item {
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        .testimonial-card:hover, .tool-icon:hover, .partner-logo:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 25px -12px rgba(0,0,0,0.15);
        }
        .faq-item:hover {
            transform: translateX(4px);
        }
    </style>
</head>
<body>

<%- include("../../partials/common/navbar.ejs") %>

<!-- Hero Section (reduced height) -->
<div class="hero-glow pt-20 pb-10 relative">
    <div  class="absolute inset-0 opacity-[0.04] brand-grid pointer-events-none"></div>
    <div style="height:200px;" class="container mx-auto px-6 relative z-20">
        <div class="breadcrumb text-sm mb-3">
            <a href="/" class="text-teal-700/80 hover:text-teal-900">Home</a>
            <span class="text-gray-500 mx-2">/</span>
            <a href="/courseCatogry" class="text-teal-700/80 hover:text-teal-900">Courses</a>
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <span class="text-gray-500 mx-2">/</span>
                <span class="text-gray-800 font-semibold"><%= decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1) %></span>
            <% } %>
        </div>
        <h1  style=" font-weight: bolder; font-size:50px; margin-top: 30px;"  class="text-4xl md:text-4xl font-bold text-gray-900 text-center mb-2">
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <%= decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1) %> Programs
            <% } else { %>
                All Premium Courses
            <% } %>
        </h1>
        <p class="text-gray-700 text-center max-w-2xl mx-auto text-base font-medium">
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                Choose your learning path – classroom or online live or Recorded – and master <%= decodeURIComponent(selectedCategory).toLowerCase() %> with industry experts.
            <% } else { %>
                Discover a wide range of industry‑ready courses taught by expert mentors.
            <% } %>
        </p>
    </div>
</div>

<!-- Courses Grid + Extra Program Cards (improved spacing) -->
<section class="py-12 px-6 md:px-12 bg-transparent">
    <div class="container mx-auto max-w-7xl px-2 md:px-4">
        <% if (errorMessage) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl text-center mb-6">
                <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= errorMessage %>
            </div>
        <% } %>
        
        <% 
            if (typeof selectedCategory === 'undefined') selectedCategory = 'all';
            if (typeof registerCourses === 'undefined') registerCourses = [];
            let categoryDisplay = "Full Stack Development";
            if (selectedCategory && selectedCategory !== 'all') {
                categoryDisplay = decodeURIComponent(selectedCategory).charAt(0).toUpperCase() + decodeURIComponent(selectedCategory).slice(1);
            }
            const defaultImg = (registerCourses && registerCourses.length > 0 && registerCourses[0].image) 
                ? registerCourses[0].image 
                : 'https://via.placeholder.com/600x400?text=No+Image';
        %>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            <!-- Classroom Program Card -->
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <div class="course-card rounded-xl overflow-hidden border-l-4 border-l-amber-500">
                    <div class="image-container relative">
                        <img src="<%= defaultImg %>" alt="<%= categoryDisplay %> Classroom" class="w-full h-full object-cover">
                        <div class="absolute top-3 left-3 bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded-full">Classroom Program</div>
                    </div>
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-xl font-bold text-gray-900 mb-2"><%= categoryDisplay %> – Classroom</h3>
                        <p class="text-gray-700 text-sm mb-3 leading-relaxed">Instructor‑led classroom training with hands‑on projects, peer collaboration, and campus placement support.</p>
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class="feature-badge"><i class="fa-solid fa-chalkboard-user"></i> On‑Campus</span>
                            <span class="feature-badge"><i class="fa-solid fa-users"></i> Group Learning</span>
                            <span class="feature-badge"><i class="fa-regular fa-building"></i> Lab Access</span>
                        </div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-sm text-gray-700"><i class="fa-regular fa-clock"></i> 6 Months</span>
                            <span class="text-sm text-gray-700"><i class="fa-regular fa-user"></i> Limited Seats</span>
                        </div>
                        <div class="flex items-center justify-between mb-4">
                            <div><span class="text-2xl font-bold text-amber-700">₹45,000</span><span class="text-sm text-gray-400 line-through ml-2">₹65,000</span><span class="text-sm font-semibold text-green-600 ml-2">31% off</span></div>
                            <span class="text-xs font-semibold bg-amber-100 px-2 py-1 rounded-full text-amber-800">Classroom</span>
                        </div>
                        <div class="flex gap-3 mt-auto">
                            <button onclick="openEnrollModal('<%= categoryDisplay %> Classroom')" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">Enroll Now</button>
                            <button onclick="downloadBrochure('<%= categoryDisplay %> Classroom')" class="px-3 py-2 border-2 border-amber-600 text-amber-700 rounded-lg hover:bg-amber-50 transition-all text-sm"><i class="fa-regular fa-file-pdf"></i></button>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <!-- Online Live Program Card -->
            <% if (selectedCategory && selectedCategory !== 'all') { %>
                <div class="course-card rounded-xl overflow-hidden border-l-4 border-l-cyan-500">
                    <div class="image-container relative">
                        <img src="<%= defaultImg %>" alt="<%= categoryDisplay %> Online Live" class="w-full h-full object-cover">
                        <div class="absolute top-3 left-3 bg-cyan-500 text-white text-xs font-bold px-2 py-1 rounded-full">Online Live</div>
                    </div>
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-xl font-bold text-gray-900 mb-2"><%= categoryDisplay %> – Online Live</h3>
                        <p class="text-gray-700 text-sm mb-3 leading-relaxed">Live interactive classes from anywhere. Industry mentors, real‑time doubt solving, and recorded sessions.</p>
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class="feature-badge"><i class="fa-solid fa-video"></i> Live Classes</span>
                            <span class="feature-badge"><i class="fa-regular fa-clock"></i> Flexible Timing</span>
                            <span class="feature-badge"><i class="fa-solid fa-cloud-arrow-up"></i> Recorded Backup</span>
                        </div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-sm text-gray-700"><i class="fa-regular fa-clock"></i> 6 Months</span>
                            <span class="text-sm text-gray-700"><i class="fa-regular fa-user"></i> Unlimited Access</span>
                        </div>
                        <div class="flex items-center justify-between mb-4">
                            <div><span class="text-2xl font-bold text-cyan-700">₹35,000</span><span class="text-sm text-gray-400 line-through ml-2">₹55,000</span><span class="text-sm font-semibold text-green-600 ml-2">36% off</span></div>
                            <span class="text-xs font-semibold bg-cyan-100 px-2 py-1 rounded-full text-cyan-800">Online</span>
                        </div>
                        <div class="flex gap-3 mt-auto">
                            <button onclick="openEnrollModal('<%= categoryDisplay %> Online Live')" class="flex-1 bg-cyan-700 hover:bg-cyan-800 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">Enroll Now</button>
                            <button onclick="downloadBrochure('<%= categoryDisplay %> Online Live')" class="px-3 py-2 border-2 border-cyan-600 text-cyan-700 rounded-lg hover:bg-cyan-50 transition-all text-sm"><i class="fa-regular fa-file-pdf"></i></button>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <!-- Regular Database Courses (Recorded Program) with improved spacing -->
            <% if (registerCourses && registerCourses.length > 0) { %>
                <% registerCourses.forEach(course => { %>
                    <div class="course-card rounded-xl overflow-hidden">
                        <div class="image-container relative">
                            <img src="<%= course.image || 'https://via.placeholder.com/600x400?text=No+Image' %>" alt="<%= course.courseName %>" class="w-full h-full object-cover">
                            <div class="absolute top-3 left-3 bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded-full">Recorded Program</div>
                        </div>
                        <div class="p-5 flex flex-col flex-grow">
                            <h3 class="text-lg font-bold text-gray-900 mb-2"><%= course.courseName %></h3>
                            <p class="text-gray-700 text-sm mb-3 leading-relaxed"><%= course.courseDescription || course.description || 'No description available' %></p>
                            <div class="flex flex-wrap gap-2 mb-3">
                                <span class="feature-badge"><i class="fa-solid fa-briefcase"></i> Placement</span>
                                <span class="feature-badge"><i class="fa-solid fa-chart-line"></i> Live Projects</span>
                                <span class="feature-badge"><i class="fa-regular fa-certificate"></i> Certificate</span>
                            </div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-sm text-gray-700"><i class="fa-regular fa-clock"></i> <%= course.duration || 'N/A' %> Months</span>
                                <span class="text-sm text-gray-700"><i class="fa-regular fa-user"></i> <%= Math.floor(Math.random() * 5000) + 500 %>+ students</span>
                            </div>
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <span class="text-2xl font-bold text-cyan-700">₹<%= course.price %></span>
                                    <span class="text-sm text-gray-400 line-through ml-2">₹<%= course.originalPrice %></span>
                                    <span class="text-sm font-semibold text-green-600 ml-2">
                                        <%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off
                                    </span>
                                </div>
                                <span class="text-xs font-semibold bg-gray-200 px-2 py-1 rounded-full"><%= course.level || 'Beginner' %></span>
                            </div>
                            <div class="flex gap-3 mt-auto">
                                <a href="/viewCourse/<%= course.courseName %>" class="flex-1 bg-cyan-700 hover:bg-cyan-800 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all shadow-md">View Details</a>
                                <button onclick="downloadBrochure('<%= course.courseName %>')" class="px-3 py-2 border-2 border-cyan-600 text-cyan-700 rounded-lg hover:bg-cyan-50 transition-all"><i class="fa-regular fa-file-pdf"></i></button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else if (!(selectedCategory && selectedCategory !== 'all')) { %>
                <div class="col-span-full text-center py-12">
                    <i class="fa-regular fa-folder-open text-6xl text-gray-400 mb-3"></i>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">No courses found</h3>
                    <p class="text-gray-600">No courses available at the moment. Please check back later.</p>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- ========== THE FOLLOWING SECTIONS (Tools, Testimonials, Partners, FAQ, Modal) REMAIN EXACTLY AS IN YOUR ORIGINAL FILE ========== -->
<!-- (They are identical to your provided code – I am including them exactly as you had to avoid any changes) -->
<!-- 1️⃣ Tools & Technologies Covered (Sky/Blue gradient) -->
<section class="py-20 bg-gradient-to-b from-sky-50 to-blue-50">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-100 text-cyan-700 text-sm font-bold uppercase tracking-wider shadow-sm">Tech Stack</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-4 mb-4">Tools & Technologies You'll Master</h2>
            <p class="text-gray-600 text-lg">Industry-relevant tools to make you job-ready from day one</p>
        </div>

        <div class="flex flex-wrap justify-center gap-6 md:gap-8">
            <% 
                const toolData = {
                    'frontend development': [
                        { icon: 'fab fa-html5', label: 'HTML5', color: 'from-orange-500 to-orange-600', textColor: 'text-orange-600' },
                        { icon: 'fab fa-css3-alt', label: 'CSS3', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' },
                        { icon: 'fab fa-js', label: 'JavaScript', color: 'from-yellow-400 to-yellow-500', textColor: 'text-yellow-600' },
                        { icon: 'fab fa-react', label: 'React', color: 'from-cyan-400 to-cyan-500', textColor: 'text-cyan-600' },
                        { icon: 'fab fa-tailwind', label: 'Tailwind', color: 'from-teal-400 to-teal-500', textColor: 'text-teal-600' },
                        { icon: 'fab fa-figma', label: 'Figma', color: 'from-purple-400 to-purple-500', textColor: 'text-purple-600' }
                    ],
                    'backend development': [
                        { icon: 'fab fa-node-js', label: 'Node.js', color: 'from-green-500 to-green-600', textColor: 'text-green-600' },
                        { icon: 'fab fa-python', label: 'Python', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' },
                        { icon: 'fab fa-java', label: 'Java', color: 'from-red-500 to-red-600', textColor: 'text-red-600' },
                        { icon: 'fas fa-database', label: 'MongoDB', color: 'from-emerald-500 to-emerald-600', textColor: 'text-emerald-600' },
                        { icon: 'fab fa-php', label: 'PHP', color: 'from-indigo-500 to-indigo-600', textColor: 'text-indigo-600' },
                        { icon: 'fas fa-server', label: 'Express', color: 'from-gray-600 to-gray-700', textColor: 'text-gray-700' }
                    ],
                    'data science': [
                        { icon: 'fab fa-python', label: 'Python', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' },
                        { icon: 'fas fa-chart-line', label: 'Pandas', color: 'from-green-500 to-green-600', textColor: 'text-green-600' },
                        { icon: 'fas fa-database', label: 'SQL', color: 'from-orange-500 to-orange-600', textColor: 'text-orange-600' },
                        { icon: 'fas fa-cloud', label: 'Cloud', color: 'from-cyan-500 to-cyan-600', textColor: 'text-cyan-600' },
                        { icon: 'fas fa-chart-pie', label: 'Tableau', color: 'from-purple-500 to-purple-600', textColor: 'text-purple-600' },
                        { icon: 'fas fa-brain', label: 'TensorFlow', color: 'from-amber-500 to-amber-600', textColor: 'text-amber-600' }
                    ],
                    'full stack mern': [
                        { icon: 'fab fa-react', label: 'React', color: 'from-cyan-400 to-cyan-500', textColor: 'text-cyan-600' },
                        { icon: 'fab fa-node-js', label: 'Node.js', color: 'from-green-500 to-green-600', textColor: 'text-green-600' },
                        { icon: 'fas fa-database', label: 'MongoDB', color: 'from-emerald-500 to-emerald-600', textColor: 'text-emerald-600' },
                        { icon: 'fab fa-js', label: 'JavaScript', color: 'from-yellow-400 to-yellow-500', textColor: 'text-yellow-600' },
                        { icon: 'fab fa-html5', label: 'HTML5', color: 'from-orange-500 to-orange-600', textColor: 'text-orange-600' },
                        { icon: 'fab fa-css3-alt', label: 'CSS3', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' }
                    ],
                    default: [
                        { icon: 'fab fa-html5', label: 'HTML5', color: 'from-orange-500 to-orange-600', textColor: 'text-orange-600' },
                        { icon: 'fab fa-css3-alt', label: 'CSS3', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' },
                        { icon: 'fab fa-js', label: 'JavaScript', color: 'from-yellow-400 to-yellow-500', textColor: 'text-yellow-600' },
                        { icon: 'fab fa-react', label: 'React', color: 'from-cyan-400 to-cyan-500', textColor: 'text-cyan-600' },
                        { icon: 'fab fa-python', label: 'Python', color: 'from-blue-500 to-blue-600', textColor: 'text-blue-600' },
                        { icon: 'fas fa-database', label: 'SQL', color: 'from-orange-500 to-orange-600', textColor: 'text-orange-600' }
                    ]
                };
                let toolsList = toolData.default;
                if (selectedCategory && selectedCategory !== 'all') {
                    const catKey = decodeURIComponent(selectedCategory).toLowerCase();
                    if (toolData[catKey]) toolsList = toolData[catKey];
                    else toolsList = toolData.default;
                }
                toolsList.forEach(tool => { %>
                    <div class="group w-28 h-28 md:w-32 md:h-32 bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 flex flex-col items-center justify-center gap-2 hover:-translate-y-2 relative overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-br <%= tool.color %> opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
                        <i class="<%= tool.icon %> text-4xl md:text-5xl <%= tool.textColor %> group-hover:scale-110 transition-transform duration-300"></i>
                        <span class="text-gray-700 font-semibold text-sm"><%= tool.label %></span>
                    </div>
            <% }); %>
        </div>
        <p class="text-center text-gray-500 text-sm mt-12">+ many more frameworks and libraries</p>
    </div>
</section>

<!-- 2️⃣ Student Testimonials (Amber/Orange gradient) -->
<section class="py-20 bg-gradient-to-b from-amber-50 to-orange-50">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-cyan-600 text-sm font-bold uppercase tracking-wider bg-cyan-50 px-4 py-1.5 rounded-full">Success Stories</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-4">What Our Students Say</h2>
            <p class="text-gray-600 text-lg mt-3">Join 15,000+ successful graduates who transformed their careers</p>
        </div>

        <!-- Carousel Container -->
        <div class="relative max-w-5xl mx-auto">
            <div class="overflow-hidden rounded-2xl">
                <div id="testimonialSlider" class="flex transition-transform duration-500 ease-in-out">
                    <!-- Slide 1 -->
                    <div class="w-full flex-shrink-0 px-4">
                        <div class="bg-white rounded-2xl p-8 shadow-xl border border-gray-100 relative">
                            <i class="fa-solid fa-quote-left text-5xl text-cyan-100 absolute top-6 right-6"></i>
                            <div class="flex items-center gap-1 mb-5">
                                <i class="fa-solid fa-star text-yellow-400"></i><i class="fa-solid fa-star text-yellow-400"></i><i class="fa-solid fa-star text-yellow-400"></i><i class="fa-solid fa-star text-yellow-400"></i><i class="fa-solid fa-star text-yellow-400"></i>
                            </div>
