<script>
    window.downloadBrochure = function(courseName) {
        alert(`📄 Downloading brochure for "${courseName}"\n\nBrochure will be available shortly.`);
    };
    let selectedCourse = "";
    window.openEnrollModal = function(course) {
        selectedCourse = course;
        document.getElementById('courseNameDisplay').value = course;
        document.getElementById('interestedCourse').value = course;
        document.getElementById('enrollModal').style.display = 'flex';
    };
    const modal = document.getElementById('enrollModal');
    const closeBtn = document.getElementById('closeEnrollModal');
    const form = document.getElementById('enrollmentForm');
    if (closeBtn) closeBtn.onclick = () => modal.style.display = 'none';
    if (modal) modal.onclick = (e) => { if (e.target === modal) modal.style.display = 'none'; };
    if (form) form.onsubmit = (e) => {
        e.preventDefault();
        alert(`✅ Thank you! Our counselor will contact you regarding ${selectedCourse}`);
        form.reset();
        modal.style.display = 'none';
    };
</script>
