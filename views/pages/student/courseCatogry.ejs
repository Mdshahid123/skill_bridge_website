<script>
    // Testimonial Carousel Logic (unchanged)
    (function() {
        const slider = document.getElementById('testimonialSlider');
        const dots = document.querySelectorAll('.testimonial-dot');
        let currentIndex = 0;
        let interval;
        const slideCount = dots.length;
        const autoSlideInterval = 5000;

        function updateSlider(index) {
            if (!slider) return;
            const slideWidth = slider.parentElement.clientWidth;
            slider.style.transform = `translateX(-${index * slideWidth}px)`;
            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.add('bg-cyan-600', 'w-5');
                    dot.classList.remove('bg-gray-300', 'w-3');
                } else {
                    dot.classList.add('bg-gray-300', 'w-3');
                    dot.classList.remove('bg-cyan-600', 'w-5');
                }
            });
            currentIndex = index;
        }

        function nextSlide() {
            let newIndex = currentIndex + 1;
            if (newIndex >= slideCount) newIndex = 0;
            updateSlider(newIndex);
        }

        function startAutoSlide() {
            if (interval) clearInterval(interval);
            interval = setInterval(nextSlide, autoSlideInterval);
        }

        function stopAutoSlide() {
            if (interval) clearInterval(interval);
        }

        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => updateSlider(currentIndex), 100);
        });

        dots.forEach(dot => {
            dot.addEventListener('click', (e) => {
                const index = parseInt(dot.getAttribute('data-index'));
                if (!isNaN(index)) {
                    stopAutoSlide();
                    updateSlider(index);
                    startAutoSlide();
                }
            });
        });

        const sliderParent = slider?.parentElement?.parentElement;
        if (sliderParent) {
            sliderParent.addEventListener('mouseenter', stopAutoSlide);
            sliderParent.addEventListener('mouseleave', startAutoSlide);
        }

        updateSlider(0);
        startAutoSlide();
    })();
</script>
<script>
    // FAQ Accordion Logic
    (function() {
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            const answer = item.querySelector('.faq-answer');
            const icon = question.querySelector('.fa-chevron-down');
            question.addEventListener('click', () => {
                const isOpen = answer.classList.contains('open');
                faqItems.forEach(otherItem => {
                    const otherAnswer = otherItem.querySelector('.faq-answer');
                    const otherIcon = otherItem.querySelector('.fa-chevron-down');
                    if (otherAnswer !== answer && otherAnswer.classList.contains('open')) {
                        otherAnswer.classList.remove('open');
                        otherAnswer.classList.add('hidden');
                        otherIcon.style.transform = 'rotate(0deg)';
                    }
                });
                if (isOpen) {
                    answer.classList.remove('open');
                    answer.classList.add('hidden');
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    answer.classList.add('open');
                    answer.classList.remove('hidden');
                    icon.style.transform = 'rotate(180deg)';
                }
            });
        });
    })();
</script>

