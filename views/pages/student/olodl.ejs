    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #0a0a0f; color: #e5e7eb; }

        /* ====== HERO & COMMON STYLES ====== */
        .hero-olodl {
            background: linear-gradient(145deg, #0a0a0f, #111827, #0a1628);
            position: relative;
            overflow: hidden;
        }
        .hero-grid {
            background-image: 
                repeating-linear-gradient(90deg, rgba(34,211,238,0.06) 0px, rgba(34,211,238,0.06) 1px, transparent 1px, transparent 50px),
                repeating-linear-gradient(0deg, rgba(34,211,238,0.06) 0px, rgba(34,211,238,0.06) 1px, transparent 1px, transparent 50px);
            background-size: 50px 50px;
            animation: gridMove 8s linear infinite;
        }
        @keyframes gridMove {
            0% { background-position: 0 0; }
            100% { background-position: 50px 50px; }
        }
        .glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            pointer-events: none;
            animation: pulseOrb 4s ease-in-out infinite;
        }
        .glow-orb-1 { width: 350px; height: 350px; top: -80px; right: -80px; background: rgba(6,182,212,0.2); }
        .glow-orb-2 { width: 250px; height: 250px; bottom: -40px; left: 5%; background: rgba(59,130,246,0.25); animation-delay: 2s; }
        .glow-orb-3 { width: 180px; height: 180px; top: 40%; right: 15%; background: rgba(139,92,246,0.2); animation-delay: 1.5s; }
        @keyframes pulseOrb {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.2); opacity: 0.8; }
        }
        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(34,211,238,0.15);
            pointer-events: none;
            animation: floatParticle 8s ease-in-out infinite;
        }
        .p1 { width: 8px; height: 8px; top: 15%; left: 8%; animation-duration: 6s; }
        .p2 { width: 14px; height: 14px; top: 65%; left: 90%; animation-duration: 9s; animation-delay: 1s; }
        .p3 { width: 6px; height: 6px; top: 30%; left: 80%; animation-duration: 5s; animation-delay: 2s; }
        .p4 { width: 10px; height: 10px; top: 85%; left: 20%; animation-duration: 7s; animation-delay: 0.5s; }
        .p5 { width: 7px; height: 7px; top: 20%; left: 50%; animation-duration: 6.5s; animation-delay: 1.5s; }
        .p6 { width: 12px; height: 12px; top: 50%; left: 60%; animation-duration: 8.5s; animation-delay: 3s; opacity: 0.08; }
        .p7 { width: 5px; height: 5px; top: 75%; left: 45%; animation-duration: 7.5s; animation-delay: 2.5s; }
        .p8 { width: 9px; height: 9px; top: 10%; left: 35%; animation-duration: 5.5s; animation-delay: 1.8s; }
        @keyframes floatParticle {
            0%, 100% { transform: translate(0,0) scale(1); opacity: 0.3; }
            25% { transform: translate(25px,-20px) scale(1.1); opacity: 0.7; }
            50% { transform: translate(-10px,-35px) scale(0.9); opacity: 0.4; }
            75% { transform: translate(15px,-10px) scale(1.05); opacity: 0.6; }
        }
        .animate-border-glow { animation: borderGlow 2s ease-in-out infinite; }
        .animate-border-glow-delay { animation: borderGlow 2.5s ease-in-out infinite 1s; }
        @keyframes borderGlow {
            0%, 100% { border-color: rgba(34,211,238,0.3); box-shadow: 0 0 10px rgba(34,211,238,0); }
            50% { border-color: rgba(34,211,238,1); box-shadow: 0 0 30px rgba(34,211,238,0.5); }
        }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-up { animation: fadeUp 0.6s ease-out forwards; opacity: 0; }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-slide-down { animation: slideDown 0.5s ease-out forwards; opacity: 0; }
        @keyframes pulseRing { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
        .animate-pulse-ring { animation: pulseRing 1.5s ease-in-out infinite; }

        /* ====== GLASS CARDS ====== */
        .glass-card {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 1.25rem;
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            border-color: rgba(34,211,238,0.3);
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -12px rgba(0,0,0,0.4);
        }
        .glass-card-dark {
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 1.25rem;
            transition: all 0.3s ease;
        }
        .glass-card-dark:hover {
            border-color: rgba(34,211,238,0.2);
            transform: translateY(-4px);
        }

        /* ====== ACCORDION ====== */
        .faq-question {
            cursor: pointer;
            transition: all 0.2s;
        }
        .faq-answer {
            display: none;
            padding-top: 0.5rem;
        }
        .faq-answer.open { display: block; }

        /* ====== GRADIENT TEXT ====== */
        .gradient-text {
            background: linear-gradient(135deg, #22d3ee, #3b82f6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .gradient-border-top {
            border-top: 2px solid transparent;
            background-image: linear-gradient(135deg, #22d3ee, #3b82f6, #8b5cf6);
            background-origin: border-box;
            background-clip: padding-box, border-box;
        }

        /* ====== RESPONSIVE ====== */
        @media (max-width: 768px) {
            .hero-olodl { padding-top: 4rem; padding-bottom: 3rem; }
        }
    </style>
</head>
