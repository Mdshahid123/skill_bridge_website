                    { q: "Are online degrees accepted abroad?", a: "Yes. Many international employers and universities accept online degrees from reputed Indian universities, though acceptance may vary by country and institution." },
                    { q: "How does SkillBridge help students choose the right program?", a: "SkillBridge provides unbiased counselling to help students choose UGC-approved universities, career-oriented specializations, and avoid unrecognized institutions." },
                    { q: "Are online programs easier than regular programs?", a: "No. Online programs follow the same academic standards, assessments, and examinations as regular programs. Discipline and time management are key to success." }
                ]; %>
                <% faqs.forEach((faq, index) => { %>
                    <div class="faq-item glass-card-dark p-5 border-l-4 border-l-cyan-400/40">
                        <div class="faq-question flex justify-between items-center cursor-pointer hover:bg-white/5 transition-colors rounded-lg p-2 -m-2">
                            <div class="flex items-center gap-3">
                                <i class="fa-regular fa-circle-question text-cyan-400 text-lg"></i>
                                <h3 class="font-bold text-white"><%= faq.q %></h3>
                            </div>
                            <i class="fa-solid fa-chevron-down text-gray-500 transition-transform duration-300"></i>
                        </div>
                        <div class="faq-answer text-gray-300 text-sm leading-relaxed pt-3 border-t border-white/5 mt-3"><%= faq.a %></div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- FINAL CTA                                                     -->
    <!-- ============================================================ -->
    <section class="py-16 lg:py-20 bg-gradient-to-r from-cyan-600/20 via-blue-600/20 to-purple-600/20 border-t border-white/5">
        <div class="container mx-auto px-6 lg:px-12 text-center">
            <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Ready to Advance Your Career?</h2>
            <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Get personalised guidance on UGC-approved online programs, specializations, and admission process.</p>
            <a href="/contact" class="inline-block px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-full font-bold shadow-lg hover:scale-105 transition-all">Talk to a Counsellor <i class="fa-solid fa-arrow-right ml-2"></i></a>
        </div>
    </section>

    <%- include("../../partials/common/footer") %>

    <!-- ============================================================ -->
    <!-- SCRIPT: FAQ ACCORDION                                        -->
    <!-- ============================================================ -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const question = item.querySelector('.faq-question');
                const answer = item.querySelector('.faq-answer');
                const icon = question.querySelector('.fa-chevron-down');
                question.addEventListener('click', function() {
                    const isOpen = answer.classList.contains('open');
                    // Close all others
                    faqItems.forEach(other => {
                        const otherAnswer = other.querySelector('.faq-answer');
                        const otherIcon = other.querySelector('.fa-chevron-down');
                        if (otherAnswer !== answer && otherAnswer.classList.contains('open')) {
                            otherAnswer.classList.remove('open');
                            otherAnswer.style.display = 'none';
                            if (otherIcon) otherIcon.style.transform = 'rotate(0deg)';
                        }
                    });
                    if (isOpen) {
                        answer.classList.remove('open');
                        answer.style.display = 'none';
                        if (icon) icon.style.transform = 'rotate(0deg)';
                    } else {
                        answer.classList.add('open');
                        answer.style.display = 'block';
                        if (icon) icon.style.transform = 'rotate(180deg)';
                    }
                });
            });
        });
    </script>
</body>
</html>