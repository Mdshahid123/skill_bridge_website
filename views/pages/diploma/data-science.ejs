                        <i class="fa-regular fa-calendar-check"></i> SCHEDULE A DEMO
                    </button>
                </div>

                <!-- Trust Indicators -->
                <div style="display: none;" class="flex flex-wrap gap-3 justify-center lg:justify-start text-sm">
                    <span class="flex items-center gap-1.5 bg-white/10 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20 text-gray-200">
                        <i class="fa-regular fa-circle-check text-cyan-400 text-xs"></i> UGC Approved
                    </span>
                    <span class="flex items-center gap-1.5 bg-white/10 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20 text-gray-200">
