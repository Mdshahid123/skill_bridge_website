<script>
    // ========== TOGGLE MODULE ==========
    function toggleModule(header) {
        const content = header.nextElementSibling;
        const icon = header.querySelector('.fa-chevron-down');
        if (content.style.display === 'none' || !content.style.display) {
            content.style.display = 'block';
            if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
            content.style.display = 'none';
            if (icon) icon.style.transform = 'rotate(-90deg)';
        }
    }

    // ========== FAQ ACCORDION ==========
    document.addEventListener('DOMContentLoaded', function() {
        const faqItems = document.querySelectorAll('.faq-question');
        faqItems.forEach((question, idx) => {
            const container = question.closest('.bg-white');
            const answer = container.querySelector('.faq-answer');
            const icon = question.querySelector('.fa-chevron-down');
            if (idx === 0) {
                answer.classList.add('open');
                answer.style.display = 'block';
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                answer.style.display = 'none';
            }
            question.addEventListener('click', function(e) {
                e.stopPropagation();
                const isOpen = answer.classList.contains('open');
                // Close all others
                document.querySelectorAll('.faq-answer').forEach(el => {
                    el.classList.remove('open');
                    el.style.display = 'none';
                    const ic = el.closest('.bg-white').querySelector('.fa-chevron-down');
                    if (ic) ic.style.transform = 'rotate(0deg)';
                });
                if (!isOpen) {
                    answer.classList.add('open');
                    answer.style.display = 'block';
                    if (icon) icon.style.transform = 'rotate(180deg)';
                }
            });
        });
    });
</script>

