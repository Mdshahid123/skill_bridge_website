        </div>
    </div>
</section>

<!-- ==================== WHO SHOULD ATTEND – CARDS WITH GRADIENT BORDERS ==================== -->
<section class="py-16 bg-gradient-to-b from-teal-50 via-white to-cyan-50 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30">
        <div class="absolute top-0 left-0 w-80 h-80 bg-purple-200 rounded-full blur-3xl"></div>
