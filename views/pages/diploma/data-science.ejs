                <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-teal-50 to-cyan-50 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative z-10 flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center text-white text-xl shadow-lg shadow-teal-200 flex-shrink-0">
                        <i class="fa-regular fa-user-graduate"></i>
                    </div>
                    <div>
                        <p class="text-gray-700 text-sm leading-relaxed"><strong class="text-teal-700">Students/freshers</strong> aiming for data/analyst roles with proof of work.</p>
                    </div>
                </div>
