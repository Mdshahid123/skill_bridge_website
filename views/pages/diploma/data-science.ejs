                        <i class="fa-regular fa-file-pdf"></i> DOWNLOAD CURRICULUM
                    </a>
                    <a href="#inquiry" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-extrabold text-sm border-2 border-cyan-400 text-cyan-300 hover:bg-cyan-400/10 hover:shadow-md transition-all hover:scale-105">
