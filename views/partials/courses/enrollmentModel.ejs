<div id="enrollModal" class="modal-overlay">
        <div class="course-modal" style="max-width: 500px;">
            <div class="modal-close" id="closeEnrollModal">&times;</div>
            <div class="text-center mb-6">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-[#1a1a2e] to-[#0f3460] flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-graduation-cap text-white text-xl"></i>
                </div>
                <h2 class="text-xl font-bold text-gray-800">Start Your Journey</h2>
                <p class="text-gray-500 text-xs mt-1">Fill the form to get a free counseling session</p>
            </div>
            <form id="enrollmentForm" class="space-y-3">
                <div><label class="block text-xs font-medium text-gray-700 mb-1">Full Name *</label><input type="text" id="fullName" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="Enter your full name"></div>
                <div><label class="block text-xs font-medium text-gray-700 mb-1">Email Address *</label><input type="email" id="email" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="you@example.com"></div>
                <div><label class="block text-xs font-medium text-gray-700 mb-1">Phone Number *</label><input type="tel" id="phone" required class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="+91 98765 43210"></div>
                <div><label class="block text-xs font-medium text-gray-700 mb-1">Interested Course</label><select id="courseSelect" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]"><option value="">Select a course</option><option>Web Development</option><option>Data Science & AI</option><option>Cloud & DevOps</option><option>Data Structures & Algorithms</option><option>Cybersecurity</option><option>Digital Marketing</option><option>UI/UX Design</option><option>Blockchain Development</option></select></div>
                <div><label class="block text-xs font-medium text-gray-700 mb-1">Message (Optional)</label><textarea id="message" rows="2" class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-[#1a6f8c]" placeholder="Any specific questions?"></textarea></div>
                <button type="submit" class="w-full bg-gradient-to-r from-[#1a1a2e] to-[#0f3460] text-white py-2.5 rounded-lg font-semibold text-sm transition-all hover:opacity-90">Submit Application <i class="fa-solid fa-arrow-right ml-2"></i></button>
            </form>
            <p class="text-center text-[10px] text-gray-400 mt-3">We'll contact you within 24 hours. No spam, guaranteed.</p>
        </div>
    </div>

    <!-- Course Detail Modal -->
    <div id="courseDetailModal" class="modal-overlay">
        <div class="course-modal">
            <div class="modal-close" id="closeCourseModal">&times;</div>
            <div id="courseModalContent"></div>
        </div>
    </div>