<!-- courses.ejs - Course Cards Section -->
<section class="py-12 px-6 md:px-12 bg-white">
    <div class="container mx-auto max-w-7xl">
        <!-- Courses Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <% if (registerCourses && registerCourses.length > 0) { %>
                <% registerCourses.forEach(course => { %>
                    <div class="course-card bg-white rounded-xl overflow-hidden shadow-md border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                        <!-- Course Image -->
                        <div class="relative h-48 overflow-hidden">
                            <img src="<%= course.image %>" alt="<%= course.courseName %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105">
                        </div>
                        
                        <!-- Course Content -->
                        <div class="p-5">
                            <h3 class="text-lg font-bold text-gray-800 mb-2 line-clamp-1"><%= course.courseName %></h3>
                            <p class="text-gray-500 text-sm mb-3 line-clamp-2"><%= course.description %></p>
                            
                            <!-- Features Badges -->
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                <span class="feature-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-[10px]">
                                    <i class="fa-solid fa-briefcase text-[8px]"></i> Assured Placement
                                </span>
                                <span class="feature-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[10px]">
                                    <i class="fa-solid fa-chart-line text-[8px]"></i> Live Projects
                                </span>
                                <span class="feature-badge inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-purple-50 text-purple-700 text-[10px]">
                                    <i class="fa-regular fa-certificate text-[8px]"></i> Certificate
                                </span>
                            </div>
                            
                            <!-- Course Meta Info -->
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2 text-xs text-gray-500">
                                    <i class="fa-regular fa-clock"></i>
                                    <span><%= course.duration %> Months</span>
                                </div>
                                <div class="flex items-center gap-2 text-xs text-gray-500">
                                    <i class="fa-regular fa-user"></i>
                                    <span><%= Math.floor(Math.random() * 5000) + 500 %>+ students</span>
                                </div>
                            </div>
                            
                            <!-- Price Section -->
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <span class="text-2xl font-bold text-teal-600">₹<%= course.price %></span>
                                    <span class="text-xs text-gray-400 line-through ml-2">₹<%= course.originalPrice %></span>
                                    <span class="text-xs text-green-600 ml-2"><%= Math.round(((course.originalPrice - course.price) / course.originalPrice) * 100) %>% off</span>
                                </div>
                                <span class="text-xs bg-gray-100 px-2 py-1 rounded-full"><%= course.level %></span>
                            </div>
                            
                            <!-- Buttons -->
                            <div class="flex gap-2">
                                <a href="/viewCourse/<%= course._id %>" class="flex-1 bg-gradient-to-r from-teal-500 to-blue-600 hover:from-teal-600 hover:to-blue-700 text-white text-center py-2 rounded-lg font-semibold text-sm transition-all duration-300 hover:scale-105">
                                    View Details
                                </a>
                                <button onclick="downloadBrochure('<%= course.courseName %>')" class="px-3 py-2 border border-teal-500 text-teal-600 rounded-lg hover:bg-teal-500 hover:text-white transition-all duration-300">
                                    <i class="fa-regular fa-file-pdf"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <!-- No Courses Found -->
                <div class="col-span-3 text-center py-12">
                    <i class="fa-regular fa-folder-open text-6xl text-gray-300 mb-4"></i>
                    <h3 class="text-xl font-semibold text-gray-700 mb-2">No courses found</h3>
                    <p class="text-gray-500">Check back later for new courses</p>
                </div>
            <% } %>
            
        </div>
    </div>
</section>

<style>
    /* Line clamp utility */
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    /* Course card transition */
    .course-card {
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    
    /* Feature badges */
    .feature-badge {
        transition: all 0.2s ease;
    }
    .feature-badge:hover {
        transform: translateY(-1px);
    }
</style>

<script>
    // Download brochure function
    function downloadBrochure(courseName) {
        alert(`📄 Downloading brochure for "${courseName}"\n\nBrochure will be available shortly.`);
        // In production: window.open(`/brochures/${courseName}.pdf`, '_blank');
    }
</script>