 <div class="hero-glow pt-28 pb-16 relative overflow-visible">
    <div class="absolute inset-0 opacity-[0.08] brand-grid pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.05] brand-grid-light pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
        style="background-image: 
            repeating-linear-gradient(45deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px),
            repeating-linear-gradient(135deg, #1a6f8c 0px, #1a6f8c 0.5px, transparent 0.5px, transparent 80px);">
    </div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-teal-400/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="container mx-auto px-6 relative z-20">
        <div class="breadcrumb text-sm mb-4">
            <a href="/" class="text-teal-700/70 hover:text-teal-700">Home</a>
            <span class="text-teal-700/40 mx-2">/</span>
            <span class="text-teal-800 font-medium">Courses</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 text-center mb-3 glow-text">All Premium Courses</h1>
        <p class="text-gray-600 text-center max-w-2xl mx-auto mb-8">Explore our comprehensive collection of industry-ready courses taught by expert mentors</p>
        
        <div class="max-w-3xl mx-auto mb-6">
            <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
                <!-- Search Bar -->
                <div class="relative flex-1 max-w-md">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="courseSearchInput" placeholder="Search courses by name, category, or skill..." 
                           class="w-full pl-11 pr-4 py-3 rounded-full border border-gray-200 bg-white/80 backdrop-blur-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 transition-all text-gray-700 text-sm">
                </div>
                
                <!-- Category Dropdown -->
                <div class="relative" style="z-index: 100;">
                    <button id="categoryDropdownBtn" class="flex items-center gap-2 px-5 py-3 rounded-full bg-white/80 backdrop-blur-sm border border-gray-200 text-gray-700 text-sm font-medium hover:border-teal-500 hover:text-teal-600 transition-all">
                        <i class="fa-solid fa-filter text-teal-500"></i>
                        <span id="selectedCategoryText">All Categories</span>
                        <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300"></i>
                    </button>
                    
                    <div id="categoryDropdownMenu" class="absolute top-full left-0 mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 hidden overflow-y-auto" style="z-index: 1000; max-height: 400px;">
                        <div class="p-2">
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="all">
                                <i class="fa-regular fa-circle-dot text-teal-500 text-base w-5"></i>
                                <span>All Categories</span>
                            </div>
                            <div class="border-t border-gray-100 my-1"></div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="development">
                                <i class="fa-brands fa-react text-teal-500 text-base w-5"></i>
                                <span>Web Development</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="data">
                                <i class="fa-solid fa-chart-line text-teal-500 text-base w-5"></i>
                                <span>Data Science</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="analyst">
                                <i class="fa-solid fa-table text-teal-500 text-base w-5"></i>
                                <span>Data Analyst</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="dsa">
                                <i class="fa-solid fa-diagram-project text-teal-500 text-base w-5"></i>
                                <span>DSA</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="placement">
                                <i class="fa-solid fa-briefcase text-teal-500 text-base w-5"></i>
                                <span>Placement Preparation</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="programming">
                                <i class="fa-solid fa-code text-teal-500 text-base w-5"></i>
                                <span>Programming Languages</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="cloud">
                                <i class="fa-solid fa-cloud-arrow-up text-teal-500 text-base w-5"></i>
                                <span>Cloud & DevOps</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="cyber">
                                <i class="fa-solid fa-shield-haltered text-teal-500 text-base w-5"></i>
                                <span>Cybersecurity</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="ai">
                                <i class="fa-solid fa-robot text-teal-500 text-base w-5"></i>
                                <span>Artificial Intelligence</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="marketing">
                                <i class="fa-solid fa-chart-simple text-teal-500 text-base w-5"></i>
                                <span>Digital Marketing</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="design">
                                <i class="fa-solid fa-pen-ruler text-teal-500 text-base w-5"></i>
                                <span>UI/UX Design</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="mobile">
                                <i class="fa-brands fa-android text-teal-500 text-base w-5"></i>
                                <span>Mobile Development</span>
                            </div>
                            <div class="category-option px-4 py-2.5 rounded-lg cursor-pointer hover:bg-teal-50 transition-all text-sm text-gray-700 flex items-center gap-3" data-category="blockchain">
                                <i class="fa-solid fa-link text-teal-500 text-base w-5"></i>
                                <span>Blockchain</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <button id="resetFiltersBtn" class="px-5 py-3 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium transition-all flex items-center gap-2">
                    <i class="fa-solid fa-rotate-right text-xs"></i>
                    Reset
                </button>
            </div>
            
            <div id="activeFiltersContainer" class="flex flex-wrap gap-2 justify-center mt-4 min-h-[32px]"></div>
        </div>
        
        <p class="text-gray-500 text-center text-sm" id="resultsCount">Showing 0 courses</p>
    </div>
</div> 