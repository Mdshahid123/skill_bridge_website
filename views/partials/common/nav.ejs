    .absolute {
        opacity: 0;
        visibility: hidden;
        transform: translate(-50%, -15px);
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        left: 50%;
        right: auto;
    }
    
