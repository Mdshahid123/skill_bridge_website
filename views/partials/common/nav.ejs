                { name: "SDE Preparation (Web Track)", price: "₹699", duration: "16 weeks", link: "/viewCourse?id=12", level: "Expert" },
                { name: "Competitive Programming", price: "₹499", duration: "12 weeks", link: "/viewCourse?id=4", level: "Advanced" }
            ]
        }
    };

    // Function to update right panel
    function updateMegaMenuPanelModern(categoryId) {
        const panel = document.getElementById('megaMenuRightPanelModern');
        const category = megaMenuCoursesModern[categoryId];
        
        if (category && panel) {
            panel.innerHTML = `
                <div class="mb-5 pb-4 border-b border-gray-100">
                    <div class="flex items-center justify-between">
                        <h4 class="text-lg font-bold text-gray-800">${category.title}</h4>
                        <span class="text-xs text-cyan-600 bg-cyan-50 px-2 py-1 rounded-full">${category.courses.length} courses</span>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">Explore our ${category.title.toLowerCase()} courses</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    ${category.courses.map(course => `
                        <a href="${course.link}" class="group block p-3 rounded-xl hover:bg-gradient-to-r hover:from-cyan-50 hover:to-transparent transition-all duration-300 border border-transparent hover:border-cyan-100">
                            <div class="flex items-start justify-between">
                                <div class="font-semibold text-sm text-gray-800 group-hover:text-cyan-600 transition-colors">${course.name}</div>
                                <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-gray-100 text-gray-500">${course.level}</span>
                            </div>
                            <div class="flex items-center gap-3 mt-2">
                                <span class="text-xs text-gray-500 flex items-center gap-1"><i class="fa-regular fa-clock"></i> ${course.duration}</span>
                                <span class="text-xs font-bold text-cyan-600">${course.price}</span>
                            </div>
                        </a>
                    `).join('')}
                </div>
            `;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Mega menu categories
        const categories = document.querySelectorAll('.mega-menu-category-modern');
        categories.forEach(category => {
            category.addEventListener('mouseenter', function() {
                const categoryId = this.getAttribute('data-category');
                updateMegaMenuPanelModern(categoryId);
                categories.forEach(c => c.classList.remove('bg-white', 'shadow-md'));
                this.classList.add('bg-white', 'shadow-md');
            });
        });
        
        // Set default category
        const defaultCategory = document.querySelector('.mega-menu-category-modern[data-category="web"]');
        if (defaultCategory) {
            defaultCategory.classList.add('bg-white', 'shadow-md');
            updateMegaMenuPanelModern('web');
        }
        
        // Search dropdown
        const searchContainer = document.querySelector('.relative .flex.items-center.bg-gray-100');
        const searchDropdown = document.getElementById('searchDropdownModern');
        const searchInput = document.getElementById('searchInputModern');
        
        if (searchContainer && searchDropdown) {
            searchContainer.addEventListener('click', function(e) {
                e.stopPropagation();
                searchDropdown.classList.toggle('hidden');
                if (!searchDropdown.classList.contains('hidden') && searchInput) {
                    setTimeout(() => searchInput.focus(), 100);
                }
            });
        }
        
        document.addEventListener('click', function(e) {
            if (searchDropdown && !searchDropdown.contains(e.target) && searchContainer && !searchContainer.contains(e.target)) {
                searchDropdown.classList.add('hidden');
            }
        });
        
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    const query = searchInput.value.trim();
                    if (query) window.location.href = '/courses?search=' + encodeURIComponent(query);
                }
            });
        }
        
        document.querySelectorAll('.pop-search-modern').forEach(tag => {
            tag.addEventListener('click', function() {
                window.location.href = '/courses?search=' + encodeURIComponent(this.textContent);
            });
        });
        
        // Mobile menu
        const menuBtn = document.getElementById('menuBtnModern');
        const closeMenuBtn = document.getElementById('closeMenuBtnModern');
        const mobileMenu = document.getElementById('mobileMenuPanelModern');
        
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
        }
        
        if (closeMenuBtn && mobileMenu) {
            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                document.body.style.overflow = '';
            });
        }
        
        // Scroll effect for navbar
        const navbar = document.getElementById('mainNav');
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('shadow-xl', 'bg-white/98');
                navbar.classList.remove('shadow-lg', 'bg-white/95');
            } else {
                navbar.classList.remove('shadow-xl', 'bg-white/98');
                navbar.classList.add('shadow-lg', 'bg-white/95');
            }
        });
        
        // Keyboard shortcut
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                if (searchContainer && searchDropdown) {
                    searchDropdown.classList.remove('hidden');
                    if (searchInput) setTimeout(() => searchInput.focus(), 100);
                }
            }
        });
    });
</script>

