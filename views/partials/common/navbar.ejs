<style>
    /* Core Styles */
    .nav-link { position: relative; padding-bottom: 2px; }
    .nav-link::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: linear-gradient(135deg, #1a6f8c, #0066b3); transition: width 0.3s ease; }
    .nav-link:hover::after, .nav-link.active::after { width: 100%; }
    #mainNav.scrolled { box-shadow: 0 8px 25px -5px rgba(0,0,0,0.1); background: white; }
    #mobileMenuPanel.open { transform: translateX(0); }
    #mobileProfileSheet.open { transform: translateY(0); }
    @media (min-width: 475px) { .xs\:block { display: block; } }

    /* Search Button Animation */
    .animated-border { position: relative; display: inline-block; border-radius: 9999px; }
    .animated-border::before { content: ""; position: absolute; inset: -2px; border-radius: inherit; background: linear-gradient(90deg, #00d4ff, #0066ff, #7c3aed, #ff00ff, #00d4ff); background-size: 300% 300%; animation: borderFlow 4s linear infinite; z-index: -1; }
    #searchBtn { width: 200px; display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; border: none; outline: none; border-radius: 9999px; background: #f3f4f6; cursor: pointer; font-size: 13px; }
    #searchBtn:hover { background: linear-gradient(to right, #1a6f8c, #0066b3); color: white; }
    .search-content { display: flex; align-items: center; gap: 8px; }
    kbd { background: #e5e7eb; padding: 2px 6px; border-radius: 6px; font-size: 11px; }
    @keyframes borderFlow { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

    /* Professional Book Demo Button (subtle attention) */
    .btn-attention {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    .btn-attention::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s ease;
    }
    .btn-attention:hover::before {
        left: 100%;
    }
    .badge-hot {
        background: #f97316;
        color: white;
        border-radius: 999px;
        padding: 2px 6px;
        font-size: 9px;
        font-weight: 800;
        animation: subtlePulse 1.5s infinite;
        display: inline-block;
        line-height: 1.2;
    }
    @keyframes subtlePulse {
        0%, 100% { opacity: 0.8; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.08); background: #f97316; }
    }

    /* Mobile menu link */
    .mobile-attention-link {
        background: linear-gradient(135deg, rgba(26,111,140,0.08), rgba(0,102,179,0.08));
        border-left: 3px solid #1a6f8c;
        font-weight: 800 !important;
        color: #1a6f8c !important;
    }

    /* Modal & form responsiveness */
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fadeInUp { animation: fadeInUp 0.3s ease-out forwards; }
    .modal-transition { transition: opacity 0.2s ease, visibility 0.2s; }
    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

    /* Ensure modal content scrolls on small screens */
    #demoBookingModal .overflow-y-auto {
        -webkit-overflow-scrolling: touch;
    }
</style>

<script>
    (function() {
        // ========== SEARCH FUNCTIONALITY (unchanged) ==========
        function escapeHtml(str) { if (!str) return ''; return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' })[m]); }
        async function fetchSearchResults(query) { if (!query || query.length < 2) return []; try { const response = await fetch(`/api/courses/search?q=${encodeURIComponent(query)}`); if (!response.ok) throw new Error(`HTTP ${response.status}`); const data = await response.json(); return Array.isArray(data) ? data : []; } catch (error) { console.error('Search API error:', error); const container = document.getElementById('searchResultsContainer'); if (container) container.innerHTML = '<div class="text-center text-red-500 text-sm py-4">⚠️ Search temporarily unavailable</div>'; return []; } }
        function renderDesktopResults(courses, query) { const container = document.getElementById('searchResultsContainer'); if (!container) return; container.innerHTML = ''; if (!courses.length) { container.innerHTML = '<div class="text-center text-gray-500 text-sm py-4">No courses found.</div>'; return; } const html = `<div class="space-y-3">${courses.map(c => `<div class="search-course-item flex gap-3 p-3 rounded-xl hover:bg-teal-50 cursor-pointer transition-all duration-200" data-course-id="${c._id}"><img src="${c.image || '/default-course.png'}" onerror="this.src='/default-course.png'" class="w-12 h-12 rounded-lg object-cover"><div class="flex-1"><div class="font-bold text-gray-800">${escapeHtml(c.courseName)}</div><div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(c.courseDescription || '')}</div><div class="flex items-center gap-2 mt-1"><span class="text-sm font-semibold text-teal-600">₹${c.price}</span><span class="text-xs text-gray-400 line-through">₹${c.originalPrice}</span></div></div><i class="fa-solid fa-arrow-right text-gray-300 self-center"></i></div>`).join('')}</div><div class="mt-3 text-center"><a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a></div>`; container.innerHTML = html; document.querySelectorAll('.search-course-item').forEach(el => el.addEventListener('click', () => window.location.href = `/viewCourse/${el.dataset.courseId}`)); }
        function renderMobileResults(courses, query, container) { if (!container) return; container.innerHTML = ''; if (!courses.length) { if (query.length >= 2) container.innerHTML = '<div class="text-center text-gray-500 text-sm py-2">No courses found</div>'; return; } courses.forEach(course => { const card = document.createElement('div'); card.className = 'search-course-item flex gap-3 p-2 rounded-lg hover:bg-teal-50 cursor-pointer transition-all duration-200'; card.dataset.courseId = course._id; card.innerHTML = `<img src="${course.image || '/default-course.png'}" onerror="this.src='/default-course.png'" class="w-10 h-10 rounded-lg object-cover"><div class="flex-1"><div class="font-bold text-sm text-gray-800">${escapeHtml(course.courseName)}</div><div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(course.courseDescription || '')}</div><div class="flex items-center gap-2 mt-1"><span class="text-xs font-semibold text-teal-600">₹${course.price}</span><span class="text-xs text-gray-400 line-through">₹${course.originalPrice}</span></div></div><i class="fa-solid fa-arrow-right text-gray-300 self-center"></i>`; card.addEventListener('click', () => window.location.href = `/viewCourse/${course._id}`); container.appendChild(card); }); const viewAll = document.createElement('div'); viewAll.className = 'text-center mt-2'; viewAll.innerHTML = `<a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a>`; container.appendChild(viewAll); }
        const searchBtn = document.getElementById('searchBtn'), mobileSearchBtn = document.getElementById('mobileSearchBtn'), searchModal = document.getElementById('searchModal'), searchInput = document.getElementById('searchInput'), closeSearchBtn = document.getElementById('closeSearchBtn'), mobileSearchInput = document.getElementById('mobileSearchInput'), mobileResultsContainer = document.getElementById('mobileSearchResultsContainer'); let desktopTimer, mobileTimer;
        function openSearchModal() { if (searchModal) { searchModal.classList.remove('hidden'); searchModal.style.display = 'flex'; if (searchInput) { searchInput.value = ''; setTimeout(() => searchInput.focus(), 100); } const container = document.getElementById('searchResultsContainer'); if (container) container.innerHTML = ''; } }
        function closeSearchModal() { if (searchModal) { searchModal.classList.add('hidden'); searchModal.style.display = 'none'; if (searchInput) searchInput.value = ''; const container = document.getElementById('searchResultsContainer'); if (container) container.innerHTML = ''; } }
        if (searchBtn) searchBtn.addEventListener('click', openSearchModal); if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', openSearchModal); if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearchModal); if (searchModal) searchModal.addEventListener('click', (e) => { if (e.target === searchModal) closeSearchModal(); });
        if (searchInput) searchInput.addEventListener('input', (e) => { clearTimeout(desktopTimer); const query = e.target.value.trim(); if (query.length < 2) { document.getElementById('searchResultsContainer').innerHTML = ''; return; } desktopTimer = setTimeout(async () => { const courses = await fetchSearchResults(query); renderDesktopResults(courses, query); }, 300); });
        if (mobileSearchInput && mobileResultsContainer) mobileSearchInput.addEventListener('input', (e) => { clearTimeout(mobileTimer); const query = e.target.value.trim(); if (query.length < 2) { mobileResultsContainer.innerHTML = ''; return; } mobileTimer = setTimeout(async () => { const courses = await fetchSearchResults(query); renderMobileResults(courses, query, mobileResultsContainer); }, 300); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearchModal(); if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearchModal(); } });
        
        // ========== MOBILE MENU ==========
        const menuBtn = document.getElementById('menuBtn'), closeMenuBtn = document.getElementById('closeMenuBtn'), mobileMenu = document.getElementById('mobileMenuPanel'), mobileOverlay = document.getElementById('mobileOverlay');
        function openMobileMenu() { mobileMenu?.classList.add('open'); mobileOverlay?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
        function closeMobileMenu() { mobileMenu?.classList.remove('open'); mobileOverlay?.classList.add('hidden'); document.body.style.overflow = ''; if (mobileResultsContainer) mobileResultsContainer.innerHTML = ''; if (mobileSearchInput) mobileSearchInput.value = ''; }
        if (menuBtn) menuBtn.addEventListener('click', openMobileMenu); if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMobileMenu); if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileMenu);
        
        // ========== SCROLL EFFECT ==========
        const navbar = document.getElementById('mainNav'); window.addEventListener('scroll', () => { if (window.scrollY > 20) navbar.classList.add('scrolled'); else navbar.classList.remove('scrolled'); });
        
        // ========== PROFILE DROPDOWN (desktop) ==========
        const dropdownBtn = document.getElementById('profileDropdownBtn');
        const dropdownMenu = document.getElementById('profileDropdown');
        if (dropdownBtn && dropdownMenu) {
            dropdownBtn.addEventListener('click', (e) => { e.stopPropagation(); dropdownMenu.classList.toggle('hidden'); const chev = dropdownBtn.querySelector('.fa-chevron-down'); if (chev) chev.style.transform = dropdownMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)'; });
            document.addEventListener('click', (e) => { if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) { dropdownMenu.classList.add('hidden'); const chev = dropdownBtn.querySelector('.fa-chevron-down'); if (chev) chev.style.transform = 'rotate(0deg)'; } });
        }
        document.getElementById('logoutBtn')?.addEventListener('click', () => window.location.href = '/logout');
        
        // ========== MOBILE PROFILE SHEET ==========
        const mobileProfileBtn = document.getElementById('mobileProfileBtn');
        const mobileProfileSheet = document.getElementById('mobileProfileSheet');
        const closeProfileSheet = document.getElementById('closeProfileSheet');
        if (mobileProfileBtn && mobileProfileSheet) {
            mobileProfileBtn.addEventListener('click', () => { mobileProfileSheet.classList.remove('hidden'); setTimeout(() => mobileProfileSheet.classList.add('open'), 10); });
            closeProfileSheet?.addEventListener('click', () => { mobileProfileSheet.classList.remove('open'); setTimeout(() => mobileProfileSheet.classList.add('hidden'), 300); });
            document.getElementById('mobileLogoutBtn')?.addEventListener('click', () => window.location.href = '/logout');
        }
        
        // ========== BOOK DEMO MODAL ==========
        const demoModal = document.getElementById('demoBookingModal');
        const bookDemoDesktop = document.getElementById('bookDemoBtnDesktop');
        const bookDemoMobileLink = document.getElementById('bookDemoMobileLink');
        const closeDemoModalBtn = document.getElementById('closeDemoModalBtn');
        const cancelDemoBtn = document.getElementById('cancelDemoBtn');
        const demoForm = document.getElementById('demoBookingForm');
        const submitBtn = document.getElementById('demoSubmitBtn');
        const statusDiv = document.getElementById('demoFormStatus');
        
        function showStatus(message, isError = true) { if (!statusDiv) return; statusDiv.textContent = message; statusDiv.className = `mb-4 rounded-lg p-2 sm:p-3 text-xs sm:text-sm ${isError ? 'bg-red-100 text-red-700 border border-red-200' : 'bg-green-100 text-green-700 border border-green-200'}`; statusDiv.classList.remove('hidden'); setTimeout(() => { if (statusDiv) statusDiv.classList.add('hidden'); }, 5000); }
        function openDemoModal() { if (demoModal) { demoModal.classList.remove('hidden'); demoModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; if (statusDiv) statusDiv.classList.add('hidden'); } }
        function closeDemoModal() { if (demoModal) { demoModal.classList.add('hidden'); demoModal.style.display = 'none'; document.body.style.overflow = ''; if (demoForm) demoForm.reset(); if (statusDiv) statusDiv.classList.add('hidden'); } }
        if (bookDemoDesktop) bookDemoDesktop.addEventListener('click', (e) => { e.preventDefault(); openDemoModal(); });
        if (bookDemoMobileLink) bookDemoMobileLink.addEventListener('click', (e) => { e.preventDefault(); closeMobileMenu(); openDemoModal(); });
        if (closeDemoModalBtn) closeDemoModalBtn.addEventListener('click', closeDemoModal);
        if (cancelDemoBtn) cancelDemoBtn.addEventListener('click', closeDemoModal);
        if (demoModal) demoModal.addEventListener('click', (e) => { if (e.target === demoModal) closeDemoModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && demoModal && !demoModal.classList.contains('hidden')) closeDemoModal(); });
        
        if (demoForm) {
            demoForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const name = document.getElementById('demoName')?.value.trim();
                const email = document.getElementById('demoEmail')?.value.trim();
                const phoneNumber = document.getElementById('demoPhone')?.value.trim();
                const course = document.getElementById('demoCourse')?.value;
                const degree = document.getElementById('demoDegree')?.value;
                const dateTimeValue = document.getElementById('demoDateTime')?.value || '';
                const message = document.getElementById('demoMessage')?.value.trim() || '';
                
                if (!name || !email || !phoneNumber || !course || !degree) { showStatus('❌ All required fields (*) must be filled.', true); return; }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) { showStatus('❌ Invalid email format.', true); return; }
                const phoneRegex = /^\d{10}$/;
                if (!phoneRegex.test(phoneNumber)) { showStatus('❌ Phone number must be exactly 10 digits (numbers only).', true); return; }
                
                const payload = { name, email, phoneNumber, course, degree, message, callbackTime: dateTimeValue };
                if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; }
                try {
                    const response = await fetch('/submitEnquery', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Submission failed');
                    showStatus(data.message || '✅ Your inquiry has been received. We will contact you soon!', false);
                    setTimeout(() => closeDemoModal(), 2000);
                } catch (err) { showStatus(err.message || '❌ Something went wrong. Please try again later.', true); }
                finally { if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fa-regular fa-paper-plane"></i><span>Request Demo</span>'; } }
            });
        }
    })();
</script>