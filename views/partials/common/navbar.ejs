<style>
    .nav-link { position: relative; padding-bottom: 2px; }
    .nav-link::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: linear-gradient(135deg, #1a6f8c, #0066b3); transition: width 0.3s ease; }
    .nav-link:hover::after, .nav-link.active::after { width: 100%; }
    .nav-link.active { color: #1a6f8c; }
    #mainNav { background: white; transition: all 0.3s ease; }
    #mainNav.scrolled { box-shadow: 0 8px 25px -5px rgba(0,0,0,0.1); background: white; }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fadeInUp { animation: fadeInUp 0.3s ease-out; }
    #mobileMenuPanel.open { transform: translateX(0); }
    #mobileProfileSheet.open { transform: translateY(0); }
    @media (min-width: 475px) { .xs\:block { display: block; } }
    @media (max-width: 768px) { .container { padding-left: 0.75rem; padding-right: 0.75rem; } button, a { min-height: 36px; } }
</style>

<script>
    // Full search functionality (fixed)
    (function() {
        // Helper: escape HTML
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' })[m]);
        }

        // Fetch courses from API
        async function fetchSearchResults(query) {
            if (!query || query.length < 2) return [];
            try {
                const response = await fetch(`/api/courses/search?q=${encodeURIComponent(query)}`);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();
                return Array.isArray(data) ? data : [];
            } catch (error) {
                console.error('Search API error:', error);
                // Show fallback message in results container
                const container = document.getElementById('searchResultsContainer');
                if (container) container.innerHTML = '<div class="text-center text-red-500 text-sm py-4">⚠️ Search temporarily unavailable. Please try again later.</div>';
                return [];
            }
        }

        // Render results in desktop modal
        function renderDesktopResults(courses, query) {
            const container = document.getElementById('searchResultsContainer');
            if (!container) return;
            container.innerHTML = '';
            if (!courses.length) {
                container.innerHTML = '<div class="text-center text-gray-500 text-sm py-4">No courses found. Try a different keyword.</div>';
                return;
            }
            const html = `
                <div class="space-y-3">
                    ${courses.map(c => `
                        <div class="search-course-item flex gap-3 p-3 rounded-xl hover:bg-teal-50 cursor-pointer transition-all duration-200" data-course-id="${c._id}">
                            <img src="${c.image || '/default-course.png'}" onerror="this.src='/default-course.png'" class="w-12 h-12 rounded-lg object-cover">
                            <div class="flex-1">
                                <div class="font-bold text-gray-800">${escapeHtml(c.courseName)}</div>
                                <div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(c.courseDescription || '')}</div>
                                <div class="flex items-center gap-2 mt-1"><span class="text-sm font-semibold text-teal-600">₹${c.price}</span><span class="text-xs text-gray-400 line-through">₹${c.originalPrice}</span></div>
                            </div>
                            <i class="fa-solid fa-arrow-right text-gray-300 self-center"></i>
                        </div>
                    `).join('')}
                </div>
                <div class="mt-3 text-center"><a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a></div>
            `;
            container.innerHTML = html;
            document.querySelectorAll('.search-course-item').forEach(el => {
                el.addEventListener('click', () => window.location.href = `/viewCourse/${el.dataset.courseId}`);
            });
        }

        // Mobile results rendering (same as before)
        function renderMobileResults(courses, query, container) {
            if (!container) return;
            container.innerHTML = '';
            if (!courses.length) {
                if (query.length >= 2) container.innerHTML = '<div class="text-center text-gray-500 text-sm py-2">No courses found</div>';
                return;
            }
            courses.forEach(course => {
                const card = document.createElement('div');
                card.className = 'search-course-item flex gap-3 p-2 rounded-lg hover:bg-teal-50 cursor-pointer transition-all duration-200';
                card.dataset.courseId = course._id;
                card.innerHTML = `
                    <img src="${course.image || '/default-course.png'}" onerror="this.src='/default-course.png'" class="w-10 h-10 rounded-lg object-cover">
                    <div class="flex-1"><div class="font-bold text-sm text-gray-800">${escapeHtml(course.courseName)}</div><div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(course.courseDescription || '')}</div><div class="flex items-center gap-2 mt-1"><span class="text-xs font-semibold text-teal-600">₹${course.price}</span><span class="text-xs text-gray-400 line-through">₹${course.originalPrice}</span></div></div>
                    <i class="fa-solid fa-arrow-right text-gray-300 self-center"></i>
                `;
                card.addEventListener('click', () => window.location.href = `/viewCourse/${course._id}`);
                container.appendChild(card);
            });
            const viewAll = document.createElement('div');
            viewAll.className = 'text-center mt-2';
            viewAll.innerHTML = `<a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a>`;
            container.appendChild(viewAll);
        }

        // DOM elements
        const searchBtn = document.getElementById('searchBtn');
        const mobileSearchBtn = document.getElementById('mobileSearchBtn');
        const searchModal = document.getElementById('searchModal');
        const searchInput = document.getElementById('searchInput');
        const closeSearchBtn = document.getElementById('closeSearchBtn');
        const mobileSearchInput = document.getElementById('mobileSearchInput');
        const mobileResultsContainer = document.getElementById('mobileSearchResultsContainer');
        let desktopTimer, mobileTimer;

        function openSearchModal() {
            if (!searchModal) return;
            searchModal.classList.remove('hidden');
            searchModal.style.display = 'flex';
            if (searchInput) { searchInput.value = ''; setTimeout(() => searchInput.focus(), 100); }
            const container = document.getElementById('searchResultsContainer');
            if (container) container.innerHTML = '';
        }
        function closeSearchModal() {
            if (!searchModal) return;
            searchModal.classList.add('hidden');
            searchModal.style.display = 'none';
            if (searchInput) searchInput.value = '';
            const container = document.getElementById('searchResultsContainer');
            if (container) container.innerHTML = '';
        }

        if (searchBtn) searchBtn.addEventListener('click', openSearchModal);
        if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', openSearchModal);
        if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearchModal);
        if (searchModal) searchModal.addEventListener('click', (e) => { if (e.target === searchModal) closeSearchModal(); });

        // Desktop search input
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                clearTimeout(desktopTimer);
                const query = e.target.value.trim();
                if (query.length < 2) {
                    document.getElementById('searchResultsContainer').innerHTML = '';
                    return;
                }
                desktopTimer = setTimeout(async () => {
                    const courses = await fetchSearchResults(query);
                    renderDesktopResults(courses, query);
                }, 300);
            });
            searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
        }

        // Mobile search input
        if (mobileSearchInput && mobileResultsContainer) {
            mobileSearchInput.addEventListener('input', (e) => {
                clearTimeout(mobileTimer);
                const query = e.target.value.trim();
                if (query.length < 2) { mobileResultsContainer.innerHTML = ''; return; }
                mobileTimer = setTimeout(async () => {
                    const courses = await fetchSearchResults(query);
                    renderMobileResults(courses, query, mobileResultsContainer);
                }, 300);
            });
        }

        // Close modal on ESC, open on Cmd+K
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeSearchModal();
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearchModal(); }
        });

        // Mobile menu logic (unchanged)
        const menuBtn = document.getElementById('menuBtn'), closeMenuBtn = document.getElementById('closeMenuBtn'), mobileMenu = document.getElementById('mobileMenuPanel'), mobileOverlay = document.getElementById('mobileOverlay');
        function openMobileMenu() { mobileMenu?.classList.add('open'); mobileOverlay?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
        function closeMobileMenu() { mobileMenu?.classList.remove('open'); mobileOverlay?.classList.add('hidden'); document.body.style.overflow = ''; if (mobileResultsContainer) mobileResultsContainer.innerHTML = ''; if (mobileSearchInput) mobileSearchInput.value = ''; }
        if (menuBtn) menuBtn.addEventListener('click', openMobileMenu);
        if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMobileMenu);
        if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileMenu);
        document.querySelectorAll('.mobile-nav-link').forEach(link => link.addEventListener('click', closeMobileMenu));

        // Profile dropdown (unchanged)
        const dropdownBtn = document.getElementById('profileDropdownBtn'), dropdownMenu = document.getElementById('profileDropdown');
        if (dropdownBtn && dropdownMenu) {
            dropdownBtn.addEventListener('click', (e) => { e.stopPropagation(); dropdownMenu.classList.toggle('hidden'); const chev = dropdownBtn.querySelector('.fa-chevron-down'); if (chev) chev.style.transform = dropdownMenu.classList.contains('hidden') ? 'rotate(0deg)' : 'rotate(180deg)'; });
            document.addEventListener('click', (e) => { if (!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)) { dropdownMenu.classList.add('hidden'); const chev = dropdownBtn.querySelector('.fa-chevron-down'); if (chev) chev.style.transform = 'rotate(0deg)'; } });
        }
        document.getElementById('logoutBtn')?.addEventListener('click', () => window.location.href = '/logout');

        // Mobile profile sheet
        const mobileProfileBtn = document.getElementById('mobileProfileBtn'), mobileProfileSheet = document.getElementById('mobileProfileSheet'), closeProfileSheet = document.getElementById('closeProfileSheet');
        if (mobileProfileBtn && mobileProfileSheet) {
            mobileProfileBtn.addEventListener('click', () => { mobileProfileSheet.classList.remove('hidden'); setTimeout(() => mobileProfileSheet.classList.add('open'), 10); });
            closeProfileSheet?.addEventListener('click', () => { mobileProfileSheet.classList.remove('open'); setTimeout(() => mobileProfileSheet.classList.add('hidden'), 300); });
            document.getElementById('mobileLogoutBtn')?.addEventListener('click', () => window.location.href = '/logout');
        }

        // Scroll effect: add scrolled class to make background solid (already solid, but for shadow)
        const navbar = document.getElementById('mainNav');
        window.addEventListener('scroll', () => { if (window.scrollY > 20) navbar.classList.add('scrolled'); else navbar.classList.remove('scrolled'); });
    })();
</script>