<style>
    .nav-link { position: relative; padding-bottom: 4px; font-weight: 700; }
    .nav-link span { display: inline-block; transition: transform 0.3s ease; }
    .nav-link:hover span { transform: translateY(-1px); }
    .nav-link.active { color: #1a6f8c; }
    .nav-link.active::after { width: 100%; }
    #mobileMenuPanel { transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1); background-color: white; }
    #mobileMenuPanel.open { transform: translateX(0); }
    .mobile-nav-link { position: relative; overflow: hidden; }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(-30px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fadeInUp { animation: fadeInUp 0.3s ease-out; }
    .search-tag { transition: all 0.3s ease; }
    #mainNav { transition: all 0.3s ease; }
    #mainNav.scrolled { background: white; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1); }
    @media (max-width: 768px) { .container { padding-left: 1rem; padding-right: 1rem; } }
    .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .search-results-modern { scrollbar-width: thin; }
    .search-results-modern::-webkit-scrollbar { width: 4px; }
    .search-results-modern::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
    .search-results-modern::-webkit-scrollbar-thumb { background: #1a6f8c; border-radius: 10px; }
    #searchResultsContainer .search-results-modern { max-height: 60vh; overflow-y: auto; }
</style>

<script>
    // ========== MEGA MENU DATA (optional) ==========
    const megaMenuCoursesModern = {
        web: { title: "Web Development", courses: [] },
        data: { title: "Data Science", courses: [] },
        programming: { title: "Programming Languages", courses: [] },
        cloud: { title: "Cloud & DevOps", courses: [] },
        cyber: { title: "Cybersecurity", courses: [] },
        design: { title: "UI/UX Design", courses: [] },
        dsa: { title: "DSA & SDE Preparation", courses: [] }
    };
    function updateMegaMenuPanelModern(categoryId) {
        const panel = document.getElementById('megaMenuRightPanelModern');
        const category = megaMenuCoursesModern[categoryId];
        if (category && panel) {
            panel.innerHTML = `<div class="mb-5 pb-4 border-b border-gray-100"><h4 class="text-lg font-bold text-gray-800">${category.title}</h4><p class="text-xs text-gray-500 mt-1">Loading courses...</p></div>`;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Mega menu (optional)
        const categories = document.querySelectorAll('.mega-menu-category-modern');
        categories.forEach(category => {
            category.addEventListener('mouseenter', function() {
                const categoryId = this.getAttribute('data-category');
                updateMegaMenuPanelModern(categoryId);
                categories.forEach(c => c.classList.remove('bg-white', 'shadow-md'));
                this.classList.add('bg-white', 'shadow-md');
            });
        });
        const defaultCategory = document.querySelector('.mega-menu-category-modern[data-category="web"]');
        if (defaultCategory) {
            defaultCategory.classList.add('bg-white', 'shadow-md');
            updateMegaMenuPanelModern('web');
        }

        // ========== SHARED SEARCH LOGIC (Desktop & Mobile) ==========
        // Helper functions
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[m]);
        }

        async function fetchSearchResults(query) {
            if (!query || query.length < 2) return [];
            try {
                const response = await fetch(`/api/courses/search?q=${encodeURIComponent(query)}`);
                if (!response.ok) throw new Error('Search failed');
                const courses = await response.json();
                return courses;
            } catch (error) {
                console.error('Search API error:', error);
                return [];
            }
        }

        // Render course cards into a given container
        function renderMobileResults(courses, query, container) {
            if (!container) return;
            container.innerHTML = '';
            if (!courses || courses.length === 0) {
                if (query.length >= 2) {
                    container.innerHTML = '<div class="text-center text-gray-500 text-sm py-2">No courses found</div>';
                }
                return;
            }
            courses.forEach(course => {
                const card = document.createElement('div');
                card.className = 'search-course-item flex gap-3 p-2 rounded-lg hover:bg-teal-50 cursor-pointer transition-all duration-200';
                card.setAttribute('data-course-id', course._id);
                card.innerHTML = `
                    <img src="${course.image || '/default-course.png'}" onerror="this.src='/default-course.png'" alt="${escapeHtml(course.courseName)}" class="w-10 h-10 rounded-lg object-cover">
                    <div class="flex-1">
                        <div class="font-bold text-sm text-gray-800">${escapeHtml(course.courseName)}</div>
                        <div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(course.courseDescription || 'No description')}</div>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-xs font-semibold text-teal-600">₹${course.price}</span>
                            <span class="text-xs text-gray-400 line-through">₹${course.originalPrice}</span>
                        </div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-gray-300 self-center"></i>
                `;
                card.addEventListener('click', () => {
                    window.location.href = `/viewCourse/${course._id}`;
                });
                container.appendChild(card);
            });
            // Add "View all results" link at bottom
            const viewAll = document.createElement('div');
            viewAll.className = 'text-center mt-2';
            viewAll.innerHTML = `<a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a>`;
            container.appendChild(viewAll);
        }

        // ========== DESKTOP MODAL SEARCH ==========
        const searchBtn = document.getElementById('searchBtn');
        const searchModal = document.getElementById('searchModal');
        const searchInput = document.getElementById('searchInput');
        const closeSearchBtn = document.getElementById('closeSearchBtn');
        const resultsContainer = document.getElementById('searchResultsContainer');
        let desktopDebounceTimer;

        function openSearchModal() {
            if (!searchModal) return;
            searchModal.classList.remove('hidden');
            searchModal.style.display = 'flex';
            if (searchInput) {
                searchInput.value = '';
                setTimeout(() => searchInput.focus(), 100);
            }
            if (resultsContainer) resultsContainer.innerHTML = '';
        }

        function closeSearchModal() {
            if (!searchModal) return;
            searchModal.classList.add('hidden');
            searchModal.style.display = 'none';
            if (searchInput) searchInput.value = '';
            if (resultsContainer) resultsContainer.innerHTML = '';
        }

        if (searchBtn) searchBtn.addEventListener('click', openSearchModal);
        if (closeSearchBtn) closeSearchBtn.addEventListener('click', closeSearchModal);
        if (searchModal) {
            searchModal.addEventListener('click', function(e) {
                if (e.target === searchModal) closeSearchModal();
            });
        }

        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                clearTimeout(desktopDebounceTimer);
                const query = e.target.value.trim();
                if (query.length < 2) {
                    if (resultsContainer) resultsContainer.innerHTML = '';
                    return;
                }
                desktopDebounceTimer = setTimeout(async () => {
                    const courses = await fetchSearchResults(query);
                    // Render into the modal's results container
                    if (!resultsContainer) return;
                    resultsContainer.innerHTML = '';
                    if (!courses.length) {
                        resultsContainer.innerHTML = '<div class="text-center text-gray-500 text-sm py-4">No courses found</div>';
                        return;
                    }
                    const resultsDiv = document.createElement('div');
                    resultsDiv.className = 'search-results-modern mt-2';
                    resultsDiv.innerHTML = `
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-xs font-semibold text-gray-500">Courses found (${courses.length})</p>
                        </div>
                        <div class="max-h-96 overflow-y-auto space-y-2 pr-1"></div>
                        <div class="mt-3 text-center">
                            <a href="/courses?search=${encodeURIComponent(query)}" class="text-xs text-teal-600 hover:underline">🔍 View all results →</a>
                        </div>
                    `;
                    const listContainer = resultsDiv.querySelector('.max-h-96');
                    courses.forEach(course => {
                        const card = document.createElement('div');
                        card.className = 'search-course-item flex gap-3 p-2 rounded-lg hover:bg-teal-50 cursor-pointer transition-all duration-200';
                        card.setAttribute('data-course-id', course._id);
                        card.innerHTML = `
                            <img src="${course.image || '/default-course.png'}" onerror="this.src='/default-course.png'" class="w-12 h-12 rounded-lg object-cover">
                            <div class="flex-1">
                                <div class="font-bold text-sm text-gray-800">${escapeHtml(course.courseName)}</div>
                                <div class="text-xs text-gray-500 line-clamp-1">${escapeHtml(course.courseDescription || 'No description')}</div>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-xs font-semibold text-teal-600">₹${course.price}</span>
                                    <span class="text-xs text-gray-400 line-through">₹${course.originalPrice}</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-arrow-right text-gray-300 self-center"></i>
                        `;
                        card.addEventListener('click', () => {
                            window.location.href = `/viewCourse/${course._id}`;
                        });
                        listContainer.appendChild(card);
                    });
                    resultsContainer.appendChild(resultsDiv);
                }, 300);
            });
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') e.preventDefault();
            });
        }

        // ========== MOBILE SEARCH (inline within mobile menu) ==========
        const mobileSearchInput = document.getElementById('mobileSearchInput');
        const mobileResultsContainer = document.getElementById('mobileSearchResultsContainer');
        let mobileDebounceTimer;

        if (mobileSearchInput && mobileResultsContainer) {
            mobileSearchInput.addEventListener('input', function(e) {
                clearTimeout(mobileDebounceTimer);
                const query = e.target.value.trim();
                if (query.length < 2) {
                    mobileResultsContainer.innerHTML = '';
                    return;
                }
                mobileDebounceTimer = setTimeout(async () => {
                    const courses = await fetchSearchResults(query);
                    renderMobileResults(courses, query, mobileResultsContainer);
                }, 300);
            });
            mobileSearchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') e.preventDefault();
            });
        }

        // ========== CLOSE SEARCH MODAL ON ESCAPE ==========
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeSearchModal();
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                openSearchModal();
            }
        });

        // ========== MOBILE MENU LOGIC ==========
        const menuBtn = document.getElementById('menuBtn');
        const closeMenuBtn = document.getElementById('closeMenuBtn');
        const mobileMenu = document.getElementById('mobileMenuPanel');
        const mobileOverlay = document.getElementById('mobileOverlay');

        function openMobileMenu() {
            if (mobileMenu) mobileMenu.classList.add('open');
            if (mobileOverlay) mobileOverlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeMobileMenu() {
            if (mobileMenu) mobileMenu.classList.remove('open');
            if (mobileOverlay) mobileOverlay.classList.add('hidden');
            document.body.style.overflow = '';
            // Clear mobile search results when closing
            if (mobileResultsContainer) mobileResultsContainer.innerHTML = '';
            if (mobileSearchInput) mobileSearchInput.value = '';
        }
        if (menuBtn) menuBtn.addEventListener('click', openMobileMenu);
        if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMobileMenu);
        if (mobileOverlay) mobileOverlay.addEventListener('click', closeMobileMenu);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && mobileMenu?.classList.contains('open')) closeMobileMenu();
        });
        document.querySelectorAll('.mobile-nav-link').forEach(link => link.addEventListener('click', closeMobileMenu));

        // Scroll effect
        const navbar = document.getElementById('mainNav');
        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');
        });

        // Helper CSS injection (if not already present)
        if (!document.querySelector('#navbar-helper-styles')) {
            const style = document.createElement('style');
            style.id = 'navbar-helper-styles';
            style.textContent = `
