<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // ===== SCROLL EFFECT - Navbar shadow enhancement =====
        const navbar = document.getElementById('mainNav');
        window.addEventListener('scroll', function() {
            if (window.scrollY > 10) {
                navbar.classList.add('shadow-md');
            } else {
                navbar.classList.remove('shadow-md');
            }
        });
        
        // ===== SEARCH DROPDOWN =====
        const searchContainer = document.querySelector('.relative .flex.items-center.bg-gray-100');
        const searchDropdown = document.getElementById('searchDropdown');
        const searchInput = document.getElementById('searchInput');
        
        if (searchContainer && searchDropdown) {
            searchContainer.addEventListener('click', function(e) {
                e.stopPropagation();
                searchDropdown.classList.toggle('hidden');
                if (!searchDropdown.classList.contains('hidden')) {
                    setTimeout(function() {
                        if (searchInput) searchInput.focus();
                    }, 100);
                }
            });
        }
        
        document.addEventListener('click', function(e) {
            if (searchDropdown && !searchDropdown.contains(e.target) && searchContainer && !searchContainer.contains(e.target)) {
                searchDropdown.classList.add('hidden');
            }
        });
        
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    const query = searchInput.value.trim();
                    if (query) {
                        window.location.href = '/courses?search=' + encodeURIComponent(query);
                    }
                }
            });
        }
        
        const popSearches = document.querySelectorAll('.pop-search');
        popSearches.forEach(function(tag) {
            tag.addEventListener('click', function() {
                const query = tag.textContent;
                window.location.href = '/courses?search=' + encodeURIComponent(query);
            });
        });
        
        const mobileSearch = document.getElementById('mobileSearch');
        if (mobileSearch) {
            mobileSearch.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    const query = mobileSearch.value.trim();
                    if (query) {
                        window.location.href = '/courses?search=' + encodeURIComponent(query);
                    }
                }
            });
        }
        
        // ===== MOBILE MENU =====
        const menuBtn = document.getElementById('menuBtn');
        const closeMenuBtn = document.getElementById('closeMenuBtn');
        const mobileMenuPanel = document.getElementById('mobileMenuPanel');
        
        if (menuBtn && mobileMenuPanel) {
            menuBtn.addEventListener('click', function() {
                mobileMenuPanel.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
        }
        
        if (closeMenuBtn && mobileMenuPanel) {
            closeMenuBtn.addEventListener('click', function() {
                mobileMenuPanel.classList.add('hidden');
                document.body.style.overflow = '';
            });
        }
        
        // Close mobile menu when clicking on a link
        const mobileLinks = mobileMenuPanel ? mobileMenuPanel.querySelectorAll('a') : [];
        mobileLinks.forEach(link => {
            link.addEventListener('click', function() {
                mobileMenuPanel.classList.add('hidden');
                document.body.style.overflow = '';
            });
        });
        
        // ===== ACTIVE LINK HIGHLIGHTING =====
        const currentPage = window.location.pathname;
        const navLinks = document.querySelectorAll('.nav-link-enhanced');
        
        navLinks.forEach(function(link) {
            const href = link.getAttribute('href');
            if (href === currentPage || (currentPage === '/' && href === '/') || 
                (currentPage.includes(href) && href !== '/' && href !== '#')) {
                link.classList.add('text-[#0066b3]');
                const underline = link.querySelector('span');
                if (underline) underline.classList.add('w-full');
            }
        });
        
        // ===== KEYBOARD SHORTCUT (Ctrl+K) =====
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                if (searchContainer && searchDropdown) {
                    searchDropdown.classList.remove('hidden');
                    setTimeout(function() {
                        if (searchInput) searchInput.focus();
                    }, 100);
                }
            }
        });
        
        // ===== HOVER SOUND EFFECT (Optional - just for visual feedback) =====
        // Add ripple effect to buttons
        const buttons = document.querySelectorAll('button');
        buttons.forEach(btn => {
            btn.addEventListener('click', function(e) {
                let ripple = document.createElement('span');
                ripple.classList.add('ripple');
                this.appendChild(ripple);
                setTimeout(() => ripple.remove(), 500);
            });
        });
    });
</script>

<style>
    /* Navbar Enhanced Styles */
    .nav-link-enhanced {
        transition: all 0.3s ease;
        position: relative;
    }
    
    /* Active link indicator */
    .nav-link-enhanced .w-full {
        width: 100%;
