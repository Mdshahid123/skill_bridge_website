    }
    
    @keyframes slideInRight {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(0);
        }
    }
    
    /* Ripple effect for buttons */
    .ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(26,111,140,0.3);
        transform: scale(0);
        animation: ripple 0.5s linear;
        pointer-events: none;
    }
    
    @keyframes ripple {
        to {
            transform: scale(4);
            opacity: 0;
        }
    }
    
    button {
        position: relative;
        overflow: hidden;
    }
    
    /* Navbar scroll transition */
    #mainNav {
        transition: all 0.3s ease;
    }
    
    /* Hover scale effect for icons */
    .fa-arrow-right {
        transition: transform 0.3s ease;
