<!-- ======================== FULLY RESPONSIVE BOOK DEMO MODAL ======================== -->
<div id="demoBookingModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[500] hidden items-center justify-center p-3 sm:p-4 transition-all duration-300 modal-transition">
    <div class="relative w-full max-w-4xl bg-white rounded-2xl shadow-2xl overflow-hidden animate-fadeInUp max-h-[95vh] overflow-y-auto">
        <div class="relative bg-gradient-to-r from-[#0a2b3e] to-[#1a6f8c] px-4 py-3 sm:px-5 sm:py-4 flex justify-between items-center">
            <div>
                <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-white flex items-center gap-2"><i class="fa-regular fa-calendar-check"></i> Book a Free Demo</h3>
                <p class="text-[10px] sm:text-xs text-teal-100 mt-0.5">Experience SkillBridge — unlock your future</p>
            </div>
            <button id="closeDemoModalBtn" class="text-white/80 hover:text-white bg-white/20 rounded-full w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center transition-all hover:rotate-90"><i class="fa-solid fa-xmark text-base sm:text-lg"></i></button>
        </div>
        <div class="p-4 sm:p-6 md:p-7">
            <div id="demoFormStatus" class="mb-4 hidden rounded-lg p-2 sm:p-3 text-xs sm:text-sm"></div>
            <form id="demoBookingForm" class="space-y-4 sm:space-y-5">
                <!-- Row 1: Name, Email, Phone - stacks on mobile -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
                    <div>
                        <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Full Name <span class="text-red-500">*</span></label>
                        <div class="relative"><i class="fa-regular fa-user absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i><input type="text" id="demoName" required placeholder="John Doe" class="w-full pl-8 sm:pl-9 pr-3 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm"></div>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Email Address <span class="text-red-500">*</span></label>
                        <div class="relative"><i class="fa-regular fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i><input type="email" id="demoEmail" required placeholder="hello@skillbridge.com" class="w-full pl-8 sm:pl-9 pr-3 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm"></div>
                    </div>
                    <div>
                        <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Phone (10 digits) <span class="text-red-500">*</span></label>
                        <div class="relative"><i class="fa-solid fa-phone absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i><input type="tel" id="demoPhone" required placeholder="9876543210" class="w-full pl-8 sm:pl-9 pr-3 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm" maxlength="10"></div>
                        <p class="text-[10px] text-gray-400 mt-0.5">Exactly 10 digits, no spaces</p>
                    </div>
                </div>
                <!-- Row 2: Course, Degree, Date/Time -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
                    <div>
                        <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Interested Course <span class="text-red-500">*</span></label>
                        <div class="relative"><i class="fa-solid fa-laptop-code absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i><select id="demoCourse" required class="w-full pl-8 sm:pl-9 pr-8 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] appearance-none bg-white text-sm">
                            <option value="">Select a course</option>
                            <option value="Full Stack Development">Full Stack Development</option>
                            <option value="Full Stack Development">Generative AI</option>
                            <option value="Data Science & AI">Data Science & AI</option>
                            <option value="Data Science & AI">Data Analytics</option>
                            <option value="Digital Marketing"> Digital Marketing</option>
                            <option value="Full Stack Development">Programming Language</option>
                            <option value="Digital Marketing"> Data Structure and Algorithm</option>
                            <option value="Full Stack Development">Placement preparation</option>
                            <option value="Cloud Computing">Cloud Computing</option><option value="UI/UX Design">UI/UX Design</option>
                        </select><i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-[10px] pointer-events-none"></i></div>
                    </div>
                  
                    <div>
                        <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Preferred Date & Time</label>
                        <div class="relative"><i class="fa-regular fa-calendar-clock absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs sm:text-sm"></i><input type="datetime-local" id="demoDateTime" class="w-full pl-8 sm:pl-9 pr-3 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm"></div>
                    </div>
                </div>
                <!-- Message (full width) -->
                <div>
                    <label class="block text-gray-700 text-xs sm:text-sm font-semibold mb-1">Message (Optional)</label>
                    <div class="relative"><i class="fa-regular fa-comment absolute left-3 top-3 text-gray-400 text-xs sm:text-sm"></i><textarea id="demoMessage" rows="2" placeholder="Any specific questions or topics?" class="w-full pl-8 sm:pl-9 pr-3 py-2 sm:py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm resize-none"></textarea></div>
                </div>
                <!-- Buttons -->
                <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 pt-2">
                    <button type="button" id="cancelDemoBtn" class="px-4 sm:px-5 py-2 sm:py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl text-sm">Cancel</button>
                    <button type="submit" id="demoSubmitBtn" class="px-4 sm:px-6 py-2 sm:py-2.5 bg-gradient-to-r from-[#1a6f8c] to-[#0066b3] hover:from-[#0a2b3e] hover:to-[#1a6f8c] text-white font-bold rounded-xl shadow-md transition-all duration-300 flex items-center justify-center gap-2 text-sm"><i class="fa-regular fa-paper-plane"></i><span>Request Demo</span></button>
                </div>
                <p class="text-[10px] sm:text-xs text-center text-gray-400 mt-2">* Our team will reach out within 24 hours to confirm your slot.</p>
            </form>
        </div>
    </div>
</div>

