        bottom: -1px;
        left: 0;
        width: 0;
        height: 2.5px;
        background: linear-gradient(90deg, #1a6f8c, #0066b3);
        border-radius: 2px;
        transition: width 0.25s;
    }
    .category-link:hover {
        color: #1a6f8c !important;
    }
    .category-link:hover::after {
        width: 100%;
    }
    .dropdown-container {
        position: relative;
    }
    .dropdown-menu {
        position: absolute;
        top: 100%;
        left:-30px;
        margin-top: 0.75rem;
        width: 260px;
        background: white;
        border-radius: 1rem;
        box-shadow: 0 20px 25px -12px rgba(0,0,0,0.15);
        border: 1px solid #e5e7eb;
        opacity: 0;
        visibility: hidden;
        transform: scale(0.95);
        transition: opacity 0.2s, visibility 0.2s, transform 0.2s;
        z-index: 100;
        transform-origin: top center;
    }
    .dropdown-container:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
    }
    .dropdown-container:hover .fa-chevron-down {
        transform: rotate(180deg);
    }
    .dropdown-menu a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 1rem;
        font-size: 0.875rem;
        font-weight: 700;
        color: #1f2937;
        transition: background 0.15s;
    }
    .dropdown-menu a i {
        width: 1.25rem;
    }
    .dropdown-menu a:hover {
        background: linear-gradient(90deg, #f0f9ff, transparent);
        color: #0d5e6b;
    }
    #mobileMenuPanel {
        transition: transform 0.3s ease-out;
    }
    #mobileMenuPanel.open {
        transform: translateX(0) !important;
    }
    /* ========== PREMIUM HORIZONTAL MODAL – IMPROVED RIGHT SIDE FORM ========== */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(8px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }
    .course-modal {
        background: white;
        border-radius: 2rem;
        max-width: 1000px;
        width: 90%;
        position: relative;
        animation: modalFadeIn 0.3s ease;
        box-shadow: 0 30px 50px -20px rgba(0,0,0,0.3);
        overflow: hidden;
    }
    @keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.96); }
        to { opacity: 1; transform: scale(1); }
    }
    .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        cursor: pointer;
        font-size: 1.5rem;
        color: #9ca3af;
        transition: color 0.2s;
        z-index: 20;
        background: rgba(255,255,255,0.8);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .modal-close:hover {
        color: #1f2937;
        background: white;
    }
    /* Two‑column layout */
    .modal-two-columns {
        display: flex;
        flex-wrap: wrap;
    }
    .modal-left {
        flex: 1.2;
        background: linear-gradient(145deg, #0a2b3e, #1a6f8c);
        padding: 2rem;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .modal-left h3 {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 1rem;
        line-height: 1.2;
    }
    .modal-left p {
        font-size: 0.95rem;
        opacity: 0.9;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }
    .modal-left .benefits {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .modal-left .benefits li {
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }
    .modal-left .benefits li i {
        font-size: 1.1rem;
    }
    .modal-right {
        flex: 1.8;
        padding: 2rem;
        background: white;
    }
    /* Improved form layout – cleaner, more spacious */
    .form-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    .form-group {
        flex: 1;
        min-width: calc(50% - 0.5rem);
    }
    .form-group.full-width {
        flex: 1 1 100%;
    }
    .form-group label {
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 0.4rem;
    }
    .form-group input, 
    .form-group select, 
    .form-group textarea {
        width: 100%;
        padding: 0.7rem 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #fafbfc;
        font-family: inherit;
    }
    .form-group input:focus, 
    .form-group select:focus, 
    .form-group textarea:focus {
        outline: none;
        border-color: #1a6f8c;
        box-shadow: 0 0 0 3px rgba(26,111,140,0.1);
        background: white;
    }
    .btn-submit {
        background: linear-gradient(105deg, #1a6f8c, #0f5f7a);
        color: white;
        font-weight: 800;
        padding: 0.8rem;
        border-radius: 3rem;
        font-size: 1rem;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        width: 100%;
        margin-top: 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -8px rgba(26,111,140,0.4);
    }
    @media (max-width: 768px) {
        .modal-two-columns {
            flex-direction: column;
        }
        .modal-left {
            padding: 1.5rem;
            text-align: center;
        }
        .modal-left .benefits li {
            justify-content: center;
        }
        .form-row {
            flex-direction: column;
            gap: 0.75rem;
        }
        .form-group {
            min-width: 100%;
        }
        .course-modal {
            width: 95%;
        }
    }
    .suggestion-item {
        transition: background 0.15s;
        cursor: pointer;
    }
    .suggestion-item:hover {
        background-color: #f3f4f6;
    }
</style>

<script>
    (function() {
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
        }

        // ========== SCROLL SHADOW ==========
        const mainNav = document.getElementById('mainNav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) mainNav.classList.add('scrolled', 'shadow-lg');
            else mainNav.classList.remove('scrolled', 'shadow-lg');
        });

        // ========== MOBILE MENU TOGGLE ==========
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const mobilePanel = document.getElementById('mobileMenuPanel');
        const closeMenu = document.getElementById('closeMenu');

        function openMobileMenu() {
            if (!mobileMenu || !mobilePanel) return;
            mobileMenu.classList.remove('hidden');
            // Use requestAnimationFrame for smooth opening
            requestAnimationFrame(() => {
                mobilePanel.classList.add('open');
            });
            document.body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            if (!mobilePanel) return;
            mobilePanel.classList.remove('open');
            setTimeout(() => {
                if (mobileMenu) mobileMenu.classList.add('hidden');
                document.body.style.overflow = '';
            }, 300);
        }

        if (menuBtn) {
            menuBtn.addEventListener('click', openMobileMenu);
        } else {
            console.warn('⚠️ menuBtn not found!');
        }
        if (closeMenu) {
            closeMenu.addEventListener('click', closeMobileMenu);
        }
        if (mobileMenu) {
            mobileMenu.addEventListener('click', (e) => {
                if (e.target === mobileMenu) closeMobileMenu();
            });
        }

        // ========== PROFILE DROPDOWN ==========
        const profileToggle = document.getElementById('profileDropdownToggle');
        const profileDropdown = document.getElementById('profileDropdown');
        if (profileToggle && profileDropdown) {
            profileToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });
            document.addEventListener('click', (e) => {
                if (!profileToggle.contains(e.target) && !profileDropdown.contains(e.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });
        }

        // ========== SEARCH SUGGESTIONS (FIXED) ==========
        let debounceTimer;

        async function fetchAndShowSuggestions(inputElement, suggestionsContainer) {
            const query = inputElement.value.trim();
            clearTimeout(debounceTimer);
            if (query.length < 2) {
                suggestionsContainer.classList.add('hidden');
                return;
            }
            debounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/api/courses/search?q=${encodeURIComponent(query)}`);
                    const courses = await res.json();
                    if (courses && courses.length) {
                        suggestionsContainer.innerHTML = courses.map(c => {
                            const category = c.category || c.courseName || '';
                            return `
                                <div class="suggestion-item p-3 border-b border-gray-100" data-category="${escapeHtml(category)}">
                                    <div class="font-semibold">${escapeHtml(c.courseName)}</div>
                                    <div class="text-xs text-gray-500">${escapeHtml((c.courseDescription || '').substring(0, 80))}...</div>
                                    <div class="text-xs text-teal-600 font-medium mt-0.5">${escapeHtml(category)}</div>
                                </div>
                            `;
                        }).join('');
                        suggestionsContainer.classList.remove('hidden');

                        // Attach click handlers
                        document.querySelectorAll(`#${suggestionsContainer.id} .suggestion-item`).forEach(el => {
                            el.addEventListener('click', function() {
                                const category = this.getAttribute('data-category');
                                if (category) {
                                    window.location.href = `/courseCatogry?category=${encodeURIComponent(category)}`;
                                } else {
                                    const courseName = this.querySelector('.font-semibold')?.textContent || '';
                                    if (courseName) {
                                        window.location.href = `/courseCatogry?courseName=${encodeURIComponent(courseName)}`;
                                    }
                                }
                            });
                        });
                    } else {
                        suggestionsContainer.classList.add('hidden');
                    }
                } catch (err) {
                    console.error('Search error:', err);
                    suggestionsContainer.classList.add('hidden');
                }
            }, 300);
        }

        // Desktop search
        const desktopInput = document.getElementById('desktopSearchInput');
        const desktopSuggestions = document.getElementById('desktopSuggestions');
        if (desktopInput && desktopSuggestions) {
            desktopInput.addEventListener('input', () => fetchAndShowSuggestions(desktopInput, desktopSuggestions));
            document.addEventListener('click', (e) => {
                if (!desktopInput.contains(e.target) && !desktopSuggestions.contains(e.target)) {
                    desktopSuggestions.classList.add('hidden');
                }
            });
            desktopInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const query = desktopInput.value.trim();
                    if (query) window.location.href = `/courseCatogry?courseName=${encodeURIComponent(query)}`;
                }
            });
        }

        // Mobile search
        const mobileInput = document.getElementById('mobileSearchInput');
        const mobileSuggestions = document.getElementById('mobileSuggestions');
        if (mobileInput && mobileSuggestions) {
            mobileInput.addEventListener('input', () => fetchAndShowSuggestions(mobileInput, mobileSuggestions));
            document.addEventListener('click', (e) => {
                if (!mobileInput.contains(e.target) && !mobileSuggestions.contains(e.target)) {
                    mobileSuggestions.classList.add('hidden');
                }
            });
            mobileInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const query = mobileInput.value.trim();
                    if (query) window.location.href = `/courseCatogry?courseName=${encodeURIComponent(query)}`;
                    closeMobileMenu();
                }
            });
        }

        // ========== MOBILE CATEGORY TOGGLE ==========
        window.toggleMobileCategory = function(header) {
            const parent = header.closest('.mobile-category');
            if (!parent) return;
            const submenu = parent.querySelector('.mobile-submenu');
            const icon = header.querySelector('.fa-chevron-down');
            if (submenu) {
                submenu.classList.toggle('hidden');
                if (icon) icon.classList.toggle('rotate-180');
            }
        };

        // ========== BOOK DEMO MODAL ==========
        let demoModal = document.getElementById('demoModal');
        if (!demoModal) {
            demoModal = document.createElement('div');
            demoModal.id = 'demoModal';
            demoModal.className = 'modal-overlay';
            demoModal.innerHTML = `
                <div class="course-modal">
                    <div class="modal-close" id="closeDemoModal">&times;</div>
                    <div class="modal-two-columns">
                        <div class="modal-left">
                            <h3>✨ Free Career Consultation</h3>
                            <p>Our expert counsellors will help you choose the right course and answer all your questions.</p>
                            <ul class="benefits">
                                <li><i class="fa-regular fa-circle-check"></i> Live course overview</li>
                                <li><i class="fa-regular fa-clock"></i> Flexible scheduling</li>
                                <li><i class="fa-regular fa-message"></i> One-on-one interaction</li>
                                <li><i class="fa-regular fa-building"></i> Placement guidance</li>
                            </ul>
                        </div>
                        <div class="modal-right">
                            <form id="demoForm">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Full Name <span class="text-red-500">*</span></label>
                                        <input type="text" id="demoName" placeholder="e.g. John Doe" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Email <span class="text-red-500">*</span></label>
                                        <input type="email" id="demoEmail" placeholder="john@example.com" required>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Phone <span class="text-red-500">*</span></label>
                                        <input type="tel" id="demoPhone" placeholder="+91 98765 43210" required>
                                    </div>
                                    <div class="form-group">
                                        <label>Interested Course (Optional)</label>
                                        <select id="demoCourse">
                                            <option value="">Select a course</option>
                                            <option>Frontend Development</option><option>Backend Development</option>
                                            <option>Data Science</option><option>Full Stack MERN</option>
                                            <option>Python</option><option>Java</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group full-width">
                                    <label>Preferred Date & Time (Optional)</label>
                                    <textarea id="demoMessage" rows="2" placeholder="e.g., 'Weekday evenings after 7 PM'"></textarea>
                                </div>
                                <button type="submit" class="btn-submit">Request Demo <i class="fa-solid fa-arrow-right"></i></button>
                                <p class="text-center text-xs text-gray-500 mt-3">No spam. We'll contact you within 24h.</p>
                            </form>
                        </div>
                    </div>
                </div>
            `;
            document.body.appendChild(demoModal);
        }

        const bookDemoBtns = [document.getElementById('bookDemoBtnDesktop'), document.getElementById('bookDemoBtnMobile')];
        const closeDemo = document.getElementById('closeDemoModal');
        const demoForm = document.getElementById('demoForm');

        bookDemoBtns.forEach(btn => {
            if (btn) btn.addEventListener('click', () => demoModal.style.display = 'flex');
        });
        if (closeDemo) closeDemo.addEventListener('click', () => demoModal.style.display = 'none');
        if (demoModal) demoModal.addEventListener('click', (e) => {
            if (e.target === demoModal) demoModal.style.display = 'none';
        });
        if (demoForm) demoForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('✅ Demo request sent! Our team will contact you within 24 hours.');
            demoForm.reset();
            demoModal.style.display = 'none';
            closeMobileMenu();
        });

    })();
</script>
