    /* Search dropdown animation */
    #searchDropdown {
        animation: fadeInUp 0.25s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
