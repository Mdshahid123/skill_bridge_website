<!-- ======================== CTA SECTION (PROFESSIONAL CARD) ======================== -->
<section class="py-20 px-6 md:px-12 scroll-reveal">
    <div class="container mx-auto max-w-5xl">
        <div class="relative rounded-3xl bg-gradient-to-br from-[#0a2b3e] via-[#1a6f8c] to-[#0066b3] p-12 md:p-16 text-center text-white overflow-hidden shadow-2xl transition-all duration-500 hover:shadow-[0_30px_50px_-12px_rgba(26,111,140,0.5)]">
            <!-- Animated background pattern -->
            <div class="absolute inset-0 opacity-10">
                <div class="absolute -top-20 -right-20 w-80 h-80 bg-white/20 rounded-full blur-3xl animate-pulse"></div>
                <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-white/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
                <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 1px); background-size: 40px 40px;"></div>
            </div>
            <div class="relative z-10">
                <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight">Ready to Start Your Journey?</h2>
                <p class="text-lg md:text-xl text-white/90 mt-4 max-w-2xl mx-auto">Join 15,000+ successful students who transformed their careers with Skill Bridge.</p>
                <div class="flex flex-wrap justify-center gap-5 mt-10">
                    <a href="/courses" class="group relative bg-white text-[#0a2b3e] px-8 py-3.5 rounded-full font-extrabold text-base shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 inline-flex items-center gap-2 overflow-hidden">
                        <span class="relative z-10">Browse Courses</span>
                        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        <div class="absolute inset-0 -translate-x-full group-hover:translate-x-0 transition-transform duration-500 bg-gradient-to-r from-teal-100 to-white/30"></div>
                    </a>
                    <button id="ctaEnquiryBtn" class="group relative border-2 border-white bg-transparent hover:bg-white hover:text-[#0a2b3e] text-white px-8 py-3.5 rounded-full font-extrabold text-base shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 inline-flex items-center gap-2 overflow-hidden">
                        <span class="relative z-10"><i class="fa-regular fa-pen-to-square mr-2"></i>Enquiry</span>
                        <div class="absolute inset-0 -translate-x-full group-hover:translate-x-0 transition-transform duration-500 bg-white/20"></div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================== ENQUIRY MODAL (PROFESSIONAL HORIZONTAL FORM) ======================== -->
<div id="enquiryModal" class="fixed inset-0 z-[1000] hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);">
    <div class="relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl overflow-hidden animate-fadeInUp max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="bg-gradient-to-r from-[#0a2b3e] to-[#1a6f8c] px-6 py-5 flex justify-between items-center">
            <div>
                <h3 class="text-2xl font-bold text-white flex items-center gap-2">
                    <i class="fa-regular fa-pen-to-square"></i> Quick Enquiry
                </h3>
                <p class="text-white/80 text-sm mt-1">Fill the form – we'll respond within 24 hours</p>
            </div>
            <button id="closeEnquiryModal" class="text-white/80 hover:text-white bg-white/20 rounded-full w-10 h-10 flex items-center justify-center transition-all hover:rotate-90 hover:bg-white/30">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        
        <div class="p-6">
            <!-- Message Container (auto‑scrolled into view) -->
            <div id="modalFormMessage" class="mb-5 hidden rounded-xl p-3 text-sm font-medium shadow-sm"></div>
            
            <!-- Dual Tabs (Courses / Degree) -->
            <div class="flex border-b border-gray-200 mb-6">
                <button id="modalCoursesTab" class="modal-tab active flex-1 py-3 text-center font-semibold text-base transition-all duration-300 relative">
                    <i class="fa-solid fa-laptop-code mr-2"></i> Courses
                    <span class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-teal-500 to-blue-500 scale-x-100 transition-transform"></span>
                </button>
                <button id="modalDegreeTab" class="modal-tab flex-1 py-3 text-center font-semibold text-base text-gray-500 hover:text-gray-700 transition-all duration-300 relative">
                    <i class="fa-solid fa-graduation-cap mr-2"></i> Online Degree
                    <span class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-teal-500 to-blue-500 scale-x-0 transition-transform"></span>
                </button>
            </div>
            
            <!-- Horizontal Form (2 columns on desktop, 1 on mobile) -->
            <form id="enquiryForm" class="space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Left Column -->
                    <div class="space-y-4">
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Full Name <span class="text-red-500">*</span></label>
                            <input type="text" id="modalName" name="name" required placeholder="John Doe" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm transition-all">
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Email Address <span class="text-red-500">*</span></label>
                            <input type="email" id="modalEmail" name="email" required placeholder="hello@skillbridge.com" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm transition-all">
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Phone Number <span class="text-red-500">*</span></label>
                            <input type="tel" id="modalPhone" name="phoneNumber" required placeholder="9876543210" maxlength="10" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm transition-all">
                            <p class="text-xs text-gray-400 mt-1">Exactly 10 digits, no spaces</p>
                        </div>
                    </div>
                    
                    <!-- Right Column -->
                    <div class="space-y-4">
                        <!-- Course / Degree Select (switches based on tab) -->
                        <div id="modalCourseOptions">
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Select Course <span class="text-red-500">*</span></label>
                            <select id="modalCourseSelect" name="course" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm bg-white transition-all">
                                <option value="">Select a course *</option>
                                        <option>Web Development</option>
                                        <option>Gen AI</option>
                                        <option>Data Science & AI</option>
                                        <option>Data Analytics</option>
                                        <option>Digital Marketing</option>
                                        <option>Programming Language</option>
                                        <option>Placement Preparation</option>
                                        <option>DSA</option>
                                        <option>UI/UX Design</option>
                                        <option>Cloud & DevOps</option>
                                        <option>Cybersecurity</option>
                            </select>
                        </div>
                        
                        <div id="modalDegreeOptions" class="hidden">
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Select Degree Program <span class="text-red-500">*</span></label>
                            <select id="modalDegreeSelect" name="course" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm bg-white transition-all">
                                       <option value="">Select a degree</option>
                                       <option class="text-gray-900 bg-white">MBA</option>
                                        <option class="text-gray-900 bg-white">MCA</option>
                                        <option class="text-gray-900 bg-white">M.Sc</option>
                                        <option class="text-gray-900 bg-white">M.Com</option>
                                        <option class="text-gray-900 bg-white">M.Ed & Ed.D</option>
                                        <option class="text-gray-900 bg-white">PGDM</option>
                                        <option class="text-gray-900 bg-white">BCA</option>
                                        <option class="text-gray-900 bg-white">B.Sc</option>
                                        <option class="text-gray-900 bg-white">BBA</option>
                                        <option class="text-gray-900 bg-white">BA</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Preferred Callback Time</label>
                            <input type="datetime-local" id="modalCallbackTime" name="callbackTime" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm transition-all">
                        </div>
                        <div>
                            <label class="block text-gray-700 text-sm font-bold mb-1.5">Message (Optional)</label>
                            <textarea id="modalMessage" name="message" rows="2" placeholder="I'm interested in... courses, online degrees, career guidance" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-[#1a6f8c]/40 focus:border-[#1a6f8c] outline-none text-sm resize-none transition-all"></textarea>
                        </div>
                    </div>
                </div>
                
                <input type="hidden" name="degree" value="">
                
                <!-- Submit Button -->
                <button type="submit" id="modalSubmitBtn" class="w-full bg-gradient-to-r from-[#1a6f8c] to-[#0066b3] hover:from-[#0a2b3e] hover:to-[#1a6f8c] text-white py-3 rounded-xl font-bold text-base transition-all duration-300 flex items-center justify-center gap-2 shadow-lg hover:shadow-xl">
                    <i class="fa-regular fa-paper-plane"></i> Submit Enquiry
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    /* Modal animations */
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeInUp {
        animation: fadeInUp 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
    }
    #enquiryModal {
        transition: opacity 0.25s ease;
    }
    
    /* Tab styles */
    .modal-tab {
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }
    .modal-tab.active {
        color: #0f5c6e;
        font-weight: 700;
    }
    .modal-tab.active span {
        transform: scaleX(1);
    }
    .modal-tab span {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #14b8a6, #3b82f6);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }
    
    /* Pulse animation for CTA background */
    @keyframes pulse {
        0%, 100% { opacity: 0.4; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(1.05); }
    }
    .animate-pulse {
        animation: pulse 4s ease-in-out infinite;
    }
    .delay-1000 {
        animation-delay: 1s;
    }
</style>

<script>
    (function() {
        const modal = document.getElementById('enquiryModal');
        const openBtn = document.getElementById('ctaEnquiryBtn');
        const closeBtn = document.getElementById('closeEnquiryModal');
        const form = document.getElementById('enquiryForm');
        const submitBtn = document.getElementById('modalSubmitBtn');
        const msgDiv = document.getElementById('modalFormMessage');
        
        // Tabs
        const coursesTab = document.getElementById('modalCoursesTab');
        const degreeTab = document.getElementById('modalDegreeTab');
        const courseOptionsDiv = document.getElementById('modalCourseOptions');
        const degreeOptionsDiv = document.getElementById('modalDegreeOptions');
        
        // Tab switching
        if (coursesTab && degreeTab) {
            coursesTab.addEventListener('click', () => {
                coursesTab.classList.add('active');
                degreeTab.classList.remove('active');
                courseOptionsDiv.classList.remove('hidden');
                degreeOptionsDiv.classList.add('hidden');
            });
            degreeTab.addEventListener('click', () => {
                degreeTab.classList.add('active');
                coursesTab.classList.remove('active');
                degreeOptionsDiv.classList.remove('hidden');
                courseOptionsDiv.classList.add('hidden');
            });
        }
        
        // Show message and scroll it into view automatically
        function showMessage(message, isError = false) {
            if (!msgDiv) return;
            msgDiv.textContent = message;
            msgDiv.className = `mb-5 rounded-xl p-3 text-sm font-medium shadow-sm ${isError ? 'bg-red-50 text-red-700 border-l-4 border-red-500' : 'bg-green-50 text-green-700 border-l-4 border-green-500'}`;
            msgDiv.classList.remove('hidden');
            
            // Auto-scroll to the message (smooth)
            msgDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            
            setTimeout(() => {
                if (msgDiv) msgDiv.classList.add('hidden');
            }, 5000);
        }
        
        // Open modal
        function openModal() {
            if (!modal) return;
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
            if (msgDiv) msgDiv.classList.add('hidden');
            // Reset to Courses tab
            if (coursesTab) coursesTab.click();
            // Focus first input
            setTimeout(() => document.getElementById('modalName')?.focus(), 100);
        }
        
        function closeModal() {
            if (!modal) return;
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
            if (form) form.reset();
            if (msgDiv) msgDiv.classList.add('hidden');
        }
        
        if (openBtn) openBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
        }
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
        });
        
        // Form submission
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const isCourseTab = coursesTab.classList.contains('active');
                let courseValue = '';
                if (isCourseTab) {
                    const courseSelect = document.getElementById('modalCourseSelect');
                    courseValue = courseSelect.value;
                } else {
                    const degreeSelect = document.getElementById('modalDegreeSelect');
                    courseValue = degreeSelect.value;
                }
                
                const name = document.getElementById('modalName')?.value.trim();
                const email = document.getElementById('modalEmail')?.value.trim();
                const phone = document.getElementById('modalPhone')?.value.trim();
                const callbackTime = document.getElementById('modalCallbackTime')?.value || '';
                const message = document.getElementById('modalMessage')?.value.trim() || '';
                
                if (!name || !email || !phone || !courseValue) {
                    showMessage('❌ All required fields (Name, Email, Phone, and selected option) must be filled.', true);
                    return;
                }
                const phoneRegex = /^\d{10}$/;
                if (!phoneRegex.test(phone)) {
                    showMessage('❌ Phone number must be exactly 10 digits (numbers only).', true);
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    showMessage('❌ Invalid email format.', true);
                    return;
                }
                
                const payload = {
                    name,
                    email,
                    phoneNumber: phone,
                    course: courseValue,
                    message,
                    degree: '',
                    callbackTime
                };
                
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
                }
                
                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await response.json();
                    if (!response.ok) throw new Error(data.error || 'Submission failed');
                    showMessage(data.message || '✅ Your inquiry has been received. We will contact you soon!', false);
                    form.reset();
                    setTimeout(() => closeModal(), 2000);
                } catch (err) {
                    showMessage(err.message || '❌ Something went wrong. Please try again later.', true);
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fa-regular fa-paper-plane"></i> Submit Enquiry';
                    }
                }
            });
        }
    })();
</script>