<style>
    /* Testimonials Section Animations */
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 20s linear infinite;
    }
    
    @keyframes pulse-glow {
        0%, 100% { opacity: 0.05; transform: scale(1); }
        50% { opacity: 0.15; transform: scale(1.1); }
    }
    .animate-pulse-glow {
        animation: pulse-glow 4s ease-in-out infinite;
    }
    
    @keyframes grid-move {
        0% { background-position: 0 0; }
        100% { background-position: 60px 0; }
    }
    .animate-grid-move {
        animation: grid-move 12s linear infinite;
    }
    
    @keyframes float-big {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(5deg); }
    }
    .animate-float-big {
        animation: float-big 5s ease-in-out infinite;
    }
    .animate-float-big-delay {
        animation: float-big 6s ease-in-out infinite 1.5s;
    }
    
    @keyframes pulse-ring {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
    .animate-pulse-ring {
        animation: pulse-ring 1.5s ease-in-out infinite;
    }
    
    @keyframes fade-up {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
    
    /* Particles */
    .particle-testimonial {
        position: absolute;
        background: rgba(34,211,238,0.4);
        border-radius: 50%;
        animation: float-particle 10s infinite ease-in-out;
    }
    .particle-testimonial-1 { width: 3px; height: 3px; top: 15%; left: 20%; animation-duration: 7s; }
    .particle-testimonial-2 { width: 5px; height: 5px; top: 70%; left: 85%; animation-duration: 9s; animation-delay: 1s; }
    .particle-testimonial-3 { width: 2px; height: 2px; top: 40%; left: 10%; animation-duration: 6s; animation-delay: 2s; }
    .particle-testimonial-4 { width: 4px; height: 4px; top: 80%; left: 30%; animation-duration: 8s; animation-delay: 0.5s; }
    .particle-testimonial-5 { width: 3px; height: 3px; top: 25%; left: 75%; animation-duration: 11s; animation-delay: 1.5s; }
    .particle-testimonial-6 { width: 5px; height: 5px; top: 55%; left: 50%; animation-duration: 7.5s; animation-delay: 3s; }
    
    @keyframes float-particle {
        0%, 100% { transform: translateY(0px) translateX(0px); opacity: 0.4; }
        25% { transform: translateY(-40px) translateX(20px); opacity: 0.8; }
        50% { transform: translateY(15px) translateX(-15px); opacity: 0.2; }
        75% { transform: translateY(-20px) translateX(25px); opacity: 0.6; }
    }
    
    .bg-gradient-conic {
        background: conic-gradient(from 0deg, #06b6d4, #3b82f6, #8b5cf6, #06b6d4);
    }
    
    /* Active Dot Styling */
    .testimonial-dot.active {
        width: 24px;
        background: linear-gradient(90deg, #06b6d4, #3b82f6);
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .particle-testimonial {
            display: none;
        }
        
        #prevTestimonial, #nextTestimonial {
            width: 32px;
            height: 32px;
            -translate-x: 0;
        }
    }
</style>

<script>
    // Testimonial Slider Functionality
    (function() {
        const slider = document.getElementById('testimonialSlider');
        const dots = document.querySelectorAll('.testimonial-dot');
        const prevBtn = document.getElementById('prevTestimonial');
        const nextBtn = document.getElementById('nextTestimonial');
        let currentIndex = 0;
        const totalSlides = dots.length;
        let autoSlideInterval;
        const slideIntervalTime = 3000; // 5 seconds per slide
        
        function updateSlider() {
            if (slider) {
                slider.style.transform = `translateX(-${currentIndex * 100}%)`;
            }
            
            // Update active dot
            dots.forEach((dot, index) => {
                if (index === currentIndex) {
                    dot.classList.add('active');
                    dot.style.width = '24px';
                } else {
                    dot.classList.remove('active');
                    dot.style.width = '8px';
                }
            });
        }
        
        function nextSlide() {
            currentIndex = (currentIndex + 1) % totalSlides;
            updateSlider();
            resetAutoSlide();
        }
        
        function prevSlide() {
            currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
            updateSlider();
            resetAutoSlide();
        }
        
        function goToSlide(index) {
            currentIndex = index;
            updateSlider();
            resetAutoSlide();
        }
        
        function startAutoSlide() {
            autoSlideInterval = setInterval(() => {
                nextSlide();
            }, slideIntervalTime);
        }
        
        function resetAutoSlide() {
            if (autoSlideInterval) {
                clearInterval(autoSlideInterval);
            }
            startAutoSlide();
        }
        
        // Event Listeners
        if (nextBtn) {
            nextBtn.addEventListener('click', nextSlide);
        }
        
        if (prevBtn) {
            prevBtn.addEventListener('click', prevSlide);
        }
        
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => goToSlide(index));
        });
        
        // Pause auto-slide on hover
        const sliderContainer = document.querySelector('.overflow-hidden');
        if (sliderContainer) {
            sliderContainer.addEventListener('mouseenter', () => {
                if (autoSlideInterval) {
                    clearInterval(autoSlideInterval);
                }
            });
            
            sliderContainer.addEventListener('mouseleave', () => {
                startAutoSlide();
            });
        }
        
        // Start auto-slide
        startAutoSlide();
        
        // Initialize first dot as active
        if (dots[0]) {
            dots[0].classList.add('active');
            dots[0].style.width = '24px';
        }
    })();
</script>