<style>
    /* Founder Section Animations - Same as Hero Section */
    
    /* Spinning Background */
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 20s linear infinite;
    }
    
    /* Pulse Glow */
    @keyframes pulse-glow {
        0%, 100% { opacity: 0.05; transform: scale(1); }
        50% { opacity: 0.15; transform: scale(1.1); }
    }
    .animate-pulse-glow {
        animation: pulse-glow 4s ease-in-out infinite;
    }
    
    /* Moving Grids */
    @keyframes grid-move {
        0% { background-position: 0 0; }
        100% { background-position: 60px 0; }
    }
    .animate-grid-move {
        animation: grid-move 12s linear infinite;
    }
    
    @keyframes grid-move-reverse {
        0% { background-position: 0 0; }
        100% { background-position: -100px 0; }
    }
    .animate-grid-move-reverse {
        animation: grid-move-reverse 15s linear infinite;
    }
    
    /* Floating Icons */
    @keyframes float-big {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(5deg); }
    }
    .animate-float-big {
        animation: float-big 5s ease-in-out infinite;
    }
    .animate-float-big-delay {
        animation: float-big 6s ease-in-out infinite 1.5s;
    }
    .animate-float-big-delay2 {
        animation: float-big 4.5s ease-in-out infinite 2.5s;
    }
    
    /* Pulse Ring */
    @keyframes pulse-ring {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
    .animate-pulse-ring {
        animation: pulse-ring 1.5s ease-in-out infinite;
    }
    
    /* Fade Up Animation */
    @keyframes fade-up {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
    
    /* Particles */
    .particle-founder {
        position: absolute;
        background: rgba(34,211,238,0.4);
        border-radius: 50%;
        animation: float-particle 10s infinite ease-in-out;
    }
    .particle-founder-1 { width: 3px; height: 3px; top: 15%; left: 20%; animation-duration: 7s; }
    .particle-founder-2 { width: 5px; height: 5px; top: 70%; left: 85%; animation-duration: 9s; animation-delay: 1s; }
    .particle-founder-3 { width: 2px; height: 2px; top: 40%; left: 10%; animation-duration: 6s; animation-delay: 2s; }
    .particle-founder-4 { width: 4px; height: 4px; top: 80%; left: 30%; animation-duration: 8s; animation-delay: 0.5s; }
    .particle-founder-5 { width: 3px; height: 3px; top: 25%; left: 75%; animation-duration: 11s; animation-delay: 1.5s; }
    .particle-founder-6 { width: 5px; height: 5px; top: 55%; left: 50%; animation-duration: 7.5s; animation-delay: 3s; }
    
    @keyframes float-particle {
        0%, 100% { transform: translateY(0px) translateX(0px); opacity: 0.4; }
        25% { transform: translateY(-40px) translateX(20px); opacity: 0.8; }
        50% { transform: translateY(15px) translateX(-15px); opacity: 0.2; }
        75% { transform: translateY(-20px) translateX(25px); opacity: 0.6; }
    }
    
    /* Conic Gradient */
    .bg-gradient-conic {
        background: conic-gradient(from 0deg, #06b6d4, #3b82f6, #8b5cf6, #06b6d4);
    }
    
    /* Leadership Card Hover Effects */
    .leadership-card {
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    
    /* Gradient Border */
    .border-gradient-to-b {
        border-image: linear-gradient(to bottom, #06b6d4, #3b82f6);
        border-image-slice: 1;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .particle-founder {
            display: none;
        }
    }
</style>