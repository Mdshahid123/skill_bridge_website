<style>
    /* ========== ANIMATIONS (unchanged except for question marks) ========== */
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 15s linear infinite;
    }
    
    @keyframes pulse-glow {
        0%, 100% { opacity: 0.15; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.1); }
    }
    .animate-pulse-glow {
        animation: pulse-glow 3s ease-in-out infinite;
    }
    
    @keyframes ping-slow {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }
    .animate-ping-slow {
        animation: ping-slow 2s ease-in-out infinite;
    }
    
    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s ease-in-out infinite;
    }
    
    @keyframes grid-move {
        0% { background-position: 0 0; }
        100% { background-position: 60px 0; }
    }
    .animate-grid-move {
        animation: grid-move 10s linear infinite;
    }
    
    @keyframes grid-move-reverse {
        0% { background-position: 0 0; }
        100% { background-position: -100px 0; }
    }
    .animate-grid-move-reverse {
        animation: grid-move-reverse 15s linear infinite;
    }
    
    @keyframes border-glow {
        0%, 100% { border-color: rgba(34,211,238,0.3); box-shadow: 0 0 10px rgba(34,211,238,0); }
        50% { border-color: rgba(34,211,238,1); box-shadow: 0 0 30px rgba(34,211,238,0.5); }
    }
    .animate-border-glow {
        animation: border-glow 2s ease-in-out infinite;
    }
    .animate-border-glow-delay {
        animation: border-glow 2.5s ease-in-out infinite 1s;
    }
    
    @keyframes fade-up {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
    
    @keyframes slide-down {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-down {
        animation: slide-down 0.5s ease-out forwards;
    }
    
    @keyframes gradient-x {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    .animate-gradient-x {
        background-size: 200% auto;
        animation: gradient-x 3s ease-in-out infinite;
    }
    
    @keyframes pulse-ring {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
    .animate-pulse-ring {
        animation: pulse-ring 1.5s ease-in-out infinite;
    }
    
    /* New animation for question marks: translate up and down */
    @keyframes question-move {
        0%, 100% { transform: translate(-50%, 0px); }
        50% { transform: translate(-50%, -10px); }
    }
    .animate-question-move {
        animation: question-move 2s ease-in-out infinite;
    }
    @keyframes question-move-delay {
        0%, 100% { transform: translate(calc(-50% + 48px), 0px); }
        50% { transform: translate(calc(-50% + 48px), -8px); }
    }
    .animate-question-move-delay {
        animation: question-move-delay 2.2s ease-in-out infinite 0.3s;
    }
    
    /* Particles (unchanged) */
    .particle {
        position: absolute;
        background: rgba(34,211,238,0.6);
        border-radius: 50%;
        animation: float-particle 8s infinite ease-in-out;
    }
    .particle-1 { width: 4px; height: 4px; top: 15%; left: 20%; animation-duration: 6s; }
    .particle-2 { width: 6px; height: 6px; top: 70%; left: 85%; animation-duration: 8s; animation-delay: 1s; }
    .particle-3 { width: 3px; height: 3px; top: 40%; left: 10%; animation-duration: 5s; animation-delay: 2s; }
    .particle-4 { width: 5px; height: 5px; top: 80%; left: 30%; animation-duration: 7s; animation-delay: 0.5s; }
    .particle-5 { width: 4px; height: 4px; top: 25%; left: 75%; animation-duration: 9s; animation-delay: 1.5s; }
    .particle-6 { width: 6px; height: 6px; top: 55%; left: 50%; animation-duration: 6.5s; animation-delay: 3s; }
    .particle-7 { width: 3px; height: 3px; top: 10%; left: 45%; animation-duration: 7.5s; animation-delay: 2.5s; }
    .particle-8 { width: 5px; height: 5px; top: 90%; left: 60%; animation-duration: 5.5s; animation-delay: 1.8s; }
    
    @keyframes float-particle {
        0%, 100% { transform: translateY(0px) translateX(0px); opacity: 0.6; }
        25% { transform: translateY(-30px) translateX(15px); opacity: 1; }
        50% { transform: translateY(10px) translateX(-10px); opacity: 0.4; }
        75% { transform: translateY(-15px) translateX(20px); opacity: 0.8; }
    }
    
    .bg-gradient-conic {
        background: conic-gradient(from 0deg, #06b6d4, #3b82f6, #8b5cf6, #06b6d4);
    }
    
    /* Typing Animation - NO BLINKING CURSOR */
    .typing-wrapper {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: transparent;
    }
    .typing-static {
        color: #e5e7eb;
        font-weight: 600;
    }
    .typing-dynamic-container {
        display: inline-flex;
        align-items: center;
        position: relative;
        min-width: 220px;
    }
    .typing-text {
        color: #22d3ee;
        font-weight: 700;
        white-space: nowrap;
        display: inline-block;
        letter-spacing: 0.5px;
    }
    .typing-cursor {
