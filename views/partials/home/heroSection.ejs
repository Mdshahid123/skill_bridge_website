<script>
    // ==================== DYNAMIC TYPING ANIMATION ====================
    (function() {
        const words = ["Web Development ", "Data Science ", "DSA ", "Data Analytics ", "Digital Marketing ", "Programming Languages ", "UI/UX Design ", "Placement Training "];
        let wordIndex = 0, charIndex = 0, isDeleting = false, isWaiting = false, timeoutId = null;
        const textElement = document.getElementById('dynamic-word');
        if (!textElement) return;
        
        function clearTypingTimeout() { if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; } }
        
        function typeEffect() {
            clearTypingTimeout();
            if (isWaiting) {
                timeoutId = setTimeout(() => { isWaiting = false; typeEffect(); }, 200);
                return;
            }
            const currentWord = words[wordIndex];
            if (isDeleting) {
                if (charIndex > 0) { charIndex--; textElement.textContent = currentWord.substring(0, charIndex); }
                if (charIndex === 0) { isDeleting = false; wordIndex = (wordIndex + 1) % words.length; isWaiting = true; timeoutId = setTimeout(typeEffect, 800); return; }
            } else {
                if (charIndex < currentWord.length) { charIndex++; textElement.textContent = currentWord.substring(0, charIndex); }
                if (charIndex === currentWord.length) { isDeleting = true; isWaiting = true; timeoutId = setTimeout(typeEffect, 2000); return; }
            }
            const speed = isDeleting ? 35 : 65;
            timeoutId = setTimeout(typeEffect, speed);
        }
        setTimeout(typeEffect, 300);
    })();

    // ==================== COUNTER ANIMATION ====================
    (function() {
        function animateCounter(element, target) {
            let current = 0;
            const increment = target / 50;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = Math.floor(target);
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current);
                }
            }, 20);
        }
        const counters = document.querySelectorAll('.counter');
        counters.forEach(counter => {
            const target = parseInt(counter.getAttribute('data-target'));
            if (!isNaN(target)) animateCounter(counter, target);
        });
    })();

    // ==================== HERO FORM – NOW WORKS ON BOTH TABS, ALWAYS ====================
    document.addEventListener('DOMContentLoaded', function() {
        const coursesTab = document.getElementById('heroCoursesTab');
        const degreeTab = document.getElementById('heroDegreeTab');
        const courseOptions = document.getElementById('heroCourseOptions');
        const degreeOptions = document.getElementById('heroDegreeOptions');
        const heroForm = document.getElementById('heroAdmissionForm');
        
        if (!coursesTab || !degreeTab || !heroForm) return;
        
        // DOM refs for form fields
        const fullName = document.getElementById('heroFullName');
        const email = document.getElementById('heroEmail');
        const phone = document.getElementById('heroPhone');
        const message = document.getElementById('heroMessage');
        const courseSelect = document.getElementById('heroCourseSelect');
        const degreeSelect = document.getElementById('heroDegreeSelect');
        const submitBtn = heroForm.querySelector('button[type="submit"]');
        
        // ---- Tab switching ----
        function activateTab(tab) {
            coursesTab.classList.remove('active');
            degreeTab.classList.remove('active');
            tab.classList.add('active');
            
            if (tab === coursesTab) {
                courseOptions.classList.remove('hidden');
                degreeOptions.classList.add('hidden');
            } else {
                degreeOptions.classList.remove('hidden');
                courseOptions.classList.add('hidden');
            }
        }
        
        coursesTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab(coursesTab);
        });
        
        degreeTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab(degreeTab);
        });
        
        activateTab(coursesTab); // default
        
        // ---- Form submission handler ----
        async function handleSubmit(e) {
            e.preventDefault();
            
            // 1. Gather values
            const nameVal = fullName ? fullName.value.trim() : '';
            const emailVal = email ? email.value.trim() : '';
            const phoneVal = phone ? phone.value.trim() : '';
            const msgVal = message ? message.value.trim() : '';
            
            const isCourseActive = coursesTab.classList.contains('active');
            let courseVal = '';
            if (isCourseActive && courseSelect) {
                courseVal = courseSelect.value || '';
            } else if (degreeSelect) {
                courseVal = degreeSelect.value || '';
            }
            
            // 2. Validate
            if (!nameVal || !emailVal || !phoneVal || !courseVal) {
                alert('⚠️ Please fill all required fields.');
                return;
            }
            if (!/^\d{10}$/.test(phoneVal)) {
                alert('⚠️ Phone number must be exactly 10 digits.');
                return;
            }
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
                alert('⚠️ Please enter a valid email address.');
                return;
            }
            
            // 3. Build payload
            const payload = {
                name: nameVal,
                email: emailVal,
                phoneNumber: phoneVal,
                course: courseVal,
                message: msgVal
            };
            if (!isCourseActive) {
                payload.degree = courseVal;
            }
            
            // 4. Disable button
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
            
            try {
                const response = await fetch('/submitEnquery', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                let result = null;
                let responseText = '';
                try {
                    responseText = await response.text();
                    result = JSON.parse(responseText);
                } catch (_) {
                    console.warn('Non-JSON response:', responseText);
                    throw new Error('Server returned an unexpected response. Please try again later.');
                }
                
                if (response.ok) {
                    alert('✅ ' + (result.message || 'Inquiry sent successfully! We will contact you soon.'));
                    // Reset fields
                    if (fullName) fullName.value = '';
                    if (email) email.value = '';
                    if (phone) phone.value = '';
                    if (message) message.value = '';
                    if (courseSelect) courseSelect.value = '';
                    if (degreeSelect) degreeSelect.value = '';
                    // Keep the current tab active (no forced switch)
                } else {
                    const errorMsg = result?.error || result?.message || 'Submission failed. Please try again.';
                    alert('❌ ' + errorMsg);
                }
            } catch (err) {
                console.error('Submission error:', err);
                alert('❌ ' + (err.message || 'Something went wrong. Please check your network and try again.'));
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }
        
        // Attach the event handler (safe to call multiple times)
        heroForm.removeEventListener('submit', handleSubmit);
        heroForm.addEventListener('submit', handleSubmit);
    });
</script>