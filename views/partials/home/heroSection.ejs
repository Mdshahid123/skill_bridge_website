<script>
    // ==================== DYNAMIC TYPING ANIMATION (unchanged) ====================
    (function() {
        const words = ["Web Development ", "Data Science ", "DSA ", "Data Analytics ", "Digital Marketing ", "Programming Languages ","UI/UX Design ", "Placement Training "];
        let wordIndex = 0, charIndex = 0, isDeleting = false, isWaiting = false, timeoutId = null;
        const textElement = document.getElementById('dynamic-word');
        if (!textElement) return;
        
        function clearTypingTimeout() { if (timeoutId) { clearTimeout(timeoutId); timeoutId = null; } }
        
        function typeEffect() {
            clearTypingTimeout();
            if (isWaiting) {
                timeoutId = setTimeout(() => { isWaiting = false; typeEffect(); }, 200);
                return;
            }
            const currentWord = words[wordIndex];
            if (isDeleting) {
                if (charIndex > 0) { charIndex--; textElement.textContent = currentWord.substring(0, charIndex); }
                if (charIndex === 0) { isDeleting = false; wordIndex = (wordIndex + 1) % words.length; isWaiting = true; timeoutId = setTimeout(typeEffect, 800); return; }
            } else {
                if (charIndex < currentWord.length) { charIndex++; textElement.textContent = currentWord.substring(0, charIndex); }
                if (charIndex === currentWord.length) { isDeleting = true; isWaiting = true; timeoutId = setTimeout(typeEffect, 2000); return; }
            }
            const speed = isDeleting ? 35 : 65;
            timeoutId = setTimeout(typeEffect, speed);
        }
        setTimeout(typeEffect, 300);
    })();

    // ==================== COUNTER ANIMATION (unchanged) ====================
    (function() {
        function animateCounter(element, target) {
            let current = 0;
            const increment = target / 40;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = Math.floor(target);
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current);
                }
            }, 20);
        }
        
        const counters = document.querySelectorAll('.counter');
        let animated = false;
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !animated) {
                    animated = true;
                    counters.forEach(counter => {
                        const target = parseInt(counter.getAttribute('data-target'));
                        if (!isNaN(target)) animateCounter(counter, target);
                    });
                    observer.disconnect();
                }
            });
        }, { threshold: 0.3 });
        
        const statsContainer = document.querySelector('.grid-cols-2');
        if (statsContainer) observer.observe(statsContainer);
    })();

    // ==================== MODAL LOGIC (message now optional) ====================
    document.addEventListener('DOMContentLoaded', function() {
        const coursesTab = document.getElementById('modalCoursesTab');
        const degreeTab = document.getElementById('modalDegreeTab');
        const courseOptions = document.getElementById('modalCourseOptions');
        const degreeOptions = document.getElementById('modalDegreeOptions');
        const inquiryBtn = document.getElementById('inquiryBtn');
        const modal = document.getElementById('admissionModal');
        const closeBtn = document.getElementById('closeModalBtn');
        const admissionForm = document.getElementById('admissionForm');
        
        if (!coursesTab || !degreeTab) return;
        
        function activateTab(tabToActivate, showElement, hideElement) {
            coursesTab.classList.remove('active');
            degreeTab.classList.remove('active');
            tabToActivate.classList.add('active');
            showElement.classList.remove('hidden');
            hideElement.classList.add('hidden');
        }
        
        coursesTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab(coursesTab, courseOptions, degreeOptions);
        });
        
        degreeTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab(degreeTab, degreeOptions, courseOptions);
        });
        
        function resetToCourses() {
            activateTab(coursesTab, courseOptions, degreeOptions);
        }
        
        if (inquiryBtn && modal) {
            inquiryBtn.addEventListener('click', function(e) {
                e.preventDefault();
                resetToCourses();
                modal.classList.remove('hidden');
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            });
        }
        
        function closeModal() {
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        }
        
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (modal) modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

        // Admission form submission with validation (message is optional, no check)
        if (admissionForm) {
            admissionForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const name = document.getElementById('fullName')?.value.trim();
                const email = document.getElementById('email')?.value.trim();
                const phone = document.getElementById('phone')?.value.trim();
                const message = document.getElementById('message')?.value.trim() || ''; // optional
                
                const isCourseTab = document.getElementById('modalCoursesTab')?.classList.contains('active');
                let courseValue = '';
                if (isCourseTab) {
                    const courseSelect = document.getElementById('modalCourseSelect');
                    courseValue = courseSelect?.value;
                } else {
                    const degreeSelect = document.getElementById('modalDegreeSelect');
                    courseValue = degreeSelect?.value;
                }
                
                if (!name || !email || !phone || !courseValue) {
                    alert('Please fill all required fields.');
                    return;
                }
                
                const payload = {
                    name: name,
                    email: email,
                    phoneNumber: phone,
                    course: courseValue,
                    message: message
                };

                const submitBtn = admissionForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
                
                try {
                    const response = await fetch('/submitEnquery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await response.json();
                    
                    if (response.ok) {
                        alert('✅ Inquiry sent! You will receive a confirmation email shortly.');
                        admissionForm.reset();
                        document.getElementById('modalCourseSelect').value = '';
                        document.getElementById('modalDegreeSelect').value = '';
                        closeModal();
                    } else {
                        alert('❌ ' + (result.error || 'Submission failed. Please try again.'));
                    }
                } catch(err) {
                    console.error('Submission error:', err);
                    alert('❌ Something went wrong. Please try again later.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
        });
    });
</script>