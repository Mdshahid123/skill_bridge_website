<style>
    /* ========== BOLD VISIBLE ANIMATIONS ========== */
    
    /* Spinning Background */
    @keyframes spin-slow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spin-slow 15s linear infinite;
    }
    
    /* Pulse Glow */
    @keyframes pulse-glow {
        0%, 100% { opacity: 0.15; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.1); }
    }
    .animate-pulse-glow {
        animation: pulse-glow 3s ease-in-out infinite;
    }
    
    /* Ping Slow */
    @keyframes ping-slow {
        0%, 100% { opacity: 0.2; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }
    .animate-ping-slow {
        animation: ping-slow 2s ease-in-out infinite;
    }
    
    /* Bounce Slow */
    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s ease-in-out infinite;
    }
    
    /* Moving Grids */
    @keyframes grid-move {
        0% { background-position: 0 0; }
        100% { background-position: 60px 0; }
    }
    .animate-grid-move {
        animation: grid-move 10s linear infinite;
    }
    
    @keyframes grid-move-reverse {
        0% { background-position: 0 0; }
        100% { background-position: -100px 0; }
    }
    .animate-grid-move-reverse {
        animation: grid-move-reverse 15s linear infinite;
    }
    
    /* Scanning Line */
    @keyframes scan {
        0% { transform: translateX(-100%) rotate(45deg); }
        100% { transform: translateX(100%) rotate(45deg); }
    }
    .animate-scan {
        animation: scan 8s linear infinite;
    }
    
    /* Floating Icons */
    @keyframes float-big {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(8deg); }
    }
    .animate-float-big {
        animation: float-big 4s ease-in-out infinite;
    }
    .animate-float-big-delay {
        animation: float-big 5s ease-in-out infinite 1s;
    }
    .animate-float-big-delay2 {
        animation: float-big 4.5s ease-in-out infinite 2s;
    }
    
    /* Confused Person Floating Animation (Up/Down) */
    @keyframes float-person {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
    }
    .animate-float-person {
        animation: float-person 3s ease-in-out infinite;
    }
    
    /* Floating Question Marks */
    @keyframes float-question {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(10deg); }
    }
    .animate-float-question {
        animation: float-question 2.5s ease-in-out infinite;
    }
    .animate-float-question-delay {
        animation: float-question 3s ease-in-out infinite 0.8s;
    }
    .animate-float-question-delay2 {
        animation: float-question 2.8s ease-in-out infinite 1.5s;
    }
    
    /* Border Glow */
    @keyframes border-glow {
        0%, 100% { border-color: rgba(34,211,238,0.3); box-shadow: 0 0 10px rgba(34,211,238,0); }
        50% { border-color: rgba(34,211,238,1); box-shadow: 0 0 30px rgba(34,211,238,0.5); }
    }
    .animate-border-glow {
        animation: border-glow 2s ease-in-out infinite;
    }
    .animate-border-glow-delay {
        animation: border-glow 2.5s ease-in-out infinite 1s;
    }
    
    /* Fade Up Animation */
    @keyframes fade-up {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fade-up 0.6s ease-out forwards;
    }
    
    /* Slide Down */
    @keyframes slide-down {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-down {
        animation: slide-down 0.5s ease-out forwards;
    }
    
    /* Gradient X Animation */
    @keyframes gradient-x {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    .animate-gradient-x {
        background-size: 200% auto;
        animation: gradient-x 3s ease-in-out infinite;
    }
    
    /* Pulse Ring */
    @keyframes pulse-ring {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
    .animate-pulse-ring {
        animation: pulse-ring 1.5s ease-in-out infinite;
    }
    
    /* Particles */
    .particle {
        position: absolute;
        background: rgba(34,211,238,0.6);
        border-radius: 50%;
        animation: float-particle 8s infinite ease-in-out;
    }
    .particle-1 { width: 4px; height: 4px; top: 15%; left: 20%; animation-duration: 6s; }
    .particle-2 { width: 6px; height: 6px; top: 70%; left: 85%; animation-duration: 8s; animation-delay: 1s; }
    .particle-3 { width: 3px; height: 3px; top: 40%; left: 10%; animation-duration: 5s; animation-delay: 2s; }
    .particle-4 { width: 5px; height: 5px; top: 80%; left: 30%; animation-duration: 7s; animation-delay: 0.5s; }
    .particle-5 { width: 4px; height: 4px; top: 25%; left: 75%; animation-duration: 9s; animation-delay: 1.5s; }
    .particle-6 { width: 6px; height: 6px; top: 55%; left: 50%; animation-duration: 6.5s; animation-delay: 3s; }
    .particle-7 { width: 3px; height: 3px; top: 10%; left: 45%; animation-duration: 7.5s; animation-delay: 2.5s; }
    .particle-8 { width: 5px; height: 5px; top: 90%; left: 60%; animation-duration: 5.5s; animation-delay: 1.8s; }
    
    @keyframes float-particle {
        0%, 100% { transform: translateY(0px) translateX(0px); opacity: 0.6; }
        25% { transform: translateY(-30px) translateX(15px); opacity: 1; }
        50% { transform: translateY(10px) translateX(-10px); opacity: 0.4; }
        75% { transform: translateY(-15px) translateX(20px); opacity: 0.8; }
    }
    
    /* Conic Gradient */
    .bg-gradient-conic {
        background: conic-gradient(from 0deg, #06b6d4, #3b82f6, #8b5cf6, #06b6d4);
    }
    
    /* Typing Animation */
    .typing-wrapper { display: inline-flex; align-items: center; gap: 4px; }
    .typing-static { color: #e5e7eb; }
    .typing-dynamic-container { display: inline-flex; align-items: center; position: relative; }
    .typing-text { color: #22d3ee; font-weight: 700; white-space: nowrap; }
    .typing-cursor { display: inline-block; width: 3px; height: 2rem; background-color: #22d3ee; animation: cursorBlink 0.8s step-end infinite; vertical-align: middle; }
    @keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    
    /* Modal Pop */
    @keyframes modal-pop {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    .animate-modal-pop {
        animation: modal-pop 0.3s ease-out forwards;
    }
    
    .animate-float-slow {
        animation: float-person 3s ease-in-out infinite;
    }
    
    .modal-tab {
        transition: all 0.3s ease;
    }
    .modal-tab.active {
        background: rgba(34,211,238,0.2);
        border-color: #22d3ee;
        color: #22d3ee;
    }
    
    .counter {
        display: inline-block;
    }

    /* Remove or comment out the cursor styles */
.typing-cursor {
    display: none;
}

.typing-cursor {
    display: inline-block;
    width: 3px;
    height: 2rem;
    background-color: #22d3ee;
    vertical-align: middle;
    animation: none; /* Remove blinking animation */
}
</style>

<script>
    // ==================== DYNAMIC TYPING ANIMATION (NO BLINKING) ====================
(function() {
    const words = ["Web Development ", "Data Science ", "DSA ", "Data Analytics ", "Digital Marketing ", "Programming Languages "];
    let wordIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let timeoutId = null;
    const textElement = document.getElementById('dynamic-word');
    
    if (!textElement) return;
    
    function clearTypingTimeout() {
        if (timeoutId) {
            clearTimeout(timeoutId);
            timeoutId = null;
        }
    }
    
    function typeEffect() {
        clearTypingTimeout();
        
        const currentWord = words[wordIndex];
        
        if (isDeleting) {
            charIndex--;
            textElement.textContent = currentWord.substring(0, charIndex);
            
            if (charIndex === 0) {
                isDeleting = false;
                wordIndex = (wordIndex + 1) % words.length;
                timeoutId = setTimeout(typeEffect, 500);
                return;
            }
        } else {
            charIndex++;
            textElement.textContent = currentWord.substring(0, charIndex);
            
            if (charIndex === currentWord.length) {
                isDeleting = true;
                timeoutId = setTimeout(typeEffect, 1500);
                return;
            }
        }
        
        const speed = isDeleting ? 30 : 60;
        timeoutId = setTimeout(typeEffect, speed);
    }
    
    // Start the typing animation after a short delay
    setTimeout(typeEffect, 500);
})();

    // Counter Animation
    (function() {
        function animateCounter(element, target) {
            let current = 0;
            const increment = target / 40;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = Math.floor(target);
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current);
                }
            }, 25);
        }
        
        const counters = document.querySelectorAll('.counter');
        let animated = false;
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !animated) {
                    animated = true;
                    counters.forEach(counter => {
                        const target = parseInt(counter.getAttribute('data-target'));
                        if (!isNaN(target)) animateCounter(counter, target);
                    });
                    observer.disconnect();
                }
            });
        }, { threshold: 0.3 });
        
        const statsContainer = document.querySelector('.grid-cols-2');
        if (statsContainer) observer.observe(statsContainer);
    })();

    // Modal Logic
    (function() {
        const inquiryBtn = document.getElementById('inquiryBtn');
        const modal = document.getElementById('admissionModal');
        const closeBtn = document.getElementById('closeModalBtn');
        const coursesTab = document.getElementById('modalCoursesTab');
        const degreeTab = document.getElementById('modalDegreeTab');
        const courseOptions = document.getElementById('modalCourseOptions');
        const degreeOptions = document.getElementById('modalDegreeOptions');
        const form = document.getElementById('admissionForm');
        
        if (coursesTab && degreeTab) {
            coursesTab.onclick = () => {
                coursesTab.classList.add('active');
                degreeTab.classList.remove('active');
                courseOptions.classList.remove('hidden');
                degreeOptions.classList.add('hidden');
            };
            degreeTab.onclick = () => {
                degreeTab.classList.add('active');
                coursesTab.classList.remove('active');
                degreeOptions.classList.remove('hidden');
                courseOptions.classList.add('hidden');
            };
        }
        
        if (inquiryBtn && modal) {
            inquiryBtn.onclick = (e) => {
                e.preventDefault();
                modal.classList.remove('hidden');
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            };
        }
        
        const closeModal = () => {
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.style.overflow = '';
        };
        
        if (closeBtn) closeBtn.onclick = closeModal;
        if (modal) modal.onclick = (e) => { if (e.target === modal) closeModal(); };
        if (form) form.onsubmit = (e) => { e.preventDefault(); alert('✅ Thank you! Our counselor will contact you soon.'); form.reset(); closeModal(); };
        document.onkeydown = (e) => { if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal(); };
    })();
</script>