    }
    
    .modal-overlay .inquiry-tab {
        transition: all 0.2s ease;
        cursor: pointer;
    }
    
    .modal-overlay .inquiry-tab.active {
        background: linear-gradient(105deg, #0a2b3e 0%, #1a6f8c 100%);
        color: white;
        border-color: transparent;
