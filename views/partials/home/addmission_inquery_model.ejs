<div id="inquiryModal" class="modal-overlay">
    <div class="inquiry-modal">
        <div class="modal-close" id="closeInquiryModal">&times;</div>
        <div class="text-center mb-6">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-[#0a2b3e] to-[#1a6f8c] flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-file-pen text-white text-2xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800">Get Admission Inquiry</h2>
            <p class="text-gray-500 text-sm mt-1">Fill the form and our counselor will contact you</p>
        </div>
        
        <!-- Inquiry Type Tabs -->
        <div class="flex gap-3 mb-6">
            <button type="button" id="modalCoursesTab" class="inquiry-tab active flex-1 px-4 py-2.5 rounded-lg border-2 border-[#1a6f8c] text-[#1a6f8c] font-semibold text-sm flex items-center justify-center gap-2">
                <i class="fa-solid fa-laptop-code"></i> Courses Inquiry
            </button>
            <button type="button" id="modalDegreeTab" class="inquiry-tab flex-1 px-4 py-2.5 rounded-lg border-2 border-gray-300 text-gray-600 font-semibold text-sm flex items-center justify-center gap-2">
                <i class="fa-solid fa-graduation-cap"></i> Online Degree Program
            </button>
        </div>
        
        <form action="/submitEnquery" id="inquiryForm" class="space-y-4" method="POST">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                <input type="text" id="fullName" name="fullName" required class="form-input" placeholder="Enter your full name">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label>
                <input type="email" id="email" name="email" required class="form-input" placeholder="you@example.com">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+91 98765 43210">
            </div>
            
            <!-- Courses Options (Visible by default) -->
            <div id="modalCourseOptions">
                <label class="block text-sm font-medium text-gray-700 mb-1">Interested Course *</label>
                <select id="courseSelect" name="course" class="form-input">
                    <option value="">Select a course</option>
                    <option>Web Development</option>
                    <option>Data Science & AI</option>
                    <option>Cloud & DevOps</option>
                    <option>Data Structures & Algorithms</option>
                    <option>Cybersecurity</option>
                    <option>Digital Marketing</option>
                    <option>Mobile App Development</option>
                    <option>UI/UX Design</option>
                    <option>Blockchain Development</option>
                </select>
            </div>
            
            <!-- Degree Program Options (Hidden by default) -->
            <div id="modalDegreeOptions" class="hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1">Select Degree Program *</label>
                <select id="degreeSelect" name="degree" class="form-input">
                    <option value="">Select a degree program</option>
                    <option>B.Tech in Computer Science</option>
                    <option>BBA in Digital Business</option>
                    <option>M.Sc in Artificial Intelligence</option>
                    <option>M.Tech in Cybersecurity</option>
                    <option>BCA (Bachelor of Computer Applications)</option>
                    <option>MCA (Master of Computer Applications)</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Preferred Callback Time</label>
                <select id="callbackTime" name="callbackTime" class="form-input">
                    <option value="">Select time slot</option>
                    <option>Morning (9 AM - 12 PM)</option>
                    <option>Afternoon (12 PM - 3 PM)</option>
                    <option>Evening (3 PM - 6 PM)</option>
                    <option>Night (6 PM - 8 PM)</option>
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Message (Optional)</label>
                <textarea id="message" name="message" rows="3" class="form-input" placeholder="Any specific questions?"></textarea>
            </div>
            
            <button type="submit" class="submit-inquiry-btn">Submit Inquiry <i class="fa-solid fa-paper-plane ml-2"></i></button>
        </form>
    </div>
</div>

