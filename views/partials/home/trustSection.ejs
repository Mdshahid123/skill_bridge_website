<style>
    /* TRUST SECTION - SEAMLESS INFINITE SCROLLING */
    .trust-section { 
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%); 
        padding: 60px 0; 
        overflow: hidden; 
        position: relative;
    }
    
    /* Row 1 - Scrolls from RIGHT to LEFT (seamless loop) */
    .marquee-right-to-left {
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
        margin-bottom: 30px;
        position: relative;
    }
    
    .marquee-right-to-left .marquee-track {
        display: inline-flex;
        align-items: center;
        gap: 40px;
        animation: scrollRightToLeft 25s linear infinite;
        width: max-content;
    }
    
    @keyframes scrollRightToLeft {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    
    /* Row 2 - Scrolls from LEFT to RIGHT (seamless loop) */
    .marquee-left-to-right {
        width: 100%;
        overflow: hidden;
        white-space: nowrap;
        position: relative;
    }
    
    .marquee-left-to-right .marquee-track {
        display: inline-flex;
        align-items: center;
        gap: 40px;
        animation: scrollLeftToRight 25s linear infinite;
        width: max-content;
    }
    
    @keyframes scrollLeftToRight {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }
    
    /* Pause on hover */
    .marquee-right-to-left:hover .marquee-track,
    .marquee-left-to-right:hover .marquee-track {
        animation-play-state: paused;
    }
    
    /* Logo Styles */
    .trust-logo { 
        display: inline-flex; 
        flex-direction: column; 
        align-items: center; 
        justify-content: center;
        gap: 8px; 
        background: white; 
        padding: 12px 28px; 
        border-radius: 60px; 
        box-shadow: 0 5px 15px rgba(0,0,0,0.05); 
        transition: all 0.3s ease; 
        border: 1px solid rgba(0,0,0,0.05);
        cursor: pointer;
        position: relative;
    }
    
    .trust-logo:hover { 
        transform: translateY(-5px); 
        box-shadow: 0 15px 25px rgba(0,0,0,0.1); 
        border-color: rgba(26,111,140,0.3); 
    }
    
    .trust-logo img { 
        width: 2rem; 
        height: 2rem; 
        object-fit: contain; 
        transition: transform 0.2s;
    }
    
    .trust-logo span { 
        font-size: 0.75rem; 
        font-weight: 600; 
        color: #4b5563; 
        margin-top: 5px; 
    }
    
    /* Fallback: if image fails to load, show company initial with brand color */
    .trust-logo img::before {
        content: attr(alt);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: #e5e7eb;
        color: #374151;
        font-weight: bold;
        font-size: 1rem;
        border-radius: 50%;
    }
    
    /* Mobile Responsive */
    @media (max-width: 768px) {
        .trust-section { padding: 40px 0; }
        .trust-logo { padding: 8px 20px; }
        .trust-logo img { width: 1.5rem; height: 1.5rem; }
        .trust-logo span { font-size: 0.6rem; }
        .marquee-right-to-left .marquee-track,
        .marquee-left-to-right .marquee-track { gap: 20px; }
    }
</style>

<script>
    // Optional: Add error handling for images that fail to load
    document.querySelectorAll('.trust-logo img').forEach(img => {
        img.onerror = function() {
            const company = this.parentElement.getAttribute('data-company') || this.alt;
            this.style.display = 'none';
            const fallback = document.createElement('div');
            fallback.textContent = company.charAt(0).toUpperCase();
            fallback.style.width = '2rem';
            fallback.style.height = '2rem';
            fallback.style.backgroundColor = '#e5e7eb';
            fallback.style.borderRadius = '50%';
            fallback.style.display = 'flex';
            fallback.style.alignItems = 'center';
            fallback.style.justifyContent = 'center';
            fallback.style.fontWeight = 'bold';
            fallback.style.fontSize = '1rem';
            fallback.style.color = '#374151';
            this.parentElement.insertBefore(fallback, this);
        };
    });
</script>