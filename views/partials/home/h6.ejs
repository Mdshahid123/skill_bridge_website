    }
    
    .typing-cursor {
        display: inline-block;
        width: 3px;
        height: 1.8rem;
        background-color: #0891b2;
        animation: cursorBlink 0.8s step-end infinite;
        vertical-align: middle;
    }
    
    @keyframes cursorBlink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>