<!-- Courses Section – DYNAMIC -->
<section id="courses" class="py-16 px-6 md:px-12 bg-gradient-to-b from-gray-50 to-white scroll-reveal">
    <div class="container mx-auto max-w-6xl text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-2 section-underline pb-2">Our Premium Courses</h2>

        <% 
            // Prepare course data
            const courses = typeof registerCourses !== 'undefined' && Array.isArray(registerCourses) 
                ? registerCourses 
                : [];
            
            // Limit for initial visible cards (first 3)
            const initialCount = 3;
            const initialCourses = courses.slice(0, initialCount);
            const moreCourses = courses.slice(initialCount);
            
            // Fallback image if course.image is missing
            const defaultImage = 'https://via.placeholder.com/600x400?text=Course+Image';
        %>

        <!-- Initial 3 Courses (visible by default) -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10" id="initialCourses">
            <% if (initialCourses.length > 0) { %>
                <% initialCourses.forEach(course => { %>
                    <div class="course-card-impressive bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 flex flex-col">
                        <div class="course-img-wrapper h-52 overflow-hidden relative">
                            <img src="<%= course.image || defaultImage %>" 
                                 alt="<%= course.courseName %>" 
                                 class="w-full h-full object-cover transition-transform duration-500">
                            <div class="course-overlay"></div>
                            <!-- Optional badge: you can add logic if you have a 'popular' field -->
                            <!-- <div class="course-badge-new text-[10px] px-2 py-1 top-2 right-2">Popular</div> -->
                        </div>
                        <div class="p-5 flex-grow">
                            <h3 class="text-xl font-bold text-gray-800 mb-2"><%= course.courseName %></h3>
                            <p class="text-gray-600 text-sm leading-relaxed"><%= course.courseDescription || 'No description available.' %></p>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full text-center py-8 text-gray-500">
                    <p>No courses available at the moment. Please check back later.</p>
                </div>
            <% } %>
        </div>

        <!-- Additional Courses (hidden initially, shown on "View All") -->
        <% if (moreCourses.length > 0) { %>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6 hidden" id="moreCourses">
                <% moreCourses.forEach(course => { %>
                    <div class="course-card-impressive bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 flex flex-col">
                        <div class="course-img-wrapper h-52 overflow-hidden relative">
                            <img src="<%= course.image || defaultImage %>" 
                                 alt="<%= course.courseName %>" 
                                 class="w-full h-full object-cover transition-transform duration-500">
                            <div class="course-overlay"></div>
                        </div>
                        <div class="p-5 flex-grow">
                            <h3 class="text-xl font-bold text-gray-800 mb-2"><%= course.courseName %></h3>
                            <p class="text-gray-600 text-sm leading-relaxed"><%= course.courseDescription || 'No description available.' %></p>
                        </div>
                    </div>
                <% }); %>
            </div>

            <!-- Toggle Button -->
            <div class="mt-10">
                <button id="toggleCoursesBtn" class="border-2 border-[#0a2b3e] px-8 py-3 rounded-full font-semibold text-base hover:bg-[#0a2b3e] hover:text-white transition-all duration-300">
                    View All Courses →
                </button>
            </div>
        <% } %>
    </div>
</section>

<!-- Reuse your existing styles (they are unchanged) -->
<style>
    /* Course Card Styles - Reduced Displacement */
    .course-card-impressive {
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        will-change: transform;
    }
    .course-card-impressive:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.12);
    }
    .course-img-wrapper img {
        transition: transform 0.4s ease-out;
    }
    .course-card-impressive:hover .course-img-wrapper img {
        transform: scale(1.03);
    }
    .course-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(10,43,62,0.2) 0%, rgba(26,111,140,0.3) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .course-card-impressive:hover .course-overlay {
        opacity: 1;
    }
</style>

<script>
    // Toggle functionality – works with dynamic data
    document.addEventListener('DOMContentLoaded', function() {
        const initialCourses = document.getElementById('initialCourses');
        const moreCourses = document.getElementById('moreCourses');
        const toggleBtn = document.getElementById('toggleCoursesBtn');

        // If there are no extra courses, hide the button
        if (moreCourses && moreCourses.children.length === 0 && toggleBtn) {
            toggleBtn.style.display = 'none';
        }

        let isExpanded = false;
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                if (!isExpanded) {
                    moreCourses.classList.remove('hidden');
                    toggleBtn.textContent = 'Show Less Courses ↑';
                    isExpanded = true;
                } else {
                    moreCourses.classList.add('hidden');
                    toggleBtn.textContent = 'View All Courses →';
                    isExpanded = false;
                    document.getElementById('courses').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }
    });
</script>