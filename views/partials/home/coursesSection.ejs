<style>
    /* Course Card Styles - Reduced Displacement */
    .course-card-impressive {
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        will-change: transform;
    }
    
    .course-card-impressive:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.12);
    }
    
    /* Image hover effect - subtle zoom */
    .course-img-wrapper img {
        transition: transform 0.4s ease-out;
    }
    
    .course-card-impressive:hover .course-img-wrapper img {
        transform: scale(1.03);
    }
    
    /* Overlay effect - subtle */
    .course-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(10,43,62,0.2) 0%, rgba(26,111,140,0.3) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .course-card-impressive:hover .course-overlay {
        opacity: 1;
    }
</style>

<script>
    // Toggle functionality for View All / Show Less
    document.addEventListener('DOMContentLoaded', function() {
        const initialCourses = document.getElementById('initialCourses');
        const moreCourses = document.getElementById('moreCourses');
        const toggleBtn = document.getElementById('toggleCoursesBtn');
        
        let isExpanded = false;
        
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function() {
                if (!isExpanded) {
                    // Show all courses
                    moreCourses.classList.remove('hidden');
                    toggleBtn.textContent = 'Show Less Courses ↑';
                    isExpanded = true;
                } else {
                    // Hide extra courses
                    moreCourses.classList.add('hidden');
                    toggleBtn.textContent = 'View All Courses →';
                    isExpanded = false;
                    
                    // Smooth scroll back to courses section
                    document.getElementById('courses').scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }
    });
</script>