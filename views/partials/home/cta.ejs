    .question-mark-big {
        font-size: 3rem;
        font-weight: 700;
        background: linear-gradient(145deg, #0a2b3e, #1a6f8c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        opacity: 0.9;
    }
    
    .question-mark-small {
