<script>
    // Handle CTA form submission
    (function() {
        const ctaForm = document.getElementById('ctaHelpForm');
        if (ctaForm) {
            ctaForm.addEventListener('submit', function(e) {
                e.preventDefault();
                alert('✅ Thank you! Our counselor will contact you soon.');
                this.reset();
            });
        }
    })();
</script>