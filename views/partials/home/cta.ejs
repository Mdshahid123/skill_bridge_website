                    </div>
                    <div>
                        <label class="text-xs font-medium text-gray-700 block mb-1">Message</label>
                        <textarea rows="1" placeholder="I'm interested in... courses, scholarships, career guidance" class="input-field w-full rounded-lg px-3 py-2 text-sm text-gray-800 resize-none bg-gray-50"></textarea>
