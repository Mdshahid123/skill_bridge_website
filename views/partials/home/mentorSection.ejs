<style>
    .mentor-card {
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        will-change: transform;
        overflow: hidden;
    }
    .mentor-card:hover {
        box-shadow: 0 20px 30px -12px rgba(26,111,140,0.15);
    }
    .mentor-card .relative {
        overflow: hidden;
        background-color: #f3f4f6;
    }
    .mentor-card .relative img {
        transition: transform 0.5s ease-out;
    }
    .mentor-card p {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    @media (max-width: 768px) {
        .mentor-card .relative {
            height: 240px !important;
        }
        .mentor-card {
            width: 280px !important;
        }
    }
    #mentorCarouselWrapper {
        overflow: hidden !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const wrapper = document.getElementById('mentorCarouselWrapper');
        const track = document.getElementById('mentorTrack');
        const prevBtn = document.getElementById('prevMentorBtn');
        const nextBtn = document.getElementById('nextMentorBtn');

        if (!wrapper || !track || !prevBtn || !nextBtn) return;

        let currentIndex = 0;
        let visibleCount = 3;
        let cardWidth = 0;
        let gap = 24;

        function updateCarousel() {
            visibleCount = window.innerWidth < 768 ? 2 : 3;

            const firstCard = track.querySelector('.mentor-card');
            if (!firstCard) return;

            const trackStyle = window.getComputedStyle(track);
            gap = parseFloat(trackStyle.gap) || 24;

            const cardRect = firstCard.getBoundingClientRect();
            const cardTotalWidth = cardRect.width + gap;

            const totalCards = track.children.length;
            const maxIndex = Math.max(0, totalCards - visibleCount);
            if (currentIndex > maxIndex) currentIndex = maxIndex;
            if (currentIndex < 0) currentIndex = 0;

            const wrapperWidth = visibleCount * cardTotalWidth - gap;
            wrapper.style.width = wrapperWidth + 'px';

            const shift = currentIndex * cardTotalWidth;
            track.style.transform = `translateX(-${shift}px)`;

            prevBtn.style.opacity = currentIndex === 0 ? '0.3' : '1';
            nextBtn.style.opacity = currentIndex >= maxIndex ? '0.3' : '1';
        }

        function slide(direction) {
            const totalCards = track.children.length;
            const maxIndex = Math.max(0, totalCards - visibleCount);
            const newIndex = Math.min(Math.max(0, currentIndex + direction), maxIndex);
            if (newIndex !== currentIndex) {
                currentIndex = newIndex;
                updateCarousel();
            }
        }

        prevBtn.addEventListener('click', () => slide(-1));
        nextBtn.addEventListener('click', () => slide(1));

        let resizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(updateCarousel, 200);
        });

        setTimeout(updateCarousel, 200);
        window.addEventListener('load', updateCarousel);
    });
</script>