    .particle-mentor-5 { width: 3px; height: 3px; top: 25%; left: 75%; animation-duration: 11s; animation-delay: 1.5s; }
    .particle-mentor-6 { width: 5px; height: 5px; top: 55%; left: 50%; animation-duration: 7.5s; animation-delay: 3s; }
    
    @keyframes float-particle {
        0%, 100% { transform: translateY(0px) translateX(0px); opacity: 0.4; }
        25% { transform: translateY(-40px) translateX(20px); opacity: 0.8; }
        50% { transform: translateY(15px) translateX(-15px); opacity: 0.2; }
        75% { transform: translateY(-20px) translateX(25px); opacity: 0.6; }
